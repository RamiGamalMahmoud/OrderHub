<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>632ae278-bff5-426b-815c-2de7bcd10723</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="TailwindBlazor" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderHub.Application\OrderHub.Application.csproj" />
    <ProjectReference Include="..\OrderHub.Domain\OrderHub.Domain.csproj" />
    <ProjectReference Include="..\OrderHub.Infrastructure\OrderHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="wwwroot\fonts\Tajawal-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Images\almasajid.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Resources\Images\documents-background.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

	<PropertyGroup>
		<TailwindVersion>4.1.18</TailwindVersion>
		<TailwindInputFile>Styles/app.css</TailwindInputFile>
		<TailwindOutputFile>wwwroot/css/tailwind.css</TailwindOutputFile>
		<TailwindEnabled>true</TailwindEnabled>
		<TailwindMinify>false</TailwindMinify>
	</PropertyGroup>

  <!-- Release archives use only base settings; server configuration is external. -->
  <ItemGroup Condition="'$(ReleasePackage)' == 'true'">
    <Content Update="appsettings.*.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
