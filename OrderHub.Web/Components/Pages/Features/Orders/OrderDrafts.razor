@using System.Globalization
@using OrderHub.Application.Features.OrderDrafts.Contracts
@using OrderHub.Application.Interfaces
@using OrderHub.Application.Features.OrderDrafts.List
@using OrderHub.Application.Features.OrderDrafts.Delete
@using OrderHub.Web.Components.Pages.Features.Orders.Drafts
@inject IRequestExecutor RequestExecutor
@inject IDialogService DialogService
@inject ILogger<OrderDrafts> Logger
@implements IDisposable

<MudDrawer Open="@IsOpen"
           Anchor="Anchor.End"
           OpenChanged="OnOpenChanged"
           Variant="@DrawerVariant.Temporary"
           Class="bg-slate-50"
           Width="min(92vw, 380px)">

    <div class="flex h-full min-h-0 flex-col">
        <header class="flex items-center gap-2.5 border-b border-slate-200 bg-white px-4 py-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                <MudIcon Icon="@Icons.Material.Filled.Description" Class="text-[18px]" />
            </span>
            <div class="min-w-0">
                <p class="text-sm font-black text-slate-900">الطلبات المعلقة</p>
                <p class="text-[11px] text-slate-500">
                    @((_stats?.TotalCount ?? 0).ToString(CultureInfo.InvariantCulture)) مسودة غير مكتملة
                </p>
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           OnClick="OnCloseClicked"
                           aria-label="إغلاق المسودات"
                           Class="ms-auto rounded-lg text-slate-500" />
        </header>

        <div class="flex-1 space-y-2.5 overflow-y-auto p-3">
            @if (_busy)
            {
                <MudProgressLinear Color="Color.Info" Indeterminate="true" Class="rounded-full" aria-label="جارٍ تحميل المسودات" />
            }

            @if (_error is not null)
            {
                <div class="rounded-xl bg-rose-50 p-3" role="alert">
                    <p class="text-xs font-bold text-rose-700">@_error</p>
                    <button type="button"
                            class="mt-2 rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-rose-700 transition-colors hover:bg-rose-100 disabled:opacity-50"
                            disabled="@_busy"
                            @onclick="RefreshAsync">إعادة المحاولة</button>
                </div>
            }
            else if (!_busy && _items.Count == 0)
            {
                <div class="rounded-xl bg-white p-6 text-center shadow-xs">
                    <span class="mx-auto mb-2 flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="text-[22px]" aria-hidden="true" />
                    </span>
                    <p class="text-sm font-bold text-slate-800">لا توجد طلبات معلقة.</p>
                    <p class="mt-1 text-[11px] text-slate-500">ستظهر هنا الطلبات التي لم يتم إكمالها بعد.</p>
                </div>
            }

            @foreach (OrderDraftSummary draftSummary in _items)
            {
                <DraftCard Summary="draftSummary"
                           Compact="true"
                           Busy="_busy"
                           OnContinue="NavigateToDraft"
                           OnDelete="DeleteDraftAsync"
                           @key="draftSummary.Id" />
            }
        </div>

        <footer class="space-y-2 border-t border-slate-200 bg-white p-3">
            <button type="button"
                    class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-sky-600 px-3 py-2 text-xs font-bold text-white transition-colors hover:bg-sky-700"
                    @onclick="OpenDraftsPage">
                <MudIcon Icon="@Icons.Material.Filled.Description" Class="text-[16px]" />
                <span>عرض كل المسودات</span>
            </button>
            @if (_error is null && _total > 0)
            {
                <DraftsPager TotalItems="_total"
                             CurrentPage="_page"
                             CurrentPageChanged="OnPageChanged"
                             PageSize="_pageSize"
                             Compact="true" />
            }
        </footer>
    </div>
</MudDrawer>

@code
{
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private IReadOnlyList<OrderDraftSummary> _items { get; set; } = [];
    private DraftListStats? _stats;
    private int _page = 1;
    private int _pageSize = 5;
    private int _total;
    private bool _wasOpen;
    private bool _busy;
    private bool _refreshPending;
    private bool _disposed;
    private long _loadVersion;
    private string? _error;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    private Task OnOpenChanged(bool value)
    {
        return IsOpenChanged.InvokeAsync(value);
    }

    protected override Task OnParametersSetAsync()
    {
        bool opening = IsOpen && !_wasOpen;
        _wasOpen = IsOpen;
        if (!IsOpen)
        {
            _loadVersion++;
            return Task.CompletedTask;
        }

        if (opening)
            _page = 1;

        return opening ? RefreshAsync() : Task.CompletedTask;
    }

    private Task OnCloseClicked() => IsOpenChanged.InvokeAsync(false);

    private void NavigateToDraft(Guid draftId) => Navigation.NavigateTo($"/orders/continue/{draftId}");

    private async Task OpenDraftsPage()
    {
        await IsOpenChanged.InvokeAsync(false);
        Navigation.NavigateTo("/orders/drafts");
    }

    public async Task RefreshAsync()
    {
        if (_disposed || !IsOpen)
            return;
        if (_busy)
        {
            _refreshPending = true;
            return;
        }

        _busy = true;
        try
        {
            do
            {
                _refreshPending = false;
                _error = null;
                long version = ++_loadVersion;
                try
                {
                    var result = await RequestExecutor.ExecuteAsync(new GetDraftListQuery(new DraftListRequest(_page, _pageSize)));
                    if (!_disposed && IsOpen && version == _loadVersion)
                    {
                        _items = result.Items;
                        _total = result.TotalCount;
                        _stats = result.Stats;
                        _page = result.Page;
                    }
                }
                catch (Exception exception)
                {
                    Logger.LogError(exception, "Failed to refresh order drafts.");
                    if (!_disposed && IsOpen && version == _loadVersion)
                        _error = "تعذر تحميل المسودات. حاول مرة أخرى.";
                }
            } while (_refreshPending && IsOpen && !_disposed);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Max(1, page);
        await RefreshAsync();
    }

    private async Task DeleteDraftAsync(Guid draftId)
    {
        if (_busy || _disposed)
            return;
        _busy = true;
        _error = null;
        try
        {
            var result = await DialogService.ShowMessageBoxAsync(
                "حذف مسودة", "هل أنت متأكد من حذف هذه المسودة نهائياً؟", yesText: "نعم", cancelText: "لا");
            if (result is true && !_disposed)
            {
                var deleteResult = await RequestExecutor.ExecuteAsync(new DeleteDraftCommand(draftId));
                if (!deleteResult.IsSuccess)
                    throw new InvalidOperationException(deleteResult.ErrorMessage);
                _refreshPending = true;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete draft {DraftId}.", draftId);
            if (!_disposed)
                _error = "تعذر حذف المسودة. حاول مرة أخرى.";
        }
        finally
        {
            _busy = false;
        }
        if (_refreshPending && IsOpen && !_disposed)
            await RefreshAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _loadVersion++;
    }
}
