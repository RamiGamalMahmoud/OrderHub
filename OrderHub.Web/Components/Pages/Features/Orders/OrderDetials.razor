@page "/orders/{id:int}"
@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Read)]
@using System.Globalization
@using OrderHub.Application.Features.Orders.GetDetails
@using OrderHub.Application.Features.Orders.GetSummaries
@using OrderHub.Application.Features.Orders.Lifecycle
@using OrderHub.Application.Common.Extensions
@using OrderHub.Application.Interfaces
@using OrderHub.Web.Components.Pages.Features.Orders.Workflow
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IRequestExecutor RequestExecutor
@inject IDialogService DialogService
@inject PermissionAccess Permissions
@inject ILogger<OrderDetials> Logger

<PageTitle>تفاصيل الطلب</PageTitle>

<div class="space-y-6">
    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل الطلب" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل بيانات الطلب...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-2xl border border-red-200 bg-red-50 p-5 shadow-sm">
            <p class="text-sm font-bold text-red-800">@_error</p>
            <button type="button"
                    class="@($"oh-btn oh-btn--sm mt-3 {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                    @onclick="RefreshAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_order is null)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <p class="text-sm font-bold text-slate-700">الطلب غير موجود.</p>
            <a href="/orders" class="oh-btn oh-btn--secondary oh-btn--sm mt-3">العودة إلى الطلبات</a>
        </div>
    }
    else
    {
        @* ============================================================
           Breadcrumb + top actions (order-details.html)
           ============================================================ *@
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <nav class="flex items-center gap-2 text-xs font-medium text-slate-500" aria-label="مسار التنقل">
                <a class="transition-colors hover:text-slate-800" href="/">الرئيسية</a>
                <span>/</span>
                <a class="transition-colors hover:text-slate-800" href="/orders">الطلبات</a>
                <span>/</span>
                <span class="font-semibold text-brand-600">تفاصيل الطلب @_order.Header.OrderNumber</span>
            </nav>

            <div class="flex flex-wrap items-center gap-2.5">
                <button type="button"
                        class="oh-btn oh-btn--secondary"
                        disabled="@(_summaries.Count == 0)"
                        @onclick="OpenSummariesAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Print" Class="text-[16px] text-slate-500" />
                    <span>ملخص الطلب</span>
                </button>

                <button type="button"
                        class="oh-btn oh-btn--primary"
                        aria-busy="@_loading"
                        disabled="@_loading"
                        @onclick="RefreshAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Refresh"
                             Class="@(_loading ? "animate-spin text-[16px]" : "text-[16px]")" />
                    <span>@(_loading ? "جارٍ التحديث..." : "تحديث الطلب")</span>
                </button>

                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    <ActivatorContent>
                        <button type="button"
                                class="oh-btn oh-btn--icon oh-btn--secondary"
                                title="خيارات أخرى"
                                aria-label="خيارات أخرى"
                                @onclick="@context.ToggleAsync">
                            <MudIcon Icon="@Icons.Material.Filled.MoreVert" Class="text-[16px]" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="OrderNumberClicked">نسخ رقم الطلب</MudMenuItem>
                        <MudMenuItem Href="@($"/orders/{Id}/workflow")">فتح دورة الطلب</MudMenuItem>
                        <MudMenuItem OnClick="OpenSummariesAsync" Disabled="_summaries.Count == 0">ملخص الطلب</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        </div>

        @* ============================================================
           Header banner
           ============================================================ *@
        <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <div class="flex flex-wrap items-center gap-3.5">
                    <h1 class="text-2xl font-extrabold tracking-tight text-slate-900">تفاصيل الطلب</h1>
                    <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 font-mono text-xs font-bold text-slate-700" dir="ltr">
                        #@_order.Header.OrderNumber
                    </span>
                    <span class="@($"inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold {OrderWorkflowPresentation.Tag(StatusTone)}")">
                        <span class="@($"h-2 w-2 animate-pulse rounded-full {OrderWorkflowPresentation.Dot(StatusTone)}")"></span>
                        @StatusLabel
                    </span>
                    @if (_workflow?.IsArchived == true)
                    {
                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">مؤرشف — للقراءة فقط</span>
                    }
                </div>
                <div class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Class="text-[16px] text-slate-400" />
                    <span>تاريخ الإنشاء: <UserLocalTime Value="_order.Header.CreatedAt" /></span>
                </div>
            </div>
        </div>

        @* ============================================================
           Quick KPIs
           ============================================================ *@
        <section aria-label="مؤشرات الطلب السريعة">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <span class="text-xs font-medium text-slate-500">رقم الطلب المرجعي</span>
                    <div class="mt-2 flex items-center justify-between gap-2">
                        <span class="font-mono text-lg font-bold text-slate-900" dir="ltr">@_order.Header.OrderNumber</span>
                        <button type="button"
                                class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost"
                                title="نسخ رقم الطلب"
                                aria-label="نسخ رقم الطلب"
                                @onclick="OrderNumberClicked">
                            <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Class="text-[16px]" />
                        </button>
                    </div>
                </div>

                <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <span class="text-xs font-medium text-slate-500">تاريخ الطلب</span>
                    <div class="mt-2">
                        <span class="text-sm font-bold text-slate-800"><UserLocalTime Value="_order.Header.CreatedAt" /></span>
                    </div>
                </div>

                <div class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <span class="text-xs font-medium text-slate-500">عدد المنتجات</span>
                    <div class="mt-2 flex items-baseline gap-1">
                        <span class="text-xl font-extrabold text-slate-900">@_items.Count.ToString(CultureInfo.InvariantCulture)</span>
                        <span class="text-xs font-medium text-slate-500">عناصر إجمالية</span>
                    </div>
                </div>

                <div class="flex flex-col justify-between rounded-2xl border border-brand-100 bg-brand-50/20 p-4 shadow-sm">
                    <span class="text-xs font-medium text-slate-500">الإجمالي شامل الضريبة</span>
                    <div class="mt-2 flex items-baseline gap-1.5 text-brand-600">
                        <span class="font-mono text-xl font-extrabold" dir="ltr">@Money(_order.Payment.GrandTotal)</span>
                        <span class="text-xs font-bold text-slate-600">ر.س</span>
                    </div>
                </div>
            </div>
        </section>

        @* ============================================================
           Customer + delivery
           ============================================================ *@
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <section class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div>
                    <div class="mb-5 flex items-center justify-between border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-2.5">
                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                                <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="text-[18px]" />
                            </div>
                            <h2 class="text-base font-bold text-slate-900">بيانات العميل</h2>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div class="flex items-start justify-between gap-4 py-1">
                            <div class="flex shrink-0 items-center gap-2 text-xs text-slate-500">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" Class="text-[16px]" />
                                <span>الاسم</span>
                            </div>
                            <span class="text-left text-sm font-bold text-slate-900">@_order.Client.Name</span>
                        </div>
                        <div class="flex items-start justify-between gap-4 py-1">
                            <div class="flex shrink-0 items-center gap-2 text-xs text-slate-500">
                                <MudIcon Icon="@Icons.Material.Outlined.Phone" Class="text-[16px]" />
                                <span>الهاتف</span>
                            </div>
                            <span class="text-left font-mono text-sm font-bold text-slate-800" dir="ltr">@_order.Client.PhoneNumber</span>
                        </div>
                        <div class="flex items-start justify-between gap-4 py-1">
                            <div class="flex shrink-0 items-center gap-2 text-xs text-slate-500">
                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Class="text-[16px]" />
                                <span>العنوان</span>
                            </div>
                            <span class="text-left text-sm font-medium text-slate-800">@_order.Client.Address</span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div>
                    <div class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
                        <div class="flex items-center gap-2.5">
                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                                <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Class="text-[18px]" />
                            </div>
                            <h2 class="text-base font-bold text-slate-900">بيانات التوصيل وسلسلة الإمداد</h2>
                        </div>
                        <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@DeliveryMethodLabel</span>
                    </div>

                    <div class="mb-5 grid grid-cols-2 gap-4 text-xs">
                        <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5">
                            <span class="mb-1 block text-slate-500">جهة التنفيذ</span>
                            <span class="font-bold text-slate-800">@HandlerLabel</span>
                        </div>
                        <div class="rounded-lg border border-slate-100 bg-slate-50 p-2.5">
                            <span class="mb-1 block text-slate-500">آخر تحديث تشغيلي</span>
                            <span class="font-bold text-slate-800">
                                @if (_workflow is not null)
                                {
                                    <UserLocalTime Value="_workflow.LastChangedAtUtc" />
                                }
                                else
                                {
                                    <span>غير متاح</span>
                                }
                            </span>
                        </div>
                    </div>

                    @if (_workflow is not null)
                    {
                        @if (_workflow.Status == OrderStatus.Cancelled)
                        {
                            <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-bold text-red-700">تم إلغاء الطلب؛ لا توجد مراحل تنفيذ نشطة.</div>
                        }
                        else
                        {
                            <div class="space-y-2">
                                <span class="mb-2 block text-xs font-bold text-slate-500">مراحل سير الطلب</span>
                                <div class="grid grid-cols-3 gap-2">
                                    @for (var index = 0; index < _stages.Length; index++)
                                    {
                                        var stage = _stages[index];
                                        <div class="@($"rounded-lg p-3 text-center transition-all {StageTileClass(index)}")">
                                            <span class="@($"mb-1 inline-flex h-5 w-5 items-center justify-center rounded-full text-[11px] font-bold {StageBadgeClass(index)}")">
                                                @((index + 1).ToString(CultureInfo.InvariantCulture))
                                            </span>
                                            <p class="text-xs font-bold text-slate-900">@stage.GetDescription()</p>
                                            <span class="@($"mt-1 inline-block text-[10px] {StageCaptionClass(index)}")">@StageCaption(index)</span>
                                        </div>
                                    }
                                </div>
                                @if (_workflow.IsLegacy)
                                {
                                    <p class="text-xs font-medium text-amber-700">آخر حالة ناتجة عن ترحيل بيانات قديمة؛ التوقيت لا يثبت وقت التنفيذ الفعلي.</p>
                                }
                                @if (_workflow.Steps.Count > 0)
                                {
                                    <p class="text-xs text-slate-600">
                                        @_workflow.CompletedActiveStepCount من @_workflow.ActiveStepCount خطوات مكتملة
                                    </p>
                                    @if (_workflow.Steps.Any(step => !step.IsSuperseded && step.Status == DeliveryStatus.Failed))
                                    {
                                        <div class="rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs font-bold text-orange-800">توجد خطوة متعذر تنفيذها؛ راجع دورة الطلب.</div>
                                    }
                                }
                                @if (_workflow.Status == OrderStatus.DeliveryFailed)
                                {
                                    <div class="rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs font-bold text-orange-800">سبب التعذر: @_workflow.LatestReason</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-500">بيانات دورة الطلب غير متاحة لهذا الطلب.</p>
                    }
                </div>

                @if (_workflow is not null)
                {
                    <div class="mt-6 border-t border-slate-100 pt-3">
                        <a href="@($"/orders/{Id}/workflow")"
                           class="oh-btn oh-btn--secondary oh-btn--block">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="text-[16px] text-brand-500" />
                            <span>@WorkflowButtonLabel</span>
                        </a>
                    </div>
                }
            </section>
        </div>

        @* ============================================================
           Items
           ============================================================ *@
        <section aria-label="محتويات وعناصر الطلب" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 p-5">
                <div class="flex items-center gap-3">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Class="text-[18px]" />
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">محتويات الطلب</h2>
                        <p class="text-xs text-slate-500">قائمة الأصناف والكميات والأسعار المحتسبة</p>
                    </div>
                </div>
                <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600">
                    @_items.Count.ToString(CultureInfo.InvariantCulture) عناصر مسجلة
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs">
                    <thead class="border-b border-slate-200 bg-slate-50/80 font-bold uppercase tracking-wider text-slate-600">
                        <tr>
                            <th class="w-12 px-4 py-3 text-center" scope="col">#</th>
                            <th class="min-w-[220px] px-4 py-3" scope="col">المنتج / الصنف</th>
                            <th class="px-4 py-3 text-center" scope="col">سعر الوحدة (ر.س)</th>
                            <th class="px-4 py-3 text-center" scope="col">الكمية</th>
                            <th class="px-4 py-3 text-center" scope="col">الضريبة %</th>
                            <th class="px-4 py-3 text-center" scope="col">قيمة الضريبة (ر.س)</th>
                            <th class="px-4 py-3 text-center" scope="col">الإجمالي شامل الضريبة (ر.س)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @if (_items.Count == 0)
                        {
                            <tr>
                                <td class="px-4 py-8 text-center text-sm text-slate-500" colspan="7">لا توجد منتجات في هذا الطلب.</td>
                            </tr>
                        }
                        else
                        {
                            @for (var index = 0; index < _items.Count; index++)
                            {
                                var item = _items[index];
                                <tr class="transition-colors hover:bg-slate-50/70">
                                    <td class="px-4 py-3.5 text-center font-mono text-slate-400">@((index + 1).ToString(CultureInfo.InvariantCulture))</td>
                                    <td class="px-4 py-3.5">
                                        <div class="font-bold text-slate-900">@item.ProductName</div>
                                    </td>
                                    <td class="px-4 py-3.5 text-center font-mono font-medium" dir="ltr">@Money(item.UnitPrice)</td>
                                    <td class="px-4 py-3.5 text-center">
                                        <span class="inline-block rounded-full bg-slate-100 px-2.5 py-0.5 font-bold text-slate-800">@item.Quantity.ToString(CultureInfo.InvariantCulture)</span>
                                    </td>
                                    <td class="px-4 py-3.5 text-center font-mono" dir="ltr">@item.VatRate.ToString("N2", CultureInfo.InvariantCulture)%</td>
                                    <td class="px-4 py-3.5 text-center font-mono text-slate-600" dir="ltr">@Money(item.VatAmount)</td>
                                    <td class="px-4 py-3.5 text-center font-mono font-bold text-slate-900" dir="ltr">@Money(item.Total)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ============================================================
           Linked invoice (narrow) + financial totals (wide)
           ============================================================ *@
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            @if (_canReadDocuments)
            {
                <OrderInvoiceSection OrderId="Id" PaymentMethod="@_order.Payment.PaymentMethod" />
            }

            <section aria-label="الملخص المالي النهائي"
                     class="@($"rounded-2xl border border-slate-200 bg-white p-6 shadow-sm {(_canReadDocuments ? "lg:col-span-2" : "lg:col-span-3")}")">
                <h3 class="mb-4 flex items-center justify-between border-b border-slate-100 pb-3 text-sm font-bold text-slate-900">
                    <span>الحسابات والإجماليات المالية</span>
                    <span class="text-xs font-normal text-slate-500">العملة: ريال سعودي (SAR)</span>
                </h3>

                <div class="grid grid-cols-1 gap-x-8 gap-y-3 text-xs sm:grid-cols-2">
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">قيمة المنتجات (قبل الضريبة):</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.ProductsTotal) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">ضريبة القيمة المضافة:</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.VatAmount) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">إجمالي المنتجات شامل الضريبة:</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.ProductsTotalIncludingVat) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">رسوم التجهيز / الشحن:</span>
                        <span class="font-mono font-bold text-slate-800">+ @Money(_order.Payment.ShippingCost) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">الخصم التجاري المطبق:</span>
                        <span class="font-mono font-bold text-emerald-600">- @Money(_order.Payment.Discount) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">تفاصيل الخصم:</span>
                        <span class="font-bold text-slate-800">@DiscountLabel</span>
                    </div>
                </div>

                <div class="mt-6 flex items-center justify-between gap-3 rounded-2xl border border-brand-100 bg-brand-50 p-4">
                    <div>
                        <span class="block text-xs font-bold text-brand-700">الإجمالي النهائي المستحق للمطالبة</span>
                        <span class="text-[11px] text-slate-500">شامل ضريبة القيمة المضافة والشحن والخصومات</span>
                    </div>
                    <div class="shrink-0 text-left font-mono">
                        <span class="text-2xl font-black text-brand-600" dir="ltr">@Money(_order.Payment.GrandTotal)</span>
                        <span class="mr-1 text-xs font-bold text-brand-700">ر.س</span>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetails? _order;
    private OrderWorkflowState? _workflow;
    private IReadOnlyList<OrderDetailsLine> _items = [];
    private IReadOnlyList<OrderSummaryText> _summaries = [];
    private OrderStatus[] _stages = [];
    private bool _canReadDocuments;
    private bool _loading;
    private string? _error;
    private int _loadedId, _generation;

    private string StatusTone => _workflow is null ? OrderWorkflowPresentation.Neutral : OrderWorkflowPresentation.StatusTone(_workflow.Status);
    private string StatusLabel => _workflow?.Status.GetDescription() ?? _order?.Header.OrderStatus ?? "غير محددة";
    private string DeliveryMethodLabel => _workflow?.Method is { } method ? method.GetDescription() : _order?.Delivery.DeliveryMethod ?? "غير محددة";
    private string HandlerLabel =>
        !string.IsNullOrWhiteSpace(_workflow?.HandlerName) ? _workflow!.HandlerName! :
        !string.IsNullOrWhiteSpace(_order?.Delivery.DeliverymanName) ? _order!.Delivery.DeliverymanName :
        !string.IsNullOrWhiteSpace(_order?.Delivery.ShippingCarrierName) ? _order!.Delivery.ShippingCarrierName! :
        "غير محددة";
    private string DiscountLabel => _order!.Payment.DiscountType == DiscountType.Percentage
        ? $"{_order.Payment.DiscountValue.ToString("N2", CultureInfo.InvariantCulture)}%"
        : $"{Money(_order.Payment.DiscountValue)} ر.س";
    private string WorkflowButtonLabel => _workflow is not null && (_workflow.IsArchived || _workflow.Status is OrderStatus.Delivered or OrderStatus.Cancelled)
        ? "عرض دورة الطلب والسجل التفصيلي"
        : "متابعة دورة الطلب وسلسلة التوصيل التفصيلية";

    private int CurrentStageIndex => _workflow is null || _stages.Length == 0
        ? 0
        : Math.Min(_stages.Length - 1, _workflow.Status == OrderStatus.Processing ? 0 : _workflow.Status == OrderStatus.Delivered ? 2 : 1);

    private string StageTileClass(int index) => index == CurrentStageIndex
        ? $"border-2 shadow-sm {OrderWorkflowPresentation.Surface(StageTone(index))}"
        : index < CurrentStageIndex
            ? "border border-emerald-200 bg-emerald-50/60"
            : "border border-slate-200 bg-slate-50 opacity-75";

    private string StageBadgeClass(int index) => index == CurrentStageIndex
        ? $"{OrderWorkflowPresentation.Dot(StageTone(index))} text-white"
        : index < CurrentStageIndex
            ? "bg-emerald-500 text-white"
            : "bg-slate-300 text-slate-700";

    private string StageCaptionClass(int index) => index == CurrentStageIndex
        ? "rounded bg-white/70 px-1.5 py-0.5 font-medium text-slate-600"
        : index < CurrentStageIndex
            ? "font-medium text-emerald-700"
            : "font-medium text-slate-400";

    private string StageTone(int index) => index == CurrentStageIndex && _workflow is not null
        ? OrderWorkflowPresentation.StatusTone(_workflow.Status)
        : index < CurrentStageIndex
            ? "completed"
            : OrderWorkflowPresentation.Neutral;

    private string StageCaption(int index) => index < CurrentStageIndex
        ? "مرحلة مكتملة"
        : index > CurrentStageIndex
            ? "لم تبدأ"
            : _workflow?.Status switch
            {
                OrderStatus.Delivered => "اكتملت دورة الطلب",
                OrderStatus.DeliveryFailed => "تحتاج مراجعة",
                _ => "المرحلة الحالية"
            };

    private static string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);

    protected override Task OnParametersSetAsync() => _loadedId == Id ? Task.CompletedTask : LoadAsync();

    private async Task LoadAsync()
    {
        _loadedId = Id;
        var generation = ++_generation;
        _loading = true;
        _error = null;
        _order = null;
        _workflow = null;
        _items = [];
        _summaries = [];
        _stages = [];
        _canReadDocuments = false;
        try
        {
            var order = await RequestExecutor.ExecuteAsync(new GetOrderDetailsQuery(Id));
            OrderWorkflowState? workflow = null;
            OrderSummaryData? summaryData = null;
            if (order is not null)
            {
                workflow = await RequestExecutor.ExecuteAsync(new GetOrderWorkflowQuery(Id));
                summaryData = await RequestExecutor.ExecuteAsync(new GetOrderSummariesQuery(Id));
            }
            var canReadDocuments = await Permissions.IsAllowedAsync(PermissionFeature.Documents, PermissionLevel.Read);
            if (generation != _generation) return;
            _order = order;
            _workflow = workflow;
            _items = order?.Items.ToList() ?? [];
            _summaries = summaryData is null ? [] : OrderSummaryTextBuilder.Build(summaryData);
            _stages = workflow is null ? [] : OrderWorkflowPresentation.Stages(workflow.Method);
            _canReadDocuments = canReadDocuments;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load order details {OrderId}.", Id);
            if (generation == _generation) _error = "تعذر تحميل الطلب. حاول مرة أخرى.";
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_loading) return;
        await LoadAsync();
    }

    private async Task OrderNumberClicked()
    {
        if (_order is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _order.Header.OrderNumber);
            Snackbar.Add($"تم نسخ رقم الطلب: {_order.Header.OrderNumber}", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("تعذر نسخ رقم الطلب من هذا المتصفح.", Severity.Warning);
        }
    }

    private async Task OpenSummariesAsync()
    {
        if (_summaries.Count == 0) return;
        var parameters = new DialogParameters<OrderSummaryDialog>
        {
            { dialog => dialog.Summaries, _summaries }
        };
        await DialogService.ShowAsync<OrderSummaryDialog>("ملخص الطلب", parameters,
            new DialogOptions { CloseButton = false, FullWidth = true, MaxWidth = MaxWidth.Medium });
    }
}
