@page "/orders/{id:int}"
@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Read)]
@using System.Globalization
@using OrderHub.Application.Features.Orders.GetDetails
@using OrderHub.Application.Features.Orders.GetSummaries
@using OrderHub.Application.Features.Orders.Lifecycle
@using OrderHub.Application.Common.Extensions
@using OrderHub.Application.Interfaces
@using OrderHub.Web.Components.Pages.Features.Orders.Workflow
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IRequestExecutor RequestExecutor
@inject IDialogService DialogService
@inject PermissionAccess Permissions
@inject ILogger<OrderDetials> Logger

<PageTitle>تفاصيل الطلب</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل الطلب" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل بيانات الطلب...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <button type="button"
                    class="@($"oh-btn oh-btn--sm mt-3 {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                    @onclick="RefreshAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_order is null)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <p class="text-xs font-bold text-slate-700">الطلب غير موجود.</p>
            <a href="/orders" class="oh-btn oh-btn--secondary oh-btn--sm mt-3">العودة إلى الطلبات</a>
        </div>
    }
    else
    {
        var failedStep = _workflow?.Steps.Any(step => !step.IsSuperseded && step.Status == DeliveryStatus.Failed) == true;
        var hasSteps = _workflow is not null && _workflow.ActiveStepCount > 0;

        <PageScaffold Title="تفاصيل الطلب"
                      Description="@_order.Header.OrderNumber"
                      Crumbs="_crumbs">
            <Actions>
                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm"
                        disabled="@(_summaryData is null)"
                        @onclick="OpenSummariesAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Description" Class="text-[16px]" />
                    <span>ملخص الطلب</span>
                </button>
                <a href="@($"/orders/{Id}/workflow")" class="oh-btn oh-btn--secondary oh-btn--sm">
                    <MudIcon Icon="@Icons.Material.Outlined.Timeline" Class="text-[16px]" />
                    <span>دورة الطلب</span>
                </a>
                <button type="button"
                        class="oh-btn oh-btn--primary oh-btn--sm"
                        aria-busy="@_loading"
                        disabled="@_loading"
                        @onclick="RefreshAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Refresh"
                             Class="@(_loading ? "animate-spin text-[16px]" : "text-[16px]")" />
                    <span>@(_loading ? "جارٍ التحديث..." : "تحديث الطلب")</span>
                </button>
                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                    <ActivatorContent>
                        <button type="button"
                                class="oh-btn oh-btn--icon oh-btn--secondary"
                                title="خيارات أخرى"
                                aria-label="خيارات أخرى"
                                @onclick="@context.ToggleAsync">
                            <MudIcon Icon="@Icons.Material.Filled.MoreVert" Class="text-[16px]" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="OrderNumberClicked">نسخ رقم الطلب</MudMenuItem>
                        @if (_summaryData is not null)
                        {
                            <MudMenuItem OnClick="OpenSummariesAsync">ملخص الطلب</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </Actions>
        </PageScaffold>

        @* ============================================================
           Summary (status + delivery + stages) and customer
           ============================================================ *@
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            <section class="@($"lg:col-span-2 {OrderWorkflowPresentation.Card}")" aria-label="ملخص الطلب">
                <header class="@OrderWorkflowPresentation.CardHeader">
                    <div class="flex items-center gap-2.5">
                        <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile(StatusTone)}")">
                            <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Class="text-[18px]" />
                        </span>
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">ملخص الطلب</h2>
                            <p class="text-[11px] text-slate-600">الحالة الحالية وبيانات التنفيذ الأساسية</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(StatusTone)}")">
                            <span class="@($"h-1.5 w-1.5 rounded-full {OrderWorkflowPresentation.Dot(StatusTone)}")"></span>
                            @StatusLabel
                        </span>
                        <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">@DeliveryMethodLabel</span>
                        <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 font-mono text-[11px] font-bold text-slate-700" dir="ltr">
                            @_order.Header.OrderNumber
                            <button type="button"
                                    class="inline-flex h-4 w-4 items-center justify-center rounded text-slate-400 transition-colors hover:bg-slate-200 hover:text-slate-700"
                                    title="نسخ رقم الطلب"
                                    aria-label="نسخ رقم الطلب"
                                    @onclick="OrderNumberClicked">
                                <MudIcon Icon="@Icons.Material.Outlined.ContentCopy" Class="text-[12px]" />
                            </button>
                        </span>
                    </div>
                </header>

                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500">
                    <span>جهة التنفيذ: <strong class="font-bold text-slate-700">@HandlerLabel</strong></span>
                    <span aria-hidden="true" class="text-slate-300">•</span>
                    <span>تاريخ الإنشاء: <strong class="font-bold text-slate-700"><UserLocalTime Value="_order.Header.CreatedAt" /></strong></span>
                    @if (_workflow is not null)
                    {
                        <span aria-hidden="true" class="text-slate-300">•</span>
                        <span>آخر حدث تشغيلي: <strong class="font-bold text-slate-700"><UserLocalTime Value="_workflow.LastChangedAtUtc" /></strong></span>
                    }
                </div>

                @if (_workflow is null)
                {
                    <p class="mt-3 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-[11px] text-slate-600">بيانات دورة الطلب غير متاحة لهذا الطلب.</p>
                }
                else if (_workflow.Status == OrderStatus.Cancelled)
                {
                    <div class="mt-3 rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-[11px] font-bold text-rose-700">تم إلغاء الطلب؛ لا توجد مراحل تنفيذ نشطة.</div>
                }
                else
                {
                    <div class="mt-3">
                        <OrderStageStrip State="_workflow" />
                    </div>
                }

                @if (_workflow is not null)
                {
                    @if (_workflow.IsLegacy)
                    {
                        <p class="mt-2 text-[11px] font-medium text-amber-700">آخر حالة ناتجة عن ترحيل بيانات قديمة؛ التوقيت لا يثبت وقت التنفيذ الفعلي.</p>
                    }
                    @if (failedStep)
                    {
                        <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800">توجد خطوة متعذر تنفيذها؛ راجع دورة الطلب.</div>
                    }
                    @if (_workflow.Status == OrderStatus.DeliveryFailed)
                    {
                        <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800">سبب التعذر: @_workflow.LatestReason</div>
                    }
                }

                <div class="@($"mt-3 grid grid-cols-2 gap-2 {(hasSteps ? "sm:grid-cols-4" : "sm:grid-cols-3")}")">
                    <div class="@OrderWorkflowPresentation.StatTile">
                        <p class="text-[10px] font-bold text-slate-500">تاريخ الطلب</p>
                        <p class="mt-0.5 text-xs font-bold text-slate-800"><UserLocalTime Value="_order.Header.CreatedAt" /></p>
                    </div>
                    <div class="@OrderWorkflowPresentation.StatTile">
                        <p class="text-[10px] font-bold text-slate-500">عدد الأصناف</p>
                        <p class="mt-0.5 text-xs font-bold text-slate-800">@_items.Count.ToString(CultureInfo.InvariantCulture) عنصر</p>
                    </div>
                    @if (hasSteps && _workflow is not null)
                    {
                        <div class="@OrderWorkflowPresentation.StatTile">
                            <p class="text-[10px] font-bold text-slate-500">الخطوات المكتملة</p>
                            <p class="mt-0.5 text-xs font-bold text-slate-800">
                                @_workflow.CompletedActiveStepCount.ToString(CultureInfo.InvariantCulture)
                                <span class="font-medium text-slate-400">/ @_workflow.ActiveStepCount.ToString(CultureInfo.InvariantCulture)</span>
                            </p>
                        </div>
                    }
                    <div class="rounded-lg border border-brand-100 bg-brand-50 px-3 py-2">
                        <p class="text-[10px] font-bold text-brand-700">الإجمالي شامل الضريبة</p>
                        <p class="mt-0.5 font-mono text-xs font-bold text-brand-700" dir="ltr">
                            @Money(_order.Payment.GrandTotal) <span class="font-sans text-[10px]">ر.س</span>
                        </p>
                    </div>
                </div>
            </section>

            <section class="@OrderWorkflowPresentation.Card" aria-label="بيانات العميل">
                <header class="@OrderWorkflowPresentation.CardHeader">
                    <div class="flex items-center gap-2.5">
                        <span class="@($"{OrderWorkflowPresentation.IconTileBase} border-teal-100 bg-teal-50 text-teal-600")">
                            <MudIcon Icon="@Icons.Material.Outlined.PersonOutline" Class="text-[18px]" />
                        </span>
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">بيانات العميل</h2>
                            <p class="text-[11px] text-slate-600">الاسم ووسائل التواصل والعنوان</p>
                        </div>
                    </div>
                </header>

                <dl class="space-y-2 text-xs">
                    <div class="rounded-lg bg-slate-50 px-3 py-2">
                        <dt class="text-[10px] font-bold text-slate-500">الاسم</dt>
                        <dd class="mt-0.5 font-bold text-slate-800">@_order.Client.Name</dd>
                    </div>
                    <div class="rounded-lg bg-slate-50 px-3 py-2">
                        <dt class="text-[10px] font-bold text-slate-500">الهاتف</dt>
                        <dd class="mt-0.5 font-mono font-bold text-slate-800" dir="ltr">@_order.Client.PhoneNumber</dd>
                    </div>
                    <div class="rounded-lg bg-slate-50 px-3 py-2">
                        <dt class="text-[10px] font-bold text-slate-500">العنوان</dt>
                        <dd class="mt-0.5 font-medium leading-5 text-slate-700">@_order.Client.Address</dd>
                    </div>
                </dl>
            </section>
        </div>

        @* ============================================================
           Items
           ============================================================ *@
        <section aria-label="محتويات وعناصر الطلب"
                 class="overflow-hidden rounded-xl border border-slate-200/90 bg-white shadow-xs">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-4 py-3 sm:px-5">
                <div class="flex items-center gap-2.5">
                    <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile("processing")}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Class="text-[18px]" />
                    </span>
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">محتويات الطلب</h2>
                        <p class="text-[11px] text-slate-600">الأصناف والكميات والأسعار المحتسبة</p>
                    </div>
                </div>
                <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-bold text-slate-600">
                    @_items.Count.ToString(CultureInfo.InvariantCulture) عنصر
                </span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-right text-xs">
                    <thead class="border-b border-slate-200 bg-slate-50/70 text-[11px] font-bold text-slate-500">
                        <tr>
                            <th class="w-12 px-3 py-2.5 text-center" scope="col">#</th>
                            <th class="min-w-[200px] px-3 py-2.5" scope="col">المنتج / الصنف</th>
                            <th class="px-3 py-2.5 text-center" scope="col">سعر الوحدة (ر.س)</th>
                            <th class="px-3 py-2.5 text-center" scope="col">الكمية</th>
                            <th class="px-3 py-2.5 text-center" scope="col">الضريبة %</th>
                            <th class="px-3 py-2.5 text-center" scope="col">قيمة الضريبة (ر.س)</th>
                            <th class="px-3 py-2.5 text-center" scope="col">الإجمالي شامل الضريبة (ر.س)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-700">
                        @if (_items.Count == 0)
                        {
                            <tr>
                                <td class="px-3 py-8 text-center text-xs text-slate-500" colspan="7">لا توجد منتجات في هذا الطلب.</td>
                            </tr>
                        }
                        else
                        {
                            @for (var index = 0; index < _items.Count; index++)
                            {
                                var item = _items[index];
                                <tr class="transition-colors hover:bg-slate-50/70">
                                    <td class="px-3 py-2.5 text-center font-mono text-slate-400">@((index + 1).ToString(CultureInfo.InvariantCulture))</td>
                                    <td class="px-3 py-2.5 font-bold text-slate-800">@item.ProductName</td>
                                    <td class="px-3 py-2.5 text-center font-mono font-medium" dir="ltr">@Money(item.UnitPrice)</td>
                                    <td class="px-3 py-2.5 text-center">
                                        <span class="inline-block rounded-md bg-slate-100 px-2 py-0.5 font-bold text-slate-800">@item.Quantity.ToString(CultureInfo.InvariantCulture)</span>
                                    </td>
                                    <td class="px-3 py-2.5 text-center font-mono" dir="ltr">@item.VatRate.ToString("N2", CultureInfo.InvariantCulture)%</td>
                                    <td class="px-3 py-2.5 text-center font-mono text-slate-600" dir="ltr">@Money(item.VatAmount)</td>
                                    <td class="px-3 py-2.5 text-center font-mono font-bold text-slate-900" dir="ltr">@Money(item.Total)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ============================================================
           Linked invoice (narrow) + financial totals (wide)
           ============================================================ *@
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
            @if (_canReadDocuments)
            {
                <OrderInvoiceSection OrderId="Id" PaymentMethod="@_order.Payment.PaymentMethod" />
            }

            <section aria-label="الملخص المالي النهائي"
                     class="@($"rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5 {(_canReadDocuments ? "lg:col-span-2" : "lg:col-span-3")}")">
                <header class="@OrderWorkflowPresentation.CardHeader">
                    <div class="flex items-center gap-2.5">
                        <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile("completed")}")">
                            <MudIcon Icon="@Icons.Material.Outlined.Payments" Class="text-[18px]" />
                        </span>
                        <div>
                            <h2 class="text-sm font-bold text-slate-800">الحسابات والإجماليات</h2>
                            <p class="text-[11px] text-slate-600">العملة: ريال سعودي (SAR)</p>
                        </div>
                    </div>
                </header>

                <div class="grid grid-cols-1 gap-x-6 gap-y-2 text-xs sm:grid-cols-2">
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">قيمة المنتجات (قبل الضريبة)</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.ProductsTotal) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">ضريبة القيمة المضافة</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.VatAmount) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">إجمالي المنتجات شامل الضريبة</span>
                        <span class="font-mono font-bold text-slate-800">@Money(_order.Payment.ProductsTotalIncludingVat) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">رسوم التجهيز / الشحن</span>
                        <span class="font-mono font-bold text-slate-800">+ @Money(_order.Payment.ShippingCost) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">الخصم التجاري المطبق</span>
                        <span class="font-mono font-bold text-emerald-600">- @Money(_order.Payment.Discount) ر.س</span>
                    </div>
                    <div class="flex items-center justify-between border-b border-slate-100 py-1.5">
                        <span class="text-slate-500">تفاصيل الخصم</span>
                        <span class="font-bold text-slate-800">@DiscountLabel</span>
                    </div>
                </div>

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-brand-100 bg-brand-50 px-3.5 py-3">
                    <div>
                        <span class="block text-xs font-bold text-brand-700">الإجمالي النهائي المستحق</span>
                        <span class="text-[11px] text-slate-600">شامل ضريبة القيمة المضافة والشحن والخصومات</span>
                    </div>
                    <div class="shrink-0 font-mono">
                        <span class="text-xl font-black text-brand-600" dir="ltr">@Money(_order.Payment.GrandTotal)</span>
                        <span class="mr-1 text-xs font-bold text-brand-700">ر.س</span>
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetails? _order;
    private OrderWorkflowState? _workflow;
    private IReadOnlyList<OrderDetailsLine> _items = [];
    private OrderSummaryData? _summaryData;
    private bool _canReadDocuments;
    private bool _loading;
    private string? _error;
    private int _loadedId, _generation;
    private PageScaffold.CrumbItem[] _crumbs = [];

    private string StatusTone => _workflow is null ? OrderWorkflowPresentation.Neutral : OrderWorkflowPresentation.StatusTone(_workflow.Status);
    private string StatusLabel => _workflow?.Status.GetDescription() ?? _order?.Header.OrderStatus ?? "غير محددة";
    private string DeliveryMethodLabel => _workflow?.Method is { } method ? method.GetDescription() : _order?.Delivery.DeliveryMethod ?? "غير محددة";
    private string HandlerLabel =>
        !string.IsNullOrWhiteSpace(_workflow?.HandlerName) ? _workflow!.HandlerName! :
        !string.IsNullOrWhiteSpace(_order?.Delivery.DeliverymanName) ? _order!.Delivery.DeliverymanName :
        !string.IsNullOrWhiteSpace(_order?.Delivery.ShippingCarrierName) ? _order!.Delivery.ShippingCarrierName! :
        "غير محددة";
    private string DiscountLabel => _order!.Payment.DiscountType == DiscountType.Percentage
        ? $"{_order.Payment.DiscountValue.ToString("N2", CultureInfo.InvariantCulture)}%"
        : $"{Money(_order.Payment.DiscountValue)} ر.س";

    private static string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);

    protected override Task OnParametersSetAsync() => _loadedId == Id ? Task.CompletedTask : LoadAsync();

    private async Task LoadAsync()
    {
        _loadedId = Id;
        var generation = ++_generation;
        _loading = true;
        _error = null;
        _order = null;
        _workflow = null;
        _items = [];
        _summaryData = null;
        _canReadDocuments = false;
        try
        {
            var order = await RequestExecutor.ExecuteAsync(new GetOrderDetailsQuery(Id));
            OrderWorkflowState? workflow = null;
            OrderSummaryData? summaryData = null;
            if (order is not null)
            {
                workflow = await RequestExecutor.ExecuteAsync(new GetOrderWorkflowQuery(Id));
                summaryData = await RequestExecutor.ExecuteAsync(new GetOrderSummariesQuery(Id));
            }
            var canReadDocuments = await Permissions.IsAllowedAsync(PermissionFeature.Documents, PermissionLevel.Read);
            if (generation != _generation) return;
            _order = order;
            _workflow = workflow;
            _items = order?.Items.ToList() ?? [];
            _summaryData = summaryData;
            _canReadDocuments = canReadDocuments;
            _crumbs = order is null
                ? [new("الطلبات", "/orders")]
                : [new("الطلبات", "/orders"), new(order.Header.OrderNumber)];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load order details {OrderId}.", Id);
            if (generation == _generation) _error = "تعذر تحميل الطلب. حاول مرة أخرى.";
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_loading) return;
        await LoadAsync();
    }

    private async Task OrderNumberClicked()
    {
        if (_order is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _order.Header.OrderNumber);
            Snackbar.Add($"تم نسخ رقم الطلب: {_order.Header.OrderNumber}", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("تعذر نسخ رقم الطلب من هذا المتصفح.", Severity.Warning);
        }
    }

    private async Task OpenSummariesAsync()
    {
        if (_summaryData is null) return;
        var parameters = new DialogParameters<OrderSummaryDialog>
        {
            { dialog => dialog.Data, _summaryData }
        };
        await DialogService.ShowAsync<OrderSummaryDialog>("ملخص الطلب المخصص للإرسال", parameters,
            new DialogOptions
            {
                CloseButton = false,
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                BackgroundClass = "bg-slate-900/60 backdrop-blur-sm"
            });
    }
}
