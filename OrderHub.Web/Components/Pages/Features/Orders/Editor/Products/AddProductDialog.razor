@using OrderHub.Application.Features.Products.Contracts

<MudDialog Class="flex max-h-[92vh] w-full max-w-[36rem] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50 text-blue-600">
                    <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">إضافة منتج</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">ابحث عن المنتج وحدده لإضافته إلى الطلب</p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_isAdding"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="product-dialog-content p-5">
            <MudTextField T="string"
                          @ref="_productSearchField"
                          Value="@_searchTerm"
                          ValueChanged="TextChanged"
                          Placeholder="ابحث عن منتج..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_isAdding"
                          AutoFocus="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true" />

            <div class="product-list-container">
                @if (_searchError is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert">
                        @_searchError
                        <MudButton OnClick="@(() => TextChanged(_searchTerm ?? string.Empty))"
                                   Disabled="_isAdding"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm mt-2">
                            إعادة المحاولة
                        </MudButton>
                    </MudAlert>
                }

                @if (!_isSearching && string.IsNullOrWhiteSpace(_searchError)
                                && !string.IsNullOrWhiteSpace(_searchTerm)
                                && _products.Count == 0)
                {
                    <MudText Class="pa-4" Color="Color.Secondary">
                        لا توجد منتجات مطابقة للبحث.
                    </MudText>
                }

                <MudList T="ProductLookupItem"
                         SelectedValue="@_selectedProduct"
                         SelectedValueChanged="SelectProduct"
                         Disabled="_isAdding">

                    @foreach (var product in _products)
                    {
                        <MudListItem T="ProductLookupItem"
                                     @key="product.Id"
                                     Class="my-1 list-item"
                                     Value="@product">

                            <MudStack Row AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">
                                        @product.Name
                                    </MudText>

                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">
                                        @product.Code • @product.CategoryName
                                    </MudText>
                                </MudStack>

                                <MudSpacer />

                                <MudText Color="Color.Primary">
                                    @product.Price.ToString("N2") ر.س
                                </MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </div>

            @if (_selectedProduct is not null)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-2">
                    <MudText Typo="Typo.subtitle1">
                        المنتج المحدد
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @_selectedProduct.Name
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        السعر الافتراضي: @_selectedProduct.Price.ToString("N2") ر.س
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        ستتمكن من تعديل السعر والكمية والضريبة والخصائص في الخطوة التالية.
                    </MudText>
                </MudPaper>
            }
            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_addError
                </MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex w-full flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton OnClick="Cancel" Disabled="_isAdding" Class="oh-btn oh-btn--secondary">
                إلغاء
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="oh-btn oh-btn--primary"
                       StartIcon="@Icons.Material.Outlined.ArrowForward"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueAsync">
                متابعة
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>
