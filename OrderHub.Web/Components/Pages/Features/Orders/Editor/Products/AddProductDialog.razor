@using OrderHub.Application.Features.Products.Contracts

<MudDialog Class="product-selection-dialog">
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="px-1 py-1">
            <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart"
                     Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="font-bold">إضافة منتج</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <div class="product-dialog-content">
            <MudTextField T="string"
                          @ref="_productSearchField"
                          Value="@_searchTerm"
                          ValueChanged="TextChanged"
                          Placeholder="ابحث عن منتج..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_isAdding"
                          AutoFocus="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true" />

            <div class="product-list-container">
                @if (_searchError is not null)
                {
                    <MudAlert Severity="Severity.Error" role="alert">
                        @_searchError
                        <MudButton OnClick="@(() => TextChanged(_searchTerm ?? string.Empty))"
                                   Disabled="_isAdding">
                            إعادة المحاولة
                        </MudButton>
                    </MudAlert>
                }

                @if (!_isSearching && string.IsNullOrWhiteSpace(_searchError)
                                && !string.IsNullOrWhiteSpace(_searchTerm)
                                && _products.Count == 0)
                {
                    <MudText Class="pa-4" Color="Color.Secondary">
                        لا توجد منتجات مطابقة للبحث.
                    </MudText>
                }

                <MudList T="ProductLookupItem"
                         SelectedValue="@_selectedProduct"
                         SelectedValueChanged="SelectProduct"
                         Disabled="_isAdding">

                    @foreach (var product in _products)
                    {
                        <MudListItem T="ProductLookupItem"
                                     @key="product.Id"
                                     Class="my-1 list-item"
                                     Value="@product">

                            <MudStack Row AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">
                                        @product.Name
                                    </MudText>

                                    <MudText Typo="Typo.caption"
                                             Color="Color.Secondary">
                                        @product.Code • @product.CategoryName
                                    </MudText>
                                </MudStack>

                                <MudSpacer />

                                <MudText Color="Color.Primary">
                                    @product.Price.ToString("N2") ر.س
                                </MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </div>

            @if (_selectedProduct is not null)
            {
                <MudPaper Outlined="true" Class="pa-3 mt-2">
                    <MudText Typo="Typo.subtitle1">
                        المنتج المحدد
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @_selectedProduct.Name
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        السعر الافتراضي: @_selectedProduct.Price.ToString("N2") ر.س
                    </MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        ستتمكن من تعديل السعر والكمية والضريبة والخصائص في الخطوة التالية.
                    </MudText>
                </MudPaper>
            }
            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_addError
                </MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <div class="flex w-full flex-wrap justify-end gap-2 border-t border-slate-100 pa-4">
            <MudButton OnClick="Cancel" Disabled="_isAdding">
                إلغاء
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="rounded-xl px-5 font-bold"
                       StartIcon="@Icons.Material.Outlined.ArrowForward"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueAsync">
                متابعة
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
