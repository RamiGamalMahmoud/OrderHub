@using OrderHub.Application.Features.Products.Contracts

<MudDialog Class="flex max-h-[92vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl bg-white p-0 shadow-2xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 p-5 pb-3">
            <div class="flex items-center gap-2.5">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                    <MudIcon Icon="@Icons.Material.Outlined.AddShoppingCart" Size="Size.Small" />
                </span>
                <div>
                    <h2 class="text-base font-bold leading-tight text-slate-900">إضافة منتج إلى الطلب</h2>
                    <p class="text-xs text-slate-400">ابحث بالاسم أو الكود، أو اختر من قائمة المنتجات</p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_isAdding"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="flex flex-col gap-4 p-5 pt-0">

            @* Search *@
            <MudTextField T="string"
                          @ref="_productSearchField"
                          Value="@_searchTerm"
                          ValueChanged="TextChanged"
                          Placeholder="ابحث باسم المنتج أو الرمز..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="_isAdding"
                          AutoFocus="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true" />

            @if (_searchError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_searchError
                    <MudButton OnClick="@(() => TextChanged(_searchTerm ?? string.Empty))"
                               Disabled="_isAdding"
                               Class="oh-btn oh-btn--secondary oh-btn--sm mt-2">
                        إعادة المحاولة
                    </MudButton>
                </MudAlert>
            }

            @if (_isSearching)
            {
                <MudProgressLinear Indeterminate="true" Class="rounded" aria-label="جارٍ تحميل المنتجات" />
            }
            else if (!_isSearching
                     && string.IsNullOrWhiteSpace(_searchError)
                     && _products.Count == 0)
            {
                <p class="py-6 text-center text-xs text-slate-500">
                    @(string.IsNullOrWhiteSpace(_searchTerm)
                        ? "لا توجد منتجات في النظام."
                        : "لا توجد منتجات مطابقة للبحث.")
                </p>
            }

            @* Results *@
            <div class="max-h-72 space-y-2 overflow-y-auto pe-1">
                @foreach (var product in _products)
                {
                    var isSelected = ReferenceEquals(product, _selectedProduct);
                    <button type="button"
                            @key="product.Id"
                            class="flex w-full items-center justify-between gap-3 rounded-xl border p-3 text-right transition @(isSelected ? "border-blue-200 bg-blue-50/60" : "border-transparent bg-slate-50 hover:bg-blue-50")"
                            disabled="@_isAdding"
                            @onclick="@(() => SelectProduct(product))">
                        <span class="flex min-w-0 items-center gap-3">
                            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-blue-600 shadow-sm">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                            </span>
                            <span class="min-w-0">
                                <span class="block text-xs font-bold text-slate-900">@product.Name</span>
                                <span class="block font-mono text-[11px] text-slate-500">@product.Code • @product.CategoryName</span>
                            </span>
                        </span>

                        <span class="shrink-0 text-left">
                            <span class="block text-xs font-black text-blue-700">@product.Price.ToString("N2") ر.س</span>
                        </span>
                    </button>
                }

                @if (_isLoadingMore)
                {
                    <div class="flex items-center justify-center gap-2 py-2" aria-label="جارٍ تحميل المزيد">
                        <MudProgressLinear Indeterminate="true" Class="w-24 rounded" />
                        <span class="text-[11px] font-bold text-slate-500">جارٍ تحميل المزيد…</span>
                    </div>
                }
            </div>

            @if (_loadMoreError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_loadMoreError
                    <MudButton OnClick="LoadMoreAsync"
                               Disabled="_isAdding"
                               Class="oh-btn oh-btn--secondary oh-btn--sm mt-2">
                        إعادة المحاولة
                    </MudButton>
                </MudAlert>
            }

            @if (ShowLoadMoreButton)
            {
                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm w-full justify-center"
                        disabled="@_isAdding"
                        @onclick="LoadMoreAsync">
                    تحميل المزيد (@DisplayedCountText)
                </button>
            }

            @if (_addError is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_addError
                </MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex w-full items-center justify-end gap-2 border-t border-slate-100 p-4">
            <MudButton OnClick="Cancel" Disabled="_isAdding" Class="oh-btn oh-btn--secondary">
                إلغاء
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="oh-btn oh-btn--primary"
                       StartIcon="@Icons.Material.Outlined.ArrowForward"
                       Disabled="@(!CanContinue)"
                       OnClick="ContinueAsync">
                إضافة الصنف المحدد
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>
