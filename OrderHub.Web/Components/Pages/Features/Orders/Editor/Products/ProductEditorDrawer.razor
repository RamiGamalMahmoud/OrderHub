@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State
@using OrderHub.Application.Features.Orders.GetItemEditor
@using OrderHub.Domain.Common
@using OrderHub.Domain.Enums
@using OrderHub.Domain.Services.Pricing
@inject OrderHub.Application.Interfaces.IRequestExecutor RequestExecutor

<MudDrawer Open="IsOpen"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="min(448px, 100vw)"
           Style="z-index: 1600 !important;"
           Class="p-5">

    @if (_workingCopy is not null)
    {
        <div class="flex h-full flex-col gap-4 overflow-y-auto">

            @* Header *@
            <header class="flex items-start justify-between gap-3 pb-3">
                <div class="flex min-w-0 items-center gap-2">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                    </span>
                    <div class="min-w-0">
                        <h3 class="truncate text-sm font-bold text-slate-900">@_workingCopy.ProductName</h3>
                        <p class="truncate text-[11px] text-slate-400">ضبط خصائص المنتج — @_workingCopy.CategoryName</p>
                    </div>
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Color="Color.Default"
                               Disabled="_saving"
                               OnClick="Cancel"
                               aria-label="إغلاق الدرج"
                               Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
            </header>

            @if (!string.IsNullOrWhiteSpace(_workingCopy.MetadataRestorationError))
            {
                <MudAlert Severity="Severity.Warning">
                    @_workingCopy.MetadataRestorationError
                </MudAlert>
            }

            <MudForm @ref="_form">
                <div class="flex flex-col gap-4">

                    @* Supplier *@
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700">المورد المعتمد</label>
                        <div class="flex items-center gap-2">
                            <div class="min-w-0 flex-1">
                                <MudSelect T="int?"
                                           @bind-Value="_workingCopy.SupplierId"
                                           Clearable="true"
                                           Disabled="_saving"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           InputClass="text-xs font-semibold">

                                    @foreach (var supplier in _workingCopy.Suppliers)
                                    {
                                        <MudSelectItem T="int?"
                                                       Value="@((int?)supplier.Id)">
                                            @supplier.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <SupplierEditorButton Variant="Variant.Text"
                                                  ButtonText=""
                                                  StartIcon="@Icons.Material.Outlined.Add"
                                                  Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--secondary"
                                                  PreselectedProductId="_workingCopy.ProductId"
                                                  OnCreated="OnSupplierCreatedAsync" />
                        </div>

                        @if (_workingCopy.SupplierId.HasValue &&
                             !_workingCopy.Suppliers.Any(s => s.Id == _workingCopy.SupplierId))
                        {
                            <MudAlert Severity="Severity.Warning">
                                المورد المحدد لم يعد متاحاً. اختر مورداً متاحاً أو امسح الاختيار.
                            </MudAlert>
                        }
                    </div>

                    @* Price & quantity *@
                    <div class="grid grid-cols-2 gap-3">
                        <MudNumericField T="decimal"
                                         Label="سعر الوحدة قبل الضريبة"
                                         @bind-Value="_workingCopy.UnitPrice"
                                         Min="0"
                                         Disabled="_saving"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Validation="@(new Func<decimal, string?>(value =>
                                                                                      value > 0 ? null : "يجب أن يكون السعر أكبر من صفر."))" />

                        <MudNumericField T="int"
                                         Label="الكمية"
                                         @bind-Value="_workingCopy.Quantity"
                                         Min="1"
                                         Disabled="_saving"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Validation="@(new Func<int, string?>(value =>
                                                                                  value > 0 ? null : "يجب أن تكون الكمية أكبر من صفر."))" />
                    </div>

                    @* Tax *@
                    <MudNumericField T="decimal"
                                     Label="نسبة الضريبة (%)"
                                     @bind-Value="_workingCopy.VatRate"
                                     Min="0"
                                     Max="100"
                                     Disabled="_saving"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Validation="@(new Func<decimal, string?>(value =>
                                                                                  value is >= 0 and <= 100
                                                                                      ? null
                                                                                      : "الضريبة يجب أن تكون بين 0 و100."))" />

                    @* Properties *@
                    @if (_workingCopy.Properties.Count > 0)
                    {
                        <div class="space-y-2 border-t border-slate-100 pt-3">
                            <label class="block text-xs font-bold text-slate-700">خيارات ومواصفات المنتج</label>

                            @foreach (var property in _workingCopy.Properties)
                            {
                                @if (!property.HasMetadata)
                                {
                                    <MudAlert Severity="Severity.Warning">
                                        @property.ValidateValue(property.Value) — @property.Value
                                    </MudAlert>
                                    continue;
                                }

                                @switch (property.Type)
                                {
                                    case PropertyType.Text:
                                        <MudTextField T="string"
                                                      @key="property.PropertyId"
                                                      Label="@property.Name"
                                                      @bind-Value="property.Value"
                                                      Required="property.IsRequired"
                                                      Disabled="_saving"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      InputClass="text-xs"
                                                      Validation="@(new Func<string?, string?>(property.ValidateValue))" />
                                        break;

                                    case PropertyType.Boolean:
                                        <MudSelect T="string"
                                                   @key="property.PropertyId"
                                                   Label="@property.Name"
                                                   @bind-Value="property.Value"
                                                   Clearable="true"
                                                   Required="property.IsRequired"
                                                   Disabled="_saving"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   InputClass="text-xs"
                                                   Validation="@(new Func<string?, string?>(property.ValidateValue))">
                                            <MudSelectItem T="string" Value='@("true")'>
                                                نعم
                                            </MudSelectItem>
                                            <MudSelectItem T="string" Value='@("false")'>
                                                لا
                                            </MudSelectItem>
                                        </MudSelect>
                                        break;

                                    case PropertyType.List:
                                        <MudSelect T="string"
                                                   @key="property.PropertyId"
                                                   Label="@property.Name"
                                                   @bind-Value="property.Value"
                                                   Clearable="true"
                                                   Required="property.IsRequired"
                                                   Disabled="_saving"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   InputClass="text-xs"
                                                   Validation="@(new Func<string?, string?>(property.ValidateValue))">
                                            @foreach (var option in property.Options)
                                            {
                                                <MudSelectItem T="string" Value="@option.Value">
                                                    @option.Value
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                        break;
                                }

                                @if (property.Value is not null &&
                                     property.ValidateValue(property.Value) is { } error)
                                {
                                    <MudAlert Severity="Severity.Warning">
                                        @error
                                    </MudAlert>
                                }
                            }
                        </div>
                    }

                    @* Mini summary *@
                    @if (CurrentPricing is { } pricing)
                    {
                        <div class="space-y-1.5 rounded-xl bg-slate-50 p-3 text-xs">
                            <span class="block text-xs font-bold text-slate-800">ملخص الصنف المعدل:</span>

                            <div class="flex items-center justify-between text-slate-500">
                                <span>قيمة المنتجات قبل الضريبة</span>
                                <span class="font-mono text-slate-800">@pricing.Subtotal.ToString("N2") ر.س</span>
                            </div>

                            <div class="flex items-center justify-between text-slate-500">
                                <span>قيمة الضريبة (@pricing.VatRate.ToString("N2")%)</span>
                                <span class="font-mono text-slate-800">@pricing.VatAmount.ToString("N2") ر.س</span>
                            </div>

                            <div class="flex items-center justify-between border-t border-slate-200 pt-1.5 font-bold text-blue-700">
                                <span>الإجمالي للصنف:</span>
                                <span class="font-mono text-sm">@pricing.Total.ToString("N2") ر.س</span>
                            </div>
                        </div>
                    }
                </div>
            </MudForm>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_error
                </MudAlert>
            }

            <div class="mt-auto flex items-center gap-2 border-t border-slate-100 pt-4">
                <MudButton OnClick="Cancel"
                           Class="oh-btn oh-btn--secondary w-1/2"
                           Disabled="_saving">
                    إلغاء
                </MudButton>

                <MudButton OnClick="SaveAsync"
                           Disabled="_saving"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Class="oh-btn oh-btn--primary w-1/2"
                           StartIcon="@(IsAdding
                                            ? Icons.Material.Outlined.Add
                                            : Icons.Material.Outlined.Save)">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true"
                                             Class="me-2" />
                    }

                    @(IsAdding ? "إضافة المنتج" : "حفظ التعديلات")
                </MudButton>
            </div>
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired]
    public OrderItemEditorState Item { get; set; } = null!;

    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public bool IsAdding { get; set; }

    [Parameter, EditorRequired]
    public Func<OrderItemEditorState, Guid, OrderItemEditorState, Task<Result>> Commit
    { get; set; } = null!;

    private OrderItemEditorState? _workingCopy;
    private OrderItemEditorState? _original;
    private Guid _originalSession;
    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private MudForm? _form;

    private PricingItemResult? CurrentPricing =>
        _workingCopy is null ||
        _workingCopy.UnitPrice <= 0 ||
        _workingCopy.Quantity <= 0 ||
        _workingCopy.VatRate is < 0 or > 100
            ? null
            : PricingCalculator.CalculateItem(
                new PricingItem(
                    _workingCopy.ProductId,
                    _workingCopy.ProductName,
                    _workingCopy.Quantity,
                    _workingCopy.UnitPrice,
                    _workingCopy.VatRate));

    protected override void OnParametersSet()
    {
        if (IsOpen &&
            (!_wasOpen ||
             !ReferenceEquals(Item, _original) ||
             SessionId != _originalSession))
        {
            _original = Item;
            _originalSession = SessionId;
            _workingCopy = Item.CreateWorkingCopy();
            _error = null;
        }

        _wasOpen = IsOpen;
    }

    private Task OnOpenChanged(bool open) =>
        open || _saving ? Task.CompletedTask : Cancel();

    private async Task OnSupplierCreatedAsync(int supplierId)
    {
        if (_workingCopy is null || _original is null)
            return;

        // إعادة تحميل قائمة موردي المنتج بعد ربط المورد الجديد به.
        try
        {
            var data = await RequestExecutor.ExecuteAsync(
                new GetOrderItemEditorQuery(_original.ProductId));

            if (data is null)
                return;

            var suppliers = data.Suppliers
                .Select(supplier => new OrderItemSupplierEditorState(supplier.Id, supplier.Name))
                .ToArray();

            _original.Suppliers = suppliers;

            if (_workingCopy is not null)
            {
                _workingCopy.Suppliers = suppliers;

                // اختيار المورد الجديد تلقائيًا إذا رُبط بالمنتج.
                if (suppliers.Any(supplier => supplier.Id == supplierId))
                    _workingCopy.SupplierId = supplierId;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // لا نمنع العملية؛ يمكن للمستخدم إغلاق المحرر وإعادة فتحه لتحديث القائمة.
        }
    }

    private Task Cancel()
    {
        if (_saving)
            return Task.CompletedTask;

        _workingCopy = null;

        return IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveAsync()
    {
        if (_saving || _workingCopy is null || _original is null)
            return;

        _saving = true;
        _error = null;

        try
        {
            if (_form is not null)
            {
                await _form.ValidateAsync();

                if (!_form.IsValid)
                    return;
            }

            var result = await Commit(
                _original,
                _originalSession,
                _workingCopy);

            if (result.IsSuccess)
            {
                _workingCopy = null;
                await IsOpenChanged.InvokeAsync(false);
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _error = "حدث خطأ أثناء حفظ المنتج. حاول مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}
