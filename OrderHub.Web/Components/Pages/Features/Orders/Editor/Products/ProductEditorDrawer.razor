@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State
@using OrderHub.Application.Features.Orders.GetItemEditor
@using OrderHub.Domain.Common
@using OrderHub.Domain.Enums
@using OrderHub.Domain.Services.Pricing
@inject OrderHub.Application.Interfaces.IRequestExecutor RequestExecutor

<MudDrawer Open="IsOpen"
           OpenChanged="OnOpenChanged"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="min(448px, 100vw)"
           Style="z-index: 1600 !important;"
           Class="p-5">

    @if (_workingCopy is not null)
    {
        <div class="flex h-full flex-col gap-4 overflow-y-auto">

            @* Header *@
            <header class="flex items-start justify-between gap-3 pb-3">
                <div class="flex min-w-0 items-center gap-2">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                    </span>
                    <div class="min-w-0">
                        <h3 class="truncate text-sm font-bold text-slate-900">@_workingCopy.ProductName</h3>
                        <p class="truncate text-[11px] text-slate-400">ضبط خصائص المنتج — @_workingCopy.CategoryName</p>
                    </div>
                </div>

                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Color="Color.Default"
                               Disabled="_saving"
                               OnClick="Cancel"
                               aria-label="إغلاق الدرج"
                               Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
            </header>

            @if (!string.IsNullOrWhiteSpace(_workingCopy.MetadataRestorationError))
            {
                <MudAlert Severity="Severity.Warning">
                    @_workingCopy.MetadataRestorationError
                </MudAlert>
            }

            <MudForm @ref="_form">
                <div class="flex flex-col gap-4">

                    @* Supplier *@
                    <div class="space-y-1">
                        <label class="block text-xs font-bold text-slate-700">المورد المعتمد</label>
                        <div class="flex items-center gap-2">
                            <div class="min-w-0 flex-1">
                                <MudSelect T="int?"
                                           @bind-Value="_workingCopy.SupplierId"
                                           Clearable="true"
                                           Disabled="_saving"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           InputClass="text-xs font-semibold">

                                    @foreach (var supplier in _workingCopy.Suppliers)
                                    {
                                        <MudSelectItem T="int?"
                                                       Value="@((int?)supplier.Id)">
                                            @supplier.Name
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <SupplierEditorButton Variant="Variant.Text"
                                                  ButtonText=""
                                                  StartIcon="@Icons.Material.Outlined.Add"
                                                  Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--secondary"
                                                  PreselectedProductId="_workingCopy.ProductId"
                                                  OnCreated="OnSupplierCreatedAsync" />
                        </div>

                        @if (_workingCopy.SupplierId.HasValue &&
                             !_workingCopy.Suppliers.Any(s => s.Id == _workingCopy.SupplierId))
                        {
                            <MudAlert Severity="Severity.Warning">
                                المورد المحدد لم يعد متاحاً. اختر مورداً متاحاً أو امسح الاختيار.
                            </MudAlert>
                        }
                    </div>

                    @* Price & quantity *@
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <MudNumericField T="decimal"
                                         Label="سعر الوحدة قبل الضريبة"
                                         @bind-Value="_workingCopy.UnitPrice"
                                         Min="0"
                                         Disabled="_saving"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Validation="@(new Func<decimal, string?>(value =>
                                                                                      value > 0 ? null : "يجب أن يكون السعر أكبر من صفر."))" />

                        <MudNumericField T="int"
                                         Label="الكمية"
                                         @bind-Value="_workingCopy.Quantity"
                                         Min="1"
                                         Disabled="_saving"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Validation="@(new Func<int, string?>(value =>
                                                                                  value > 0 ? null : "يجب أن تكون الكمية أكبر من صفر."))" />
                    </div>

                    @* Source allocation *@
                    <div class="space-y-2 border-t border-slate-100 pt-3">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-bold text-slate-700">مصدر الكمية</label>
                            <span class="text-[11px] text-slate-400">المطلوب: @_workingCopy.Quantity</span>
                        </div>

                        @if (AvailabilityWarning is not null)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                @AvailabilityWarning
                            </MudAlert>

                            @if (_workingCopy.Allocations.Count > 0)
                            {
                                <ul class="space-y-1 rounded-xl bg-slate-50 p-3 text-[11px] text-slate-600">
                                    @foreach (var allocation in _workingCopy.Allocations)
                                    {
                                        <li class="flex items-center justify-between">
                                            <span>
                                                @(allocation.SourceKind == AllocationSourceKind.Warehouse
                                                    ? allocation.WarehouseName
                                                    : allocation.SupplierName)
                                            </span>
                                            <span class="font-mono">@allocation.Qty</span>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                        else if (_rows.Count == 0)
                        {
                            <p class="rounded-xl bg-slate-50 p-3 text-[11px] text-slate-500">
                                لا توجد أرصدة متاحة في المخازن لهذا المنتج. ستُخصَّص الكمية من المورد.
                            </p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var row in _rows)
                                {
                                    <div class="flex items-center justify-between gap-3 rounded-xl border border-slate-100 p-2.5">
                                        <div class="min-w-0">
                                            <p class="truncate text-xs font-semibold text-slate-700">@row.WarehouseName</p>
                                            <p class="text-[11px] text-slate-400">
                                                متاح: @row.Available
                                                @if (!row.IsListed)
                                                {
                                                    <span> — لم يعد المخزن مدرجاً</span>
                                                }
                                            </p>
                                        </div>

                                        <div class="w-24 shrink-0">
                                            <MudNumericField T="int"
                                                             @bind-Value="row.Qty"
                                                             Min="0"
                                                             Max="@row.MaxQuantity"
                                                             Disabled="_saving"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             HideSpinButtons="true"
                                                             InputClass="text-xs" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div class="flex items-center justify-between rounded-xl bg-blue-50/60 px-3 py-2 text-xs">
                            <span class="font-semibold text-blue-800">الكمية المتبقية من المورد</span>
                            <span class="font-mono font-bold text-blue-700">@SupplierRemainder</span>
                        </div>

                        @if (_sourceError is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @_sourceError
                            </MudAlert>
                        }
                    </div>

                    @* Tax *@
                    <MudNumericField T="decimal"
                                     Label="نسبة الضريبة (%)"
                                     @bind-Value="_workingCopy.VatRate"
                                     Min="0"
                                     Max="100"
                                     Disabled="_saving"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Validation="@(new Func<decimal, string?>(value =>
                                                                                  value is >= 0 and <= 100
                                                                                      ? null
                                                                                      : "الضريبة يجب أن تكون بين 0 و100."))" />

                    @* Properties *@
                    @if (_workingCopy.Properties.Count > 0)
                    {
                        <div class="space-y-2 border-t border-slate-100 pt-3">
                            <label class="block text-xs font-bold text-slate-700">خيارات ومواصفات المنتج</label>

                            @foreach (var property in _workingCopy.Properties)
                            {
                                @if (!property.HasMetadata)
                                {
                                    <MudAlert Severity="Severity.Warning">
                                        @property.ValidateValue(property.Value) — @property.Value
                                    </MudAlert>
                                    continue;
                                }

                                @switch (property.Type)
                                {
                                    case PropertyType.Text:
                                        <MudTextField T="string"
                                                      @key="property.PropertyId"
                                                      Label="@property.Name"
                                                      @bind-Value="property.Value"
                                                      Required="property.IsRequired"
                                                      Disabled="_saving"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      InputClass="text-xs"
                                                      Validation="@(new Func<string?, string?>(property.ValidateValue))" />
                                        break;

                                    case PropertyType.Boolean:
                                        <MudSelect T="string"
                                                   @key="property.PropertyId"
                                                   Label="@property.Name"
                                                   @bind-Value="property.Value"
                                                   Clearable="true"
                                                   Required="property.IsRequired"
                                                   Disabled="_saving"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   InputClass="text-xs"
                                                   Validation="@(new Func<string?, string?>(property.ValidateValue))">
                                            <MudSelectItem T="string" Value='@("true")'>
                                                نعم
                                            </MudSelectItem>
                                            <MudSelectItem T="string" Value='@("false")'>
                                                لا
                                            </MudSelectItem>
                                        </MudSelect>
                                        break;

                                    case PropertyType.List:
                                        <MudSelect T="string"
                                                   @key="property.PropertyId"
                                                   Label="@property.Name"
                                                   @bind-Value="property.Value"
                                                   Clearable="true"
                                                   Required="property.IsRequired"
                                                   Disabled="_saving"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   InputClass="text-xs"
                                                   Validation="@(new Func<string?, string?>(property.ValidateValue))">
                                            @foreach (var option in property.Options)
                                            {
                                                <MudSelectItem T="string" Value="@option.Value">
                                                    @option.Value
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                        break;
                                }

                                @if (property.Value is not null &&
                                     property.ValidateValue(property.Value) is { } error)
                                {
                                    <MudAlert Severity="Severity.Warning">
                                        @error
                                    </MudAlert>
                                }
                            }
                        </div>
                    }

                    @* Mini summary *@
                    @if (CurrentPricing is { } pricing)
                    {
                        <div class="space-y-1.5 rounded-xl bg-slate-50 p-3 text-xs">
                            <span class="block text-xs font-bold text-slate-800">ملخص الصنف المعدل:</span>

                            <div class="flex items-center justify-between text-slate-500">
                                <span>قيمة المنتجات قبل الضريبة</span>
                                <span class="font-mono text-slate-800">@pricing.Subtotal.ToString("N2") ر.س</span>
                            </div>

                            <div class="flex items-center justify-between text-slate-500">
                                <span>قيمة الضريبة (@pricing.VatRate.ToString("N2")%)</span>
                                <span class="font-mono text-slate-800">@pricing.VatAmount.ToString("N2") ر.س</span>
                            </div>

                            <div class="flex items-center justify-between border-t border-slate-200 pt-1.5 font-bold text-blue-700">
                                <span>الإجمالي للصنف:</span>
                                <span class="font-mono text-sm">@pricing.Total.ToString("N2") ر.س</span>
                            </div>
                        </div>
                    }
                </div>
            </MudForm>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">
                    @_error
                </MudAlert>
            }

            <div class="mt-auto flex items-center gap-2 border-t border-slate-100 pt-4">
                <MudButton OnClick="Cancel"
                           Class="oh-btn oh-btn--secondary w-1/2"
                           Disabled="_saving">
                    إلغاء
                </MudButton>

                <MudButton OnClick="SaveAsync"
                           Disabled="_saving"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Class="oh-btn oh-btn--primary w-1/2"
                           StartIcon="@(IsAdding
                                            ? Icons.Material.Outlined.Add
                                            : Icons.Material.Outlined.Save)">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true"
                                             Class="me-2" />
                    }

                    @(IsAdding ? "إضافة المنتج" : "حفظ التعديلات")
                </MudButton>
            </div>
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired]
    public OrderItemEditorState Item { get; set; } = null!;

    [Parameter]
    public Guid SessionId { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public bool IsAdding { get; set; }

    [Parameter, EditorRequired]
    public Func<OrderItemEditorState, Guid, OrderItemEditorState, Task<Result>> Commit
    { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<StockAvailabilityEditorState> Availability { get; set; } = [];

    [Parameter]
    public string? AvailabilityWarning { get; set; }

    private List<WarehouseSourceRow> _rows = [];
    private string? _sourceError;

    private bool StockDenied => AvailabilityWarning is not null;

    private int WarehouseQuantity => StockDenied
        ? _workingCopy?.Allocations
            .Where(allocation => allocation.SourceKind == AllocationSourceKind.Warehouse)
            .Sum(allocation => allocation.Qty) ?? 0
        : _rows.Sum(row => row.Qty);

    private int SupplierRemainder => Math.Max(0, (_workingCopy?.Quantity ?? 0) - WarehouseQuantity);

    private sealed class WarehouseSourceRow
    {
        public int WarehouseId { get; init; }
        public required string WarehouseName { get; init; }
        public int Available { get; init; }
        public bool IsListed { get; init; }
        public int PersistedQty { get; init; }
        public int MaxQuantity => Math.Max(Available + PersistedQty, 0);
        public int Qty { get; set; }
    }

    private void BuildSourceRows()
    {
        _rows = [];
        _sourceError = null;

        if (_workingCopy is null)
            return;

        var persisted = _workingCopy.Allocations
            .Where(allocation => allocation.SourceKind == AllocationSourceKind.Warehouse && allocation.WarehouseId.HasValue)
            .GroupBy(allocation => allocation.WarehouseId!.Value)
            .ToDictionary(group => group.Key, group => (Qty: group.Sum(allocation => allocation.Qty),
                Name: group.Select(allocation => allocation.WarehouseName).FirstOrDefault()));

        if (StockDenied)
            return;

        foreach (var availability in Availability)
        {
            var qty = persisted.TryGetValue(availability.WarehouseId, out var saved) ? saved.Qty : 0;
            _rows.Add(new WarehouseSourceRow
            {
                WarehouseId = availability.WarehouseId,
                WarehouseName = availability.WarehouseName,
                Available = availability.Available,
                IsListed = true,
                PersistedQty = qty,
                Qty = qty
            });
        }

        foreach (var missing in persisted.Where(pair => _rows.All(row => row.WarehouseId != pair.Key)))
        {
            _rows.Add(new WarehouseSourceRow
            {
                WarehouseId = missing.Key,
                WarehouseName = missing.Value.Name ?? "مخزن غير متاح",
                Available = 0,
                IsListed = false,
                PersistedQty = missing.Value.Qty,
                Qty = missing.Value.Qty
            });
        }
    }

    private string? ValidateSources()
    {
        if (_workingCopy is null)
            return null;

        if (StockDenied)
        {
            // بلا صلاحية مخزون نحافظ على مصادر المخازن المحفوظة ونعيد حساب حصة المورد فقط.
            if (WarehouseQuantity > _workingCopy.Quantity)
                return "الكمية الجديدة أقل من الكميات المخصصة من المخازن. زد الكمية أو أعد التوزيع من حساب يملك صلاحية عرض المخزون.";

            return ValidateSupplierRemainder(_workingCopy.Quantity - WarehouseQuantity);
        }

        var warehouseQty = _rows.Sum(row => row.Qty);
        if (warehouseQty > _workingCopy.Quantity)
            return "مجموع كميات المخازن يتجاوز كمية البند.";

        foreach (var row in _rows.Where(row => row.Qty > 0))
        {
            if (row.Qty > row.MaxQuantity)
                return $"الكمية المطلوبة من {row.WarehouseName} تتجاوز المتاح ({row.MaxQuantity}).";
        }

        return ValidateSupplierRemainder(_workingCopy.Quantity - warehouseQty);
    }

    private string? ValidateSupplierRemainder(int remainder)
    {
        if (remainder <= 0)
            return null;

        if (!_workingCopy!.SupplierId.HasValue)
            return "يجب تحديد المورد للكمية غير المتوفرة في المخازن.";

        if (!_workingCopy.Suppliers.Any(supplier => supplier.Id == _workingCopy.SupplierId))
            return "المورد المحدد غير متاح لهذا المنتج.";

        return null;
    }

    private void ApplyAllocations()
    {
        if (_workingCopy is null)
            return;

        var allocations = new List<OrderItemAllocationEditorState>();
        if (StockDenied)
        {
            allocations.AddRange(_workingCopy.Allocations
                .Where(allocation => allocation.SourceKind == AllocationSourceKind.Warehouse)
                .Select(allocation => allocation.Clone()));
        }
        else
        {
            foreach (var row in _rows.Where(row => row.Qty > 0))
            {
                allocations.Add(new OrderItemAllocationEditorState
                {
                    SourceKind = AllocationSourceKind.Warehouse,
                    Qty = row.Qty,
                    WarehouseId = row.WarehouseId,
                    WarehouseName = row.WarehouseName
                });
            }
        }

        var remainder = _workingCopy.Quantity - allocations.Sum(allocation => allocation.Qty);
        if (remainder > 0)
        {
            allocations.Add(new OrderItemAllocationEditorState
            {
                SourceKind = AllocationSourceKind.Supplier,
                Qty = remainder,
                SupplierId = _workingCopy.SupplierId,
                SupplierName = _workingCopy.Suppliers
                    .FirstOrDefault(supplier => supplier.Id == _workingCopy.SupplierId)?.Name
            });
        }

        _workingCopy.Allocations.Clear();
        _workingCopy.Allocations.AddRange(allocations);
    }

    private OrderItemEditorState? _workingCopy;
    private OrderItemEditorState? _original;
    private Guid _originalSession;
    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private MudForm? _form;

    private PricingItemResult? CurrentPricing =>
        _workingCopy is null ||
        _workingCopy.UnitPrice <= 0 ||
        _workingCopy.Quantity <= 0 ||
        _workingCopy.VatRate is < 0 or > 100
            ? null
            : PricingCalculator.CalculateItem(
                new PricingItem(
                    _workingCopy.ProductId,
                    _workingCopy.ProductName,
                    _workingCopy.Quantity,
                    _workingCopy.UnitPrice,
                    _workingCopy.VatRate));

    protected override void OnParametersSet()
    {
        if (IsOpen &&
            (!_wasOpen ||
             !ReferenceEquals(Item, _original) ||
             SessionId != _originalSession))
        {
            _original = Item;
            _originalSession = SessionId;
            _workingCopy = Item.CreateWorkingCopy();
            BuildSourceRows();
            _error = null;
        }

        _wasOpen = IsOpen;
    }

    private Task OnOpenChanged(bool open) =>
        open || _saving ? Task.CompletedTask : Cancel();

    private async Task OnSupplierCreatedAsync(int supplierId)
    {
        if (_workingCopy is null || _original is null)
            return;

        // إعادة تحميل قائمة موردي المنتج بعد ربط المورد الجديد به.
        try
        {
            var data = await RequestExecutor.ExecuteAsync(
                new GetOrderItemEditorQuery(_original.ProductId));

            if (data is null)
                return;

            var suppliers = data.Suppliers
                .Select(supplier => new OrderItemSupplierEditorState(supplier.Id, supplier.Name))
                .ToArray();

            _original.Suppliers = suppliers;

            if (_workingCopy is not null)
            {
                _workingCopy.Suppliers = suppliers;

                // اختيار المورد الجديد تلقائيًا إذا رُبط بالمنتج.
                if (suppliers.Any(supplier => supplier.Id == supplierId))
                    _workingCopy.SupplierId = supplierId;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // لا نمنع العملية؛ يمكن للمستخدم إغلاق المحرر وإعادة فتحه لتحديث القائمة.
        }
    }

    private Task Cancel()
    {
        if (_saving)
            return Task.CompletedTask;

        _workingCopy = null;

        return IsOpenChanged.InvokeAsync(false);
    }

    private async Task SaveAsync()
    {
        if (_saving || _workingCopy is null || _original is null)
            return;

        _saving = true;
        _error = null;

        try
        {
            if (_form is not null)
            {
                await _form.ValidateAsync();

                if (!_form.IsValid)
                    return;
            }

            _sourceError = ValidateSources();
            if (_sourceError is not null)
                return;

            ApplyAllocations();

            var result = await Commit(
                _original,
                _originalSession,
                _workingCopy);

            if (result.IsSuccess)
            {
                _workingCopy = null;
                await IsOpenChanged.InvokeAsync(false);
            }
            else
            {
                _error = result.ErrorMessage;
            }
        }
        catch (Exception)
        {
            _error = "حدث خطأ أثناء حفظ المنتج. حاول مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}
