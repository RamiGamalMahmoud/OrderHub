@using System.Globalization
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State

<section class="flex flex-col gap-4 rounded-xl bg-white p-4 shadow-sm sm:p-5">

    @* Card header *@
    <div class="flex flex-col justify-between gap-3 pb-1 sm:flex-row sm:items-center">
        <div class="flex items-center gap-2">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
            </span>
            <div>
                <h3 class="text-base font-bold leading-tight text-slate-900">المنتجات المضافة إلى الطلب</h3>
                <p class="text-xs text-slate-500">إدارة ومراجعة البنود المحجوزة والكميات</p>
            </div>
            <span class="mr-2 rounded-full bg-blue-100 px-2 py-0.5 text-xs font-extrabold text-blue-800">
                @Items.Count.ToString(CultureInfo.InvariantCulture) منتجات
            </span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <PermissionView Feature="PermissionFeature.Products">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="oh-btn oh-btn--secondary oh-btn--sm"
                           StartIcon="@Icons.Material.Outlined.AddShoppingCart"
                           OnClick="AddProductAsync">
                    اختيار منتج
                </MudButton>
            </PermissionView>

            <PermissionView Feature="PermissionFeature.Products">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="oh-btn oh-btn--secondary oh-btn--sm"
                           StartIcon="@Icons.Material.Outlined.AddBox"
                           Href="/products/create"
                           Target="_blank">
                    منتج جديد
                </MudButton>
            </PermissionView>
        </div>
    </div>

    @if (Items.Count == 0)
    {
        <div class="flex flex-col items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 p-6 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" Class="text-slate-400" />
            <p class="text-sm font-bold text-slate-800">لا توجد منتجات مضافة</p>
            <p class="text-xs text-slate-500">ابدأ بإضافة المنتجات المطلوبة لهذا الطلب</p>

            <PermissionView Feature="PermissionFeature.Products">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="oh-btn oh-btn--secondary oh-btn--sm"
                           StartIcon="@Icons.Material.Outlined.Add"
                           OnClick="AddProductAsync">
                    اختيار منتج
                </MudButton>
            </PermissionView>
        </div>
    }
    else
    {
        @* In-table quick filter *@
        <div class="flex items-center justify-between gap-2 rounded-lg bg-slate-50 p-2.5">
            <MudTextField T="string"
                          Value="@_searchTerm"
                          ValueChanged="OnSearchChanged"
                          Placeholder="بحث داخل المنتجات المضافة..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Outlined.Search"
                          Class="w-full max-w-xs" />
        </div>

        <MudDataGrid T="OrderItemEditorState"
                     Items="FilteredItems"
                     Class="oh-products-table w-full"
                     Dense="true"
                     Hover="true"
                     ReadOnly="true"
                     @bind-CurrentPage="_gridCurrentPage"
                     @bind-RowsPerPage="_gridRowsPerPage"
                     SelectedItem="@_selectedItem"
                     SelectOnRowClick="true"
                     SelectedItemChanged="OnSelectedItemChanged"
                     RowClick="@(args => OnGridRowClicked(args.Item))">

            <Columns>
                <TemplateColumn Title="المنتج / الصنف" Sortable="false">
                    <CellTemplate>
                        <div class="flex items-center gap-3">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Small" />
                            </span>
                            <div class="min-w-0">
                                <span class="block font-bold text-slate-900">@context.Item.ProductName</span>
                                <span class="block text-[11px] text-slate-400">@context.Item.CategoryName</span>
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="السعر الإفرادي" Sortable="false">
                    <CellTemplate>
                        <span class="font-semibold text-slate-800">@context.Item.UnitPrice.ToString("N2") ر.س</span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="الكمية" Sortable="false">
                    <CellTemplate>
                        <span class="font-bold text-slate-800">@context.Item.Quantity.ToString(CultureInfo.InvariantCulture)</span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="الضريبة" Sortable="false">
                    <CellTemplate>
                        <span class="font-semibold text-slate-700">@PricingOf(context.Item).VatAmount.ToString("N2") ر.س</span>
                        <span class="block font-mono text-[10px] text-slate-400">@context.Item.VatRate.ToString(CultureInfo.InvariantCulture)%</span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="الإجمالي" Sortable="false">
                    <CellTemplate>
                        <span class="text-sm font-bold text-blue-700">@PricingOf(context.Item).Total.ToString("N2") ر.س</span>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="إجراءات" Sortable="false">
                    <CellTemplate>
                        <span class="inline-flex items-center gap-1"
                              @onclick="@(() => { })"
                              @onclick:stopPropagation="true">
                            <MudIconButton Icon="@Icons.Material.Outlined.Tune"
                                           Size="Size.Small"
                                           OnClick="@(() => EditItem(context.Item))"
                                           aria-label="تعديل خصائص المنتج"
                                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />

                            <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveItem(context.Item))"
                                           aria-label="حذف المنتج"
                                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost oh-btn--danger" />
                        </span>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <TableFooter TotalItems="FilteredItems.Count()"
                             CurrentPage="@FooterCurrentPage"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="@_gridRowsPerPage"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>

        </MudDataGrid>
    }

</section>

@if (_editingItem is not null)
{
    <ProductEditorDrawer Item="_editingItem"
                         SessionId="SessionId"
                         IsOpen="_isEditorOpen"
                         IsOpenChanged="OnEditorOpenChanged"
                         IsAdding="_isAddingItem"
                         Commit="CommitItemAsync" />
}

@code
{
    private OrderItemEditorState? _selectedItem;
    private int _gridCurrentPage;
    private int _gridRowsPerPage = 10;
    private string? _searchTerm;

    private int FooterCurrentPage => _gridCurrentPage + 1;

    private IEnumerable<OrderItemEditorState> FilteredItems =>
        string.IsNullOrWhiteSpace(_searchTerm)
            ? Items
            : Items.Where(item =>
                item.ProductName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                item.CategoryName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private void OnSearchChanged(string? value)
    {
        _searchTerm = value;
        _gridCurrentPage = 0;
    }

    private Task OnFooterPageChanged(int page)
    {
        _gridCurrentPage = page - 1;
        return Task.CompletedTask;
    }

    private Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _gridRowsPerPage = rowsPerPage;
        _gridCurrentPage = 0;
        return Task.CompletedTask;
    }

    private void OnSelectedItemChanged(OrderItemEditorState? item)
    {
        _selectedItem = item;
    }

}
