@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State

<MudStack Spacing="3">

    @* Header *@
    <MudStack Row
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween">

        <div>
            <MudText Typo="Typo.h6">
                المنتجات المضافة إلى الطلب
            </MudText>
        </div>

        <MudStack Row>

            <PermissionView Feature="PermissionFeature.Products">
                <MudButton Color="Color.Primary"
                           StartIcon="@Icons.Material.Outlined.OpenInNew"
                           Href="/products/create"
                           Target="_blank">
                    إضافة منتج جديد
                </MudButton>
            </PermissionView>

            @if (Items.Count > 0)
            {
                <PermissionView Feature="PermissionFeature.Products">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.ListAlt"
                               OnClick="AddProductAsync">
                        اختيار منتج
                    </MudButton>
                </PermissionView>

            }
        </MudStack>

    </MudStack>

    @if (Items.Count == 0)
    {
        @* Empty State *@
        <MudPaper Elevation="0"
                  Outlined="true"
                  Class="pa-6">

            <MudStack AlignItems="AlignItems.Center"
                      Spacing="2">

                <MudIcon Icon="@Icons.Material.Outlined.Inventory2"
                         Size="Size.Large"
                         Color="Color.Secondary" />

                <MudText Typo="Typo.subtitle1">
                    لا توجد منتجات مضافة
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    ابدأ بإضافة المنتجات المطلوبة لهذا الطلب
                </MudText>

                <PermissionView Feature="PermissionFeature.Products">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Add"
                               OnClick="AddProductAsync">
                        اختيار منتج
                    </MudButton>
                </PermissionView>

            </MudStack>

        </MudPaper>
    }
    else
    {

        @* Products *@
        <MudDataGrid T="OrderItemEditorState"
                     Items="Items"
                     Style="cursor: pointer;"
                     SelectedItem="@_selectedItem"
                     SelectOnRowClick="true"
                     SelectedItemChanged="OnSelectedItemChanged"
                     Hover="true"
                     Striped="true"
                     ReadOnly="true">

            <Columns>

                <PropertyColumn Property="x => x.ProductName"
                                Title="المنتج" />

                <PropertyColumn Property="x => x.UnitPrice"
                                Title="سعر الوحدة قبل الضريبة"
                                Format="N2" />

                <PropertyColumn Property="x => x.Quantity"
                                Title="الكمية" />

                <PropertyColumn Property="@(x => $"{x.VatRate}%")" Title="الضريبة" />

                <PropertyColumn Title="قيمة الضريبة" Property="@(x => $"{PricingOf(x).VatAmount:N2} ر.س")" />

                <PropertyColumn Title="الإجمالي شامل الضريبة" Property="@(x => $"{PricingOf(x).Total:N2} ر.س")" />

                <TemplateColumn Title="" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Size="Size.Small"
                                       OnClick="@(() => EditItem(context.Item))" />

                        <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveItem(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>

            </Columns>

        </MudDataGrid>

    }

</MudStack>

@if (_editingItem is not null)
{
    <ProductEditorDrawer Item="_editingItem"
                         SessionId="SessionId"
                         IsOpen="_isEditorOpen"
                         IsOpenChanged="OnEditorOpenChanged"
                         IsAdding="_isAddingItem"
                         Commit="CommitItemAsync" />
}

@code
{
    private OrderItemEditorState? _selectedItem;

    private void OnSelectedItemChanged(OrderItemEditorState? item)
    {
        _selectedItem = item;
    }

}