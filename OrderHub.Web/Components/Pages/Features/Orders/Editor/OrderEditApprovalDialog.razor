@using System.Globalization
@using OrderHub.Application.Features.Orders.Update
@using OrderHub.Domain.Common

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Outlined.Approval" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">إرسال التعديل للاعتماد</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">أدخل سبب التعديل ليُرسل إلى المدير</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <p class="text-sm leading-7 text-slate-700">
                الطلب يحتوي على كميات مصروفة، لذلك لا يُحفظ التعديل مباشرة. سيُحفظ كما هو الآن ويُرسل إلى المدير،
                ولا يُطبَّق إلا بعد اعتماده مع الحفاظ على الكميات المصروفة.
            </p>

            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="سبب التعديل"
                          Required="true"
                          Immediate="true"
                          MaxLength="200"
                          HelperText="@ReasonCounter"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                رجوع دون إرسال
            </MudButton>
            <MudButton Class="oh-btn oh-btn--primary"
                       Disabled="@(!CanSubmit)"
                       OnClick="SubmitAsync">
                @(_submitting ? "جاري الإرسال…" : "إرسال للاعتماد")
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter, EditorRequired] public Func<string, Task<Result<OrderUpdateReceipt>>> Submit { get; set; } = null!;

    private string? _reason;
    private string? _error;
    private bool _submitting;

    private string ReasonCounter => $"{(_reason?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    private bool CanSubmit => !_submitting && !string.IsNullOrWhiteSpace(_reason);

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            Result<OrderUpdateReceipt> result = await Submit(_reason!.Trim());
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception)
        {
            _error = "تعذر إرسال التعديل للاعتماد. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
