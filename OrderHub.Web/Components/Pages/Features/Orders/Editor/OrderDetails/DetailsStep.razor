@using OrderHub.Application.Features.Orders.GetEditorLookups
@using OrderHub.Application.Common.Lookups
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Enums
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State

@implements IDisposable

@inject IRequestExecutor RequestExecutor
@inject ILogger<DetailsStep> Logger

<div class="flex flex-col gap-5">

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true"
                           aria-label="تحميل بيانات الطلب" />
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Outlined"
                  role="alert">

            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween">

                <MudText Typo="Typo.body2">
                    @_error
                </MudText>

                <MudButton Variant="Variant.Text"
                           Disabled="_loading"
                           OnClick="LoadLookupsAsync"
                           Class="oh-btn oh-btn--secondary oh-btn--sm">
                    إعادة المحاولة
                </MudButton>

            </MudStack>

        </MudAlert>
    }

    <ClientSection ClientId="State.ClientId"
                   ClientIdChanged="SetClientAsync"
                   Clients="_clients"
                   Disabled="_loading" />

    @* Source & payment *@
    <section class="flex flex-col gap-3 rounded-xl bg-white p-4 shadow-sm sm:p-5">
        <div class="flex items-center gap-2 pb-1">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                <MudIcon Icon="@Icons.Material.Outlined.Payments" Size="Size.Small" />
            </span>
            <div>
                <h3 class="text-sm font-bold leading-tight text-slate-900">مصدر الطلب وطريقة الدفع</h3>
                <p class="text-[11px] text-slate-500">قناة البيع وأسلوب تسوية الفاتورة</p>
            </div>
        </div>

        <OrderSourceSection OrderSource="State.OrderSource"
                            OrderSourceChanged="SetSourceAsync" />

        <PaymentSection PaymentMethodId="State.PaymentMethodId"
                        PaymentMethodIdChanged="SetPaymentAsync"
                        PaymentMethods="_payments"
                        Disabled="_loading" />
    </section>

    <DeliverySection Delivery="State.Delivery"
                     Deliverymen="_deliverymen"
                     ShippingCarriers="_carriers"
                     Disabled="_loading"
                     Changed="NotifyChangedAsync" />

</div>

