@using OrderHub.Application.Common.Lookups
@using OrderHub.Domain.Enums

<div>
    <label class="mb-1.5 block text-xs font-semibold text-slate-600">مصدر الطلب (قناة البيع)</label>

    <div class="grid grid-cols-2 gap-1 rounded-lg bg-slate-50 p-1">
        @foreach (var source in EnumItems.For<OrderSource>())
        {
            var isSelected = OrderSource == source.Value;
            <button type="button"
                    class="rounded-md py-1.5 text-center text-xs transition @(isSelected
                                                                                ? "bg-blue-600 font-bold text-white shadow-sm"
                                                                                : "font-semibold text-slate-600 hover:bg-slate-200 hover:text-slate-900")"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    @onclick="@(() => OnOrderSourceChangedAsync(source.Value))">
                @source.DisplayName
            </button>
        }
    </div>
</div>

@code
{
    [Parameter]
    public OrderSource? OrderSource { get; set; }

    [Parameter]
    public EventCallback<OrderSource?> OrderSourceChanged { get; set; }

    private Task OnOrderSourceChangedAsync(OrderSource value)
    {
        if (OrderSource == value)
            return Task.CompletedTask;

        return OrderSourceChanged.InvokeAsync(value);
    }
}
