@using OrderHub.Application.Common.Lookups
@using OrderHub.Domain.Enums
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State

<div class="flex flex-col gap-2 rounded-lg bg-slate-50 p-2.5">

    <div class="flex items-center justify-between gap-2">
        <div class="flex min-w-0 items-center gap-2">
            <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-blue-600 text-[10px] font-black text-white">
                @Step.StepOrder
            </span>
            <span class="truncate text-xs font-bold text-slate-800">خطوة @Step.StepOrder</span>

            <span class="inline-flex shrink-0 rounded bg-slate-200 p-0.5">
                <button type="button"
                        class="rounded px-2 py-0.5 text-[10px] font-bold transition @(Step.Method == DeliveryMethod.DeliveryMan ? "bg-blue-100 text-blue-700" : "text-slate-500 hover:text-slate-700")"
                        disabled="@Disabled"
                        aria-pressed="@(Step.Method == DeliveryMethod.DeliveryMan ? "true" : "false")"
                        @onclick="@(() => OnMethodChangedAsync(DeliveryMethod.DeliveryMan))">
                    مندوب
                </button>
                <button type="button"
                        class="rounded px-2 py-0.5 text-[10px] font-bold transition @(Step.Method == DeliveryMethod.ShippingCompany ? "bg-purple-100 text-purple-700" : "text-slate-500 hover:text-slate-700")"
                        disabled="@Disabled"
                        aria-pressed="@(Step.Method == DeliveryMethod.ShippingCompany ? "true" : "false")"
                        @onclick="@(() => OnMethodChangedAsync(DeliveryMethod.ShippingCompany))">
                    شركة شحن
                </button>
            </span>
        </div>

        <div class="flex shrink-0 items-center gap-1">
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward"
                           Size="Size.Small"
                           Disabled="@(Disabled || !CanMoveUp)"
                           OnClick="MoveUp"
                           aria-label="نقل الخطوة لأعلى"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />

            <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward"
                           Size="Size.Small"
                           Disabled="@(Disabled || !CanMoveDown)"
                           OnClick="MoveDown"
                           aria-label="نقل الخطوة لأسفل"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />

            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           Color="Color.Error"
                           Disabled="Disabled"
                           OnClick="Remove"
                           aria-label="حذف الخطوة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost oh-btn--danger" />
        </div>
    </div>

    @if (Step.Method == DeliveryMethod.DeliveryMan)
    {
        <MudSelect T="int?"
                   Placeholder="مندوب التوصيل"
                   Value="Step.HandlerId"
                   ValueChanged="OnHandlerChangedAsync"
                   Clearable="true"
                   Disabled="Disabled"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   InputClass="text-xs font-semibold">

            @foreach (var deliveryman in Deliverymen)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)deliveryman.Id)">
                    @deliveryman.Name
                </MudSelectItem>
            }

        </MudSelect>
    }
    else if (Step.Method == DeliveryMethod.ShippingCompany)
    {
        <MudSelect T="int?"
                   Placeholder="شركة الشحن"
                   Value="Step.HandlerId"
                   ValueChanged="OnHandlerChangedAsync"
                   Clearable="true"
                   Disabled="Disabled"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   InputClass="text-xs font-semibold">

            @foreach (var carrier in ShippingCarriers)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)carrier.Id)">
                    @carrier.Name
                </MudSelectItem>
            }

        </MudSelect>
    }

</div>

@code
{
    [Parameter, EditorRequired]
    public DeliveryStepEditorState Step { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<DeliverymanLookup> Deliverymen { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ShippingCarrierLookup> ShippingCarriers { get; set; } = [];

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public EventCallback MoveUp { get; set; }

    [Parameter]
    public EventCallback MoveDown { get; set; }

    [Parameter]
    public EventCallback Remove { get; set; }

    private async Task OnMethodChangedAsync(DeliveryMethod value)
    {
        if (Disabled ||
            value == Step.Method ||
            value is not (DeliveryMethod.DeliveryMan or DeliveryMethod.ShippingCompany))
        {
            return;
        }

        Step.Method = value;

        // الـ Handler القديم ينتمي إلى النوع السابق،
        // لذلك لا يصح الاحتفاظ به عند تغيير نوع الخطوة.
        Step.HandlerId = null;

        await Changed.InvokeAsync();
    }

    private async Task OnHandlerChangedAsync(int? value)
    {
        if (Disabled || value == Step.HandlerId)
            return;

        Step.HandlerId = value;

        await Changed.InvokeAsync();
    }
}
