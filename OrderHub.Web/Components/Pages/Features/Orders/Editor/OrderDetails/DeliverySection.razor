@using OrderHub.Application.Common.Lookups
@using OrderHub.Domain.Enums
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.State

<section class="flex flex-col gap-3 rounded-xl bg-white p-4 shadow-sm sm:p-5">
    <div class="flex items-center gap-2 pb-1">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
            <MudIcon Icon="@Icons.Material.Outlined.Route" Size="Size.Small" />
        </span>
        <div>
            <h3 class="text-sm font-bold leading-tight text-slate-900">سلسلة وخطة التوصيل</h3>
            <p class="text-[11px] text-slate-500">مسار الشحن اللوجستي متعدد المراحل</p>
        </div>
    </div>

    @* Delivery methods *@
    <div class="grid grid-cols-2 gap-1 rounded-lg bg-slate-50 p-1 text-center text-xs">
        @foreach (var method in EnumItems.For<DeliveryMethod>())
        {
            var isSelected = Delivery.Method == method.Value;
            <button type="button"
                    class="rounded py-1 font-semibold transition @(isSelected
                                                                   ? "bg-blue-600 font-bold text-white shadow-sm"
                                                                   : "text-slate-600 hover:bg-white")"
                    disabled="@Disabled"
                    aria-pressed="@(isSelected ? "true" : "false")"
                    @onclick="@(() => OnDeliveryMethodChangedAsync(method.Value))">
                @method.DisplayName
            </button>
        }
    </div>

    @if (Delivery.Method == DeliveryMethod.DeliveryMan)
    {
        <MudSelect T="int?"
                   Placeholder="مندوب التوصيل"
                   Value="Delivery.DeliverymanId"
                   ValueChanged="OnDeliverymanChangedAsync"
                   Clearable="true"
                   Disabled="Disabled"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   InputClass="text-xs font-semibold">

            @foreach (var deliveryman in Deliverymen)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)deliveryman.Id)">
                    @deliveryman.Name
                </MudSelectItem>
            }

        </MudSelect>
    }
    else if (Delivery.Method == DeliveryMethod.ShippingCompany)
    {
        <MudSelect T="int?"
                   Placeholder="شركة الشحن"
                   Value="Delivery.ShippingCarrierId"
                   ValueChanged="OnShippingCarrierChangedAsync"
                   Clearable="true"
                   Disabled="Disabled"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   InputClass="text-xs font-semibold">

            @foreach (var carrier in ShippingCarriers)
            {
                <MudSelectItem T="int?"
                               Value="@((int?)carrier.Id)">
                    @carrier.Name
                </MudSelectItem>
            }

        </MudSelect>
    }
    else if (Delivery.Method == DeliveryMethod.DeliveryChain)
    {
        <DeliveryChainEditor Steps="Delivery.Steps"
                             Deliverymen="Deliverymen"
                             ShippingCarriers="ShippingCarriers"
                             Disabled="Disabled"
                             Changed="Changed" />
    }

</section>

@code
{
    [Parameter, EditorRequired]
    public DeliveryEditorState Delivery { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<DeliverymanLookup> Deliverymen { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<ShippingCarrierLookup> ShippingCarriers { get; set; } = [];

    [Parameter]
    public EventCallback Changed { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private async Task OnDeliveryMethodChangedAsync(DeliveryMethod value)
    {
        if (Disabled || value == Delivery.Method)
            return;

        Delivery.Method = value;

        if (value is not DeliveryMethod.DeliveryChain)
            Delivery.Steps.Clear();

        await Changed.InvokeAsync();
    }

    private async Task OnDeliverymanChangedAsync(int? value)
    {
        if (value == Delivery.DeliverymanId)
            return;

        Delivery.DeliverymanId = value;

        await Changed.InvokeAsync();
    }

    private async Task OnShippingCarrierChangedAsync(int? value)
    {
        if (value == Delivery.ShippingCarrierId)
            return;

        Delivery.ShippingCarrierId = value;

        await Changed.InvokeAsync();
    }
}
