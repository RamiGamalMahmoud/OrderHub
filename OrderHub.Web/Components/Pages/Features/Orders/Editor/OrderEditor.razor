@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Write)]
@page "/orders/create"
@page "/orders/continue/{DraftId:guid}"
@page "/orders/{OrderId:int}/edit"

@using Microsoft.AspNetCore.Authorization
@using OrderHub.Application.Common.Extensions
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.OrderDetails
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.Products
@using OrderHub.Web.Components.Pages.Features.Orders.Workflow
@using OrderHub.Domain.Enums


<PageTitle>@_pageTitle</PageTitle>

<OrderDrafts @bind-IsOpen="_isDraftsOpen" />

@if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else if (IsEdit && !_state.CanEdit)
{
    <MudAlert Severity="Severity.Info">بيانات الطلب مقفولة ولا تقبل التعديل. يمكنك عرض دورة الطلب وسجله من صفحة التفاصيل.</MudAlert>
}

@if (_loadError is null && _state.CanEdit)
{
    <div class="mx-auto w-full max-w-7xl">

        @* Page header *@
        <section class="flex flex-col gap-4 border-b border-slate-200 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">@_pageTitle</h1>
                <p class="mt-1 text-xs text-slate-500">تعبئة بيانات العميل، طرق الشحن والدفع ومراجعة المنتجات</p>
            </div>

            @if (!IsEdit)
            {
                <div class="flex flex-wrap items-center gap-2">
                    <PermissionView Feature="PermissionFeature.Documents" Level="PermissionLevel.Write">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                                   Disabled="@(!CanCreateDraftDocument)"
                                   OnClick="CreateQuotationAsync"
                                   StartIcon="@Icons.Material.Outlined.RequestPage">
                            إنشاء عرض سعر
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                                   Disabled="@(!CanCreateDraftDocument)"
                                   OnClick="CreateProformaInvoiceAsync"
                                   StartIcon="@Icons.Material.Outlined.FactCheck">
                            إنشاء فاتورة أولية
                        </MudButton>
                    </PermissionView>

                    @if (CanShowDrafts)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                                   OnClick="ShowDrafts"
                                   StartIcon="@Icons.Material.Outlined.Description">
                            المسودات
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--primary oh-btn--sm"
                               Disabled="@(!CanSave)"
                               OnClick="SaveAsync">
                        إنشاء الطلب
                    </MudButton>
                </div>
            }
        </section>

        <main class="space-y-5 py-4">

            @* Sub-header: breadcrumbs + order meta + edit CTA *@
            <div class="flex flex-col justify-between gap-4 md:flex-row md:items-center">
                <div class="flex flex-col gap-1.5">
                    <nav aria-label="مسار التنقل"
                         class="flex items-center gap-2 text-xs font-semibold text-slate-500">
                        <a href="/" class="transition-colors hover:text-brand-600">الرئيسية</a>
                        <span>/</span>
                        <a href="/orders" class="transition-colors hover:text-brand-600">الطلبات</a>
                        <span>/</span>
                        <span class="font-bold text-slate-800">@_pageTitle</span>
                    </nav>

                    @if (IsEdit)
                    {
                        <div class="flex flex-wrap items-center gap-3">
                            <h2 class="flex items-center gap-2 text-xl font-black tracking-tight text-slate-900">
                                طلب #@_state.OrderNumber
                                <span class="@OrderWorkflowPresentation.TagBase @OrderWorkflowPresentation.Tag(_state.Status)">
                                    @_state.Status.GetDescription()
                                </span>
                            </h2>

                            @if (ModifiedText is not null)
                            {
                                <span class="text-xs text-slate-500">@ModifiedText</span>
                            }
                        </div>
                    }
                </div>

                @if (IsEdit)
                {
                    <MudButton Variant="Variant.Filled"
                               Class="oh-btn oh-btn--primary"
                               Disabled="@(!CanSave)"
                               OnClick="SaveAsync">
                        حفظ التعديلات
                    </MudButton>
                }
            </div>

            @* Validation banner *@
            @if (ValidationErrors.Count > 0)
            {
                <div class="rounded-xl border border-red-200 bg-red-50 p-3.5" role="alert">
                    <p class="text-xs font-bold text-red-800">يرجى استكمال البيانات التالية:</p>
                    <ul class="mt-1.5 space-y-0.5 text-xs text-red-700">
                        @foreach (var error in ValidationErrors)
                        {
                            <li>• @error</li>
                        }
                    </ul>
                </div>
            }

            @* Last created document *@
            @if (_createdDocumentNumber is not null && _createdDocumentType is { } documentType)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3">
                    <span class="flex items-center gap-2 text-xs font-bold text-emerald-800">
                        <MudIcon Icon="@Icons.Material.Outlined.Description" Class="h-4 w-4" />
                        تم إنشاء @_createdDocumentNumber
                    </span>

                    <MudButton Href="@DocumentFileUrl(documentType, _createdDocumentNumber)"
                               Target="_blank"
                               Size="Size.Small"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Outlined.PictureAsPdf"
                               Class="oh-btn oh-btn--secondary oh-btn--sm">
                        فتح PDF
                    </MudButton>
                </div>
            }

            @* Operational grid *@
            <div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-12">

                <div class="flex flex-col gap-5 lg:col-span-7">
                    <ProductsStep @key="_sessionId"
                                  SessionId="_sessionId"
                                  Items="_state.Items"
                                  ItemsChanged="OnEditorChanged" />

                    @* Financial summary *@
                    <section class="flex flex-col gap-4 rounded-xl bg-white p-4 shadow-sm sm:p-5">
                        <div class="flex items-center justify-between pb-1">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
                                    <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" Size="Size.Small" />
                                </span>
                                <div>
                                    <h3 class="text-base font-bold leading-tight text-slate-900">الحسابات والملخص المالي</h3>
                                    <p class="text-xs text-slate-500">تفاصيل الخصم، تكاليف التوصيل، والضريبة المحتسبة</p>
                                </div>
                            </div>
                            <span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">ZATCA</span>
                        </div>

                        <div class="grid grid-cols-1 gap-3 rounded-lg bg-slate-50 p-3 sm:grid-cols-3">
                            <MudNumericField T="decimal"
                                             Label="تكلفة الشحن والتوصيل"
                                             Min="0"
                                             Immediate="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Value="_state.DeliveryCost"
                                             ValueChanged="@(async value => { _state.DeliveryCost = value; await OnEditorChanged(); })" />

                            <MudSelect T="DiscountType"
                                       Label="نوع الخصم"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       InputClass="text-xs font-bold"
                                       Value="_state.DiscountType"
                                       ValueChanged="@(async value => { _state.DiscountType = value; await OnEditorChanged(); })">
                                <MudSelectItem Value="DiscountType.FixedAmount">مبلغ ثابت (ر.س)</MudSelectItem>
                                <MudSelectItem Value="DiscountType.Percentage">نسبة مئوية (%)</MudSelectItem>
                            </MudSelect>

                            <MudNumericField T="decimal?"
                                             Label="قيمة الخصم"
                                             Min="0"
                                             Max="@(_state.DiscountType == DiscountType.Percentage ? 100 : (decimal?)null)"
                                             Immediate="true"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Value="_state.DiscountValue"
                                             ValueChanged="@(async value => { _state.DiscountValue = value.GetValueOrDefault(); await OnEditorChanged(); })" />
                        </div>

                        @if (CurrentPricing is { } pricing)
                        {
                            <div class="space-y-1 text-xs">
                                <div class="flex items-center justify-between py-1 font-medium text-slate-600">
                                    <span>إجمالي المنتجات قبل الضريبة</span>
                                    <span class="font-mono font-bold text-slate-900">@pricing.Subtotal.ToString("N2") ر.س</span>
                                </div>
                                <div class="flex items-center justify-between py-1 font-medium text-slate-600">
                                    <span>ضريبة القيمة المضافة</span>
                                    <span class="font-mono font-bold text-slate-900">@pricing.TotalVat.ToString("N2") ر.س</span>
                                </div>
                                <div class="flex items-center justify-between py-1 font-semibold text-emerald-600">
                                    <span>الخصم المطبق</span>
                                    <span class="font-mono">- @EditorDiscountAmount(pricing).ToString("N2") ر.س</span>
                                </div>
                                <div class="flex items-center justify-between py-1 font-medium text-slate-600">
                                    <span>رسوم الشحن اللوجستي</span>
                                    <span class="font-mono font-bold text-slate-900">+ @_state.DeliveryCost.ToString("N2") ر.س</span>
                                </div>

                                <div class="mt-2 flex items-center justify-between rounded-lg bg-blue-50/70 p-3.5">
                                    <div>
                                        <span class="block text-xs font-bold text-blue-900">الإجمالي النهائي الشامل للضريبة</span>
                                        <span class="text-[11px] text-blue-600">جاهز للدفع والفوترة الرسمية</span>
                                    </div>
                                    <div class="flex items-baseline gap-1 text-left">
                                        <span class="font-mono text-2xl font-black tracking-tight text-blue-700">@EditorFinalTotal(pricing).ToString("N2")</span>
                                        <span class="text-xs font-extrabold text-blue-800">ر.س</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-xs text-slate-500">أضف منتجًا صالحًا لعرض الإجمالي.</p>
                        }

                        <p class="text-[11px] text-slate-500">سعر الوحدة قبل الضريبة، وتُضاف ضريبة كل منتج إلى إجمالي الطلب.</p>
                    </section>
                </div>

                <div class="flex flex-col gap-5 lg:col-span-5">
                    <DetailsStep @key="_sessionId" State="_state" DetailsChanged="OnEditorChanged" />
                </div>
            </div>
        </main>
    </div>
}
