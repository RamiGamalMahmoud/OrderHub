@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Write)]
@page "/orders/create"
@page "/orders/continue/{DraftId:guid}"
@page "/orders/{OrderId:int}/edit"

@using Microsoft.AspNetCore.Authorization
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.OrderDetails
@using OrderHub.Web.Components.Pages.Features.Orders.Editor.Products
@using OrderHub.Domain.Enums


<PageTitle>@_pageTitle</PageTitle>

<OrderDrafts @bind-IsOpen="_isDraftsOpen" />

<div class="mx-auto w-full max-w-6xl space-y-5">
    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else if (IsEdit && !_state.CanEdit)
    {
        <MudAlert Severity="Severity.Info">بيانات الطلب مقفولة ولا تقبل التعديل. يمكنك عرض دورة الطلب وسجله من صفحة التفاصيل.</MudAlert>
    }

    @if (_loadError is null && _state.CanEdit)
    {
        <MudStack Spacing="4">

            <PageScaffold Title="@_pageTitle" Crumbs="_crumbs">
                <Actions>
                    @if (!IsEdit)
                    {
                        <PermissionView Feature="PermissionFeature.Documents" Level="PermissionLevel.Write">
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@(!CanCreateDraftDocument)"
                                       OnClick="CreateQuotationAsync"
                                       StartIcon="@Icons.Material.Outlined.RequestPage">
                                إنشاء عرض سعر
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@(!CanCreateDraftDocument)"
                                       OnClick="CreateProformaInvoiceAsync"
                                       StartIcon="@Icons.Material.Outlined.FactCheck">
                                إنشاء فاتورة أولية
                            </MudButton>
                        </PermissionView>
                    }

                    @if (CanShowDrafts)
                    {
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Outlined"
                                   OnClick="ShowDrafts"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Description">
                            المسودات
                        </MudButton>
                    }

                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="@(!CanSave)"
                               OnClick="SaveAsync">
                        حفظ
                    </MudButton>
                </Actions>
            </PageScaffold>

            @* Editor *@
            <MudPaper Elevation="0"
                      Class="pa-4 rounded-2xl">

                @* Steps *@
                <div class="mb-5 flex w-fit max-w-full flex-wrap items-center gap-1 rounded-full border border-slate-200 bg-slate-50 p-1">
                    <MudButton Variant="@GetStepVariant(OrderEditorStep.Products)"
                               Color="Color.Primary"
                               Class="rounded-full px-4 font-semibold"
                               StartIcon="@Icons.Material.Outlined.Inventory2"
                               OnClick="@(() => SelectStep(OrderEditorStep.Products))">
                        <span class="inline-flex items-center gap-2">
                            المنتجات
                            <span class="inline-flex min-w-6 items-center justify-center rounded-full bg-white/20 px-2 py-0.5 text-xs font-bold">
                                @_state.Items.Count
                            </span>
                        </span>
                    </MudButton>

                    <MudButton Variant="@GetStepVariant(OrderEditorStep.Details)"
                               Color="Color.Primary"
                               Class="rounded-full px-4 font-semibold"
                               StartIcon="@Icons.Material.Outlined.ReceiptLong"
                               OnClick="@(() => SelectStep(OrderEditorStep.Details))">
                        تفاصيل الطلب
                    </MudButton>
                </div>

                @* Step Content *@
                @if (_activeStep == OrderEditorStep.Products)
                {
                    <ProductsStep @key="_sessionId" SessionId="_sessionId" Items="_state.Items" ItemsChanged="OnEditorChanged" />
                }
                else if (_activeStep == OrderEditorStep.Details)
                {
                    <DetailsStep @key="_sessionId" State="_state" DetailsChanged="OnEditorChanged" />
                }

                <MudPaper Outlined="true" Class="pa-4 mt-5 rounded-2xl border-slate-200">
                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">إجمالي الطلب</MudText>
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Label="تكلفة التوصيل" Min="0" Immediate="true" Value="_state.DeliveryCost" ValueChanged="@(async value => { _state.DeliveryCost = value; await OnEditorChanged(); })" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="DiscountType" Label="نوع الخصم" Value="_state.DiscountType" ValueChanged="@(async value => { _state.DiscountType = value; await OnEditorChanged(); })">
                                <MudSelectItem Value="DiscountType.FixedAmount">مبلغ ثابت</MudSelectItem>
                                <MudSelectItem Value="DiscountType.Percentage">نسبة مئوية</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?" Label="@(_state.DiscountType == DiscountType.Percentage ? "الخصم من المنتجات قبل الضريبة (%)" : "قيمة الخصم")" Min="0" Max="@(_state.DiscountType == DiscountType.Percentage ? 100 : (decimal?)null)" Immediate="true" Value="_state.DiscountValue" ValueChanged="@(async value => { _state.DiscountValue = value.GetValueOrDefault(); await OnEditorChanged(); })" />
                        </MudItem>
                    </MudGrid>
                    @if (CurrentPricing is { } pricing)
                    {
                        <MudGrid Class="mt-1">
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">قيمة المنتجات قبل الضريبة</MudText>
                                <MudText Typo="Typo.body1">@pricing.Subtotal.ToString("N2") ر.س</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">إجمالي الضريبة</MudText>
                                <MudText Typo="Typo.body1">@pricing.TotalVat.ToString("N2") ر.س</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudText Typo="Typo.caption">إجمالي المنتجات شامل الضريبة</MudText>
                                <MudText Typo="Typo.body1">@pricing.TotalAmount.ToString("N2") ر.س</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">الخصم</MudText><MudText Typo="Typo.body1">@EditorDiscountAmount(pricing).ToString("N2") ر.س</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">تكلفة التوصيل</MudText><MudText Typo="Typo.body1">@_state.DeliveryCost.ToString("N2") ر.س</MudText></MudItem>
                            <MudItem xs="12" sm="4"><MudText Typo="Typo.caption">الإجمالي النهائي</MudText><MudText Typo="Typo.h6" Color="Color.Primary">@EditorFinalTotal(pricing).ToString("N2") ر.س</MudText></MudItem>
                        </MudGrid>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">أضف منتجًا صالحًا لعرض الإجمالي.</MudText>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">سعر الوحدة قبل الضريبة، وتُضاف ضريبة كل منتج إلى إجمالي الطلب.</MudText>
                </MudPaper>

                @if (!IsEdit)
                {
                    <PermissionView Feature="PermissionFeature.Documents" Level="PermissionLevel.Write">
                        <MudPaper Outlined="true" Class="pa-4 mt-4 rounded-2xl border-slate-200">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">وثائق الطلب</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                تُنشأ من بيانات المسودة الحالية، ويمكن إصدار نسخة جديدة برقم جديد في كل مرة.
                            </MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Outlined" Disabled="@(!CanCreateDraftDocument)"
                                           OnClick="CreateQuotationAsync" StartIcon="@Icons.Material.Outlined.RequestPage">
                                    إنشاء عرض سعر
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Disabled="@(!CanCreateDraftDocument)"
                                           OnClick="CreateProformaInvoiceAsync" StartIcon="@Icons.Material.Outlined.FactCheck">
                                    إنشاء فاتورة أولية
                                </MudButton>
                            </MudStack>
                            @if (_createdDocumentNumber is not null && _createdDocumentType is { } documentType)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                                    <MudText Typo="Typo.body2">تم إنشاء @_createdDocumentNumber</MudText>
                                    <MudButton Href="@DocumentFileUrl(documentType, _createdDocumentNumber)" Target="_blank"
                                               Size="Size.Small" StartIcon="@Icons.Material.Outlined.PictureAsPdf">
                                        فتح PDF
                                    </MudButton>
                                </MudStack>
                            }
                        </MudPaper>
                    </PermissionView>
                }

            </MudPaper>

            @if (ValidationErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error"
                          Variant="Variant.Outlined">

                    <MudStack Spacing="1">

                        <MudText Typo="Typo.subtitle2">
                            يرجى استكمال البيانات التالية:
                        </MudText>

                        @foreach (var error in ValidationErrors)
                        {
                            <MudText Typo="Typo.body2">
                                • @error
                            </MudText>
                        }

                    </MudStack>

                </MudAlert>
            }

        </MudStack>
    }

            <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               Size="Size.Large"
               Class="rounded-xl font-bold shadow-sm"
               Disabled="@(!CanSave)"
               OnClick="SaveAsync">
        @(IsEdit ? "حفظ التعديلات" : "إنشاء الطلب")
    </MudButton>

</div>
