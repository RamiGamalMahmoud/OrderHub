@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Read)]
@using System.Globalization
@using OrderHub.Application.Features.Orders.GetPage
@using OrderHub.Application.Features.Setup.PaymentMethods.Contracts
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using OrderHub.Domain.Enums
@using OrderHub.Application.Common.Lookups
@using OrderHub.Application.Common.Extensions
@using OrderHub.Web.Components.Pages.Features.Orders.Workflow

@page "/orders"
@page "/orders/archived"

<PageTitle>@(_archivedOnly ? "سجل الطلبات المؤرشفة" : "الطلبات")</PageTitle>

<OrderDrafts @bind-IsOpen="@_isDraftsOpen" />

<div class="space-y-5">
    <PageScaffold Title="@(_archivedOnly ? "سجل الطلبات المؤرشفة" : "الطلبات")"
                  Description="@(_archivedOnly ? "البيانات والتاريخ محفوظان للقراءة فقط؛ لا توجد استعادة." : "متابعة وإدارة طلبات العملاء")"
                  Crumbs="_crumbs"
                  Count="@_totalItems">
        <Actions>
            <MudButton Href="@(_archivedOnly ? "/orders" : "/orders/archived")"
                       Variant="Variant.Text"
                       StartIcon="@(_archivedOnly ? Icons.Material.Filled.ListAlt : Icons.Material.Filled.Inventory2)"
                       Class="oh-btn oh-btn--secondary oh-btn--sm">
                @(_archivedOnly ? "الطلبات الحالية" : "سجل المؤرشف")
            </MudButton>
        </Actions>
    </PageScaffold>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        @* ============================================================
           Toolbar: search + payment filter + drafts + create/refresh
           ============================================================ *@
        <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 px-4 py-3">
            <MudTextField T="string"
                          Value="_searchTerm"
                          ValueChanged="OnSearchChanged"
                          Placeholder="ابحث برقم الطلب أو اسم العميل..."
                          aria-label="البحث في الطلبات"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Class="w-full sm:max-w-xs" />

            <MudSelect T="int?"
                       Value="_selectedPaymentMethodId"
                       ValueChanged="OnPaymentChanged"
                       Label="وسيلة الدفع"
                       aria-label="تصفية حسب وسيلة الدفع"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Class="w-full sm:w-52">
                @foreach (var paymentMethod in _paymentMethods)
                {
                    <MudSelectItem T="int?" Value="@paymentMethod!.Id">
                        @paymentMethod!.DisplayName
                    </MudSelectItem>
                }
            </MudSelect>

            <div class="flex-1"></div>

            <MudButton OnClick="ShowDrafts"
                       Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.Description"
                       Class="oh-btn oh-btn--secondary oh-btn--sm">
                الطلبات المعلقة
            </MudButton>

            @if (!_archivedOnly)
            {
                <CreateOrderButton

                Class="oh-btn oh-btn--primary oh-btn--sm" />
            }

            <MudTooltip Text="تحديث القائمة">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshAsync"
                               aria-label="تحديث القائمة"
                               Class="oh-btn oh-btn--icon oh-btn--secondary oh-btn--sm" />
            </MudTooltip>
        </div>

        @* ============================================================
           Status filter chips (server-side OrderStatus filter)
           ============================================================ *@
        <div class="flex flex-wrap items-center gap-2 border-b border-slate-100 px-4 py-3"
             role="group"
             aria-label="تصفية حسب حالة الطلب">
            <button type="button"
                    class="@StatusChipClass(null)"
                    aria-pressed="@(_selectedStatus is null)"
                    @onclick="() => OnStatusChipAsync(null)">الكل</button>
            @foreach (var item in _enumItems)
            {
                var status = item.Value;
                <button type="button"
                        class="@StatusChipClass(status)"
                        aria-pressed="@(_selectedStatus == status)"
                        @onclick="() => OnStatusChipAsync(status)">@item.DisplayName</button>
            }
        </div>

        @* ============================================================
           Orders table
           ============================================================ *@
        <MudTable T="OrderListItem"
                  @ref="_table"
                  ServerData="LoadOrdersAsync"
                  RowsPerPage="@_pageSize"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Square="true"
                  Breakpoint="Breakpoint.Sm">

            <HeaderContent>
                <MudTh Class="text-xs font-bold text-slate-500">رقم الطلب</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">العميل</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الهاتف</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">المنتجات</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الإجمالي</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">طريقة الدفع</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الحالة</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">التوصيل</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">التاريخ</MudTh>
                <MudTh Class="w-24 text-xs font-bold text-slate-500">
                    <span class="sr-only">إجراءات</span>
                </MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="رقم الطلب">
                    <span class="font-mono text-xs font-bold text-slate-900" dir="ltr">@context.OrderNumber</span>
                </MudTd>

                <MudTd DataLabel="العميل" Class="text-sm text-slate-700">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </span>
                        <span class="font-bold text-slate-900">@context.ClientName</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="الهاتف">
                    <span class="tabular-nums text-xs text-slate-600" dir="ltr">@context.ClientPhoneNumber</span>
                </MudTd>

                <MudTd DataLabel="المنتجات" Class="text-sm text-slate-700">
                    @context.ItemsCount.ToString(CultureInfo.InvariantCulture)
                </MudTd>

                <MudTd DataLabel="الإجمالي">
                    <span class="tabular-nums text-sm font-bold text-slate-900" dir="ltr">@context.Total.ToString("N2", CultureInfo.InvariantCulture)</span>
                </MudTd>

                <MudTd DataLabel="طريقة الدفع" Class="text-sm text-slate-700">
                    @(context.PaymentMethod?.DisplayName ?? "غير محددة")
                </MudTd>

                <MudTd DataLabel="الحالة">
                    <div class="flex flex-wrap gap-1.5">
                        <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(context.OrderStatus)}")">@context.EnumItem.DisplayName</span>
                        @if (context.IsArchived)
                        {
                            <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">مؤرشف</span>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="التوصيل" Class="text-sm text-slate-700">
                    @(context.DeliveryMethod.HasValue ? context.DeliveryMethod.Value.GetDescription() : "غير محددة")
                </MudTd>

                <MudTd DataLabel="التاريخ" Class="text-xs text-slate-600">
                    <UserLocalTime Value="context.CreatedAt" />
                </MudTd>

                <MudTd DataLabel="إجراءات">
                    <div class="flex items-center gap-1.5">
                        <MudTooltip Text="تفاصيل الطلب">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Class="@($"oh-btn oh-btn--icon oh-btn--sm {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                                           Size="Size.Small"
                                           Href="@($"/orders/{context.Id}")"
                                           aria-label="تفاصيل الطلب" />
                        </MudTooltip>

                        <MudTooltip Text="دورة الطلب">
                            <MudIconButton Icon="@Icons.Material.Filled.Timeline"
                                           Class="@($"oh-btn oh-btn--icon oh-btn--sm {OrderWorkflowPresentation.Action("delivery")}")"
                                           Size="Size.Small"
                                           Href="@($"/orders/{context.Id}/workflow")"
                                           aria-label="دورة الطلب" />
                        </MudTooltip>

                        @if (!context.IsArchived && context.OrderStatus == OrderStatus.Processing)
                        {
                            <PermissionView Feature="PermissionFeature.Orders" Level="PermissionLevel.Write">
                                <MudTooltip Text="تعديل الطلب">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Class="@($"oh-btn oh-btn--icon oh-btn--sm {OrderWorkflowPresentation.Action("processing")}")"
                                                   Size="Size.Small"
                                                   Href="@($"/orders/{context.Id}/edit")"
                                                   aria-label="تعديل الطلب" />
                                </MudTooltip>
                            </PermissionView>
                        }
                    </div>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="py-8 text-center">
                    <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" aria-hidden="true" />
                    </span>
                    <p class="text-base font-bold text-slate-900">
                        @(HasFilters ? "لا توجد نتائج مطابقة" : _archivedOnly ? "لا توجد طلبات مؤرشفة." : "لا توجد طلبات.")
                    </p>
                    <p class="mt-1 text-sm text-slate-500">
                        @(HasFilters ? "جرّب تعديل البحث أو التصفية للحصول على نتائج."
                            : _archivedOnly ? "ستظهر الطلبات هنا بعد أرشفتها."
                            : "أنشئ طلبًا جديدًا ليظهر في القائمة.")
                    </p>
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="flex flex-col items-center gap-2 py-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <p class="text-sm text-slate-500">جاري تحميل الطلبات...</p>
                </div>
            </LoadingContent>

            <PagerContent>
                <TableFooter TotalItems="@(_totalItems ?? 0)"
                             CurrentPage="_pageIndex"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="_pageSize"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>
        </MudTable>
    </section>
</div>
