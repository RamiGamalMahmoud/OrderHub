@using System.Globalization
@using OrderHub.Application.Features.Documents.GetDocuments
@using OrderHub.Application.Features.Documents.Invoices
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Enums
@using OrderHub.Web.Components.Pages.Features.Orders.Workflow
@inject IRequestExecutor RequestExecutor
@inject PermissionAccess Permissions
@inject ILogger<OrderInvoiceSection> Logger

<section class="flex flex-col justify-between rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5" aria-label="الفاتورة الإلكترونية">
    <div>
        <header class="@OrderWorkflowPresentation.CardHeader">
            <div class="flex items-center gap-2.5">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-emerald-100 bg-emerald-50 text-emerald-600">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Class="text-[18px]" />
                </span>
                <div>
                    <h2 class="text-sm font-bold text-slate-800">الفاتورة الضريبية</h2>
                    <p class="text-[11px] text-slate-600">المستند المرتبط بهذا الطلب</p>
                </div>
            </div>
            @if (_invoice is not null)
            {
                <span class="rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 font-mono text-[11px] font-bold text-emerald-700" dir="ltr">
                    @_invoice.DocumentNumber
                </span>
            }
        </header>

        @if (_loading)
        {
            <div class="py-2">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="تحميل الفاتورة" />
                <p class="mt-2 text-[11px] text-slate-500">جاري تحميل بيانات الفاتورة...</p>
            </div>
        }
        else if (_error is not null)
        {
            <div class="space-y-2">
                <div class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-[11px] font-bold text-rose-800">@_error</div>
                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm oh-btn--block"
                        disabled="@_busy"
                        @onclick="LoadAsync">إعادة المحاولة</button>
            </div>
        }
        else if (_invoice is null)
        {
            <div class="flex items-start gap-2.5 rounded-lg border border-slate-200 bg-slate-50/70 p-3">
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <p class="text-xs font-bold text-slate-700">لم تصدر فاتورة لهذا الطلب بعد.</p>
                    <p class="mt-0.5 text-[11px] leading-5 text-slate-500">أنشئ الفاتورة لإتاحة ملف PDF للطباعة أو المشاركة.</p>
                </div>
            </div>
        }
        else
        {
            <dl class="space-y-1.5 text-[11px]">
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">حالة الفوترة</dt>
                    <dd class="flex items-center gap-1 font-bold text-emerald-600">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        صادرة
                    </dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">تاريخ الإصدار</dt>
                    <dd class="font-bold text-slate-800"><UserLocalTime Value="_invoice.IssueDate" /></dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">طريقة الدفع</dt>
                    <dd class="font-bold text-slate-800">@(string.IsNullOrWhiteSpace(PaymentMethod) ? "غير محددة" : PaymentMethod)</dd>
                </div>
                <div class="flex items-center justify-between">
                    <dt class="text-slate-500">قيمة الفاتورة</dt>
                    <dd class="font-mono font-bold text-slate-800">@_invoice.TotalAmount.ToString("N2", CultureInfo.InvariantCulture) ر.س</dd>
                </div>
            </dl>
        }
    </div>

    @if (_invoice is not null || (!_loading && _error is null && _canWrite))
    {
        <div class="mt-3 border-t border-slate-100 pt-3">
            @if (_invoice is not null)
            {
                <div class="flex flex-col gap-1.5">
                    <a href="@InvoiceFileUrl"
                       target="_blank"
                       class="oh-btn oh-btn--secondary oh-btn--sm oh-btn--block">
                        <MudIcon Icon="@Icons.Material.Outlined.Download" Class="text-[16px]" />
                        <span>تنزيل الفاتورة (PDF)</span>
                    </a>
                    @if (_canWrite)
                    {
                        <button type="button"
                                class="oh-btn oh-btn--secondary oh-btn--sm oh-btn--block"
                                disabled="@_busy"
                                @onclick="CreateOrRegenerateAsync">
                            @(_busy ? "جارٍ التوليد..." : "إعادة توليد الفاتورة")
                        </button>
                    }
                </div>
            }
            else if (!_loading && _error is null && _canWrite)
            {
                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm oh-btn--block"
                        disabled="@_busy"
                        @onclick="CreateOrRegenerateAsync">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="text-[16px]" />
                    <span>@(_busy ? "جارٍ الإنشاء..." : "إصدار الفاتورة")</span>
                </button>
            }
        </div>
    }
</section>

@code {
    [Parameter] public int OrderId { get; set; }
    [Parameter] public string? PaymentMethod { get; set; }

    private DocumentListItem? _invoice;
    private bool _loading;
    private bool _busy;
    private bool _canWrite;
    private string? _error;
    private int _loadedOrderId;
    private string? InvoiceFileUrl => _invoice is null
        ? null
        : $"/files/invoices/{Uri.EscapeDataString(_invoice.DocumentNumber)}.pdf";

    protected override Task OnParametersSetAsync() => _loadedOrderId == OrderId
        ? Task.CompletedTask
        : LoadAsync();

    private async Task LoadAsync()
    {
        _loadedOrderId = OrderId;
        _loading = true;
        _error = null;
        _canWrite = false;
        try
        {
            var page = await RequestExecutor.ExecuteAsync(new GetDocumentsPageQuery(
                DocumentType.Invoice, PageSize: 1, OrderId: OrderId));
            var canWrite = await Permissions.IsAllowedAsync(PermissionFeature.Documents, PermissionLevel.Write);
            _invoice = page.Items.FirstOrDefault();
            _canWrite = canWrite;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load invoice for order {OrderId}.", OrderId);
            _error = "تعذر تحميل بيانات الفاتورة.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateOrRegenerateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            await RequestExecutor.ExecuteAsync(new CreateInvoiceCommand.Command(OrderId));
            await LoadAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to create invoice for order {OrderId}.", OrderId);
            _error = "تعذر إنشاء الفاتورة. حاول مرة أخرى.";
        }
        finally
        {
            _busy = false;
        }
    }
}
