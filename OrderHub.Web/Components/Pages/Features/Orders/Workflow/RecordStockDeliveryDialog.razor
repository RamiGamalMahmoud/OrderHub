@using System.Globalization
@using Microsoft.Extensions.Logging
@using MudBlazor
@using OrderHub.Application.Features.Inventory.Deliveries.Contracts
@using OrderHub.Application.Features.Inventory.Deliveries.RecordStockDelivery
@using OrderHub.Application.Interfaces

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">تسجيل تسليم مخزني</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">@OrderLabel — @Row.ProductName · @Row.WarehouseName</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-2.5">
                <p class="text-[11px] font-semibold text-slate-500">
                    المصروف: @Row.IssuedQty.ToString(CultureInfo.InvariantCulture)
                    · المسلَّم: @Row.DeliveredQty.ToString(CultureInfo.InvariantCulture)
                    · المتبقي: @Row.RemainingQty.ToString(CultureInfo.InvariantCulture)
                </p>
            </div>

            <MudNumericField T="int"
                             @bind-Value="_quantity"
                             Label="كمية التسليم"
                             Immediate="true"
                             Min="0"
                             Max="@Row.RemainingQty"
                             Variant="Variant.Outlined"
                             Disabled="_submitting"
                             Class="w-full" />

            @if (Trips.Count > 0)
            {
                <MudSelect T="int?"
                           Value="_tripId"
                           Label="المشوار (اختياري)"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Disabled="_submitting"
                           Class="w-full"
                           ValueChanged="@(value => OnTripChanged(value))">
                    @foreach (var trip in Trips)
                    {
                        <MudSelectItem T="int?" Value="@trip.Id">@LinkLabel("مشوار", trip)</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (Shipments.Count > 0)
            {
                <MudSelect T="int?"
                           Value="_shipmentId"
                           Label="الشحنة (اختياري)"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Disabled="_submitting"
                           Class="w-full"
                           ValueChanged="@(value => OnShipmentChanged(value))">
                    @foreach (var shipment in Shipments)
                    {
                        <MudSelectItem T="int?" Value="@shipment.Id">@LinkLabel("شحنة", shipment)</MudSelectItem>
                    }
                </MudSelect>
            }

            <p class="text-[11px] text-slate-500">
                بدون ربط مشوار أو شحنة يُسجَّل التسليم مباشرة على الطلب. لا يمكن أن يتجاوز التسليم الكمية المصروفة المتبقية.
            </p>

            <MudTextField T="string"
                          @bind-Value="_note"
                          Label="ملاحظة (اختياري)"
                          Immediate="true"
                          MaxLength="200"
                          HelperText="@NoteCounter"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Disabled="_submitting"
                          Class="w-full" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Disabled="@(!CanSubmit)"
                       Class="oh-btn oh-btn--primary"
                       OnClick="SubmitAsync">@(_submitting ? "جاري التسجيل…" : "تسجيل التسليم")</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<RecordStockDeliveryDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public int OrderId { get; set; }
    [Parameter, EditorRequired] public string OrderLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public OrderDeliveryRow Row { get; set; } = null!;
    [Parameter] public IReadOnlyList<DeliveryLinkOption> Trips { get; set; } = [];
    [Parameter] public IReadOnlyList<DeliveryLinkOption> Shipments { get; set; } = [];

    private int _quantity;
    private int? _tripId;
    private int? _shipmentId;
    private string? _note;
    private string? _error;
    private bool _submitting;

    protected override void OnInitialized() => _quantity = Row.RemainingQty;

    private string NoteCounter => $"{(_note?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    private bool CanSubmit => !_submitting && _quantity > 0 && _quantity <= Row.RemainingQty;

    private static string LinkLabel(string kind, DeliveryLinkOption option) =>
        $"{kind} {option.Number.ToString("D5", CultureInfo.InvariantCulture)}/{option.SequenceMonth.ToString("D2", CultureInfo.InvariantCulture)}/{option.SequenceYear.ToString(CultureInfo.InvariantCulture)}";

    private void OnTripChanged(int? value)
    {
        _tripId = value;
        if (value.HasValue)
            _shipmentId = null;
    }

    private void OnShipmentChanged(int? value)
    {
        _shipmentId = value;
        if (value.HasValue)
            _tripId = null;
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(new RecordStockDeliveryCommand(
                OrderId,
                Row.AllocationId,
                _quantity,
                _tripId,
                _shipmentId,
                Note: string.IsNullOrWhiteSpace(_note) ? null : _note.Trim()));

            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                if (result.ErrorCode == "Conflict")
                    Dialog.Close(DialogResult.Ok(false));
                return;
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to record stock delivery for order {OrderId}", OrderId);
            _error = "تعذر تسجيل التسليم. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
