@page "/orders/{Id:int}/workflow"
@attribute [PermissionAuthorize(PermissionFeature.Orders, PermissionLevel.Read)]
@using System.Globalization
@using OrderHub.Application.Features.Orders.Lifecycle
@using OrderHub.Application.Features.Orders.Archive
@using OrderHub.Application.Features.Orders.Reassignment
@using OrderHub.Domain.Common
@using OrderHub.Domain.Models
@using OrderHub.Application.Interfaces
@using OrderHub.Application.Common.Extensions
@using OrderHub.Web.Services
@implements IDisposable
@inject IRequestExecutor Executor
@inject PermissionAccess Permissions
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ILogger<OrderWorkflow> Logger

<PageTitle>دورة الطلب</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل دورة الطلب" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل دورة الطلب...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <button type="button"
                    class="@($"oh-btn oh-btn--sm mt-3 {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                    @onclick="LoadAsync">إعادة المحاولة</button>
        </div>
    }
    else if (_state is null)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <p class="text-xs font-bold text-slate-700">الطلب غير موجود.</p>
            <a href="/orders" class="oh-btn oh-btn--secondary oh-btn--sm mt-3">العودة إلى الطلبات</a>
        </div>
    }
    else
    {
        var completedSteps = _state.CompletedActiveStepCount;
        var totalSteps = _state.ActiveStepCount;
        var stepsPercent = totalSteps == 0 ? 0 : (int)Math.Round(completedSteps * 100.0 / totalSteps);
        var attention = _state.Status == OrderStatus.DeliveryFailed;

        <PageScaffold Title="دورة الطلب"
                      Description="@_state.OrderNumber"
                      Crumbs="_crumbs">
            <Actions>
                <MudButton Href="@($"/orders/{Id}")" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">تفاصيل الطلب</MudButton>
                <MudButton Disabled="_busy" OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary" Class="oh-btn oh-btn--primary oh-btn--sm">تحديث</MudButton>
            </Actions>
        </PageScaffold>

        @* ============================================================
           Overview: tags + stage strip + compact stat strip
           ============================================================ *@
        <section class="@OrderWorkflowPresentation.Card">
            <header class="@OrderWorkflowPresentation.CardHeader">
                <div class="flex items-center gap-2.5">
                    <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile(OrderWorkflowPresentation.StatusTone(_state.Status))}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Timeline" Class="text-[18px]" />
                    </span>
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">ملخص التنفيذ</h2>
                        <p class="text-[11px] text-slate-600">الحالة الحالية والمراحل التشغيلية للطلب</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(_state.Status)}")">@_state.Status.GetDescription()</span>
                    <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">
                        @(_state.Method.HasValue ? _state.Method.Value.GetDescription() : "طريقة التوصيل غير محددة")
                    </span>
                    @if (_state.IsArchived)
                    {
                        <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">مؤرشف — للقراءة فقط</span>
                    }
                </div>
            </header>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11px] text-slate-500">
                <span>جهة التنفيذ: <strong class="font-bold text-slate-700">@(_state.HandlerName ?? "غير محددة")</strong></span>
                <span aria-hidden="true" class="text-slate-300">•</span>
                <span>آخر حدث تشغيلي: <strong class="font-bold text-slate-700"><UserLocalTime Value="_state.LastChangedAtUtc" /></strong></span>
            </div>

            <div class="mt-3">
                <OrderStageStrip State="_state" />
            </div>

            @if (_state.IsLegacy)
            {
                <p class="mt-2 text-[11px] font-medium text-amber-700">آخر حالة ناتجة عن ترحيل بيانات قديمة؛ التوقيت لا يثبت وقت التنفيذ الفعلي.</p>
            }

            <div class="@($"mt-4 grid grid-cols-2 gap-2 {(totalSteps > 0 ? "lg:grid-cols-4" : "sm:grid-cols-3")}")">
                <div class="@OrderWorkflowPresentation.StatTile">
                    <p class="text-[10px] font-bold text-slate-500">آخر تحديث</p>
                    <p class="mt-0.5 text-xs font-bold text-slate-800"><UserLocalTime Value="_state.LastChangedAtUtc" /></p>
                </div>
                <div class="@OrderWorkflowPresentation.StatTile">
                    <p class="text-[10px] font-bold text-slate-500">المدة التشغيلية</p>
                    <p class="mt-0.5 text-xs font-bold text-slate-800">@OrderWorkflowPresentation.DurationLabel(_state.CreatedAt, _state.LastChangedAtUtc)</p>
                </div>
                <div class="@OrderWorkflowPresentation.StatTile">
                    <p class="text-[10px] font-bold text-slate-500">تاريخ الإنشاء</p>
                    <p class="mt-0.5 text-xs font-bold text-slate-800"><UserLocalTime Value="_state.CreatedAt" /></p>
                </div>
                @if (totalSteps > 0)
                {
                    <div class="@OrderWorkflowPresentation.StatTile">
                        <p class="text-[10px] font-bold text-slate-500">الخطوات المكتملة</p>
                        <p class="mt-0.5 text-xs font-bold text-slate-800">
                            @completedSteps.ToString(CultureInfo.InvariantCulture)
                            <span class="font-medium text-slate-400">/ @totalSteps.ToString(CultureInfo.InvariantCulture)</span>
                        </p>
                        <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-slate-200">
                            <div class="h-full rounded-full bg-emerald-500" style="@($"width:{stepsPercent.ToString(CultureInfo.InvariantCulture)}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </section>

        @* ============================================================
           Required now
           ============================================================ *@
        <section class="@OrderWorkflowPresentation.Card">
            <header class="@OrderWorkflowPresentation.CardHeader">
                <div class="flex items-center gap-2.5">
                    <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile(attention ? "failed" : OrderWorkflowPresentation.Neutral)}")">
                        <MudIcon Icon="@(attention ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.PlayCircleOutline)" Class="text-[18px]" />
                    </span>
                    <div>
                        <h2 class="text-sm font-bold text-slate-800">المطلوب الآن</h2>
                        <p class="text-[11px] text-slate-600">الخطوة التالية المتاحة لهذا الطلب</p>
                    </div>
                </div>
                @if (!_canWrite)
                {
                    <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">قراءة فقط</span>
                }
            </header>

            <p class="text-xs leading-6 text-slate-600">
                @(_state.IsArchived ? "الطلب مؤرشف؛ بياناته وسجله محفوظان، ولا يمكن تعديله أو تشغيله أو استعادته." : OrderWorkflowPresentation.Instruction(_state.Status, _state.Method))
            </p>
            @if (_state.CanEdit && _state.ReadinessError is not null)
            {
                <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800">لا يمكن بدء التوصيل: @_state.ReadinessError</div>
            }
            @if (!_state.CanEdit && !_state.IsArchived && _state.Status is not (OrderStatus.Delivered or OrderStatus.Cancelled))
            {
                <p class="mt-1.5 text-[11px] text-slate-500">بيانات الطلب مقفولة لأن التنفيذ بدأ. العمليات المتاحة أدناه تظل مسموحة.</p>
            }
            @if (_state.Status == OrderStatus.DeliveryFailed)
            {
                <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800">سبب التعذر: @_state.LatestReason</div>
            }

            @if (_canWrite && !_state.IsArchived)
            {
                <div class="mt-3 flex flex-wrap items-center gap-1.5">
                    @if (_state.CanEdit)
                    {
                        <MudButton Href="@($"/orders/{Id}/edit")" Disabled="_busy" Size="Size.Small"
                                   Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")">تعديل بيانات الطلب</MudButton>
                    }
                    @foreach (var target in _state.AllowedStatuses.Where(status => status != OrderStatus.Cancelled))
                    {
                        <MudButton Size="Size.Small" Disabled="_busy"
                                   Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action(target)}")"
                                   OnClick="@(() => ChangeStatusAsync(target))">@OrderWorkflowPresentation.ActionLabel(target, _state.Status)</MudButton>
                    }
                    @if (_state.CanDeliverDirectly)
                    {
                        <MudButton Size="Size.Small" Disabled="_busy"
                                   Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action("completed")}")"
                                   OnClick="DeliverDirectlyAsync">تأكيد التسليم المباشر</MudButton>
                    }
                    @if (_state.AllowedStatuses.Contains(OrderStatus.Cancelled) || _state.CanArchive || _state.CanReassignDirectly)
                    {
                        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                            <ActivatorContent>
                                <button type="button"
                                        class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                                        disabled="@_busy"
                                        @onclick="@context.ToggleAsync">
                                    إجراءات أخرى
                                    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
                                </button>
                            </ActivatorContent>
                            <ChildContent>
                                @if (_state.CanReassignDirectly)
                                {
                                    <MudMenuItem OnClick="ReassignDirectlyAsync">إلغاء التكليف وإعادة التوجيه</MudMenuItem>
                                }
                                @if (_state.AllowedStatuses.Contains(OrderStatus.Cancelled))
                                {
                                    <MudMenuItem OnClick="@(() => ChangeStatusAsync(OrderStatus.Cancelled))">إلغاء الطلب</MudMenuItem>
                                }
                                @if (_state.CanArchive)
                                {
                                    <MudMenuItem OnClick="ArchiveAsync">أرشفة الطلب</MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Disabled="true">يجب إلغاء الطلب النشط قبل أرشفته</MudMenuItem>
                                }
                            </ChildContent>
                        </MudMenu>
                    }
                </div>
            }
        </section>

        @* ============================================================
           Delivery steps
           ============================================================ *@
        @if (_state.Steps.Count > 0 || _state.Method == DeliveryMethod.DeliveryChain)
        {
            <section class="space-y-2">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <h2 class="text-sm font-bold text-slate-900">خطوات التوصيل</h2>
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-bold text-slate-600">
                            @completedSteps.ToString(CultureInfo.InvariantCulture) من @totalSteps.ToString(CultureInfo.InvariantCulture) مكتملة
                        </span>
                    </div>
                </div>

                @if (_state.Steps.Count == 0)
                {
                    <div class="rounded-lg border border-brand-200 bg-brand-50 px-3 py-2 text-[11px] font-bold text-brand-700">لم تتم إضافة خطوات. أكمل خطة التوصيل قبل بدء السلسلة.</div>
                }
                @if (_state.Status == OrderStatus.Delivered && completedSteps != totalSteps)
                {
                    <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-[11px] text-slate-600">تم تسليم الطلب مع خطوات غير مكتملة. حالاتها محفوظة، وأُغلق تنفيذها مع تسليم الطلب.</div>
                }

                @foreach (var step in _state.Steps)
                {
                    var stepTone = step.IsSuperseded ? OrderWorkflowPresentation.Neutral : OrderWorkflowPresentation.StatusTone(step.Status);
                    <article class="@($"rounded-xl border border-slate-200/90 border-s-4 bg-white p-3.5 shadow-xs {OrderWorkflowPresentation.Accent(stepTone)} {(!step.IsSuperseded ? "" : "opacity-90")}")" @key="step.Id">
                        <header class="flex flex-wrap items-center gap-2.5">
                            <span class="@($"{OrderWorkflowPresentation.IconTileBase} {OrderWorkflowPresentation.IconTile(stepTone)}")">
                                <MudIcon Icon="@(step.Status == DeliveryStatus.Completed ? Icons.Material.Filled.CheckCircle : step.Status == DeliveryStatus.Failed ? Icons.Material.Filled.Warning : step.IsSuperseded ? Icons.Material.Filled.CallSplit : step.AllowedStatuses.Count == 0 ? Icons.Material.Filled.Lock : Icons.Material.Filled.LocalShipping)" Class="text-[18px]" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-slate-800">الخطوة @step.EffectiveRank.ToString(CultureInfo.InvariantCulture) — @step.Method.GetDescription()</p>
                                <p class="mt-0.5 text-[11px] text-slate-500">@(step.HandlerName ?? "جهة التنفيذ غير متوفرة")</p>
                            </div>
                            @if (step.IsSuperseded)
                            {
                                <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(OrderWorkflowPresentation.Neutral)}")">ملغاة / مُعاد توجيهها</span>
                            }
                            else
                            {
                                <span class="@($"{OrderWorkflowPresentation.TagBase} {OrderWorkflowPresentation.Tag(step.Status)}")">@step.Status.GetDescription()</span>
                            }
                        </header>

                        @if (step.BlockingReason is not null)
                        {
                            <div class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-[11px] text-slate-600">بانتظار: @step.BlockingReason</div>
                        }
                        @if (step.Status is DeliveryStatus.Failed or DeliveryStatus.Cancelled && step.LatestReason is not null)
                        {
                            <div class="mt-2 rounded-lg border border-amber-100 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold text-amber-800">السبب: @step.LatestReason</div>
                        }
                        @if (step.IsLegacy)
                        {
                            <p class="mt-1.5 text-[11px] text-amber-700">الحالة ناتجة عن ترحيل بيانات قديمة.</p>
                        }
                        @if (step.LastChangedAtUtc.HasValue)
                        {
                            <p class="mt-1.5 text-[11px] text-slate-500">
                                <UserLocalTime Value="step.LastChangedAtUtc" />
                                @(!string.IsNullOrWhiteSpace(step.LastChangedBy) ? $"— سجّلها {step.LastChangedBy}" : "")
                            </p>
                        }

                        @if (_canWrite && (step.AllowedStatuses.Count > 0 || step.CanReassign || step.CanCancel))
                        {
                            <div class="mt-2.5 flex flex-wrap gap-1.5">
                                @foreach (var target in step.AllowedStatuses)
                                {
                                    <MudButton Size="Size.Small" Disabled="_busy"
                                               Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action(target)}")"
                                               OnClick="@(() => ChangeStepAsync(step, target))">@OrderWorkflowPresentation.StepActionLabel(target, step.Status)</MudButton>
                                }
                                @if (step.CanCancel)
                                {
                                    <MudButton Size="Size.Small" Disabled="_busy"
                                               Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action("cancelled")}")"
                                               OnClick="@(() => CancelStepAsync(step))">إلغاء الخطوة</MudButton>
                                }
                                @if (step.CanReassign)
                                {
                                    <MudButton Size="Size.Small" Disabled="_busy"
                                               Class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action("processing")}")"
                                               OnClick="@(() => ReassignStepAsync(step))">إلغاء التكليف وإعادة التوجيه</MudButton>
                                }
                            </div>
                        }

                        <div class="mt-2.5">
                            <OrderHistoryPanel OrderId="Id" StepId="step.Id" Version="_state.Version" Nested="true" />
                        </div>
                    </article>
                }
            </section>
        }

        @* ============================================================
           Archive
           ============================================================ *@
        @if (_state.IsArchived)
        {
            <section class="rounded-xl border border-slate-300 bg-slate-50 p-4 shadow-xs sm:p-5">
                <h2 class="text-sm font-bold text-slate-800">بيانات الأرشفة — لا توجد استعادة</h2>
                <p class="mt-1.5 text-xs text-slate-700">السبب: @_state.ArchiveReason</p>
                <p class="mt-1 text-[11px] text-slate-500"><UserLocalTime Value="_state.ArchivedAtUtc" /> — بواسطة @_state.ArchivedByUserName</p>
            </section>
        }

        <OrderHistoryPanel OrderId="Id" Version="_state.Version" AutoLoad="true" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private OrderWorkflowState? _state;
    private bool _loading, _busy, _canWrite, _disposed;
    private string? _error;
    private int _loadedId, _generation;
    private CancellationTokenSource? _load;
    private PageScaffold.CrumbItem[] _crumbs = [];
    protected override Task OnParametersSetAsync() => _loadedId == Id ? Task.CompletedTask : LoadAsync();

    private async Task LoadAsync()
    {
        _loadedId = Id;
        var generation = ++_generation;
        _load?.Cancel();
        _load?.Dispose();
        _load = new();
        var token = _load.Token;
        _loading = true;
        _state = null;
        _error = null;
        try
        {
            var state = await Executor.ExecuteAsync(new GetOrderWorkflowQuery(Id), token);
            var canWrite = await Permissions.IsAllowedAsync(PermissionFeature.Orders, PermissionLevel.Write, token);
            if (generation != _generation) return;
            _state = state;
            _canWrite = canWrite;
            _crumbs = state is null
                ? [new("الطلبات", "/orders")]
                : [new("الطلبات", "/orders"), new(state.OrderNumber)];
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load order workflow {OrderId}", Id);
            if (generation == _generation) _error = "تعذر تحميل دورة الطلب. حاول مرة أخرى.";
        }
        finally { if (generation == _generation) _loading = false; }
    }

    private async Task AskAndSubmitAsync(string title, string explanation, Func<string, Task<Result<OrderOperationReceipt>>> submit, string? tone = null)
    {
        var dialog = await Dialogs.ShowAsync<OrderReasonDialog>(title,
            new DialogParameters<OrderReasonDialog> { { value => value.Explanation, explanation }, { value => value.ConfirmLabel, title }, { value => value.Submit, submit }, { value => value.ConfirmTone, tone ?? OrderWorkflowPresentation.Neutral } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false });
        await dialog.Result;
    }

    private async Task ChangeStatusAsync(OrderStatus target)
    {
        if (_busy || !_canWrite || _state is null || !_state.AllowedStatuses.Contains(target)) return;
        _busy = true;
        var snapshot = _state;
        try
        {
            if (target is OrderStatus.Cancelled or OrderStatus.DeliveryFailed)
            {
                var effects = target == OrderStatus.Cancelled
                    ? $"لن يمكن تشغيل الطلب بعد الإلغاء. {_state.CompletedActiveStepCount} خطوة مكتملة محفوظة، و{_state.ActiveStepCount - _state.CompletedActiveStepCount} خطوة غير مكتملة ستُلغى."
                    : "سيُسجل سبب تعذر المحاولة، ويمكن إعادة المحاولة لاحقًا.";
                await AskAndSubmitAsync(OrderWorkflowPresentation.ActionLabel(target, snapshot.Status), effects,
                    reason => SubmitSnapshotAsync(snapshot, () => Executor.ExecuteAsync(new ChangeOrderStatusCommand(snapshot.Id, snapshot.Version, target, reason))), OrderWorkflowPresentation.StatusTone(target));
                return;
            }
            if (snapshot.Id != Id || _state?.Version != snapshot.Version) return;
            await CompleteAsync(await Executor.ExecuteAsync(new ChangeOrderStatusCommand(snapshot.Id, snapshot.Version, target)));
        }
        catch (Exception exception) { ShowFailure(exception); }
        finally { _busy = false; }
    }

    private async Task ChangeStepAsync(DeliveryStepWorkflowState step, DeliveryStatus target)
    {
        if (_busy || !_canWrite || _state is null || !step.AllowedStatuses.Contains(target)) return;
        _busy = true;
        var snapshot = _state;
        try
        {
            if (target == DeliveryStatus.Failed)
            {
                await AskAndSubmitAsync("تسجيل تعذر التنفيذ", "سيُحفظ سبب الفشل. الخطوة التالية ستظل مقفولة حتى اكتمال هذه الخطوة.",
                    reason => SubmitSnapshotAsync(snapshot, () => Executor.ExecuteAsync(new ChangeDeliveryStepStatusCommand(snapshot.Id, snapshot.Version, step.Id, target, reason))), OrderWorkflowPresentation.StatusTone(target));
                return;
            }
            if (snapshot.Id != Id || _state?.Version != snapshot.Version) return;
            await CompleteAsync(await Executor.ExecuteAsync(new ChangeDeliveryStepStatusCommand(snapshot.Id, snapshot.Version, step.Id, target)));
        }
        catch (Exception exception) { ShowFailure(exception); }
        finally { _busy = false; }
    }

    private async Task CompleteAsync(OrderHub.Domain.Common.Result<OrderOperationReceipt> result)
    {
        Snackbar.Add(result.IsSuccess ? "تم حفظ العملية. راجع الحالة والخطوة المتاحة الآن." : result.ErrorMessage, result.IsSuccess ? Severity.Success : Severity.Error);
        if (result.IsSuccess || result.ErrorCode == "Conflict") await LoadAsync();
    }

    private async Task<Result<OrderOperationReceipt>> SubmitSnapshotAsync(OrderWorkflowState snapshot,
        Func<Task<Result<OrderOperationReceipt>>> submit)
    {
        if (_disposed || snapshot.Id != Id || _state?.Version != snapshot.Version)
            return Result<OrderOperationReceipt>.Failure("تغيرت الشاشة؛ راجع بيانات الطلب الحالية.", "Conflict");
        var result = await submit();
        if (result.IsSuccess || result.ErrorCode == "Conflict") await CompleteAsync(result);
        return result;
    }

    private async Task ArchiveAsync()
    {
        if (_busy || !_canWrite || _state is null || !_state.CanArchive) return;
        _busy = true;
        var snapshot = _state;
        try
        {
            await AskAndSubmitAsync("أرشفة الطلب", "سيختفي الطلب من قائمة التشغيل، وستظل بياناته وخطواته وتاريخه ومستنداته محفوظة في الأرشيف. لا يمكن استعادته أو تعديله أو تشغيله.",
                reason => SubmitSnapshotAsync(snapshot, () => Executor.ExecuteAsync(new ArchiveOrderCommand(snapshot.Id, snapshot.Version, reason))));
        }
        catch (Exception exception) { ShowFailure(exception); }
        finally { _busy = false; }
    }

    private async Task DeliverDirectlyAsync()
    {
        if (_busy || !_canWrite || _state is null || !_state.CanDeliverDirectly) return;
        _busy = true;
        var snapshot = _state;
        try
        {
            Func<IReadOnlyList<DeliveryStepOutcome>, string, Task<Result<OrderOperationReceipt>>> submit =
                (outcomes, reason) => SubmitSnapshotAsync(snapshot,
                    () => Executor.ExecuteAsync(new DeliverOrderDirectlyCommand(snapshot.Id, snapshot.Version, outcomes, reason)));
            var dialog = await Dialogs.ShowAsync<DirectDeliveryDialog>("تأكيد التسليم المباشر",
                new DialogParameters<DirectDeliveryDialog> { { value => value.State, snapshot }, { value => value.Submit, submit } },
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false });
            await dialog.Result;
        }
        catch (Exception exception) { ShowFailure(exception); }
        finally { _busy = false; }
    }

    private void ShowFailure(Exception exception)
    {
        Logger.LogError(exception, "Failed order operation {OrderId}", Id);
        Snackbar.Add("تعذر تنفيذ العملية. حدّث الحالة قبل إعادة المحاولة.", Severity.Error);
    }

    private Task ReassignDirectlyAsync() => _state is null ? Task.CompletedTask : ShowReassignAsync(_state, null);

    private Task ReassignStepAsync(DeliveryStepWorkflowState step) => _state is null ? Task.CompletedTask : ShowReassignAsync(_state, step);

    private Task CancelStepAsync(DeliveryStepWorkflowState step) => _state is null ? Task.CompletedTask : ShowReassignAsync(_state, step, cancelOnly: true);

    private async Task ShowReassignAsync(OrderWorkflowState snapshot, DeliveryStepWorkflowState? step, bool cancelOnly = false)
    {
        if (_busy || !_canWrite || _state is null || _state.Version != snapshot.Version) return;
        if (step is null ? !snapshot.CanReassignDirectly : cancelOnly ? !step.CanCancel : !step.CanReassign) return;
        _busy = true;
        try
        {
            Func<DeliveryMethod?, int?, string, Task<Result<OrderOperationReceipt>>> submit =
                (method, partyId, reason) => SubmitReassignAsync(snapshot, step?.Id, method, partyId, reason);
            var dialog = await Dialogs.ShowAsync<ReassignDeliveryDialog>(
                cancelOnly ? "إلغاء الخطوة" : "إلغاء التكليف وإعادة التوجيه",
                new DialogParameters<ReassignDeliveryDialog>
                {
                    { value => value.OrderNumber, snapshot.OrderNumber },
                    { value => value.ContextLabel, step is null ? "التكليف المباشر" : $"الخطوة {step.EffectiveRank.ToString(CultureInfo.InvariantCulture)}" },
                    { value => value.CurrentMethod, step?.Method ?? snapshot.Method ?? DeliveryMethod.DeliveryMan },
                    { value => value.CurrentPartyName, step?.HandlerName ?? snapshot.HandlerName },
                    { value => value.IsCancelOnly, cancelOnly },
                    { value => value.Submit, submit }
                },
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false });
            await dialog.Result;
        }
        catch (Exception exception) { ShowFailure(exception); }
        finally { _busy = false; }
    }

    private async Task<Result<OrderOperationReceipt>> SubmitReassignAsync(OrderWorkflowState snapshot, int? stepId,
        DeliveryMethod? method, int? partyId, string reason)
    {
        if (_disposed || snapshot.Id != Id || _state?.Version != snapshot.Version)
            return Result<OrderOperationReceipt>.Failure("تغيرت الشاشة؛ راجع بيانات الطلب الحالية.", "Conflict");
        var result = method is null
            ? await Executor.ExecuteAsync(new CancelDeliveryStepCommand(snapshot.Id, snapshot.Version, stepId!.Value, reason))
            : stepId.HasValue
                ? await Executor.ExecuteAsync(new ReassignDeliveryStepCommand(snapshot.Id, snapshot.Version, stepId.Value, method.Value, partyId, reason))
                : await Executor.ExecuteAsync(new ReassignDirectDeliveryCommand(snapshot.Id, snapshot.Version, method.Value, partyId, reason));
        if (result.IsSuccess)
        {
            Snackbar.Add(method is null ? "تم إلغاء الخطوة بنجاح." : "تم إلغاء التكليف وإعادة التوجيه بنجاح.", Severity.Success);
            await LoadAsync();
        }
        else if (result.ErrorCode == "Conflict")
        {
            Snackbar.Add("تغيّرت حالة الطلب أثناء العملية؛ حُدّثت الشاشة. راجع الحالة الحالية قبل المحاولة مجددًا.", Severity.Warning);
            await LoadAsync();
        }
        return result;
    }

    public void Dispose() { _disposed = true; _canWrite = false; _state = null; _generation++; _load?.Cancel(); _load?.Dispose(); }
}
