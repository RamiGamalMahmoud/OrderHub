@using System.Globalization
@using OrderHub.Application.Common.Extensions
@using OrderHub.Application.Common.Lookups
@using OrderHub.Application.Features.Orders.GetEditorLookups
@using OrderHub.Application.Features.Orders.Lifecycle
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Common
@using OrderHub.Domain.Models

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-orange-600">
                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">إلغاء التكليف وإعادة التوجيه</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">@OrderNumber — @ContextLabel</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-5">
            <div class="rounded-xl border border-slate-200 bg-white px-3 py-3 text-xs leading-6 text-slate-600">
                <p class="font-bold text-slate-800">التكليف الحالي</p>
                <p class="mt-1">@CurrentMethod.GetDescription() — @(string.IsNullOrWhiteSpace(CurrentPartyName) ? "جهة التنفيذ غير محددة" : CurrentPartyName)</p>
            </div>

            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                سيُغلق التكليف الحالي ويُسجَّل في سجل الطلب، ويبدأ التكليف الجديد فورًا. لا تُحذف أي خطوات أو سجلات تشغيل سابقة.
            </div>

            <MudSelect T="DeliveryMethod"
                       @bind-Value="Method"
                       Label="المسار البديل"
                       Disabled="_submitting"
                       Immediate="true"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem T="DeliveryMethod" Value="DeliveryMethod.DeliveryMan">مندوب توصيل</MudSelectItem>
                <MudSelectItem T="DeliveryMethod" Value="DeliveryMethod.ShippingCompany">شركة شحن</MudSelectItem>
                <MudSelectItem T="DeliveryMethod" Value="DeliveryMethod.Pickup">استلام من المقر</MudSelectItem>
            </MudSelect>

            @if (Method != DeliveryMethod.Pickup)
            {
                @if (_lookupsLoading)
                {
                    <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs text-slate-500">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" aria-label="تحميل جهات التوصيل" />
                        جاري تحميل جهات التوصيل…
                    </div>
                }
                else if (_lookupsError is not null)
                {
                    <div class="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-xs font-bold text-red-800">
                        @_lookupsError
                        <button type="button"
                                class="@($"oh-btn oh-btn--sm mt-2 {OrderWorkflowPresentation.Action(OrderWorkflowPresentation.Neutral)}")"
                                disabled="@_submitting"
                                @onclick="LoadPartiesAsync">إعادة المحاولة</button>
                    </div>
                }
                else if (Parties.Count == 0)
                {
                    <div class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs font-bold text-slate-600">
                        لا توجد جهة أخرى متاحة على هذا المسار. اختر مسارًا مختلفًا.
                    </div>
                }
                else
                {
                    <MudSelect T="int?"
                               @bind-Value="_partyId"
                               Label="جهة التنفيذ البديلة"
                               Disabled="_submitting"
                               Immediate="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var party in Parties)
                        {
                            <MudSelectItem T="int?" Value="@((int?)party.Id)">@party.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            else
            {
                <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-bold leading-6 text-emerald-800">
                    يصبح الطلب «جاهز للاستلام»، ثم يُؤكد التسليم عند استلام العميل له من المقر.
                </div>
            }

            <div class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-xs leading-6 text-slate-600">
                <span class="font-bold text-slate-800">المسار الجديد:</span>
                @NewRouteLabel
            </div>

            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="سبب إلغاء التكليف"
                          Required="true"
                          Immediate="true"
                          MaxLength="200"
                          HelperText="@_reasonCounter"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Disabled="@(!CanConfirm())"
                       Class="@($"oh-btn {OrderWorkflowPresentation.Action("failed")}")"
                       OnClick="ConfirmAsync">@(_submitting ? "جاري إعادة التوجيه…" : "تأكيد إعادة التوجيه")</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Parameter, EditorRequired] public string OrderNumber { get; set; } = null!;
    [Parameter, EditorRequired] public string ContextLabel { get; set; } = null!;
    [Parameter, EditorRequired] public DeliveryMethod CurrentMethod { get; set; }
    [Parameter] public string? CurrentPartyName { get; set; }
    [Parameter, EditorRequired] public Func<DeliveryMethod, int?, string, Task<Result<OrderOperationReceipt>>> Submit { get; set; } = null!;

    private DeliveryMethod _method = DeliveryMethod.DeliveryMan;
    private DeliveryMethod Method
    {
        get => _method;
        set
        {
            if (_method == value) return;
            _method = value;
            _partyId = null;
            _error = null;
            RebuildParties();
        }
    }

    private IReadOnlyList<DeliverymanLookup> _deliverymen = [];
    private IReadOnlyList<ShippingCarrierLookup> _carriers = [];
    private List<PartyOption> _parties = [];
    private List<PartyOption> Parties => _parties;
    private int? _partyId;
    private string? _reason, _error, _lookupsError;
    private bool _submitting, _lookupsLoading = true;
    private string _reasonCounter => $"{(_reason?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    protected override async Task OnInitializedAsync()
    {
        _method = CurrentMethod is DeliveryMethod.DeliveryMan or DeliveryMethod.ShippingCompany
            ? CurrentMethod
            : DeliveryMethod.DeliveryMan;
        await LoadPartiesAsync();
    }

    private async Task LoadPartiesAsync()
    {
        _lookupsLoading = true;
        _lookupsError = null;
        try
        {
            var lookups = await Executor.ExecuteAsync(new GetOrderEditorLookupsQuery());
            _deliverymen = lookups.Deliverymen;
            _carriers = lookups.ShippingCarriers;
            RebuildParties();
        }
        catch (Exception)
        {
            _lookupsError = "تعذر تحميل جهات التوصيل. حاول مرة أخرى.";
        }
        finally { _lookupsLoading = false; }
    }

    private void RebuildParties()
    {
        var current = CurrentMethod;
        _parties = Method switch
        {
            DeliveryMethod.DeliveryMan => _deliverymen
                .Where(party => !IsCurrentParty(current == DeliveryMethod.DeliveryMan, party.Name))
                .Select(party => new PartyOption(party.Id, party.Name)).ToList(),
            DeliveryMethod.ShippingCompany => _carriers
                .Where(party => !IsCurrentParty(current == DeliveryMethod.ShippingCompany, party.Name))
                .Select(party => new PartyOption(party.Id, party.Name)).ToList(),
            _ => []
        };
        if (_partyId.HasValue && _parties.All(party => party.Id != _partyId.Value)) _partyId = null;
    }

    private bool IsCurrentParty(bool sameRoute, string name) =>
        sameRoute && !string.IsNullOrWhiteSpace(CurrentPartyName) &&
        string.Equals(name?.Trim(), CurrentPartyName.Trim(), StringComparison.OrdinalIgnoreCase);

    private string NewRouteLabel => Method switch
    {
        DeliveryMethod.Pickup => "استلام من المقر",
        _ when _partyId.HasValue => $"{Method.GetDescription()} — {_parties.First(party => party.Id == _partyId.Value).Name}",
        _ => $"{Method.GetDescription()} — لم تُحدد الجهة بعد"
    };

    private bool CanConfirm()
    {
        if (_submitting || _lookupsLoading || _lookupsError is not null) return false;
        if (!Order.ValidateReason(_reason, true).IsSuccess) return false;
        if (Method == DeliveryMethod.Pickup) return true;
        return _partyId is > 0 && _parties.Any(party => party.Id == _partyId.Value);
    }

    private void Cancel() => Dialog.Cancel();

    private async Task ConfirmAsync()
    {
        if (_submitting || !CanConfirm())
        {
            _error = "أكمل السبب واختر مسارًا وجهة مختلفة عن التكليف الحالي.";
            return;
        }
        _error = null;
        _submitting = true;
        try
        {
            var result = await Submit(Method, Method == DeliveryMethod.Pickup ? null : _partyId, _reason!.Trim());
            if (result.IsSuccess) Dialog.Close(DialogResult.Ok(result.Value));
            else if (result.ErrorCode == "Conflict") Dialog.Cancel();
            else _error = result.ErrorMessage;
        }
        catch (Exception) { _error = "تعذر الحفظ. راجع الحالة قبل المحاولة مجددًا."; }
        finally { _submitting = false; }
    }

    private sealed record PartyOption(int Id, string Name);
}
