@using System.Globalization
@using OrderHub.Application.Features.Orders.Lifecycle
@using OrderHub.Application.Common.Extensions

@if (State.Status != OrderStatus.Cancelled)
{
    <ol class="grid grid-cols-1 gap-2 sm:grid-cols-3" aria-label="مراحل الطلب">
        @for (var index = 0; index < _stages.Length; index++)
        {
            var stage = _stages[index];
            var current = Math.Min(_stages.Length - 1, State.Status == OrderStatus.Processing ? 0 : State.Status == OrderStatus.Delivered ? 2 : 1);
            var active = index == current;
            var previous = index < current;
            var tone = active ? OrderWorkflowPresentation.StatusTone(State.Status) : previous ? "completed" : OrderWorkflowPresentation.Neutral;
            var caption = active
                ? State.Status == OrderStatus.DeliveryFailed ? "تحتاج مراجعة"
                : State.Status == OrderStatus.Delivered ? "اكتملت دورة الطلب"
                : "المرحلة الحالية"
                : previous ? "مكتملة" : "لم تبدأ";
            <li class="@($"flex items-center gap-2.5 rounded-lg border p-2.5 {(active ? "border-2 shadow-sm" : "")} {(active || previous ? OrderWorkflowPresentation.Surface(tone) : "border-slate-200 bg-white")}")"
                aria-current="@(active ? "step" : null)">
                <span class="@($"inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full border text-[11px] font-black {OrderWorkflowPresentation.IconTile(tone)}")">
                    @(previous ? "✓" : (index + 1).ToString(CultureInfo.InvariantCulture))
                </span>
                <div class="min-w-0">
                    <p class="@($"truncate text-xs font-bold {(active ? "text-slate-900" : "text-slate-600")}")">@stage.GetDescription()</p>
                    <p class="truncate text-[10px] font-medium text-slate-500">@caption</p>
                </div>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public OrderWorkflowState State { get; set; } = null!;
    private OrderStatus[] _stages = [];
    protected override void OnParametersSet() => _stages = OrderWorkflowPresentation.Stages(State.Method);
}
