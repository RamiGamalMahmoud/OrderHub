@using OrderHub.Application.Features.Orders.GetSummaries
@using QRCoder
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">ملخص الطلب</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">اختر الجهة لعرض الملخص المخصص لها.</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <div>
                <p class="mb-2 text-[11px] font-bold uppercase tracking-wide text-slate-500">الجهات المشتركة في الطلب</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var audience in Audiences)
                    {
                        <button type="button"
                                class="@AudienceClass(audience)"
                                aria-pressed="@(_selectedAudience == audience)"
                                @onclick="() => SelectAudience(audience)">@audience.Label</button>
                    }
                </div>
            </div>

            @if (CurrentRecords.Count > 1)
            {
                <MudSelect T="OrderSummaryText" Value="_selectedRecord" ValueChanged="SelectRecord"
                           Label="السجل" Variant="Variant.Outlined" ToStringFunc="@(record => record?.Title ?? string.Empty)">
                    @foreach (var record in CurrentRecords)
                    {
                        <MudSelectItem Value="@record">@record.Title</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_selectedRecord is not null)
            {
                <section class="rounded-xl border border-slate-200 bg-white p-4 shadow-xs" dir="rtl">
                    <h3 class="text-sm font-black text-slate-900">@_selectedRecord.Title</h3>
                    <div class="my-3 h-px bg-slate-100"></div>
                    <p class="whitespace-pre-line break-words text-sm leading-7 text-slate-700">@_selectedRecord.Text</p>
                </section>
            }

            @if (_qrData is not null)
            {
                <section class="rounded-xl border border-slate-200 bg-white p-4 text-center shadow-xs">
                    <img src="@_qrData" alt="QR code يحتوي على نص الملخص"
                         class="mx-auto block h-auto w-full max-w-[360px] rounded-lg border border-slate-200" />
                    <p class="mt-2 text-xs text-slate-500">امسح الرمز بكاميرا الهاتف لقراءة الملخص.</p>
                </section>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">إغلاق</MudButton>
            <MudButton StartIcon="@Icons.Material.Outlined.QrCode2" OnClick="ShowQrCode"
                       Disabled="_selectedRecord is null" Variant="Variant.Outlined"
                       Class="oh-btn oh-btn--secondary">QR Code</MudButton>
            <MudButton StartIcon="@Icons.Material.Outlined.Share" OnClick="ShareAsync"
                       Disabled="_selectedRecord is null" Variant="Variant.Outlined"
                       Class="oh-btn oh-btn--secondary">مشاركة</MudButton>
            <MudButton StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="CopyAsync"
                       Disabled="_selectedRecord is null" Color="Color.Primary" Variant="Variant.Filled"
                       Class="oh-btn oh-btn--primary">نسخ</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<OrderSummaryText> Summaries { get; set; } = [];

    private AudienceChoice? _selectedAudience;
    private OrderSummaryText? _selectedRecord;
    private string? _qrData;
    private string? _error;

    private IReadOnlyList<AudienceChoice> Audiences => Summaries
        .GroupBy(summary => (summary.AudienceType, summary.PartyId))
        .Select(group => group.First())
        .Select(summary => new AudienceChoice(summary.AudienceType, summary.PartyId, AudienceLabel(summary)))
        .ToList();

    private List<OrderSummaryText> CurrentRecords => _selectedAudience is null ? [] : Summaries
        .Where(summary => summary.AudienceType == _selectedAudience.Type && summary.PartyId == _selectedAudience.PartyId)
        .ToList();

    private string AudienceClass(AudienceChoice audience) => _selectedAudience == audience
        ? "rounded-full border border-brand-200 bg-brand-50 px-3.5 py-1.5 text-xs font-bold text-brand-700"
        : "rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100";

    protected override void OnInitialized() => SelectAudience(Audiences.FirstOrDefault());

    private void SelectAudience(AudienceChoice? audience)
    {
        _selectedAudience = audience;
        _selectedRecord = audience is null ? null : Summaries.FirstOrDefault(summary =>
            summary.AudienceType == audience.Type && summary.PartyId == audience.PartyId);
        _qrData = null;
        _error = null;
    }

    private void SelectRecord(OrderSummaryText record)
    {
        _selectedRecord = record;
        _qrData = null;
        _error = null;
    }

    private void Cancel() => Dialog.Cancel();

    private async Task CopyAsync()
    {
        if (_selectedRecord is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _selectedRecord.Text);
            Snackbar.Add("تم نسخ الملخص.", Severity.Success);
        }
        catch (JSException)
        {
            _error = "تعذر النسخ من هذا المتصفح.";
        }
    }

    private async Task ShareAsync()
    {
        if (_selectedRecord is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.share", new { title = _selectedRecord.Title, text = _selectedRecord.Text });
        }
        catch (JSException)
        {
            _error = "المشاركة المباشرة غير متاحة في هذا المتصفح. يمكنك نسخ الملخص.";
        }
    }

    private void ShowQrCode()
    {
        if (_selectedRecord is null) return;
        try
        {
            using var qrData = QRCodeGenerator.GenerateQrCode(_selectedRecord.Text,
                QRCodeGenerator.ECCLevel.M, forceUtf8: true, eciMode: QRCodeGenerator.EciMode.Utf8);
            using var renderer = new PngByteQRCode(qrData);
            _qrData = $"data:image/png;base64,{Convert.ToBase64String(renderer.GetGraphic(8))}";
            _error = null;
        }
        catch (QRCoder.Exceptions.DataTooLongException)
        {
            _qrData = null;
            _error = "محتوى الملخص أطول من سعة رمز QR. استخدم النسخ أو المشاركة.";
        }
    }

    private static string AudienceLabel(OrderSummaryText summary) => summary.AudienceType switch
    {
        "order" => "الطلب",
        "customer" => "العميل",
        "deliveryman" => $"المندوب — {summary.AudienceName}",
        "shipping" => $"شركة الشحن — {summary.AudienceName}",
        "supplier" => $"المورد — {summary.AudienceName}",
        _ => summary.AudienceName
    };

    private sealed record AudienceChoice(string Type, int PartyId, string Label);
}
