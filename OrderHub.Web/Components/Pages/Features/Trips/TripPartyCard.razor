<section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs" aria-label="@Label">
    <header class="flex flex-wrap items-start justify-between gap-2 border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2.5">
            <span class="@($"inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border {_tileClasses}")">
                <MudIcon Icon="@(IsDestination ? Icons.Material.Outlined.Place : Icons.Material.Outlined.TripOrigin)" Class="text-[16px]" />
            </span>
            <div>
                <h3 class="text-base font-bold text-slate-900">@Label</h3>
                <span class="block text-xs font-medium text-slate-400">بيانات الجهة المحفوظة لحظة الإنشاء</span>
            </div>
        </div>
        <span class="@($"inline-flex items-center whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs font-bold {_chipClasses}")">
            @TripPresentation.PartyTypeLabel(Party.PartyType)
        </span>
    </header>

    <dl class="space-y-2.5 text-sm">
        <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-2.5">
            <dt class="mb-0.5 block text-xs font-medium text-slate-400">الاسم</dt>
            <dd class="block font-bold text-slate-800" style="overflow-wrap:anywhere">@Party.Name</dd>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-2.5">
            <dt class="mb-0.5 block text-xs font-medium text-slate-400">الهاتف</dt>
            <dd class="block font-mono font-bold tracking-wider text-slate-800" dir="ltr">
                @(string.IsNullOrWhiteSpace(Party.Phone) ? "—" : Party.Phone)
            </dd>
        </div>
        <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-2.5">
            <dt class="mb-0.5 block text-xs font-medium text-slate-400">العنوان</dt>
            <dd class="block font-medium leading-6 text-slate-700" style="overflow-wrap:anywhere">
                @(string.IsNullOrWhiteSpace(Party.Address) ? "—" : Party.Address)
            </dd>
        </div>
        @if (!string.IsNullOrWhiteSpace(Party.Location))
        {
            <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-2.5">
                <dt class="mb-0.5 block text-xs font-medium text-slate-400">الموقع الجغرافي</dt>
                <dd class="block font-semibold text-slate-800">
                    @if (LocationUri is not null)
                    {
                        <a href="@Party.Location"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="@($"inline-flex items-center gap-1 text-xs font-medium hover:underline {_accentClasses}")">
                            <MudIcon Icon="@Icons.Material.Outlined.Map" Class="text-[14px]" />
                            خريطة
                        </a>
                    }
                    else
                    {
                        <span style="overflow-wrap:anywhere">@Party.Location</span>
                    }
                </dd>
            </div>
        }
    </dl>
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public TripPartyData Party { get; set; } = null!;

    /// <summary>Route-card position accent: «from» blue or «to» indigo; null keeps the party-type tone.</summary>
    [Parameter] public string? Slot { get; set; }

    private string _tileClasses = string.Empty;

    private string _chipClasses = string.Empty;

    private string _accentClasses = string.Empty;

    private Uri? LocationUri =>
        Uri.TryCreate(Party.Location, UriKind.Absolute, out var uri) &&
        (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri
            : null;

    private bool IsDestination => Slot == "to";

    protected override void OnParametersSet()
    {
        var slotTone = TripPresentation.RouteSlotTone(Slot);

        if (slotTone.TileClasses.Length > 0)
        {
            _tileClasses = slotTone.TileClasses;
            _chipClasses = slotTone.ChipClasses;
            _accentClasses = slotTone.AccentClasses;
            return;
        }

        var partyTone = TripPresentation.PartyTypeTone(Party.PartyType);
        _tileClasses = OrderWorkflowPresentation.IconTile(partyTone);
        _chipClasses = OrderWorkflowPresentation.Tag(partyTone);
        _accentClasses = "text-brand-700";
    }
}
