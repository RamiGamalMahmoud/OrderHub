@using System.Globalization

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="@($"inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl {OrderWorkflowPresentation.IconTile(Tone)}")">
                    <MudIcon Icon="@Icon" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@Title</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">تأكيد العملية على المشوار</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <p class="text-sm leading-7 text-slate-700">@Explanation</p>

            @if (RequiresReason)
            {
                <MudTextField T="string"
                              @bind-Value="_reason"
                              @bind-Value:after="OnReasonChanged"
                              Label="@ReasonLabel"
                              Required="true"
                              Immediate="true"
                              MaxLength="200"
                              HelperText="@_counter"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Disabled="_submitting" />
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            @if (_conflict)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold text-amber-800">
                    @_conflictMessage
                </div>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            @if (_conflict)
            {
                <MudButton OnClick="RequestReload" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                    إعادة تحميل البيانات
                </MudButton>
                <MudButton OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                    إغلاق
                </MudButton>
            }
            else
            {
                <MudButton OnClick="Cancel" Disabled="_submitting" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                    رجوع دون تغيير
                </MudButton>
                <MudButton Class="@($"oh-btn {OrderWorkflowPresentation.Action(Tone)}")"
                           OnClick="ConfirmAsync"
                           Disabled="_submitting">
                    @(_submitting ? "جاري الحفظ…" : ConfirmLabel)
                </MudButton>
            }
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string Explanation { get; set; } = "سيتم تسجيل العملية في سجل المشوار.";

    [Parameter] public string ConfirmLabel { get; set; } = "تأكيد";

    [Parameter] public string Tone { get; set; } = "processing";

    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.CheckCircleOutline;

    [Parameter] public bool RequiresReason { get; set; }

    [Parameter] public string ReasonLabel { get; set; } = "السبب";

    [Parameter] public Func<string?, Task<Result<int>>>? Submit { get; set; }

    private string? _reason;
    private string? _error;
    private string? _conflictMessage;
    private bool _conflict;
    private bool _submitting;

    private string _counter =>
        string.Format(
            CultureInfo.InvariantCulture,
            "{0} / 200",
            (_reason?.Length ?? 0).ToString(CultureInfo.InvariantCulture));

    private void OnReasonChanged()
    {
        if (_error is not null)
        {
            _error = null;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private void RequestReload() => Dialog.Close(DialogResult.Ok(new TripActionOutcome(null, true)));

    private async Task ConfirmAsync()
    {
        if (_submitting)
        {
            return;
        }

        string? reason = null;

        if (RequiresReason)
        {
            reason = _reason?.Trim();

            if (string.IsNullOrEmpty(reason) || reason.Length > 200)
            {
                _error = "السبب مطلوب ويجب ألا يتجاوز 200 حرف.";
                return;
            }
        }

        if (Submit is null)
        {
            Dialog.Close(DialogResult.Ok(new TripActionOutcome(null, false)));
            return;
        }

        _submitting = true;
        _error = null;
        _conflict = false;

        try
        {
            var result = await Submit(reason);

            if (result.IsSuccess)
            {
                Dialog.Close(DialogResult.Ok(new TripActionOutcome(result.Value, false)));
                return;
            }

            if (result.ErrorCode == "Conflict")
            {
                _conflict = true;
                _conflictMessage = result.ErrorMessage;
                return;
            }

            _error = result.ErrorMessage;
        }
        catch (AuthorizationDeniedException)
        {
            _error = "ليست لديك صلاحية تنفيذ هذه العملية.";
        }
        catch (Exception)
        {
            _error = "تعذر حفظ العملية. راجع حالة المشوار ثم حاول مجدداً.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
