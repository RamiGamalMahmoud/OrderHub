@page "/trips/{Id:int}"

@attribute [PermissionAuthorize(
    PermissionFeature.Trips,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject TripActions TripActions
@inject ISnackbar Snackbar
@inject OrderHub.Web.Services.TripsViewPreferences ViewPreferences
@inject ILogger<Details> Logger

<PageTitle>تفاصيل المشوار</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل المشوار" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل بيانات المشوار...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <div class="mt-3 flex flex-wrap gap-2">
                <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm" @onclick="LoadAsync">
                    إعادة المحاولة
                </button>
                <a href="/trips" class="oh-btn oh-btn--ghost oh-btn--sm">العودة إلى المشاوير</a>
            </div>
        </div>
    }
    else if (_details is null)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <p class="text-xs font-bold text-slate-700">المشوار غير موجود.</p>
            <a href="/trips" class="oh-btn oh-btn--secondary oh-btn--sm mt-3">العودة إلى المشاوير</a>
        </div>
    }
    else
    {
        var statusChip = TripPresentation.GetStatusChip(_details.DisplayState);

        <PageScaffold Title="تفاصيل المشوار"
                      Description="@TripPresentation.FormatTripNumber(_details.TripNumber, _details.SequenceYear, _details.SequenceMonth)"
                      Crumbs="_crumbs">
            <Actions>
                @if (_canWrite && _details.IsEditable)
                {
                    <a href="@($"/trips/{_details.Id}/edit")" class="oh-btn oh-btn--secondary oh-btn--sm">
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="text-[16px]" />
                        <span>تعديل المشوار</span>
                    </a>
                }

                @foreach (var action in _allowedActions.Where(candidate => candidate != TripPresentation.ActionEdit))
                {
                    var capturedAction = action;
                    <button type="button"
                            class="@($"oh-btn oh-btn--sm {OrderWorkflowPresentation.Action(TripPresentation.ActionTone(capturedAction))}")"
                            @onclick="() => OpenActionAsync(capturedAction)">
                        <MudIcon Icon="@TripPresentation.ActionIcon(capturedAction)" Class="text-[16px]" />
                        <span>@TripPresentation.ActionLabel(capturedAction)</span>
                    </button>
                }

                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm"
                        aria-busy="@_refreshing"
                        disabled="@_refreshing"
                        @onclick="RefreshAsync">
                    <MudIcon Icon="@Icons.Material.Outlined.Refresh"
                             Class="@(_refreshing ? "animate-spin text-[16px]" : "text-[16px]")" />
                    <span>@(_refreshing ? "جارٍ التحديث..." : "تحديث")</span>
                </button>
            </Actions>
        </PageScaffold>

        @* ============================================================
           Header summary
           ============================================================ *@
        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs lg:p-6" aria-label="ملخص المشوار">
            <header class="flex flex-col gap-3 border-b border-slate-100 pb-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex min-w-0 items-center gap-3.5">
                    <span class="@($"inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border {OrderWorkflowPresentation.IconTile(statusChip.Tone)}")">
                        <MudIcon Icon="@Icons.Material.Outlined.Route" Class="text-[19px]" />
                    </span>
                    <div class="min-w-0">
                        <h2 class="text-xl font-bold text-slate-900" style="overflow-wrap:anywhere">@_details.Title</h2>
                        <p class="mt-0.5 text-xs font-medium text-slate-500 sm:text-sm">
                            المندوب: <span class="font-semibold text-slate-800">@_details.DeliverymanName</span>
                        </p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    <span class="@($"inline-flex items-center gap-1 whitespace-nowrap rounded-md border px-2 py-0.5 text-[11px] font-bold {OrderWorkflowPresentation.Tag(statusChip.Tone)}")">
                        <span class="@($"h-1.5 w-1.5 rounded-full {OrderWorkflowPresentation.Dot(statusChip.Tone)}")"></span>
                        @statusChip.Label
                    </span>
                    <span class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 font-mono text-xs font-medium text-slate-600" dir="ltr">
                        @TripPresentation.FormatTripNumber(_details.TripNumber, _details.SequenceYear, _details.SequenceMonth)
                    </span>
                </div>
            </header>

            @if (!string.IsNullOrWhiteSpace(_details.Description))
            {
                <p class="mt-4 rounded-lg bg-slate-50 px-3 py-2 text-sm leading-6 text-slate-700" style="overflow-wrap:anywhere">
                    @_details.Description
                </p>
            }

            <div class="grid grid-cols-2 gap-3 pt-5 md:grid-cols-3 lg:grid-cols-5">
                <div class="rounded-lg border border-slate-100 bg-slate-50/80 p-3.5">
                    <span class="mb-1 block text-xs font-medium text-slate-400">المندوب</span>
                    <span class="block text-sm font-bold text-slate-800" style="overflow-wrap:anywhere">@_details.DeliverymanName</span>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50/80 p-3.5">
                    <span class="mb-1 block text-xs font-medium text-slate-400">الجدولة</span>
                    <span class="block text-sm font-semibold text-slate-700 tabular-nums">
                        @if (_details.ScheduledAtUtc.HasValue)
                        {
                            <UserLocalTime Value="_details.ScheduledAtUtc" />
                        }
                        else
                        {
                            <span class="text-slate-400">—</span>
                        }
                    </span>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50/80 p-3.5">
                    <span class="mb-1 block text-xs font-medium text-slate-400">تاريخ الإنشاء</span>
                    <span class="block text-sm font-semibold text-slate-700 tabular-nums"><UserLocalTime Value="_details.CreatedAt" /></span>
                </div>
                <div class="rounded-lg border border-slate-100 bg-slate-50/80 p-3.5">
                    <span class="mb-1 block text-xs font-medium text-slate-400">آخر تغيير للحالة</span>
                    <span class="block text-sm font-semibold text-slate-700 tabular-nums"><UserLocalTime Value="_details.StatusChangedAtUtc" /></span>
                </div>
                <div class="col-span-2 rounded-lg border border-slate-100 bg-slate-50/80 p-3.5 md:col-span-1">
                    <span class="mb-1 block text-xs font-medium text-slate-400">المحاولات</span>
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-sm font-bold text-blue-700 tabular-nums" dir="ltr">@TripPresentation.AttemptProgress(_details.CurrentAttemptNumber, _details.AttemptCount)</span>
                        <span class="text-xs font-medium text-slate-500">محاولات مسجلة</span>
                    </div>
                </div>
            </div>
        </section>

        @* ============================================================
           Route cards
           ============================================================ *@
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <TripPartyCard Label="من (نقطة الانطلاق)" Slot="from" Party="_details.From" />
            <TripPartyCard Label="إلى (وجهة التسليم)" Slot="to" Party="_details.To" />
        </div>

        @* ============================================================
           Attempts
           ============================================================ *@
        <section class="overflow-hidden rounded-xl border border-slate-200/90 bg-white shadow-xs" aria-label="محاولات المشوار">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 bg-slate-50/50 p-5">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700">
                        <MudIcon Icon="@Icons.Material.Outlined.Repeat" Class="text-[20px]" />
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">المحاولات</h3>
                        <p class="text-xs text-slate-500">سجل محاولات تنفيذ المشوار بالترتيب</p>
                    </div>
                </div>
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-200/70 font-mono text-xs font-bold text-slate-700">
                    @_details.Attempts.Count.ToString(CultureInfo.InvariantCulture)
                </span>
            </div>

            <div class="divide-y divide-slate-100">
                @if (_details.Attempts.Count == 0)
                {
                    <p class="px-5 py-8 text-center text-xs text-slate-500">لم تبدأ أي محاولة بعد.</p>
                }
                else
                {
                    @foreach (var attempt in _details.Attempts.OrderByDescending(candidate => candidate.AttemptNumber))
                    {
                        var attemptChip = TripPresentation.GetAttemptChip(attempt.Status, attempt.StartedAtUtc.HasValue);
                        <div class="flex flex-col justify-between gap-4 p-4 transition-colors hover:bg-slate-50/60 sm:flex-row sm:items-center sm:p-5">
                            <div class="flex items-center gap-4">
                                <span class="@($"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border font-mono text-sm font-bold {TripPresentation.AttemptTile(attemptChip.Tone)}")" dir="ltr">
                                    #@attempt.AttemptNumber.ToString(CultureInfo.InvariantCulture)
                                </span>
                                <div class="min-w-0">
                                    <span class="@($"inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-0.5 text-xs font-bold {TripPresentation.SolidChip(attemptChip.Tone)}")">
                                        <span class="@($"h-1.5 w-1.5 rounded-full {OrderWorkflowPresentation.Dot(attemptChip.Tone)}")"></span>
                                        @attemptChip.Label
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(attempt.Reason))
                                    {
                                        <p class="mt-1 flex flex-wrap items-center gap-1.5 text-xs font-semibold text-amber-900" style="overflow-wrap:anywhere">
                                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Class="text-[14px] text-amber-600" />
                                            <span>@(attempt.Status == WorkRecordStatus.Failed ? "سبب عدم الإكمال:" : "السبب:")</span>
                                            <span class="font-bold">@attempt.Reason</span>
                                        </p>
                                    }
                                </div>
                            </div>

                            <div class="self-start rounded-md border border-slate-200/50 bg-slate-100/70 px-3 py-1.5 text-xs text-slate-500 tabular-nums sm:self-center">
                                <span class="flex items-center gap-1">
                                    <span class="whitespace-nowrap text-slate-400">البدء:</span>
                                    @if (attempt.StartedAtUtc.HasValue)
                                    {
                                        <UserLocalTime Value="attempt.StartedAtUtc" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </span>
                                <span class="mt-0.5 flex items-center gap-1">
                                    <span class="whitespace-nowrap text-slate-400">الانتهاء:</span>
                                    @if (attempt.EndedAtUtc.HasValue)
                                    {
                                        <UserLocalTime Value="attempt.EndedAtUtc" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        @* ============================================================
           History timeline
           ============================================================ *@
        <section class="overflow-hidden rounded-xl border border-slate-200/90 bg-white shadow-xs" aria-label="سجل المشوار">
            <div class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-700">
                        <MudIcon Icon="@Icons.Material.Outlined.History" Class="text-[20px]" />
                    </span>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">سجل المشوار</h3>
                        <p class="text-xs text-slate-500">جميع الأحداث والتغييرات المسجلة على المشوار</p>
                    </div>
                </div>
                <span class="shrink-0 whitespace-nowrap rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    @_details.History.TotalCount.ToString(CultureInfo.InvariantCulture) أحداث
                </span>
            </div>

            @if (_details.History.TotalCount == 0)
            {
                <p class="px-5 py-8 text-center text-xs text-slate-500">لا يوجد سجل بعد.</p>
            }
            else
            {
                <ol class="divide-y divide-slate-100">
                    @foreach (var entry in _details.History.Items)
                    {
                        var eventTone = TripPresentation.EventTone(entry.EventType);
                        <li class="flex gap-3 px-5 py-4">
                            <span class="@($"mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border {OrderWorkflowPresentation.IconTile(eventTone)}")">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Class="text-[8px]" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="@($"inline-flex items-center rounded-md border px-2 py-0.5 text-[11px] font-bold {OrderWorkflowPresentation.Tag(eventTone)}")">
                                        @TripPresentation.EventLabel(entry.EventType)
                                    </span>
                                    @if (entry.AttemptNumber is { } attemptNumber)
                                    {
                                        <span class="text-xs font-semibold text-slate-500">المحاولة #@attemptNumber.ToString(CultureInfo.InvariantCulture)</span>
                                    }
                                    <span class="text-xs text-slate-400">•</span>
                                    <span class="text-xs font-bold text-slate-700">@entry.ChangedByUserName</span>
                                    <span class="text-xs text-slate-400">•</span>
                                    <span class="text-xs font-medium text-slate-500 tabular-nums"><UserLocalTime Value="entry.ChangedAtUtc" /></span>
                                </div>

                                @if (entry.PreviousStatus.HasValue || entry.NewStatus.HasValue)
                                {
                                    <p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-600">
                                        <span class="text-slate-400">الحالة:</span>
                                        @if (entry.PreviousStatus.HasValue)
                                        {
                                            <span class="rounded bg-slate-100 px-2 py-0.5 font-medium text-slate-700">@StatusText(entry.PreviousStatus)</span>
                                        }
                                        else
                                        {
                                            <span class="font-mono text-slate-400">—</span>
                                        }
                                        <span class="font-bold text-slate-400">←</span>
                                        <span class="@($"rounded px-2 py-0.5 font-bold {TripPresentation.SolidChip(TripPresentation.WorkRecordTone(entry.NewStatus))}")">@StatusText(entry.NewStatus)</span>
                                    </p>
                                }

                                @if (entry.PreviousDeliverymanName is not null || entry.NewDeliverymanName is not null)
                                {
                                    <p class="mt-1 rounded-lg border border-amber-200 bg-amber-50 px-2.5 py-1.5 text-xs font-bold text-amber-800">
                                        إعادة إسناد: @(entry.PreviousDeliverymanName ?? "غير معروف")
                                        <span class="mx-1">←</span>
                                        @(entry.NewDeliverymanName ?? "غير معروف")
                                        @if (entry.PreviousTripNumber.HasValue || entry.NewTripNumber.HasValue)
                                        {
                                            <span class="mt-0.5 block font-mono font-semibold text-amber-700" dir="ltr">
                                                #@(entry.PreviousTripNumber?.ToString(CultureInfo.InvariantCulture) ?? "—")
                                                →
                                                #@(entry.NewTripNumber?.ToString(CultureInfo.InvariantCulture) ?? "—")
                                            </span>
                                        }
                                    </p>
                                }

                                @if (!string.IsNullOrWhiteSpace(entry.Reason))
                                {
                                    <p class="mt-1 rounded-lg bg-slate-50 px-2.5 py-1.5 text-xs leading-5 text-slate-700" style="overflow-wrap:anywhere">
                                        @entry.Reason
                                    </p>
                                }
                            </div>
                        </li>
                    }
                </ol>

                <TableFooter TotalItems="@_details.History.TotalCount"
                             CurrentPage="_historyPage"
                             CurrentPageChanged="OnHistoryPageChanged"
                             RowsPerPage="_historyPageSize"
                             RowsPerPageChanged="OnHistoryRowsPerPageChanged" />
            }
        </section>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private TripDetails? _details;
    private IReadOnlyList<string> _allowedActions = [];
    private IReadOnlyList<PageScaffold.CrumbItem> _crumbs = [];
    private string? _error;
    private bool _loading = true;
    private bool _refreshing;
    private bool _canWrite;
    private int _historyPage = 1;
    private int _historyPageSize = 10;
    private int _loadedId;

    protected override void OnInitialized()
    {
        _historyPageSize = OrderHub.Web.Services.TripsViewPreferences.Normalize(ViewPreferences.HistoryPageSize, 10);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var result = await RequestExecutor.ExecuteAsync(
                new GetTripDetailsQuery(Id, _historyPage, _historyPageSize));

            if (!result.IsSuccess)
            {
                _details = null;
                _error = result.ErrorMessage;
                return;
            }

            _details = result.Value;
            _loadedId = Id;
            _historyPage = Math.Clamp(_historyPage, 1, Math.Max(1, _details.History.TotalPages));
            _canWrite = await PermissionAccess.IsAllowedAsync(PermissionFeature.Trips, PermissionLevel.Write);
            _allowedActions = TripPresentation.GetAllowedActions(_details.DisplayState, _canWrite);
            _crumbs =
            [
                new("المشاوير", "/trips"),
                new(TripPresentation.FormatTripNumber(_details.TripNumber, _details.SequenceYear, _details.SequenceMonth))
            ];
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load trip details {TripId}.", Id);
            _error = "تعذر تحميل المشوار. حاول مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;

        try
        {
            await LoadAsync();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static string StatusText(WorkRecordStatus? status) => status switch
    {
        WorkRecordStatus.Pending => "قيد الانتظار",
        WorkRecordStatus.Completed => "مكتمل",
        WorkRecordStatus.Cancelled => "ملغي",
        WorkRecordStatus.Failed => "فشل",
        _ => "—"
    };

    private async Task OnHistoryPageChanged(int page)
    {
        _historyPage = Math.Max(1, page);
        await LoadAsync();
    }

    private async Task OnHistoryRowsPerPageChanged(int rowsPerPage)
    {
        _historyPageSize = OrderHub.Web.Services.TripsViewPreferences.Normalize(rowsPerPage, 10);
        ViewPreferences.HistoryPageSize = _historyPageSize;
        _historyPage = 1;
        await LoadAsync();
    }

    private async Task OpenActionAsync(string action)
    {
        if (_details is null)
        {
            return;
        }

        if (action == TripPresentation.ActionEdit)
        {
            Navigation.NavigateTo($"/trips/{_details.Id}/edit");
            return;
        }

        TripActionOutcome? outcome = await TripActions.ShowAsync(
            _details.Id,
            _details.Version,
            _details.DisplayState,
            action);

        if (outcome is null)
        {
            return;
        }

        if (outcome.ReloadRequired)
        {
            Snackbar.Add("تم تحديث بيانات المشوار بعد تعارض النسخة.", Severity.Warning);
        }
        else
        {
            Snackbar.Add(TripPresentation.SuccessMessage(action), Severity.Success);
        }

        await LoadAsync();
    }
}
