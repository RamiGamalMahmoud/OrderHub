@inject IRequestExecutor RequestExecutor
@inject ILogger<TripPartyEditor> Logger

<section class="space-y-4 rounded-xl border border-slate-200 bg-slate-50/30 p-5" aria-label="@Title">
    <header class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/60 pb-3">
        <div class="flex items-center gap-2">
            <span class="@($"inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-bold {StepClasses}")">@StepNumber</span>
            <h3 class="text-sm font-bold text-slate-800">@Title</h3>
        </div>
        <span class="@($"rounded px-2 py-0.5 text-xs font-medium {SlotChipClasses}")">@SlotLabel</span>
    </header>

    <div class="space-y-3">
        <div>
            <label class="mb-1.5 block text-xs font-semibold text-slate-700" for="@FieldId("type")">نوع الجهة</label>
            <select id="@FieldId("type")"
                    value="@((int)Party.PartyType)"
                    disabled="@Disabled"
                    class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-xs font-medium text-slate-800 focus:border-brand-500 focus:outline-none disabled:bg-slate-50"
                    @onchange="PartyTypeChangedAsync">
                <option value="@((int)TripPartyType.Client)">عميل</option>
                <option value="@((int)TripPartyType.Supplier)">مورد</option>
                <option value="@((int)TripPartyType.ShippingCarrier)">شركة شحن</option>
                <option value="@((int)TripPartyType.External)">جهة خارجية</option>
            </select>
        </div>

        @if (Party.PartyType == TripPartyType.External)
        {
            <MudTextField T="string"
                          Value="Party.Name"
                          ValueChanged="@(value => UpdateAsync(draft => draft.Name = value))"
                          Label="اسم الجهة *"
                          Required="true"
                          Immediate="true"
                          MaxLength="100"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="Disabled" />

            <MudTextField T="string"
                          Value="Party.Phone"
                          ValueChanged="@(value => UpdateAsync(draft => draft.Phone = value))"
                          Label="رقم الهاتف *"
                          Required="true"
                          Immediate="true"
                          MaxLength="22"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="Disabled" />

            <MudTextField T="string"
                          Value="Party.Address"
                          ValueChanged="@(value => UpdateAsync(draft => draft.Address = value))"
                          Label="العنوان *"
                          Required="true"
                          Immediate="true"
                          MaxLength="255"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="Disabled" />

            <MudTextField T="string"
                          Value="Party.Location"
                          ValueChanged="@(value => UpdateAsync(draft => draft.Location = value))"
                          Label="رابط الموقع (اختياري)"
                          Immediate="true"
                          MaxLength="255"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Disabled="Disabled" />
        }
        else
        {
            <MudAutocomplete T="TripLookupItem"
                             Value="_selected"
                             ValueChanged="KnownPartyChangedAsync"
                             SearchFunc="SearchAsync"
                             ToStringFunc="item => item?.Name"
                             Label="@LookupLabel"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             Strict="false"
                             ResetValueOnEmptyText="true"
                             CoerceText="false"
                             Disabled="Disabled"
                             Class="w-full" />

            <p class="border-t border-slate-200/50 pt-2 text-xs leading-5 text-slate-500">
                تُحفظ بيانات الجهة (الاسم والهاتف والعنوان) من السجل المختار لحظة حفظ المشوار.
            </p>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public TripPartyDraft Party { get; set; } = null!;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private TripLookupItem? _selected;

    private bool IsDestination => Label == "إلى";

    private string Title => IsDestination ? "نقطة الوصول (إلى)" : "نقطة الانطلاق (من)";

    private string SlotLabel => IsDestination ? "موقع التسليم" : "موقع الاستلام";

    private string StepNumber => IsDestination ? "2" : "1";

    private string StepClasses => IsDestination
        ? "bg-blue-100 text-blue-700"
        : "bg-emerald-100 text-emerald-700";

    private string SlotChipClasses => IsDestination
        ? "bg-blue-50 text-blue-700"
        : "bg-emerald-50 text-emerald-700";

    private string LookupLabel => Party.PartyType switch
    {
        TripPartyType.Client => "اختر العميل",
        TripPartyType.Supplier => "اختر المورد",
        TripPartyType.ShippingCarrier => "اختر شركة الشحن",
        _ => "اختر الجهة"
    };

    protected override void OnParametersSet()
    {
        if (Party.PartyType == TripPartyType.External || Party.PartyId is not > 0)
        {
            _selected = null;
            return;
        }

        if (_selected?.Id == Party.PartyId)
        {
            return;
        }

        string name = string.IsNullOrWhiteSpace(Party.Name) ? $"#{Party.PartyId}" : Party.Name!;
        _selected = new TripLookupItem(Party.PartyId.Value, name, null);
    }

    private string FieldId(string suffix) =>
        $"trip-party-{(IsDestination ? "to" : "from")}-{suffix}";

    private async Task PartyTypeChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var value))
        {
            return;
        }

        Party.ChangeType((TripPartyType)value);
        _selected = null;
        await OnChanged.InvokeAsync();
    }

    private async Task KnownPartyChangedAsync(TripLookupItem? item)
    {
        _selected = item;
        Party.PartyId = item?.Id;
        Party.Name = item?.Name;

        await OnChanged.InvokeAsync();
    }

    private async Task UpdateAsync(Action<TripPartyDraft> update)
    {
        update(Party);
        await OnChanged.InvokeAsync();
    }

    private async Task<IEnumerable<TripLookupItem>> SearchAsync(string value, CancellationToken cancellationToken)
    {
        try
        {
            return await RequestExecutor.ExecuteAsync(
                new GetTripLookupsQuery(ToLookupKind(Party.PartyType), value, 20),
                cancellationToken);
        }
        catch (AuthorizationDeniedException)
        {
            return [];
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to search trip parties");
            return [];
        }
    }

    private static TripLookupKind ToLookupKind(TripPartyType type) => type switch
    {
        TripPartyType.Supplier => TripLookupKind.Supplier,
        TripPartyType.ShippingCarrier => TripLookupKind.ShippingCarrier,
        _ => TripLookupKind.Client
    };
}
