@using System.Linq
@using OrderHub.Application.Features.Setup.Cities.Contracts

@inject IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<WarehouseEditorDialog> Logger

<MudDialog Class="flex max-h-[92vh] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl max-w-[30rem] w-full"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-100 bg-amber-50 text-amber-600">
                    <MudIcon Icon="@(WarehouseId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.Warehouse)"
                             Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@DialogTitle</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        اربط المخزن بأمين واحد مسؤول عن حركاته
                    </p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_saving"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />

            <MudText Typo="Typo.body2" Class="p-6 text-sm text-slate-500">
                جاري تحميل بيانات المخزن...
            </MudText>
        }
        else if (_loadError is not null)
        {
            <div class="space-y-3 p-6">
                <MudAlert Severity="Severity.Error"
                          Dense="true">
                    @_loadError
                </MudAlert>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="LoadAsync"
                           Class="oh-btn oh-btn--secondary oh-btn--sm">
                    إعادة المحاولة
                </MudButton>
            </div>
        }
        else
        {
            <MudForm @ref="_form">
                <div class="min-h-0 flex-1 space-y-4 bg-slate-50/70 p-5">
                    @if (_saveError is not null)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Dense="true">
                            @_saveError
                        </MudAlert>
                    }

                    <MudTextField T="string"
                                  @bind-Value="_state.Name"
                                  Label="اسم المخزن"
                                  Placeholder="مثال: المخزن الرئيسي"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="اسم المخزن مطلوب."
                                  MaxLength="100"
                                  Validation="@(new Func<string, string?>(WarehouseEditorState.ValidateName))"
                                  Immediate="true"
                                  Disabled="_saving" />

                    <MudSelect T="int?"
                               @bind-Value="_state.KeeperUserId"
                               Label="أمين المخزن"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               RequiredError="أمين المخزن مطلوب."
                               Validation="@(new Func<int?, string?>(ValidateKeeper))"
                               Disabled="_saving">
                        @foreach (var candidate in _state.Candidates)
                        {
                            <MudSelectItem T="int?" Value="@candidate.Id">
                                @CandidateLabel(candidate)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_state.PreviousKeeperDisplayName is not null)
                    {
                        <div class="flex items-start gap-2.5 rounded-xl border border-red-100 bg-red-50 p-3 text-sm text-red-800">
                            <MudIcon Icon="@Icons.Material.Filled.Block"
                                     Size="Size.Small"
                                     Class="mt-0.5 shrink-0" />
                            <p>
                                أمين المخزن الحالي «@_state.PreviousKeeperDisplayName» غير مؤهل لإدارة المخزون. اختر أمينًا مؤهلًا قبل الحفظ.
                            </p>
                        </div>
                    }

                    <div class="rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs">
                        <header class="mb-3 flex items-center gap-2.5 border-b border-slate-100 pb-3">
                            <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-amber-100 bg-amber-50 text-amber-600">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="text-[18px]" />
                            </span>
                            <div>
                                <h3 class="text-sm font-bold text-slate-800">عنوان المخزن</h3>
                                <p class="text-[11px] text-slate-600">المدينة والعنوان مطلوبان</p>
                            </div>
                        </header>

                        @if (_cities.Count == 0)
                        {
                            <div class="mb-3 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2">
                                <p class="text-xs font-semibold text-amber-800">
                                    لا توجد مدن متاحة. يرجى إضافة مدينة أولًا ثم إعادة المحاولة.
                                </p>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="LoadAsync"
                                           Class="oh-btn oh-btn--secondary oh-btn--sm">
                                    إعادة المحاولة
                                </MudButton>
                            </div>
                        }

                        <div class="space-y-3">
                            <MudSelect T="int?"
                                       @bind-Value="_state.CityId"
                                       Label="المدينة"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Required="true"
                                       RequiredError="اختر المدينة."
                                       Validation="@(new Func<int?, string?>(WarehouseEditorState.ValidateCity))"
                                       Disabled="_saving">
                                @foreach (var city in _cities)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)city.Id)">
                                        @city.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="string"
                                          @bind-Value="_state.Street"
                                          Label="العنوان"
                                          Placeholder="مثال: شارع الملك فهد"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="عنوان المخزن مطلوب."
                                          MaxLength="150"
                                          Validation="@(new Func<string, string?>(WarehouseEditorState.ValidateStreet))"
                                          Immediate="true"
                                          Disabled="_saving" />
                        </div>

                        @if (WarehouseId.HasValue && _state.CityId is null)
                        {
                            <div class="mt-3 flex items-start gap-2.5 rounded-xl border border-amber-100 bg-amber-50 p-3 text-sm text-amber-800">
                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                                         Size="Size.Small"
                                         Class="mt-0.5 shrink-0" />
                                <p>
                                    هذا المخزن أُنشئ قبل إضافة العناوين. أدخل المدينة والعنوان لحفظ أي تعديل.
                                </p>
                            </div>
                        }
                    </div>

                    <div class="rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs">
                        <header class="mb-3 flex items-center gap-2.5 border-b border-slate-100 pb-3">
                            <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-teal-100 bg-teal-50 text-teal-600">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Class="text-[18px]" />
                            </span>
                            <div>
                                <h3 class="text-sm font-bold text-slate-800">هاتف المخزن</h3>
                                <p class="text-[11px] text-slate-600">اختياري</p>
                            </div>
                        </header>

                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-12">
                            <div class="sm:col-span-4">
                                <MudTextField T="string"
                                              @bind-Value="_state.CountryCode"
                                              Label="مفتاح الدولة"
                                              Placeholder="+966"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              MaxLength="4"
                                              Validation="@(new Func<string, string?>(_state.ValidateCountryCode))"
                                              Immediate="true"
                                              Disabled="_saving" />
                            </div>

                            <div class="sm:col-span-8">
                                <MudTextField T="string"
                                              @bind-Value="_state.PhoneNumber"
                                              Label="رقم الهاتف"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              MaxLength="14"
                                              Validation="@(new Func<string, string?>(_state.ValidatePhone))"
                                              Immediate="true"
                                              Disabled="_saving" />
                            </div>
                        </div>
                    </div>

                    @if (WarehouseId.HasValue)
                    {
                        <div class="space-y-1">
                            <MudSwitch T="bool"
                                       @bind-Value="_state.IsActive"
                                       Label="المخزن نشط"
                                       Color="Color.Success"
                                       Disabled="_saving" />

                            <p class="text-xs text-slate-500">
                                لا يمكن إيقاف المخزن ما دام يحمل أرصدة موجبة أو كميات تالفة.
                            </p>
                        </div>
                    }
                </div>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <footer class="flex items-center justify-between gap-3 border-t border-slate-100 bg-white p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="inline-flex h-2.5 w-2.5 rounded-full @(SaveDisabled ? "bg-slate-300" : "bg-emerald-500")"></span>
                <span>@(SaveDisabled ? "غير جاهز للحفظ" : "جاهز للحفظ")</span>
            </div>

            <div class="flex items-center gap-2">
                <MudButton Disabled="_saving"
                           OnClick="Cancel"
                           Variant="Variant.Text"
                           Class="oh-btn oh-btn--secondary">
                    إلغاء
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="SaveDisabled"
                           OnClick="SaveAsync"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="oh-btn oh-btn--primary">
                    @SaveButtonText
                </MudButton>
            </div>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int? WarehouseId { get; set; }

    private WarehouseEditorState _state = new();
    private MudForm? _form;
    private IReadOnlyList<CityInfo> _cities = [];
    private string? _loadError;
    private string? _saveError;
    private bool _loading = true;
    private bool _saving;

    private string DialogTitle =>
        WarehouseId.HasValue ? "تعديل المخزن" : "إضافة مخزن";

    private string SaveButtonText
    {
        get
        {
            if (_saving)
            {
                return "جاري الحفظ...";
            }

            return WarehouseId.HasValue ? "حفظ التعديلات" : "إضافة";
        }
    }

    private bool SaveDisabled =>
        _loading || _saving || _loadError is not null || _cities.Count == 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _state = new WarehouseEditorState();

        try
        {
            var candidates = await RequestExecutor.ExecuteAsync(new GetWarehouseKeeperCandidatesQuery());
            var cities = await RequestExecutor.ExecuteAsync(new GetWarehouseEditorCitiesQuery());
            _cities = cities.ToList();

            if (WarehouseId is int warehouseId)
            {
                var warehouse = await RequestExecutor.ExecuteAsync(new GetWarehouseQuery(warehouseId));

                if (warehouse is null)
                {
                    _loadError = "المخزن غير موجود.";
                    return;
                }

                _state = WarehouseEditorState.FromWarehouse(warehouse);

                if (_state.KeeperUserId is int keeperId &&
                    candidates.All(candidate => candidate.Id != keeperId))
                {
                    _state.PreviousKeeperDisplayName = warehouse.KeeperDisplayName;
                    _state.KeeperUserId = null;
                }
            }

            _state.Candidates.AddRange(candidates);
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load warehouse {WarehouseId}",
                WarehouseId);

            _loadError = "تعذر تحميل بيانات المخزن. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CandidateLabel(WarehouseKeeperCandidate candidate) =>
        candidate.DisplayName;

    private static string? ValidateKeeper(int? keeperUserId) =>
        keeperUserId.HasValue ? null : "أمين المخزن مطلوب.";

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();

            if (!_form.IsValid ||
                _state.KeeperUserId is not int keeperUserId ||
                _state.CityId is not int cityId)
            {
                return;
            }

            Result result;

            if (WarehouseId is int warehouseId)
            {
                result = await RequestExecutor.ExecuteAsync(
                    new UpdateWarehouseCommand(
                        new(
                            warehouseId,
                            _state.Name,
                            keeperUserId,
                            _state.IsActive,
                            cityId,
                            _state.Street,
                            _state.PhoneNumber,
                            _state.CountryCode)));
            }
            else
            {
                result = await RequestExecutor.ExecuteAsync(
                    new CreateWarehouseCommand(
                        new(
                            _state.Name,
                            keeperUserId,
                            cityId,
                            _state.Street,
                            _state.PhoneNumber,
                            _state.CountryCode)));
            }

            if (!result.IsSuccess)
            {
                _saveError = result.ErrorMessage;
                return;
            }

            Snackbar.Add(
                WarehouseId.HasValue
                    ? "تم حفظ تعديلات المخزن بنجاح."
                    : "تمت إضافة المخزن بنجاح.",
                Severity.Success);

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save warehouse {WarehouseId}",
                WarehouseId);

            _saveError = "تعذر حفظ المخزن. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}
