@using System.Globalization
@using OrderHub.Application.Features.Setup.Categories

<MudCard Outlined="true"
         Class="category-card d-flex flex-column"
         Style="@($"height: 100%; --category-accent: {AccentHex};")">
    <MudCardContent Class="pa-4 flex-grow-1">
        <MudStack Spacing="3">
            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <span class="category-card-icon">
                    <MudIcon Icon="@Icons.Material.Filled.Category" aria-hidden="true" />
                </span>

                @if (CanWrite)
                {
                    <MudStack Row Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       OnClick="EditAsync"
                                       Disabled="Busy"
                                       aria-label="تعديل القسم"
                                       Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="Busy"
                                       OnClick="DeleteAsync"
                                       aria-label="حذف القسم"
                                       Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost oh-btn--danger" />
                    </MudStack>
                }
            </MudStack>

            <div class="category-card-copy">
                <MudText Typo="Typo.subtitle1"
                         Class="font-weight-bold"
                         Style="overflow-wrap: anywhere">
                    @Category.Name
                </MudText>
                @if (!string.IsNullOrWhiteSpace(Category.Description))
                {
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="category-card-description">
                        @Category.Description
                    </MudText>
                }
            </div>

            <div class="category-card-counts">
                <span class="category-count-chip">
                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" aria-hidden="true" />
                    @Category.DirectChildrenCount.ToString(CultureInfo.InvariantCulture) أقسام فرعية
                </span>
                <span class="category-count-chip">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" aria-hidden="true" />
                    @Category.TotalProductsCount.ToString(CultureInfo.InvariantCulture) منتجات
                </span>
            </div>
        </MudStack>
    </MudCardContent>

    <MudCardActions Class="pa-3 pt-0">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                   Disabled="@(!Category.HasChildren || Busy)"
                   Href="@SubCategoriesUrl"
                   EndIcon="@Icons.Material.Filled.ArrowBack">
            @SubCategoriesButtonText
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public CategoryIndexItem Category { get; set; } = null!;

    [Parameter]
    public bool CanWrite { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<CategoryIndexItem> OnDelete { get; set; }

    [Parameter]
    public EventCallback<CategoryIndexItem> OnEdit { get; set; }

    private string AccentHex => Category.Color;

    private string? SubCategoriesUrl =>
        Category.HasChildren ? $"/categories/{Category.Id}" : null;

    private string SubCategoriesButtonText =>
        Category.HasChildren ? "الأقسام الفرعية" : "لا توجد أقسام فرعية";

    private Task DeleteAsync() => OnDelete.InvokeAsync(Category);

    private Task EditAsync() => OnEdit.InvokeAsync(Category);
}
