@page "/categories"
@page "/categories/{ParentId:int}"

@attribute [PermissionAuthorize(
    PermissionFeature.Categories,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<Index> Logger

<PageTitle>@CurrentHeading</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="@CurrentHeading"
                  Description="إدارة أقسام المنتجات"
                  Crumbs="_scaffoldCrumbs">
        <Actions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="oh-btn oh-btn--primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialogAsync"
                           Disabled="_deleting || _dialogOpen">
                    @CreateButtonText
                </MudButton>
            }
        </Actions>
    </PageScaffold>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true"
                           Color="Color.Primary" />

        <MudText Typo="Typo.body2">
            جاري تحميل الأقسام...
        </MudText>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Dense="true">
            @_error
        </MudAlert>

        <MudButton Variant="Variant.Outlined"
                   OnClick="LoadAsync"
                   Class="oh-btn oh-btn--secondary oh-btn--sm">
            إعادة المحاولة
        </MudButton>
    }
    else if (_response?.ParentExists == false)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true">
            القسم غير موجود.
        </MudAlert>

        <MudButton Href="/categories"
                   StartIcon="@Icons.Material.Filled.ArrowForward"
                   Class="oh-btn oh-btn--secondary oh-btn--sm">
            الرجوع للأقسام
        </MudButton>
    }
    else if (_response is not null)
    {
        @if (_response.Categories.Count == 0)
        {
            <MudPaper Outlined="true"
                      Class="pa-6 rounded-2xl border-slate-200 bg-white">

                <MudText Typo="Typo.body1">
                    @EmptyMessage
                </MudText>

                @if (_canWrite)
                {
                    <MudButton Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="oh-btn oh-btn--secondary oh-btn--sm mt-2"
                               OnClick="OpenCreateDialogAsync"
                               Disabled="_deleting || _dialogOpen">
                        @CreateButtonText
                    </MudButton>
                }

            </MudPaper>
        }
        else
        {
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var category in _response.Categories)
                {
                    <div @key="category.Id" class="min-w-0">
                        <CategoryCard Category="category"
                                      CanWrite="_canWrite"
                                      Busy="_deleting || _dialogOpen"
                                      OnEdit="OpenEditDialogAsync"
                                      OnDelete="ConfirmDeleteAsync" />
                    </div>
                }
            </div>
        }
    }

</div>

@code {
    [Parameter]
    public int? ParentId { get; set; }


    private GetCategoriesResponse? _response;

    private IReadOnlyList<PageScaffold.CrumbItem> _scaffoldCrumbs = [];

    private bool _loading = true;
    private bool _canWrite;
    private bool _deleting;
    private bool _dialogOpen;

    private string? _error;

    private int _loadVersion;


    private bool CanCreate =>
        _canWrite &&
        !_dialogOpen &&
        !_loading &&
        _response?.ParentExists == true;

    private string CurrentHeading =>
        ParentId.HasValue && _response?.Path.LastOrDefault() is { } current
            ? current.Name
            : "الأقسام";

    private string CreateButtonText =>
        ParentId.HasValue
            ? "إضافة قسم فرعي"
            : "إضافة قسم";

    private string EmptyMessage =>
        ParentId.HasValue
            ? "لا توجد أقسام فرعية في هذا القسم."
            : "لم تتم إضافة أقسام بعد.";


    protected override Task OnParametersSetAsync()
    {
        return LoadAsync();
    }


    private async Task LoadAsync()
    {
        int version = ++_loadVersion;
        int? parentId = ParentId;

        _loading = true;
        _canWrite = false;
        _error = null;

        try
        {
            var response = await RequestExecutor.ExecuteAsync(
                new GetCategoriesQuery(parentId));

            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Categories,
                PermissionLevel.Write);

            if (version != _loadVersion)
            {
                return;
            }

            _response = response;
            _canWrite = canWrite;
            _scaffoldCrumbs = BuildScaffoldCrumbs(response, parentId);
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load categories for {ParentId}",
                parentId);

            if (version == _loadVersion)
            {
                _error = "تعذر تحميل الأقسام. يرجى المحاولة مرة أخرى.";
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }


    private static IReadOnlyList<PageScaffold.CrumbItem> BuildScaffoldCrumbs(
        GetCategoriesResponse response,
        int? parentId)
    {
        if (parentId is null)
        {
            return [new("الأقسام")];
        }

        List<PageScaffold.CrumbItem> crumbs = [new("الأقسام", "/categories")];
        var ancestors = response.Path.Take(Math.Max(0, response.Path.Count - 1));
        crumbs.AddRange(ancestors.Select(segment =>
            new PageScaffold.CrumbItem(segment.Name, $"/categories/{segment.Id}")));

        if (response.Path.Count > 0)
            crumbs.Add(new PageScaffold.CrumbItem(response.Path[^1].Name));

        return crumbs;
    }


    private Task OpenCreateDialogAsync() => OpenEditorAsync(null, ParentId);


    private Task OpenEditDialogAsync(CategoryIndexItem category) =>
        OpenEditorAsync(category.Id, null);


    private async Task OpenEditorAsync(int? categoryId, int? parentId)
    {
        if (_deleting || _dialogOpen || !_canWrite)
        {
            return;
        }

        _dialogOpen = true;

        try
        {
            DialogParameters<CategoryEditorDialog> parameters = new()
            {
                { dialog => dialog.CategoryId, categoryId },
                { dialog => dialog.ParentId, parentId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            string title = categoryId.HasValue ? "تعديل القسم" : "إضافة قسم";

            var dialog = await DialogService.ShowAsync<CategoryEditorDialog>(
                title,
                parameters,
                options);

            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await LoadAsync();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open category editor for {CategoryId}",
                categoryId);

            Snackbar.Add(
                "تعذر فتح محرر القسم. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _dialogOpen = false;
        }
    }


    private async Task ConfirmDeleteAsync(CategoryIndexItem category)
    {
        if (_deleting || _dialogOpen)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف القسم",
                $"هل تريد حذف القسم \"{category.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            var result = await RequestExecutor.ExecuteAsync(
                new DeleteCategoryCommand(category.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(
                    result.ErrorMessage,
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                "تم حذف القسم بنجاح.",
                Severity.Success);

            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete category {CategoryId}",
                category.Id);

            Snackbar.Add(
                "تعذر حذف القسم. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
