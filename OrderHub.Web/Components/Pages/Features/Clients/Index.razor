@page "/clients"

@attribute [PermissionAuthorize(
    PermissionFeature.Clients,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>العملاء</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="العملاء"
                  Description="إدارة بيانات العملاء ووسائل التواصل"
                  Crumbs="_scaffoldCrumbs"
                  Count="@BadgeCount">
        <Actions>
            @if (CanCreate)
            {
                <ClientEditorButton Size="Size.Large"
                                    Class="rounded-xl px-5 font-bold shadow-sm"
                                    OnSaved="LoadAsync" />
            }
        </Actions>
    </PageScaffold>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        @* ============================================================
           Toolbar: search + refresh
           ============================================================ *@
        <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 px-4 py-3">
            <MudTextField T="string"
                          Value="_searchTerm"
                          ValueChanged="SearchChangedAsync"
                          Placeholder="ابحث بالاسم أو الهاتف أو العنوان"
                          aria-label="البحث عن عميل"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Disabled="IsBusy"
                          Class="w-full sm:max-w-xs" />

            <div class="flex-1"></div>

            <MudTooltip Text="تحديث القائمة">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshAsync"
                               aria-label="تحديث القائمة"
                               Disabled="IsBusy"
                               Class="rounded-lg text-slate-500" />
            </MudTooltip>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary"
                               aria-label="تحميل العملاء" />
        }

        @if (_error is not null)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-red-100 bg-red-50 px-4 py-3">
                <p class="text-sm font-bold text-red-800">@_error</p>
                <button type="button"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-white px-3 py-1.5 text-xs font-bold text-red-700 transition-colors hover:bg-red-100 disabled:cursor-not-allowed disabled:opacity-60"
                        disabled="@(_loading || _deleting)"
                        @onclick="LoadAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="text-[14px]" />
                    إعادة المحاولة
                </button>
            </div>
        }

        @* ============================================================
           Clients table
           ============================================================ *@
        <MudTable T="ClientListItem"
                  @ref="_table"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@_pageSize"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Square="true"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="text-xs font-bold text-slate-500">العميل</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الهاتف</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">العنوان</MudTh>
                @if (_canWrite)
                {
                    <MudTh Class="w-24 text-xs font-bold text-slate-500">
                        <span class="sr-only">الإجراءات</span>
                    </MudTh>
                }
            </HeaderContent>

            <RowTemplate Context="client">
                <MudTd DataLabel="العميل" Style="overflow-wrap:anywhere">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-black text-brand-600">
                            @FirstLetter(client.Name)
                        </span>
                        <span class="text-sm font-bold text-slate-900">@client.Name</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="الهاتف">
                    @if (string.IsNullOrWhiteSpace(client.PhoneNumber))
                    {
                        <span class="text-sm text-slate-400">—</span>
                    }
                    else
                    {
                        <span class="tabular-nums text-sm font-semibold text-slate-700" dir="ltr">@client.PhoneNumber</span>
                    }
                </MudTd>

                <MudTd DataLabel="العنوان"
                       Class="text-sm text-slate-700"
                       Style="overflow-wrap:anywhere">@ContactText(client.Address)</MudTd>

                @if (_canWrite)
                {
                    <MudTd DataLabel="الإجراءات">
                        <div class="flex items-center justify-end gap-1.5">
                            <MudTooltip Text="تعديل العميل">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="rounded-lg text-brand-600 shadow-none hover:bg-brand-50"
                                               aria-label="تعديل العميل"
                                               OnClick="@(() => OpenEditDialogAsync(client))"
                                               Disabled="IsBusy" />
                            </MudTooltip>

                            <MudTooltip Text="حذف العميل">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Class="rounded-lg shadow-none"
                                               aria-label="حذف العميل"
                                               OnClick="@(() => ConfirmDeleteAsync(client))"
                                               Disabled="IsBusy" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                }
            </RowTemplate>

            <NoRecordsContent>
                <div class="py-8 text-center">
                    <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Filled.People" aria-hidden="true" />
                    </span>
                    <p class="text-base font-bold text-slate-900">@EmptyTitle</p>
                    <p class="mt-1 text-sm text-slate-500">@EmptyHint</p>
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="flex flex-col items-center gap-2 py-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <p class="text-sm text-slate-500">جاري تحميل العملاء...</p>
                </div>
            </LoadingContent>

            <PagerContent>
                <TableFooter TotalItems="@TotalCount"
                             CurrentPage="_pageIndex"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="_pageSize"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>
        </MudTable>
    </section>
</div>

@code {
    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs = [new("العملاء")];

    private MudTable<ClientListItem>? _table;
    private IReadOnlyList<ClientListItem> _clients = [];
    private string? _searchTerm;
    private string? _error;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private bool _loading = true;
    private bool _canWrite;
    private bool _dialogOpen;
    private bool _deleting;

    private bool CanCreate =>
        _canWrite && !_loading && _error is null;

    private bool IsBusy =>
        _loading || _dialogOpen || _deleting;

    private List<ClientListItem> FilteredClients
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _clients.ToList();
            }

            string searchTerm = _searchTerm.Trim();

            return _clients.Where(client =>
                client.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (client.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                (client.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                (client.Location?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)).ToList();
        }
    }

    private int TotalCount => FilteredClients.Count;
    private int? BadgeCount => _loading && _clients.Count == 0 ? null : TotalCount;

    private string EmptyTitle
    {
        get
        {
            if (_loading)
            {
                return "جاري تحميل العملاء...";
            }
            if (_error is not null)
            {
                return "تعذر تحميل العملاء.";
            }
            return string.IsNullOrWhiteSpace(_searchTerm) ? "لم تتم إضافة عملاء بعد." : "لا توجد نتائج مطابقة";
        }
    }

    private string EmptyHint
    {
        get
        {
            if (_loading)
            {
                return "يتم جلب بيانات العملاء من الخادم.";
            }
            if (_error is not null)
            {
                return "حدّث القائمة أو حاول مرة أخرى.";
            }
            return string.IsNullOrWhiteSpace(_searchTerm)
                ? "أضف عميلًا جديدًا ليظهر في القائمة."
                : "جرّب تعديل عبارة البحث للحصول على نتائج.";
        }
    }

    private static string FirstLetter(string name)
    {
        string trimmed = name.Trim();

        return trimmed.Length == 0 ? "—" : trimmed[..1];
    }

    private static string ContactText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _canWrite = false;
        _error = null;

        try
        {
            var clients = await RequestExecutor.ExecuteAsync(new GetAllClientsQuery());
            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Clients,
                PermissionLevel.Write);

            _clients = clients.ToList();
            _canWrite = canWrite;

            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load clients");
            _error = "تعذر تحميل العملاء. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<TableData<ClientListItem>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        var filtered = FilteredClients;
        int lastPage = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)_pageSize));
        _pageIndex = Math.Clamp(_pageIndex, 1, lastPage);

        return Task.FromResult(new TableData<ClientListItem>
        {
            Items = filtered.Skip((_pageIndex - 1) * _pageSize).Take(_pageSize).ToList(),
            TotalItems = filtered.Count
        });
    }

    private async Task SearchChangedAsync(string? value)
    {
        _searchTerm = value;
        _pageIndex = 1;

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task RefreshAsync()
    {
        if (IsBusy)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task OnFooterPageChanged(int page)
    {
        _pageIndex = Math.Max(1, page);

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _pageSize = rowsPerPage;
        _pageIndex = 1;

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private Task OpenEditDialogAsync(ClientListItem client) => OpenEditorAsync(client.Id);

    private async Task OpenEditorAsync(int? clientId)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _dialogOpen = true;

        try
        {
            DialogParameters<ClientEditorDialog> parameters = new()
            {
                { dialog => dialog.ClientId, clientId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            string title = clientId.HasValue ? "تعديل العميل" : "إضافة عميل";

            var dialog = await DialogService.ShowAsync<ClientEditorDialog>(
                title,
                parameters,
                options);

            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await LoadAsync();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open client editor for {ClientId}",
                clientId);

            Snackbar.Add(
                "تعذر فتح بيانات العميل. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _dialogOpen = false;
        }
    }

    private async Task ConfirmDeleteAsync(ClientListItem client)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف العميل",
                $"هل تريد حذف العميل \"{client.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            Result result = await RequestExecutor.ExecuteAsync(new DeleteClientCommand(client.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add("تم حذف العميل بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete client {ClientId}",
                client.Id);

            Snackbar.Add(
                "تعذر حذف العميل. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
