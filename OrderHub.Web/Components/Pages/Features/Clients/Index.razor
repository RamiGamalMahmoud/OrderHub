@page "/clients"

@attribute [PermissionAuthorize(
    PermissionFeature.Clients,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>العملاء</PageTitle>

<MudStack Spacing="3">
    <MudStack Row
              Wrap="Wrap.Wrap"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h5">
                العملاء
            </MudText>

            <MudText Typo="Typo.body2"
                     Color="Color.Secondary">
                إدارة بيانات العملاء ووسائل التواصل
            </MudText>
        </div>

        @if (CanCreate)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="IsBusy"
                       OnClick="OpenCreateDialogAsync">
                إضافة عميل
            </MudButton>
        }
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true"
                           Color="Color.Primary" />

        <MudText Typo="Typo.body2">
            جاري تحميل العملاء...
        </MudText>
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Dense="true">
            @_error
        </MudAlert>

        <MudButton Variant="Variant.Outlined"
                   OnClick="LoadAsync">
            إعادة المحاولة
        </MudButton>
    }
    else if (_clients.Count == 0)
    {
        <MudPaper Outlined="true"
                  Class="pa-4">
            <MudText Typo="Typo.body1">
                لم تتم إضافة عملاء بعد.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudTable T="ClientListItem"
                  Items="FilteredClients"
                  Dense="true"
                  Hover="true"
                  Outlined="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Sm">
            <ToolBarContent>
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="ابحث عن عميل..."
                              aria-label="البحث عن عميل"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Style="max-width:320px" />
            </ToolBarContent>

            <HeaderContent>
                <MudTh>
                    اسم العميل
                </MudTh>

                <MudTh>
                    الهاتف
                </MudTh>

                <MudTh>
                    العنوان
                </MudTh>

                @if (_canWrite)
                {
                    <MudTh>
                        الإجراءات
                    </MudTh>
                }
            </HeaderContent>

            <RowTemplate Context="client">
                <MudTd DataLabel="اسم العميل"
                       Style="overflow-wrap:anywhere">
                    @client.Name
                </MudTd>

                <MudTd DataLabel="الهاتف"
                       Style="overflow-wrap:anywhere">
                    @ContactText(client.PhoneNumber)
                </MudTd>

                <MudTd DataLabel="العنوان"
                       Style="overflow-wrap:anywhere">
                    @ContactText(client.Address)
                </MudTd>

                @if (_canWrite)
                {
                    <MudTd DataLabel="الإجراءات">
                        <MudStack Row
                                  Spacing="0">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Disabled="IsBusy"
                                           aria-label="تعديل العميل"
                                           OnClick="@(() => OpenEditDialogAsync(client))" />

                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Disabled="IsBusy"
                                           aria-label="حذف العميل"
                                           OnClick="@(() => ConfirmDeleteAsync(client))" />
                        </MudStack>
                    </MudTd>
                }
            </RowTemplate>

            <NoRecordsContent>
                <MudText Typo="Typo.body2">
                    لا يوجد عملاء يطابقون البحث.
                </MudText>
            </NoRecordsContent>

            <PagerContent>
                @if (_clients.Count > 10)
                {
                    <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })"
                                   RowsPerPageString="عملاء لكل صفحة"
                                   InfoFormat="{first_item}-{last_item} من {all_items}" />
                }
            </PagerContent>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<ClientListItem> _clients = [];
    private string? _searchTerm;
    private string? _error;
    private bool _loading = true;
    private bool _canWrite;
    private bool _dialogOpen;
    private bool _deleting;

    private bool CanCreate =>
        _canWrite && !_loading && _error is null;

    private bool IsBusy =>
        _loading || _dialogOpen || _deleting;

    private IEnumerable<ClientListItem> FilteredClients
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _clients;
            }

            string searchTerm = _searchTerm.Trim();

            return _clients.Where(client =>
                client.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (client.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                (client.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                (client.Location?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
        }
    }

    private static string ContactText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _canWrite = false;
        _error = null;

        try
        {
            var clients = await RequestExecutor.ExecuteAsync(new GetAllClientsQuery());
            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Clients,
                PermissionLevel.Write);

            _clients = clients.ToList();
            _canWrite = canWrite;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load clients");
            _error = "تعذر تحميل العملاء. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OpenCreateDialogAsync() => OpenEditorAsync(null);

    private Task OpenEditDialogAsync(ClientListItem client) => OpenEditorAsync(client.Id);

    private async Task OpenEditorAsync(int? clientId)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _dialogOpen = true;

        try
        {
            DialogParameters<ClientEditorDialog> parameters = new()
            {
                { dialog => dialog.ClientId, clientId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            string title = clientId.HasValue ? "تعديل العميل" : "إضافة عميل";

            var dialog = await DialogService.ShowAsync<ClientEditorDialog>(
                title,
                parameters,
                options);

            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await LoadAsync();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open client editor for {ClientId}",
                clientId);

            Snackbar.Add(
                "تعذر فتح بيانات العميل. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _dialogOpen = false;
        }
    }

    private async Task ConfirmDeleteAsync(ClientListItem client)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف العميل",
                $"هل تريد حذف العميل \"{client.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            Result result = await RequestExecutor.ExecuteAsync(new DeleteClientCommand(client.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add("تم حذف العميل بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete client {ClientId}",
                client.Id);

            Snackbar.Add(
                "تعذر حذف العميل. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
