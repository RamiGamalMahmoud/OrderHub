@inject IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<DeliverymanEditorDialog> Logger

<MudDialog Class="flex max-h-[92vh] w-full max-w-[32rem] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50 text-blue-600">
                    <MudIcon Icon="@(DeliverymanId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)"
                             Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@DialogTitle</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        بيانات المندوب والمدينة ووسيلة التواصل
                    </p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_saving"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />

            <MudText Typo="Typo.body2" Class="p-6 text-sm text-slate-500">
                جاري تحميل بيانات المندوب...
            </MudText>
        }
        else if (_loadError is not null)
        {
            <div class="space-y-3 p-6">
                <div class="rounded-lg border border-red-100 bg-red-50 px-3 py-2">
                    <p class="text-xs font-bold text-red-800">@_loadError</p>
                </div>

                <button type="button"
                        class="oh-btn oh-btn--danger oh-btn--sm"
                        @onclick="LoadAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="text-[14px]" />
                    إعادة المحاولة
                </button>
            </div>
        }
        else
        {
            <MudForm @ref="_form">
                <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-5">
                    @if (_saveError is not null)
                    {
                        <div class="rounded-lg border border-red-100 bg-red-50 px-3 py-2">
                            <p class="text-xs font-bold text-red-800" role="alert">@_saveError</p>
                        </div>
                    }

                    @if (_cities.Count == 0)
                    {
                        <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2">
                            <p class="text-xs font-semibold text-amber-800">
                                لا توجد مدن متاحة. يرجى إضافة مدينة أولًا ثم إعادة المحاولة.
                            </p>
                            <button type="button"
                                    class="oh-btn oh-btn--secondary oh-btn--sm"
                                    disabled="@_saving"
                                    @onclick="LoadAsync">
                                إعادة المحاولة
                            </button>
                        </div>
                    }

                    @* ---------- Card 1: deliveryman identity ---------- *@
                    <section class="rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs">
                        <header class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-blue-100 bg-blue-50 text-sm text-brand-600">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="text-[18px]" />
                                </span>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-800">بيانات المندوب</h3>
                                    <p class="text-[11px] text-slate-600">الاسم والمدينة</p>
                                </div>
                            </div>
                            <span class="inline-flex items-center rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-700">
                                مطلوب
                            </span>
                        </header>

                        <div class="space-y-3">
                            <MudTextField T="string"
                                          @bind-Value="_state.Name"
                                          Label="اسم المندوب"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="اسم المندوب مطلوب."
                                          MaxLength="100"
                                          Validation="@(new Func<string, string?>(DeliverymanEditorState.ValidateName))"
                                          Immediate="true"
                                          Disabled="_saving" />

                            <MudSelect T="int?"
                                       @bind-Value="_state.CityId"
                                       Label="المدينة"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Required="true"
                                       RequiredError="اختر المدينة."
                                       Disabled="_saving">
                                @foreach (var city in _cities)
                                {
                                    <MudSelectItem T="int?" Value="@((int?)city.Id)">
                                        @city.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </section>

                    @* ---------- Card 2: contact details ---------- *@
                    <section class="rounded-xl border border-slate-200/90 bg-white p-4 shadow-xs">
                        <header class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-teal-100 bg-teal-50 text-sm text-teal-600">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Class="text-[18px]" />
                                </span>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-800">بيانات التواصل</h3>
                                    <p class="text-[11px] text-slate-600">رقم هاتف المندوب</p>
                                </div>
                            </div>
                        </header>

                        <MudTextField T="string"
                                      @bind-Value="_state.PhoneNumber"
                                      Label="رقم الهاتف (اختياري)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="15"
                                      Validation="@(new Func<string, string?>(DeliverymanEditorState.ValidatePhone))"
                                      Immediate="true"
                                      Disabled="_saving" />
                    </section>
                </div>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <footer class="flex items-center justify-between gap-3 border-t border-slate-100 bg-white p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="inline-flex h-2.5 w-2.5 rounded-full @(SaveDisabled ? "bg-slate-300" : "bg-emerald-500")"></span>
                <span>@(SaveDisabled ? "غير جاهز للحفظ" : "جاهز للحفظ")</span>
            </div>

            <div class="flex items-center gap-2">
                <button type="button"
                        class="oh-btn oh-btn--secondary"
                        disabled="@_saving"
                        @onclick="Cancel">
                    إلغاء
                </button>

                <button type="button"
                        class="oh-btn oh-btn--primary"
                        disabled="@SaveDisabled"
                        aria-busy="@_saving"
                        @onclick="SaveAsync">
                    @if (_saving)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Save" Class="text-[12px]" />
                    }
                    @SaveButtonText
                </button>
            </div>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int? DeliverymanId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private DeliverymanEditorState _state = new();
    private MudForm? _form;
    private IReadOnlyList<CityInfo> _cities = [];
    private string? _loadError;
    private string? _saveError;
    private bool _loading = true;
    private bool _saving;

    private string DialogTitle =>
        DeliverymanId.HasValue
            ? "تعديل المندوب"
            : "إضافة مندوب";

    private string SaveButtonText
    {
        get
        {
            if (_saving)
            {
                return "جاري الحفظ...";
            }

            return DeliverymanId.HasValue ? "حفظ التعديلات" : "حفظ المندوب";
        }
    }

    private bool SaveDisabled =>
        _loading || _saving || _loadError is not null || _cities.Count == 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _state = new DeliverymanEditorState();

        try
        {
            if (DeliverymanId is int deliverymanId)
            {
                var deliveryman = await RequestExecutor.ExecuteAsync(new GetDeliverymanForEditQuery(deliverymanId));

                if (deliveryman is null)
                {
                    _loadError = "تعذر العثور على المندوب المطلوب.";
                    return;
                }

                _state = DeliverymanEditorState.FromRead(deliveryman);
            }

            var cities = await RequestExecutor.ExecuteAsync(new GetDeliverymanEditorCitiesQuery());
            _cities = cities.OrderBy(city => city.Name).ThenBy(city => city.Id).ToList();
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load deliveryman {DeliverymanId}",
                DeliverymanId);

            _loadError = "تعذر تحميل بيانات المندوب. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();

            if (!_form.IsValid)
            {
                return;
            }

            _saveError = _state.ValidateAdditional();

            if (_saveError is not null)
            {
                return;
            }

            Result result;

            if (DeliverymanId is int deliverymanId)
            {
                result = await RequestExecutor.ExecuteAsync(
                    _state.UpdateCommand(deliverymanId));
            }
            else
            {
                result = await RequestExecutor.ExecuteAsync(
                    _state.CreateCommand());
            }

            if (!result.IsSuccess)
            {
                _saveError = result.ErrorMessage;
                return;
            }

            Snackbar.Add("تم حفظ المندوب بنجاح.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save deliveryman {DeliverymanId}",
                DeliverymanId);

            _saveError = "تعذر حفظ المندوب. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}
