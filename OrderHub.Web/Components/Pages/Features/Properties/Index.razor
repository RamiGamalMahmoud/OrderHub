@page "/properties"

@attribute [PermissionAuthorize(
    PermissionFeature.Properties,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>خصائص المنتجات</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="خصائص المنتجات"
                  Description="إدارة خصائص وخيارات المنتجات"
                  Crumbs="_scaffoldCrumbs"
                  Count="@_properties.Count">
        <Actions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="rounded-xl px-5 font-bold shadow-sm"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="IsBusy"
                           OnClick="OpenCreateDialogAsync">
                    إضافة خاصية
                </MudButton>
            }
        </Actions>
    </PageScaffold>

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل خصائص المنتجات...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
            <MudAlert Severity="Severity.Error"
                      Dense="true">
                @_error
            </MudAlert>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="mt-3"
                       OnClick="LoadAsync">
                إعادة المحاولة
            </MudButton>
        </div>
    }
    else if (_properties.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                <MudIcon Icon="@Icons.Material.Filled.Tune" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">لم تتم إضافة خصائص بعد.</p>
            <p class="mt-1 text-sm text-slate-500">أضف أول خاصية ليظهر في الجدول أعلاه.</p>
        </div>
    }
    else
    {
        <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="ابحث عن خاصية..."
                              aria-label="البحث عن خاصية"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Class="w-full max-w-xs" />

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="IsBusy"
                               aria-label="تحديث القائمة"
                               OnClick="LoadAsync"
                               Class="rounded-lg" />
            </div>

            <MudTable T="PropertyListItem"
                      Items="FilteredProperties"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Square="true"
                      Breakpoint="Breakpoint.Sm"
                      @bind-CurrentPage="_currentPage"
                      @bind-RowsPerPage="_rowsPerPage">

                <HeaderContent>
                    <MudTh Class="text-xs font-bold text-slate-500">
                        اسم الخاصية
                    </MudTh>

                    <MudTh Class="text-xs font-bold text-slate-500">
                        النوع
                    </MudTh>

                    <MudTh Class="text-xs font-bold text-slate-500">
                        الخيارات
                    </MudTh>

                    @if (_canWrite)
                    {
                        <MudTh Class="w-24 text-xs font-bold text-slate-500">
                            <span class="sr-only">الإجراءات</span>
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate Context="property">
                    <MudTd DataLabel="اسم الخاصية"
                           Class="text-sm font-bold text-slate-900"
                           Style="overflow-wrap:anywhere">
                        @property.Name
                    </MudTd>

                    <MudTd DataLabel="النوع">
                        <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                            @PropertyEditorState.TypeLabel(property.Type)
                        </span>
                    </MudTd>

                    <MudTd DataLabel="الخيارات"
                           Class="text-sm text-slate-700">
                        @if (property.Type == PropertyType.List)
                        {
                            <span class="font-bold text-slate-900">@Fmt(property.OptionsCount)</span>
                            <span class="text-slate-500">خيارات</span>
                        }
                        else
                        {
                            <span class="text-slate-400">—</span>
                        }
                    </MudTd>

                    @if (_canWrite)
                    {
                        <MudTd DataLabel="الإجراءات">
                            <div class="flex items-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Disabled="IsBusy"
                                               aria-label="تعديل الخاصية"
                                               OnClick="@(() => OpenEditDialogAsync(property))" />

                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="IsBusy"
                                               aria-label="حذف الخاصية"
                                               OnClick="@(() => ConfirmDeleteAsync(property))" />
                            </div>
                        </MudTd>
                    }
                </RowTemplate>

                <NoRecordsContent>
                    <div class="py-6 text-center text-sm text-slate-500">
                        لا توجد خصائص تطابق البحث.
                    </div>
                </NoRecordsContent>

                <PagerContent>
                    <TableFooter TotalItems="@(FilteredProperties.Count())"
                                 CurrentPage="@FooterCurrentPage"
                                 CurrentPageChanged="OnFooterPageChanged"
                                 RowsPerPage="@_rowsPerPage"
                                 RowsPerPageChanged="OnFooterRowsPerPageChanged" />
                </PagerContent>
            </MudTable>
        </section>
    }
</div>

@code
{
    private IReadOnlyList<PropertyListItem> _properties = [];
    private string? _searchTerm;
    private string? _error;
    private bool _loading = true;
    private bool _canWrite;
    private bool _dialogOpen;
    private bool _deleting;

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("خصائص المنتجات")
    ];

    private int _currentPage;
    private int _rowsPerPage = 10;

    /// <summary>مجدد PageScaffold (1-based) مقابل CurrentPage (0-based) في MudTable.</summary>
    private int FooterCurrentPage => _currentPage + 1;

    private bool CanCreate =>
        _canWrite && !_loading && _error is null;

    private bool IsBusy =>
        _loading || _dialogOpen || _deleting;

    private IEnumerable<PropertyListItem> FilteredProperties
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _properties;
            }

            string searchTerm = _searchTerm.Trim();

            return _properties.Where(property =>
                property.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static string Fmt(int value) =>
        value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _canWrite = false;
        _error = null;
        _currentPage = 0;

        try
        {
            var properties = await RequestExecutor.ExecuteAsync(new GetPropertiesQuery());
            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Properties,
                PermissionLevel.Write);

            _properties = properties.ToList();
            _canWrite = canWrite;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load properties");
            _error = "تعذر تحميل خصائص المنتجات. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnFooterPageChanged(int page)
    {
        _currentPage = page - 1;
        return Task.CompletedTask;
    }

    private Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _rowsPerPage = rowsPerPage;
        _currentPage = 0;
        return Task.CompletedTask;
    }

    private Task OpenCreateDialogAsync() => OpenEditorAsync(null);

    private Task OpenEditDialogAsync(PropertyListItem property) => OpenEditorAsync(property.Id);

    private async Task OpenEditorAsync(int? propertyId)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _dialogOpen = true;

        try
        {
            DialogParameters<PropertyEditorDialog> parameters = new()
            {
                { dialog => dialog.PropertyId, propertyId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            string title = propertyId.HasValue ? "تعديل الخاصية" : "إضافة خاصية";

            var dialog = await DialogService.ShowAsync<PropertyEditorDialog>(
                title,
                parameters,
                options);

            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await LoadAsync();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open property editor for {PropertyId}",
                propertyId);

            Snackbar.Add(
                "تعذر فتح بيانات الخاصية. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _dialogOpen = false;
        }
    }

    private async Task ConfirmDeleteAsync(PropertyListItem property)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف الخاصية",
                $"هل تريد حذف الخاصية \"{property.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            Result result = await RequestExecutor.ExecuteAsync(new DeletePropertyCommand(property.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add("تم حذف الخاصية بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete property {PropertyId}",
                property.Id);

            Snackbar.Add(
                "تعذر حذف الخاصية. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
