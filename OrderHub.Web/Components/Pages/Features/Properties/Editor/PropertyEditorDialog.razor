@inject IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<PropertyEditorDialog> Logger

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @DialogTitle
        </MudText>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />

            <MudText Typo="Typo.body2"
                     Class="mt-2">
                جاري تحميل بيانات خاصية المنتج...
            </MudText>
        }
        else if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error"
                      Dense="true">
                @_loadError
            </MudAlert>

            <MudButton Variant="Variant.Text"
                       OnClick="LoadAsync"
                       Class="mt-2">
                إعادة المحاولة
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudStack Spacing="2"
                          Class="pa-1"
                          Style="max-height:60vh;overflow-y:auto">
                    @if (_saveError is not null)
                    {
                        <MudAlert Severity="Severity.Error"
                                  Dense="true">
                            @_saveError
                        </MudAlert>
                    }

                    <MudTextField T="string"
                                  @bind-Value="_state.Name"
                                  Label="اسم خاصية المنتج"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="اسم خاصية المنتج مطلوب."
                                  MaxLength="100"
                                  Validation="@(new Func<string, string?>(PropertyEditorState.ValidateText))"
                                  Immediate="true"
                                  Disabled="_saving" />

                    <MudSelect T="PropertyType"
                               Value="_state.Type"
                               ValueChanged="ChangeType"
                               Label="نوع الخاصية"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Disabled="_saving">
                        @foreach (var type in Enum.GetValues<PropertyType>())
                        {
                            <MudSelectItem Value="type">
                                @PropertyEditorState.TypeLabel(type)
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField T="string"
                                  @bind-Value="_state.Description"
                                  Label="الوصف (اختياري)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Disabled="_saving" />

                    @if (WillRemoveOptions)
                    {
                        <MudAlert Severity="Severity.Warning"
                                  Dense="true">
                            تغيير النوع سيزيل خيارات القائمة بعد الحفظ. لا يمكن تغيير نوع خاصية مستخدمة.
                        </MudAlert>
                    }

                    @if (IsList)
                    {
                        <MudDivider />

                        <MudText Typo="Typo.subtitle2">
                            الخيارات
                        </MudText>

                        @foreach (var option in _state.Options)
                        {
                            <PropertyOptionEditorRow @key="option.Key"
                                                     Option="option"
                                                     Disabled="_saving"
                                                     OnRemove="RemoveOption" />
                        }

                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="_saving"
                                   OnClick="AddOption">
                            إضافة خيار
                        </MudButton>
                    }
                </MudStack>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton Disabled="_saving"
                   OnClick="Cancel">
            إلغاء
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="SaveDisabled"
                   OnClick="SaveAsync">
            @SaveButtonText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int? PropertyId { get; set; }

    private PropertyEditorState _state = new();
    private MudForm? _form;
    private string? _loadError;
    private string? _saveError;
    private bool _loading = true;
    private bool _saving;

    private string DialogTitle =>
        PropertyId.HasValue ? "تعديل خاصية المنتج" : "إضافة خاصية منتج";

    private string SaveButtonText
    {
        get
        {
            if (_saving)
            {
                return "جاري الحفظ...";
            }

            return PropertyId.HasValue ? "حفظ التعديلات" : "إضافة";
        }
    }

    private bool SaveDisabled =>
        _loading || _saving || _loadError is not null;

    private bool IsList => _state.Type == PropertyType.List;

    private bool WillRemoveOptions =>
        !IsList && _state.Options.Count > 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _state = new PropertyEditorState();

        try
        {
            if (PropertyId is not int propertyId)
            {
                return;
            }

            var property = await RequestExecutor.ExecuteAsync(new GetPropertyQuery(propertyId));

            if (property is null)
            {
                _loadError = "خاصية المنتج غير موجودة.";
                return;
            }

            _state = PropertyEditorState.FromDetails(property);
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load property {PropertyId}",
                PropertyId);

            _loadError = "تعذر تحميل بيانات خاصية المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        MudDialog.Cancel();
    }

    private void ChangeType(PropertyType type)
    {
        _state.Type = type;

        if (IsList && _state.Options.Count == 0)
        {
            AddOption();
        }
    }

    private void AddOption()
    {
        if (_saving)
        {
            return;
        }

        _state.Options.Add(new PropertyOptionEditorState());
    }

    private void RemoveOption(PropertyOptionEditorState option)
    {
        if (_saving)
        {
            return;
        }

        _state.Options.Remove(option);
    }

    private async Task SaveAsync()
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();

            if (!_form.IsValid)
            {
                return;
            }

            _saveError = _state.ValidateOptions();

            if (_saveError is not null)
            {
                return;
            }

            if (PropertyId is int propertyId)
            {
                await RequestExecutor.ExecuteAsync(_state.UpdateCommand(propertyId));
            }
            else
            {
                await RequestExecutor.ExecuteAsync(_state.CreateCommand());
            }

            Snackbar.Add("تم حفظ خاصية المنتج بنجاح.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (DomainException exception)
        {
            _saveError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save property {PropertyId}",
                PropertyId);

            _saveError = "تعذر حفظ خاصية المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}

