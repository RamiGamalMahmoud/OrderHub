@inject IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<PropertyEditorDialog> Logger

<MudDialog Class="flex max-h-[92vh] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl max-w-[36rem] w-full"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50 text-blue-600">
                    <MudIcon Icon="@(PropertyId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.Tune)"
                             Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@DialogTitle</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        تعريف الخاصية ونوعها وخياراتها المتاحة للمنتجات
                    </p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_saving"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="shrink-0 rounded-xl text-slate-400" />
        </header>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />

            <MudText Typo="Typo.body2" Class="p-6 text-sm text-slate-500">
                جاري تحميل بيانات خاصية المنتج...
            </MudText>
        }
        else if (_loadError is not null)
        {
            <div class="space-y-3 p-6">
                <MudAlert Severity="Severity.Error"
                          Dense="true">
                    @_loadError
                </MudAlert>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="LoadAsync">
                    إعادة المحاولة
                </MudButton>
            </div>
        }
        else
        {
            <MudForm @ref="_form">
                <div class="min-h-0 flex-1 space-y-5 overflow-y-auto bg-slate-50/70 p-5">

                    <section class="rounded-xl border border-slate-200/85 bg-white p-5 shadow-xs">
                        <div class="mb-4 flex items-center gap-2.5">
                            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" />
                            </span>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">بيانات الخاصية</h3>
                                <p class="mt-0.5 text-xs text-slate-500">اسم الخاصية ونوعها ووصفها.</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            @if (_saveError is not null)
                            {
                                <MudAlert Severity="Severity.Error"
                                          Dense="true">
                                    @_saveError
                                </MudAlert>
                            }

                            <MudTextField T="string"
                                          @bind-Value="_state.Name"
                                          Label="اسم خاصية المنتج"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="اسم خاصية المنتج مطلوب."
                                          MaxLength="100"
                                          Validation="@(new Func<string, string?>(PropertyEditorState.ValidateText))"
                                          Immediate="true"
                                          Disabled="_saving" />

                            <MudSelect T="PropertyType"
                                       Value="_state.Type"
                                       ValueChanged="ChangeType"
                                       Label="نوع الخاصية"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Disabled="_saving">
                                @foreach (var type in Enum.GetValues<PropertyType>())
                                {
                                    <MudSelectItem Value="type">
                                        @PropertyEditorState.TypeLabel(type)
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="string"
                                          @bind-Value="_state.Description"
                                          Label="الوصف (اختياري)"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="2"
                                          Disabled="_saving" />

                            @if (WillRemoveOptions)
                            {
                                <div class="flex items-start gap-2.5 rounded-xl border border-amber-100 bg-amber-50 p-3 text-sm text-amber-800">
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" class="mt-0.5 shrink-0" />
                                    <p>
                                        تغيير النوع سيزيل خيارات القائمة بعد الحفظ. لا يمكن تغيير نوع خاصية مستخدمة.
                                    </p>
                                </div>
                            }
                        </div>
                    </section>

                    @if (IsList)
                    {
                        <section class="rounded-xl border border-slate-200/85 bg-white p-5 shadow-xs">
                            <div class="mb-4 flex items-center justify-between gap-2.5">
                                <div class="flex items-center gap-2.5">
                                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                        <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Small" />
                                    </span>
                                    <div>
                                        <h3 class="text-sm font-bold text-slate-900">الخيارات</h3>
                                        <p class="mt-0.5 text-xs text-slate-500">قيم القائمة المتاحة لاختيار هذا المنتج.</p>
                                    </div>
                                </div>

                                <span class="inline-flex shrink-0 items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                                    <span class="font-black">@(@_state.Options.Count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture))</span>
                                    <span class="ps-1">خيار</span>
                                </span>
                            </div>

                            <div class="space-y-2.5">
                                @foreach (var option in _state.Options)
                                {
                                    <PropertyOptionEditorRow @key="option.Key"
                                                             Option="option"
                                                             Disabled="_saving"
                                                             OnRemove="RemoveOption" />
                                }

                                <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-3 py-2.5 text-center">
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               Disabled="_saving"
                                               OnClick="AddOption">
                                        إضافة خيار
                                    </MudButton>
                                </div>
                            </div>
                        </section>
                    }
                </div>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <footer class="flex items-center justify-between gap-3 border-t border-slate-100 bg-white p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="inline-flex h-2.5 w-2.5 rounded-full @(SaveDisabled ? "bg-slate-300" : "bg-emerald-500")"></span>
                <span>@(SaveDisabled ? "غير جاهز للحفظ" : "جاهز للحفظ")</span>
            </div>

            <div class="flex items-center gap-2">
                <MudButton Disabled="_saving"
                           OnClick="Cancel"
                           Variant="Variant.Text"
                           Class="rounded-xl text-slate-600">
                    إلغاء
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="SaveDisabled"
                           OnClick="SaveAsync"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="rounded-xl px-5 font-bold">
                    @SaveButtonText
                </MudButton>
            </div>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int? PropertyId { get; set; }

    private PropertyEditorState _state = new();
    private MudForm? _form;
    private string? _loadError;
    private string? _saveError;
    private bool _loading = true;
    private bool _saving;

    private string DialogTitle =>
        PropertyId.HasValue ? "تعديل خاصية المنتج" : "إضافة خاصية منتج";

    private string SaveButtonText
    {
        get
        {
            if (_saving)
            {
                return "جاري الحفظ...";
            }

            return PropertyId.HasValue ? "حفظ التعديلات" : "إضافة";
        }
    }

    private bool SaveDisabled =>
        _loading || _saving || _loadError is not null;

    private bool IsList => _state.Type == PropertyType.List;

    private bool WillRemoveOptions =>
        !IsList && _state.Options.Count > 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _state = new PropertyEditorState();

        try
        {
            if (PropertyId is not int propertyId)
            {
                return;
            }

            var property = await RequestExecutor.ExecuteAsync(new GetPropertyQuery(propertyId));

            if (property is null)
            {
                _loadError = "خاصية المنتج غير موجودة.";
                return;
            }

            _state = PropertyEditorState.FromDetails(property);
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load property {PropertyId}",
                PropertyId);

            _loadError = "تعذر تحميل بيانات خاصية المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        MudDialog.Cancel();
    }

    private void ChangeType(PropertyType type)
    {
        _state.Type = type;

        if (IsList && _state.Options.Count == 0)
        {
            AddOption();
        }
    }

    private void AddOption()
    {
        if (_saving)
        {
            return;
        }

        _state.Options.Add(new PropertyOptionEditorState());
    }

    private void RemoveOption(PropertyOptionEditorState option)
    {
        if (_saving)
        {
            return;
        }

        _state.Options.Remove(option);
    }

    private async Task SaveAsync()
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();

            if (!_form.IsValid)
            {
                return;
            }

            _saveError = _state.ValidateOptions();

            if (_saveError is not null)
            {
                return;
            }

            if (PropertyId is int propertyId)
            {
                await RequestExecutor.ExecuteAsync(_state.UpdateCommand(propertyId));
            }
            else
            {
                await RequestExecutor.ExecuteAsync(_state.CreateCommand());
            }

            Snackbar.Add("تم حفظ خاصية المنتج بنجاح.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (DomainException exception)
        {
            _saveError = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save property {PropertyId}",
                PropertyId);

            _saveError = "تعذر حفظ خاصية المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }
}

