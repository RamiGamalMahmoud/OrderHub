<div class="flex items-center gap-2">
    <div class="flex-1">
        <MudTextField T="string"
                      @bind-Value="Option.Value"
                      Label="قيمة الخيار"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Required="true"
                      RequiredError="قيمة الخيار مطلوبة."
                      MaxLength="100"
                      Validation="@(new Func<string, string?>(PropertyEditorState.ValidateText))"
                      Immediate="true"
                      Disabled="Disabled" />
    </div>

    <MudIconButton Icon="@Icons.Material.Filled.Close"
                   Size="Size.Small"
                   Color="Color.Error"
                   Disabled="Disabled"
                   aria-label="إزالة الخيار"
                   OnClick="RemoveAsync"
                   Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
</div>

@code {
    [Parameter]
    [EditorRequired]
    public PropertyOptionEditorState Option { get; set; } = null!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<PropertyOptionEditorState> OnRemove { get; set; }

    private Task RemoveAsync() => OnRemove.InvokeAsync(Option);
}
