@using System.Globalization
@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">استلام مرتجع مستحق</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">@Pending.OrderNumber — @Pending.ProductName</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                المستحق على هذا الصنف: @Pending.PendingQty. سجّل ما وصل فعليًا فقط؛ تُضاف الكمية السليمة للرصيد المتاح
                والتالفة لخانة التالف.
            </div>

            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                <MudNumericField T="int"
                                 @bind-Value="_intact"
                                 Label="كمية سليمة"
                                 Min="0"
                                 Max="@Pending.PendingQty"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Disabled="_submitting"
                                 Class="w-full" />
                <MudNumericField T="int"
                                 @bind-Value="_damaged"
                                 Label="كمية تالفة"
                                 Min="0"
                                 Max="@Pending.PendingQty"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Disabled="_submitting"
                                 Class="w-full" />
            </div>

            <p class="text-[11px] text-slate-500">
                المتبقي غير المستلم: @Math.Max(0, Pending.PendingQty - Total)
            </p>

            <MudTextField T="string"
                          @bind-Value="_note"
                          Label="ملاحظة الاستلام (اختياري)"
                          Immediate="true"
                          MaxLength="500"
                          HelperText="@NoteCounter"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />

            <div class="space-y-1">
                <label class="block text-xs font-semibold text-slate-700" for="settle-effective">
                    وقت الاستلام الفعلي
                </label>
                <InputDate id="settle-effective"
                           TValue="DateTime"
                           Type="InputDateType.DateTimeLocal"
                           @bind-Value="_effectiveLocal"
                           disabled="@_submitting"
                           class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-medium text-slate-700" />
            </div>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Class="oh-btn oh-btn--primary"
                       Disabled="@(!CanSubmit)"
                       OnClick="SubmitAsync">
                @(_submitting ? "جاري الاستلام…" : "تسجيل الاستلام")
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<SettlePendingReturnDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public PendingReturnRow Pending { get; set; } = null!;

    private int _intact;
    private int _damaged;
    private DateTime _effectiveLocal = DateTime.Now;
    private string? _note;
    private string? _error;
    private bool _submitting;

    private int Total => _intact + _damaged;

    private string NoteCounter => $"{(_note?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 500";

    private bool CanSubmit => !_submitting && Total > 0 && Total <= Pending.PendingQty;

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            DateTime effectiveUtc = DateTime.SpecifyKind(_effectiveLocal, DateTimeKind.Local).ToUniversalTime();
            var result = await Executor.ExecuteAsync(new SettlePendingReturnCommand(
                Pending.AllocationId,
                _intact,
                _damaged,
                _note?.Trim() ?? string.Empty,
                effectiveUtc));

            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to settle pending return for allocation {AllocationId}", Pending.AllocationId);
            _error = "تعذر تسجيل الاستلام. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
