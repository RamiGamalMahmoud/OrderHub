@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                    <MudIcon Icon="@Icons.Material.Filled.Output" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">أمر صرف جديد</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        اختر الطلب ثم المخزن والبنود المطلوب صرفها
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-5">
            @if (_loading)
            {
                <div class="flex items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-8 text-xs text-slate-500">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" aria-label="تحميل بيانات الصرف" />
                    جاري تحميل الطلبات المتاحة…
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-bold text-rose-800">
                    @_loadError
                    <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm mt-2" disabled="@_submitting" @onclick="LoadOrdersAsync">
                        إعادة المحاولة
                    </button>
                </div>
            }
            else if (_orders.Count == 0)
            {
                <div class="rounded-xl border border-slate-200 bg-white px-4 py-6 text-center text-xs font-bold text-slate-600">
                    لا توجد طلبات مفتوحة تحمل تخصيصات مخزون نشطة.
                </div>
            }
            else
            {
                <MudSelect T="int?"
                           Value="_orderId"
                           ValueChanged="OnOrderChangedAsync"
                           Label="الطلب"
                           Placeholder="اختر طلبًا يحمل تخصيصات مخزون"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_submitting"
                           Class="w-full">
                    @foreach (var option in _orders)
                    {
                        <MudSelectItem T="int?" Value="@((int?)option.Id)">
                            @option.OrderNumber — @option.ClientName (@option.AvailableAllocations تخصيص)
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (_orderLoading)
                {
                    <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-3 text-xs text-slate-500">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" aria-label="تحميل تخصيصات الطلب" />
                        جاري تحميل تخصيصات الطلب…
                    </div>
                }
                else if (_selected is not null)
                {
                    @if (_selected.Warehouses.Count > 1)
                    {
                        <MudSelect T="int?"
                                   Value="_warehouseId"
                                   ValueChanged="OnWarehouseChanged"
                                   Label="المخزن"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="_submitting"
                                   Class="w-full">
                            @foreach (var warehouse in _selected.Warehouses)
                            {
                                <MudSelectItem T="int?" Value="@((int?)warehouse.WarehouseId)">@warehouse.WarehouseName</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @if (_warehouse is not null)
                    {
                        <div class="space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-xs font-bold text-slate-700">@_warehouse.WarehouseName</p>
                                <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[11px] font-semibold text-slate-500">
                                    المتاح لكل بند يظهر أعلى الحقل
                                </span>
                            </div>

                            @foreach (var line in _warehouse.Lines)
                            {
                                <div class="grid grid-cols-1 items-center gap-3 rounded-xl border border-slate-200 bg-white p-3 sm:grid-cols-12" @key="line.AllocationId">
                                    <div class="sm:col-span-7">
                                        <p class="text-xs font-bold text-slate-800">@line.ProductName</p>
                                        <p class="mt-0.5 text-[11px] text-slate-500">
                                            المخصص: @line.AllocatedQty · المصروف: @line.IssuedQty · المتاح: @line.AvailableToRequest
                                        </p>
                                    </div>
                                    <div class="sm:col-span-3">
                                        <MudNumericField T="int"
                                                         Value="_quantities.GetValueOrDefault(line.AllocationId)"
                                                         ValueChanged="@(value => SetQuantity(line, value))"
                                                         Label="الكمية المطلوبة"
                                                         Min="0"
                                                         Max="@line.AvailableToRequest"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Disabled="_submitting"
                                                         Class="w-full" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Disabled="@(!CanSubmit)"
                       Class="oh-btn oh-btn--primary"
                       OnClick="SubmitAsync">@(_submitting ? "جاري إنشاء أمر الصرف…" : "إنشاء أمر الصرف")</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<CreateIssueOrderDialog> Logger { get; set; } = null!;
    [Parameter] public int? InitialOrderId { get; set; }

    private IReadOnlyList<IssueOrderOrderOption> _orders = [];
    private IssueOrderSelectedOrder? _selected;
    private IssueOrderWarehouseGroup? _warehouse;
    private readonly Dictionary<int, int> _quantities = [];
    private int? _orderId;
    private int? _warehouseId;
    private string? _loadError;
    private string? _error;
    private bool _loading = true;
    private bool _orderLoading;
    private bool _submitting;

    private bool CanSubmit =>
        !_submitting && _orderId is not null && _warehouse is not null &&
        _quantities.Values.Any(quantity => quantity > 0);

    protected override async Task OnInitializedAsync()
    {
        _orderId = InitialOrderId;
        await LoadOrdersAsync();
        if (_orderId is not null)
            await OnOrderChangedAsync(_orderId);
    }

    private async Task LoadOrdersAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var result = await Executor.ExecuteAsync(new GetIssueOrderContextQuery());
            if (!result.IsSuccess)
            {
                _orders = [];
                _loadError = result.ErrorMessage;
                return;
            }

            _orders = result.Value.Orders;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load issue-order orders");
            _loadError = "تعذر تحميل الطلبات المتاحة. حاول مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnOrderChangedAsync(int? orderId)
    {
        _orderId = orderId;
        _selected = null;
        _warehouse = null;
        _quantities.Clear();
        _error = null;

        if (orderId is null)
            return;

        _orderLoading = true;
        try
        {
            var result = await Executor.ExecuteAsync(new GetIssueOrderContextQuery(orderId));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            _selected = result.Value.SelectedOrder;
            if (_selected is not null)
                OnWarehouseChanged(_selected.Warehouses.FirstOrDefault()?.WarehouseId);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load issue-order context for order {OrderId}", orderId);
            _error = "تعذر تحميل تخصيصات الطلب. حاول مرة أخرى.";
        }
        finally
        {
            _orderLoading = false;
        }
    }

    private void OnWarehouseChanged(int? warehouseId)
    {
        _warehouseId = warehouseId;
        _warehouse = _selected?.Warehouses.FirstOrDefault(warehouse => warehouse.WarehouseId == warehouseId);
        _quantities.Clear();
        if (_warehouse is null)
            return;
        foreach (var line in _warehouse.Lines)
            _quantities[line.AllocationId] = line.AvailableToRequest;
    }

    private void SetQuantity(IssueOrderAvailableLine line, int value) =>
        _quantities[line.AllocationId] = Math.Clamp(value, 0, line.AvailableToRequest);

    private async Task SubmitAsync()
    {
        if (!CanSubmit || _orderId is null || _warehouse is null)
            return;

        _submitting = true;
        _error = null;
        try
        {
            var input = new StockIssueOrderInput(
                _orderId.Value,
                _warehouse.WarehouseId,
                _quantities
                    .Where(pair => pair.Value > 0)
                    .Select(pair => new StockIssueOrderLineInput(pair.Key, pair.Value))
                    .ToList());

            var result = await Executor.ExecuteAsync(new CreateStockIssueOrderCommand(input));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to create a stock issue order");
            _error = "تعذر إنشاء أمر الصرف. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
