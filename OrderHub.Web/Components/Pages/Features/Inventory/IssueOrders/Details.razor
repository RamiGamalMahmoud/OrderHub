@page "/inventory/issue-orders/{Id:int}"

@attribute [PermissionAuthorize(
    PermissionFeature.Inventory,
    PermissionLevel.Read)]

@inject IRequestExecutor Executor
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ILogger<Details> Logger

<PageTitle>أمر صرف</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل أمر الصرف" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل أمر الصرف...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm mt-3" @onclick="LoadAsync">
                إعادة المحاولة
            </button>
        </div>
    }
    else if (_order is not null)
    {
        var isActive = IssueOrderPresentation.IsActive(_order.Status);

        <PageScaffold Title="@($"أمر صرف {IssueOrderPresentation.NumberLabel(_order.Number, _order.SequenceYear, _order.SequenceMonth)}")"
                      Description="@($"{_order.OrderNumber} — {_order.WarehouseName}")"
                      Crumbs="_crumbs">
            <Actions>
                <MudButton Href="/inventory/issue-orders" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">كل أوامر الصرف</MudButton>
                <MudButton Disabled="_busy" OnClick="LoadAsync" Variant="Variant.Filled" Color="Color.Primary" Class="oh-btn oh-btn--primary oh-btn--sm">تحديث</MudButton>
            </Actions>
        </PageScaffold>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                        <MudIcon Icon="@Icons.Material.Filled.Output" Class="text-[20px]" />
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">بيانات أمر الصرف</h2>
                        <p class="text-xs text-slate-500">المخزن والطلب والمسؤول عن التنفيذ</p>
                    </div>
                </div>
                <span class="@($"rounded-full border px-2.5 py-1 text-xs font-bold {IssueOrderPresentation.StatusTag(_order.Status)}")">
                    @IssueOrderPresentation.StatusLabel(_order.Status)
                </span>
            </header>

            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">الطلب</p>
                    <a href="@($"/orders/{_order.OrderId}/workflow")" class="text-sm font-bold text-brand-700 hover:underline">
                        @_order.OrderNumber
                    </a>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">المخزن</p>
                    <p class="text-sm font-bold text-slate-900">@_order.WarehouseName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">أنشأه</p>
                    <p class="text-sm font-bold text-slate-900">@_order.RequestedByName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">أمين المخزن المسند</p>
                    <p class="text-sm font-bold text-slate-900">@_order.AssignedToName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">تاريخ الإنشاء</p>
                    <p class="text-sm font-bold text-slate-900"><UserLocalTime Value="_order.CreatedAtUtc" /></p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">إجمالي المصروف</p>
                    <p class="text-sm font-bold text-slate-900">@_order.Lines.Sum(line => line.IssuedQty) من @_order.Lines.Sum(line => line.RequestedQty)</p>
                </div>
            </div>

            @if (_order.Status == WorkRecordStatus.CancelRequested)
            {
                <div class="mt-4 rounded-xl border border-orange-200 bg-orange-50 px-3 py-2.5 text-xs leading-6 text-orange-800">
                    <p class="font-bold">طلب إلغاء معلّق بانتظار قرار المدير</p>
                    <p class="mt-0.5">السبب: @_order.CancelReason</p>
                    <p class="mt-0.5 text-[11px]">
                        @_order.CancelRequestedByName
                        @if (_order.CancelRequestedAtUtc is not null)
                        {
                            <span> — <UserLocalTime Value="_order.CancelRequestedAtUtc" /></span>
                        }
                    </p>
                </div>
            }
            else if (_order.Status == WorkRecordStatus.Cancelled && !string.IsNullOrWhiteSpace(_order.CancelReason))
            {
                <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs leading-6 text-slate-700">
                    <span class="font-bold text-slate-800">سبب الإلغاء:</span> @_order.CancelReason
                </div>
            }

            @if (_order.CanRecordBatches || _order.CanRequestCancel)
            {
                <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
                    @if (_order.CanRecordBatches)
                    {
                        <MudButton Disabled="_busy"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--primary oh-btn--sm"
                                   StartIcon="@Icons.Material.Filled.PlaylistAdd"
                                   OnClick="OpenBatchDialogAsync">
                            تسجيل دفعة صرف
                        </MudButton>
                    }
                    @if (_order.CanRequestCancel)
                    {
                        <MudButton Disabled="_busy"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                                   StartIcon="@Icons.Material.Filled.Block"
                                   OnClick="OpenCancelDialogAsync">
                            طلب إلغاء
                        </MudButton>
                    }
                </div>
            }
        </section>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                    <MudIcon Icon="@Icons.Material.Outlined.Layers" Class="text-[20px]" />
                </span>
                <div>
                    <h2 class="text-base font-bold text-slate-900">بنود الصرف والدفعات</h2>
                    <p class="text-xs text-slate-500">الكميات المطلوبة والمصروفة وسجل كل دفعة</p>
                </div>
            </header>

            <div class="space-y-3">
                @foreach (var line in _order.Lines)
                {
                    var remaining = line.RequestedQty - line.IssuedQty;
                    <article class="rounded-xl border border-slate-200 bg-slate-50/60 p-3" @key="line.Id">
                        <header class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-bold text-slate-900">@line.ProductName</p>
                            <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-semibold">
                                <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-slate-600">مطلوب: @line.RequestedQty</span>
                                <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-emerald-700">مصروف: @line.IssuedQty</span>
                                <span class="@($"rounded-full border px-2 py-0.5 {(remaining == 0 ? "border-emerald-200 bg-emerald-50 text-emerald-700" : "border-amber-200 bg-amber-50 text-amber-700")}")">متبقي: @remaining</span>
                            </div>
                        </header>

                        @if (line.Batches.Count > 0)
                        {
                            <ul class="mt-2 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white">
                                @foreach (var batch in line.Batches)
                                {
                                    <li class="flex flex-wrap items-start justify-between gap-2 px-3 py-2">
                                        <div class="min-w-0">
                                            <p class="text-xs font-bold text-slate-800">دفعة @batch.Quantity</p>
                                            <p class="mt-0.5 text-[11px] text-slate-500">
                                                <UserLocalTime Value="batch.EffectiveAtUtc" /> — سجّلها @batch.RecordedByName
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(batch.ShortfallReason))
                                            {
                                                <p class="mt-1 rounded-md border border-rose-200 bg-rose-50 px-2 py-1 text-[11px] font-semibold text-rose-800">
                                                    نقص: @batch.ShortfallReason
                                                </p>
                                            }
                                        </div>
                                        <span class="rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] font-bold text-slate-600">
                                            @batch.Quantity
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="mt-2 text-[11px] text-slate-500">لم تُسجّل دفعات لهذا البند بعد.</p>
                        }
                    </article>
                }
            </div>

            @if (!isActive && _order.Status is WorkRecordStatus.Completed or WorkRecordStatus.Cancelled)
            {
                <p class="mt-3 text-[11px] font-semibold text-slate-500">
                    أمر الصرف مغلق؛ السجل محفوظ للقراءة فقط ولا يقبل تعديلًا.
                </p>
            }
        </section>
    }
</div>
