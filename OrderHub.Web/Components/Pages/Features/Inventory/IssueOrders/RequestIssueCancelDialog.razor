@using System.Globalization
@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-orange-600">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">طلب إلغاء أمر الصرف</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">@OrderLabel — @WarehouseName</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                سيُرفع طلب الإلغاء إلى المدير للمراجعة، ويُمنع تسجيل دفعات جديدة حتى يتم البت فيه.
            </div>

            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="سبب طلب الإلغاء"
                          Required="true"
                          Immediate="true"
                          MaxLength="200"
                          HelperText="@ReasonCounter"
                          Lines="2"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Disabled="@(!CanSubmit)"
                       Class="oh-btn oh-btn--danger"
                       OnClick="SubmitAsync">@(_submitting ? "جاري الإرسال…" : "إرسال طلب الإلغاء")</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<RequestIssueCancelDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public int IssueOrderId { get; set; }
    [Parameter, EditorRequired] public string OrderLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string WarehouseName { get; set; } = string.Empty;

    private string? _reason;
    private string? _error;
    private bool _submitting;

    private string ReasonCounter => $"{(_reason?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    private bool CanSubmit => !_submitting && !string.IsNullOrWhiteSpace(_reason);

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(new RequestIssueOrderCancelCommand(IssueOrderId, _reason!.Trim()));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to request cancellation for issue order {IssueOrderId}", IssueOrderId);
            _error = "تعذر إرسال طلب الإلغاء. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
