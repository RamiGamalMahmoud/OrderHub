@page "/inventory/counts/{Id:int}"

@attribute [PermissionAuthorize(
    PermissionFeature.Inventory,
    PermissionLevel.Read)]

@inject IRequestExecutor Executor
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionAccess PermissionAccess
@inject ILogger<Editor> Logger

<PageTitle>جرد مخزني</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل الجرد" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل الجرد...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm mt-3" @onclick="LoadAsync">
                إعادة المحاولة
            </button>
        </div>
    }
    else if (_count is not null)
    {
        <PageScaffold Title="جرد مخزني"
                      Description="@($"{_count.WarehouseName} — {CountPresentation.ScopeLabel(_count.Scope)}")"
                      Crumbs="_crumbs">
            <Actions>
                <MudButton Href="/inventory/counts" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">كل عمليات الجرد</MudButton>
                <MudButton Disabled="@(_busy || _hasChanges)" OnClick="LoadAsync" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">تحديث</MudButton>
            </Actions>
        </PageScaffold>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Class="text-[20px]" />
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">بيانات الجرد</h2>
                        <p class="text-xs text-slate-500">المخزن والنطاق ولقطة الأرصدة الدفترية</p>
                    </div>
                </div>
                <span class="@($"rounded-full border px-2.5 py-1 text-xs font-bold {CountPresentation.StatusTag(_count.Status)}")">
                    @CountPresentation.StatusLabel(_count.Status)
                </span>
            </header>

            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">المخزن</p>
                    <p class="text-sm font-bold text-slate-900">@_count.WarehouseName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">النطاق</p>
                    <p class="text-sm font-bold text-slate-900">@CountPresentation.ScopeLabel(_count.Scope)</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">لقطة الأرصدة</p>
                    <p class="text-sm font-bold text-slate-900"><UserLocalTime Value="_count.SnapshotAtUtc" /></p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">بدأه</p>
                    <p class="text-sm font-bold text-slate-900">@_count.StartedByName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">أنهى العدّ</p>
                    <p class="text-sm font-bold text-slate-900">
                        @if (_count.CompletedAtUtc is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <UserLocalTime Value="_count.CompletedAtUtc.Value" />
                        }
                    </p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">آخر قرار</p>
                    <p class="text-sm font-bold text-slate-900">
                        @if (_count.DecidedAtUtc is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <span>@_count.DecidedByName — <UserLocalTime Value="_count.DecidedAtUtc.Value" /></span>
                        }
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_count.DecisionNote))
            {
                <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs leading-6 text-slate-700">
                    <span class="font-bold text-slate-800">ملاحظة القرار:</span> @_count.DecisionNote
                </div>
            }

            @if (_isEditable)
            {
                <div class="mt-4 rounded-xl border border-teal-200 bg-teal-50 px-3 py-2 text-xs font-bold leading-6 text-teal-800">
                    أدخل الكمية السليمة والتالفة لكل صنف كما وُجدت فعليًا. الفروق محسوبة تلقائيًا ولا تُرحَّل إلا بعد اعتماد المدير.
                </div>
            }
            else if (_count.Status == InventoryCountStatus.UnderReview)
            {
                <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                    انتهى العدّ وأُرسل للاعتماد؛ لا يمكن تعديل الكميات.
                    @if (_count.HasLateMovements)
                    {
                        <span> سُجلت حركات بتاريخ سابق للقطة الجرد وسيتوقف الاعتماد حتى يراجعها المدير.</span>
                    }
                </div>
            }

            @if (_isEditable && _count.HasLateMovements)
            {
                <div class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                    ظهرت حركات بتاريخ سابق للقطة العدّ؛ سيتوقف الاعتماد حتى يراجعها المدير.
                </div>
            }

            @if ((_isEditable || _count.IsKeeper) && _count.Status is InventoryCountStatus.Open or InventoryCountStatus.UnderReview)
            {
                <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
                    @if (_isEditable)
                    {
                        <MudButton Disabled="@(!_hasChanges || _busy)"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--secondary oh-btn--sm"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveAsync">
                            حفظ العدّ
                        </MudButton>
                        <MudButton Disabled="@(!CanComplete || _busy)"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="oh-btn oh-btn--primary oh-btn--sm"
                                   StartIcon="@Icons.Material.Filled.DoneAll"
                                   OnClick="CompleteAsync">
                            إنهاء العدّ وإرساله للاعتماد
                        </MudButton>
                    }
                    <MudButton Disabled="_busy"
                               Variant="Variant.Text"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--danger oh-btn--sm"
                               StartIcon="@Icons.Material.Filled.Block"
                               OnClick="OpenCancelAsync">
                        إلغاء الجرد
                    </MudButton>
                </div>
            }

            @if (_count.Status == InventoryCountStatus.UnderReview && _canApprove)
            {
                <div class="mt-4 border-t border-slate-100 pt-4">
                    <MudButton Href="@($"/inventory/counts/{_count.Id}/review")"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--primary oh-btn--sm"
                               StartIcon="@Icons.Material.Filled.Approval">
                        مراجعة واعتماد
                    </MudButton>
                </div>
            }
        </section>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                    <MudIcon Icon="@Icons.Material.Outlined.Layers" Class="text-[20px]" />
                </span>
                <div>
                    <h2 class="text-base font-bold text-slate-900">بنود الجرد</h2>
                    <p class="text-xs text-slate-500">الرصيد الدفتري وقت اللقطة مقابل الكمية المعدودة</p>
                </div>
            </header>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[52rem] border-separate border-spacing-y-1 text-right">
                    <thead>
                        <tr class="text-[11px] font-bold text-slate-500">
                            <th class="px-2 py-1.5 font-bold">الصنف</th>
                            <th class="px-2 py-1.5 font-bold">دفترية سليمة</th>
                            <th class="px-2 py-1.5 font-bold">سليمة معدودة</th>
                            <th class="px-2 py-1.5 font-bold">الفرق</th>
                            <th class="px-2 py-1.5 font-bold">دفترية تالفة</th>
                            <th class="px-2 py-1.5 font-bold">تالفة معدودة</th>
                            <th class="px-2 py-1.5 font-bold">فرق التالف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            <tr class="bg-slate-50/70 text-xs text-slate-700" @key="row.LineId">
                                <td class="rounded-r-lg px-2 py-2">
                                    <p class="text-sm font-bold text-slate-900">@row.ProductName</p>
                                    <p class="text-[11px] text-slate-500">@row.ProductCode</p>
                                </td>
                                <td class="px-2 py-2 font-semibold text-slate-700">@row.BookQty</td>
                                <td class="px-2 py-2">
                                    @if (_isEditable)
                                    {
                                        <input type="number"
                                               min="0"
                                               step="1"
                                               inputmode="numeric"
                                               aria-label="@($"الكمية السليمة المعدودة لـ {row.ProductName}")"
                                               value="@row.SoundText"
                                               @oninput="args => OnSoundInput(row, args)"
                                               class="@InputClass(row.SoundInvalid)" />
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-800">@(row.CountedQty?.ToString(CultureInfo.InvariantCulture) ?? "—")</span>
                                    }
                                </td>
                                <td class="px-2 py-2">
                                    <span class="@($"rounded-full border px-2 py-0.5 text-[11px] font-bold {CountPresentation.DeltaTag(row.Delta)}")">
                                        @CountPresentation.DeltaLabel(row.Delta)
                                    </span>
                                </td>
                                <td class="px-2 py-2 font-semibold text-slate-700">@row.BookDamagedQty</td>
                                <td class="px-2 py-2">
                                    @if (_isEditable)
                                    {
                                        <input type="number"
                                               min="0"
                                               step="1"
                                               inputmode="numeric"
                                               aria-label="@($"الكمية التالفة المعدودة لـ {row.ProductName}")"
                                               value="@row.DamagedText"
                                               @oninput="args => OnDamagedInput(row, args)"
                                               class="@InputClass(row.DamagedInvalid)" />
                                    }
                                    else
                                    {
                                        <span class="font-bold text-slate-800">@(row.CountedDamagedQty?.ToString(CultureInfo.InvariantCulture) ?? "—")</span>
                                    }
                                </td>
                                <td class="rounded-l-lg px-2 py-2">
                                    <span class="@($"rounded-full border px-2 py-0.5 text-[11px] font-bold {CountPresentation.DeltaTag(row.DamagedDelta)}")">
                                        @CountPresentation.DeltaLabel(row.DamagedDelta)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_isEditable && !CanComplete)
            {
                <p class="mt-3 text-[11px] font-semibold text-slate-500">
                    أدخل الكمية السليمة والتالفة لكل صنف لتفعيل إنهاء العدّ.
                </p>
            }
        </section>
    }
</div>
