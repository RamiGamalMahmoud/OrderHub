@page "/inventory/counts/{Id:int}/review"

@attribute [PermissionAuthorize(
    PermissionFeature.Inventory,
    PermissionLevel.Read)]

@inject IRequestExecutor Executor
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PermissionAccess PermissionAccess
@inject ILogger<Review> Logger

<PageTitle>مراجعة الجرد</PageTitle>

<div class="space-y-4">
    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل مراجعة الجرد" />
            <p class="mt-2 text-xs text-slate-500">جاري تحميل الجرد...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-xs font-bold text-rose-800">@_error</p>
            <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm mt-3" @onclick="LoadAsync">
                إعادة المحاولة
            </button>
        </div>
    }
    else if (_count is not null)
    {
        <PageScaffold Title="مراجعة الجرد واعتماده"
                      Description="@($"{_count.WarehouseName} — {CountPresentation.ScopeLabel(_count.Scope)}")"
                      Crumbs="_crumbs">
            <Actions>
                <MudButton Href="@($"/inventory/counts/{_count.Id}")" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">تفاصيل العدّ</MudButton>
                <MudButton Disabled="_busy" OnClick="LoadAsync" Variant="Variant.Outlined" Class="oh-btn oh-btn--secondary oh-btn--sm">تحديث</MudButton>
            </Actions>
        </PageScaffold>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <MudIcon Icon="@Icons.Material.Filled.Approval" Class="text-[20px]" />
                    </span>
                    <div>
                        <h2 class="text-base font-bold text-slate-900">ملخص الجرد</h2>
                        <p class="text-xs text-slate-500">راجع الفروق والحركات المتأخرة قبل اعتماد التسويات</p>
                    </div>
                </div>
                <span class="@($"rounded-full border px-2.5 py-1 text-xs font-bold {CountPresentation.StatusTag(_count.Status)}")">
                    @CountPresentation.StatusLabel(_count.Status)
                </span>
            </header>

            <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">المخزن</p>
                    <p class="text-sm font-bold text-slate-900">@_count.WarehouseName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">لقطة الأرصدة</p>
                    <p class="text-sm font-bold text-slate-900"><UserLocalTime Value="_count.SnapshotAtUtc" /></p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">أنهى العدّ</p>
                    <p class="text-sm font-bold text-slate-900">
                        @if (_count.CompletedAtUtc is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <UserLocalTime Value="_count.CompletedAtUtc.Value" />
                        }
                    </p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">بدأه</p>
                    <p class="text-sm font-bold text-slate-900">@_count.StartedByName</p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">البنود المعدودة</p>
                    <p class="text-sm font-bold text-slate-900">
                        @_count.Lines.Count(line => line.IsCounted) من @_count.Lines.Count
                    </p>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5">
                    <p class="text-[11px] font-medium text-slate-500">آخر قرار</p>
                    <p class="text-sm font-bold text-slate-900">
                        @if (_count.DecidedAtUtc is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <span>@_count.DecidedByName — <UserLocalTime Value="_count.DecidedAtUtc.Value" /></span>
                        }
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_count.DecisionNote))
            {
                <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs leading-6 text-slate-700">
                    <span class="font-bold text-slate-800">ملاحظة القرار:</span> @_count.DecisionNote
                </div>
            }

            @if (_count.Status == InventoryCountStatus.UnderReview && _count.HasLateMovements)
            {
                <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                    سُجلت حركات بتاريخ سابق للقطة الجرد بعد إنهاء العدّ. راجع كل سطر معلَّم أدناه: شمول الحركة في العدّ يعيد حساب الفرق،
                    أو أعد عدّ الصنف ليعود الجرد مفتوحًا. لا يمكن الاعتماد قبل إنهاء المراجعة.
                </div>
            }
            else if (_count.Status == InventoryCountStatus.UnderReview && !_count.AllCounted)
            {
                <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-bold leading-6 text-rose-800">
                    توجد بنود لم تُدخل كمياتها؛ لا يمكن اعتماد الجرد قبل استكمالها.
                </div>
            }

            @if (_count.Status == InventoryCountStatus.UnderReview && _canApprove && !_count.HasLateMovements && _count.AllCounted)
            {
                <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
                    <MudButton Disabled="_busy"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--primary oh-btn--sm"
                               StartIcon="@Icons.Material.Filled.DoneAll"
                               OnClick="OpenApproveAsync">
                        اعتماد الجرد وترحيل التسويات
                    </MudButton>
                    <MudButton Disabled="_busy"
                               Variant="Variant.Text"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--danger oh-btn--sm"
                               StartIcon="@Icons.Material.Filled.Block"
                               OnClick="OpenCancelAsync">
                        إلغاء الجرد
                    </MudButton>
                </div>
            }
            else if (_count.Status == InventoryCountStatus.UnderReview && _canApprove)
            {
                <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-slate-100 pt-4">
                    <MudButton Disabled="_busy"
                               Variant="Variant.Text"
                               Size="Size.Small"
                               Class="oh-btn oh-btn--danger oh-btn--sm"
                               StartIcon="@Icons.Material.Filled.Block"
                               OnClick="OpenCancelAsync">
                        إلغاء الجرد
                    </MudButton>
                </div>
            }
        </section>

        <section class="rounded-xl border border-slate-200/90 bg-white p-5 shadow-xs">
            <header class="mb-4 flex items-center gap-3 border-b border-slate-100 pb-4">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
                    <MudIcon Icon="@Icons.Material.Outlined.Layers" Class="text-[20px]" />
                </span>
                <div>
                    <h2 class="text-base font-bold text-slate-900">فروق البنود</h2>
                    <p class="text-xs text-slate-500">الرصيد الدفتري وقت اللقطة مقابل الكمية المعدودة</p>
                </div>
            </header>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[56rem] border-separate border-spacing-y-1 text-right">
                    <thead>
                        <tr class="text-[11px] font-bold text-slate-500">
                            <th class="px-2 py-1.5 font-bold">الصنف</th>
                            <th class="px-2 py-1.5 font-bold">دفترية سليمة</th>
                            <th class="px-2 py-1.5 font-bold">معدودة سليمة</th>
                            <th class="px-2 py-1.5 font-bold">الفرق</th>
                            <th class="px-2 py-1.5 font-bold">دفترية تالفة</th>
                            <th class="px-2 py-1.5 font-bold">معدودة تالفة</th>
                            <th class="px-2 py-1.5 font-bold">فرق التالف</th>
                            <th class="px-2 py-1.5 font-bold">المراجعة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _count.Lines)
                        {
                            <tr class="@($"text-xs text-slate-700 {(line.LateMovement ? "bg-amber-50/80" : "bg-slate-50/70")}")" @key="line.LineId">
                                <td class="rounded-r-lg px-2 py-2">
                                    <p class="text-sm font-bold text-slate-900">@line.ProductName</p>
                                    <p class="text-[11px] text-slate-500">@line.ProductCode</p>
                                </td>
                                <td class="px-2 py-2 font-semibold text-slate-700">@line.BookQty</td>
                                <td class="px-2 py-2 font-bold text-slate-800">@(line.CountedQty?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                <td class="px-2 py-2">
                                    <span class="@($"rounded-full border px-2 py-0.5 text-[11px] font-bold {CountPresentation.DeltaTag(line.Delta)}")">
                                        @CountPresentation.DeltaLabel(line.Delta)
                                    </span>
                                </td>
                                <td class="px-2 py-2 font-semibold text-slate-700">@line.BookDamagedQty</td>
                                <td class="px-2 py-2 font-bold text-slate-800">@(line.CountedDamagedQty?.ToString(CultureInfo.InvariantCulture) ?? "—")</td>
                                <td class="px-2 py-2">
                                    <span class="@($"rounded-full border px-2 py-0.5 text-[11px] font-bold {CountPresentation.DeltaTag(line.DamagedDelta)}")">
                                        @CountPresentation.DeltaLabel(line.DamagedDelta)
                                    </span>
                                </td>
                                <td class="rounded-l-lg px-2 py-2">
                                    @if (line.LateMovement && _count.Status == InventoryCountStatus.UnderReview && _canApprove)
                                    {
                                        <div class="flex flex-wrap items-center gap-1.5">
                                            <span class="rounded-full border border-amber-300 bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800">
                                                حركة متأخرة
                                            </span>
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Disabled="_busy"
                                                       Class="oh-btn oh-btn--secondary oh-btn--sm"
                                                       OnClick="@(() => OpenReviewAsync(line, LateMovementDecision.IncludedInCount))">
                                                شملها العدّ
                                            </MudButton>
                                            <MudButton Variant="Variant.Outlined"
                                                       Size="Size.Small"
                                                       Disabled="_busy"
                                                       Class="oh-btn oh-btn--secondary oh-btn--sm"
                                                       OnClick="@(() => OpenReviewAsync(line, LateMovementDecision.Recounted))">
                                                إعادة العدّ
                                            </MudButton>
                                        </div>
                                    }
                                    else if (line.ReviewDecision == LateMovementDecision.IncludedInCount)
                                    {
                                        <span class="rounded-full border border-sky-200 bg-sky-50 px-2 py-0.5 text-[11px] font-bold text-sky-700">
                                            شملها العدّ
                                        </span>
                                    }
                                    else if (line.ReviewDecision == LateMovementDecision.Recounted)
                                    {
                                        <span class="rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-[11px] font-bold text-indigo-700">
                                            أعيد عدّها
                                        </span>
                                    }
                                    else if (line.LateMovement)
                                    {
                                        <span class="rounded-full border border-amber-300 bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800">
                                            حركة متأخرة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-[11px] text-slate-400">—</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(line.ReviewNote))
                                    {
                                        <p class="mt-1 max-w-[14rem] text-[11px] leading-5 text-slate-500">@line.ReviewNote</p>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_count.Status == InventoryCountStatus.UnderReview && !_canApprove)
            {
                <p class="mt-3 text-[11px] font-semibold text-slate-500">
                    الاعتماد متاح للمدير المختص؛ يمكنك مطالعة الفروق فقط.
                </p>
            }
        </section>
    }
</div>
