@using System.Globalization
@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-teal-50 text-teal-600">
                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">بدء جرد جديد</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        تُلتقط الأرصدة الدفترية الآن، ولا تتغير الأرصدة حتى اعتماد المدير.
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <MudSelect T="InventoryCountScope"
                       @bind-Value="_scope"
                       Label="نطاق الجرد"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_submitting">
                <MudSelectItem T="InventoryCountScope" Value="InventoryCountScope.Full">جرد كامل — كل الأصناف المتاحة</MudSelectItem>
                <MudSelectItem T="InventoryCountScope" Value="InventoryCountScope.Products">أصناف محددة</MudSelectItem>
            </MudSelect>

            @if (_scope == InventoryCountScope.Full)
            {
                <div class="rounded-xl border border-teal-200 bg-teal-50 px-3 py-2 text-xs font-bold leading-6 text-teal-800">
                    سيشمل الجرد @_rows.Count صنفًا. أي صنف له جرد مفتوح يُستبعد تلقائيًا.
                </div>
            }
            else
            {
                <div class="space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-xs font-semibold text-slate-700">اختر الأصناف المطلوب جردها</p>
                        <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 text-[11px] font-bold text-slate-600">
                            @SelectedCount محددة
                        </span>
                    </div>

                    @if (_rows.Count == 0)
                    {
                        <p class="rounded-xl border border-slate-200 bg-white p-4 text-xs text-slate-500">
                            لا توجد أصناف قابلة للجرد في المخزن.
                        </p>
                    }
                    else
                    {
                        <div class="max-h-64 space-y-1 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2">
                            @foreach (var row in _rows)
                            {
                                <div class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 hover:bg-slate-50" @key="row.ProductId">
                                    <MudCheckBox T="bool"
                                                 @bind-Value="row.Selected"
                                                 Disabled="@(_submitting || row.HasOpenCount)"
                                                 Dense="true"
                                                 Color="Color.Primary"
                                                 Label="@row.ProductName" />
                                    <div class="flex shrink-0 items-center gap-2">
                                        <span class="text-[11px] font-medium text-slate-500">@row.ProductCode</span>
                                        @if (row.HasOpenCount)
                                        {
                                            <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-[11px] font-bold text-amber-700">
                                                جرد مفتوح
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Class="oh-btn oh-btn--primary"
                       Disabled="@(!CanSubmit)"
                       OnClick="SubmitAsync">
                @(_submitting ? "جاري البدء…" : "بدء الجرد")
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    private sealed class ProductSelection(CountableProductRow product)
    {
        public int ProductId { get; } = product.ProductId;
        public string ProductName { get; } = product.ProductName;
        public string ProductCode { get; } = product.ProductCode;
        public bool HasOpenCount { get; } = product.HasOpenCount;
        public bool Selected { get; set; }
    }

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<StartCountDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<CountableProductRow> Products { get; set; } = [];

    private InventoryCountScope _scope = InventoryCountScope.Full;
    private string? _error;
    private bool _submitting;
    private List<ProductSelection> _rows = [];

    private int SelectedCount => _rows.Count(row => row.Selected);

    private bool CanSubmit =>
        !_submitting
        && _rows.Count > 0
        && (_scope == InventoryCountScope.Full || SelectedCount > 0);

    protected override void OnInitialized()
    {
        _rows = Products.Select(product => new ProductSelection(product)).ToList();

        if (_rows.All(row => row.HasOpenCount))
        {
            _scope = InventoryCountScope.Products;
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            IReadOnlyList<int> productIds = _scope == InventoryCountScope.Products
                ? _rows.Where(row => row.Selected).Select(row => row.ProductId).ToList()
                : null;

            var result = await Executor.ExecuteAsync(new StartCountCommand(_scope, productIds));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to start an inventory count");
            _error = "تعذر بدء الجرد. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
