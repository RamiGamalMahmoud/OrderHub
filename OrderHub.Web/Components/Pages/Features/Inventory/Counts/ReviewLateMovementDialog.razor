@using System.Globalization
@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@Title</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">@ProductName</p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <div class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                @Explanation
            </div>

            <MudTextField T="string"
                          @bind-Value="_note"
                          Label="ملاحظة المراجعة (اختياري)"
                          Immediate="true"
                          MaxLength="200"
                          HelperText="@NoteCounter"
                          Lines="3"
                          Variant="Variant.Outlined"
                          Disabled="_submitting" />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">رجوع دون تغيير</MudButton>
            <MudButton Class="oh-btn oh-btn--primary"
                       Disabled="@(!CanSubmit)"
                       OnClick="SubmitAsync">
                @(_submitting ? "جاري التسجيل…" : "تسجيل القرار")
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<ReviewLateMovementDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public int CountId { get; set; }
    [Parameter, EditorRequired] public int LineId { get; set; }
    [Parameter, EditorRequired] public string ProductName { get; set; } = string.Empty;
    [Parameter, EditorRequired] public LateMovementDecision Decision { get; set; }

    private string? _note;
    private string? _error;
    private bool _submitting;

    private string Title => Decision == LateMovementDecision.Recounted
        ? "إعادة عدّ الصنف"
        : "شمل الحركة في العدّ";

    private string Explanation => Decision == LateMovementDecision.Recounted
        ? "يعود الجرد مفتوحًا ويُمسح العدّ السابق لهذا الصنف؛ أعد إدخال الكميتين ثم أنهِ العدّ من جديد."
        : "يُعاد حساب الرصيد الدفتري لهذا الصنف حتى لحظة العدّ، ويُحدَّث الفرق تلقائيًا قبل الاعتماد.";

    private string NoteCounter => $"{(_note?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    private bool CanSubmit => !_submitting;

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(new ReviewLateMovementCommand(
                CountId,
                LineId,
                Decision,
                string.IsNullOrWhiteSpace(_note) ? null : _note.Trim()));

            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to review late movement for count {CountId}", CountId);
            _error = "تعذر تسجيل قرار المراجعة. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
