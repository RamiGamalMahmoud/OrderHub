@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">تأكيد إعادة بناء الأرصدة</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        تُكتب الأرصدة المشتقة فوق الأرصدة المخزنة، ولا تُنشأ أي حركة جديدة.
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            <MudSelect T="InventoryRebuildScope"
                       @bind-Value="_scope"
                       Label="نطاق إعادة البناء"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_submitting">
                <MudSelectItem T="InventoryRebuildScope" Value="InventoryRebuildScope.AllWarehouses">
                    كل المخازن
                </MudSelectItem>
                <MudSelectItem T="InventoryRebuildScope" Value="InventoryRebuildScope.SingleWarehouse">
                    مخزن واحد
                </MudSelectItem>
            </MudSelect>

            @if (_scope == InventoryRebuildScope.SingleWarehouse)
            {
                <MudSelect T="int?"
                           @bind-Value="_warehouseId"
                           Label="المخزن"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="_submitting">
                    @foreach (var warehouse in Warehouses)
                    {
                        <MudSelectItem T="int?" Value="warehouse.Id">
                            @warehouse.Name@(warehouse.IsActive ? string.Empty : " (غير نشط)")
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            <div class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-xs font-semibold leading-6 text-rose-800">
                عند التأكيد يُعاد احتساب الرصيد السليم والتالف من دفتر الحركات، والمحجوز من التخصيصات
                النشطة، ثم تُكتب القيم الجديدة فورًا. تُسجَّل العملية مع قبل/بعد لكل رصيد تغيّر.
            </div>

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                رجوع دون تغيير
            </MudButton>
            <MudButton Class="oh-btn oh-btn--primary"
                       Disabled="@(!CanSubmit)"
                       OnClick="SubmitAsync">
                @(_submitting ? "جاري إعادة البناء…" : "تأكيد إعادة البناء")
            </MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<RebuildBalancesDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public IReadOnlyList<WarehouseListItem> Warehouses { get; set; } = [];

    private InventoryRebuildScope _scope = InventoryRebuildScope.AllWarehouses;
    private int? _warehouseId;
    private string? _error;
    private bool _submitting;

    private bool CanSubmit =>
        !_submitting
        && (_scope == InventoryRebuildScope.AllWarehouses || _warehouseId is > 0);

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _submitting = true;
        _error = null;
        try
        {
            int? warehouseId = _scope == InventoryRebuildScope.SingleWarehouse
                ? _warehouseId
                : null;

            var result = await Executor.ExecuteAsync(new RebuildBalancesCommand(_scope, warehouseId));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            Dialog.Close(DialogResult.Ok(result.Value));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to rebuild the cached stock balances");
            _error = "تعذر إعادة بناء الأرصدة. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
