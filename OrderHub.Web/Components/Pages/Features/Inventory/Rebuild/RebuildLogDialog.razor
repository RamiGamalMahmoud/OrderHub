@using MudBlazor

<MudDialog Class="flex w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">تفاصيل إعادة البناء</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        الأرصدة التي تغيّرت قيمها في هذه العملية فقط.
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="Close"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="space-y-4 bg-slate-50/70 p-5">
            @if (_loading)
            {
                <div class="py-6 text-center">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل تفاصيل إعادة البناء" />
                </div>
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            else if (_details is not null)
            {
                <div class="grid gap-3 sm:grid-cols-3">
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-xs font-semibold text-slate-500">نُفّذت في</p>
                        <p class="mt-1 text-sm font-bold text-slate-800">
                            <UserLocalTime Value="_details.PerformedAtUtc" />
                        </p>
                        <p class="mt-0.5 text-xs text-slate-500">بواسطة @_details.PerformedBy</p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-xs font-semibold text-slate-500">النطاق</p>
                        <p class="mt-1 text-sm font-bold text-slate-800">@ScopeLabel()</p>
                        <p class="mt-0.5 text-xs text-slate-500">
                            @_details.InspectedPairs.ToString(CultureInfo.InvariantCulture) زوجًا مفحوصًا
                        </p>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="text-xs font-semibold text-slate-500">أزواج تغيّرت</p>
                        <p class="mt-1 text-sm font-bold @(_details.ChangedPairs > 0 ? "text-amber-700" : "text-emerald-700")">
                            @_details.ChangedPairs.ToString(CultureInfo.InvariantCulture)
                        </p>
                        <p class="mt-0.5 text-xs text-slate-500">
                            @(_details.ChangedPairs > 0 ? "تم إصلاحها في هذه العملية" : "لم يلزم إصلاح أي رصيد")
                        </p>
                    </div>
                </div>

                @if (_details.Lines.Count == 0)
                {
                    <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold leading-6 text-emerald-800">
                        الأرصدة المخزنة كانت مطابقة للدفتر والتخصيصات النشطة؛ لم تتغير أي قيمة.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white">
                        <table class="w-full min-w-[42rem] text-xs">
                            <thead class="bg-slate-50 text-slate-500">
                                <tr>
                                    <th class="px-3 py-2 text-start font-bold">المخزن</th>
                                    <th class="px-3 py-2 text-start font-bold">الصنف</th>
                                    <th class="px-3 py-2 text-start font-bold">الرصيد السليم</th>
                                    <th class="px-3 py-2 text-start font-bold">المحجوز</th>
                                    <th class="px-3 py-2 text-start font-bold">التالف</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var line in _details.Lines)
                                {
                                    <tr @key="@($"{line.WarehouseId}-{line.ProductId}")">
                                        <td class="px-3 py-2 font-semibold text-slate-700">@line.WarehouseName</td>
                                        <td class="px-3 py-2">
                                            <span class="block font-semibold text-slate-800">@line.ProductName</span>
                                            <span class="block text-xs text-slate-500">@line.ProductCode</span>
                                        </td>
                                        @foreach (var (before, after) in new[]
                                        {
                                            (line.BeforeStockOnHand, line.AfterStockOnHand),
                                            (line.BeforeReservedOnHand, line.AfterReservedOnHand),
                                            (line.BeforeDamagedQty, line.AfterDamagedQty)
                                        })
                                        {
                                            <td class="px-3 py-2">
                                                <span class="block text-xs text-slate-500">
                                                    قبل: @before.ToString(CultureInfo.InvariantCulture)
                                                </span>
                                                <span class="block font-bold text-emerald-700">
                                                    بعد: @after.ToString(CultureInfo.InvariantCulture)
                                                </span>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton OnClick="Close" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">إغلاق</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ILogger<RebuildLogDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public int LogId { get; set; }

    private RebuildLogDetails? _details;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Executor.ExecuteAsync(new GetRebuildLogQuery(LogId));
            if (!result.IsSuccess)
            {
                _error = result.ErrorMessage;
                return;
            }

            _details = result.Value;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the rebuild log {LogId}", LogId);
            _error = "تعذر تحميل تفاصيل إعادة البناء. حاول مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private string ScopeLabel() =>
        _details!.Scope == InventoryRebuildScope.AllWarehouses
            ? "كل المخازن"
            : _details.WarehouseName ?? "مخزن محدد";

    private void Close() => Dialog.Close();
}
