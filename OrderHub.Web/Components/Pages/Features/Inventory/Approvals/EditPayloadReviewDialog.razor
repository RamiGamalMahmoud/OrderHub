@using Microsoft.Extensions.Logging
@using MudBlazor

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                    <MudIcon Icon="@Icons.Material.Filled.Difference" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">مراجعة تعديل الطلب</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        @(Row.OrderNumber ?? "طلب") — أرسله @Row.RequestedByName
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_submitting"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-5">
            @if (_loading)
            {
                <div class="flex flex-col items-center gap-2 py-10">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل فروقات التعديل" />
                    <p class="text-sm text-slate-500">جاري تحميل فروقات التعديل...</p>
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3">
                    <p class="text-sm font-bold text-rose-800">@_loadError</p>
                    <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm" @onclick="LoadAsync">
                        إعادة المحاولة
                    </button>
                </div>
            }
            else
            {
                <div class="rounded-xl border border-slate-200 bg-white p-4 text-sm">
                    <p class="text-[11px] font-semibold text-slate-500">سبب التعديل</p>
                    <p class="mt-0.5 text-slate-700" style="overflow-wrap:anywhere">@Row.Reason</p>
                    <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs font-bold leading-6 text-amber-800">
                        تُطبَّق الحمولة المحفوظة كما هي عند الاعتماد، وتبقى الكميات المصروفة محفوظة مع إظهار الباقي منها كمرتجع مستحق.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                    <div class="rounded-xl border border-slate-200 bg-white p-3 text-center">
                        <span class="block text-[11px] font-semibold text-slate-500">بنود الطلب</span>
                        <span class="block text-base font-black text-slate-900">@Format(_diffs.Count)</span>
                    </div>
                    <div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-center">
                        <span class="block text-[11px] font-semibold text-amber-700">بنود متغيرة</span>
                        <span class="block text-base font-black text-amber-800">@Format(_diffs.Count(diff => diff.Changed))</span>
                    </div>
                    <div class="col-span-2 rounded-xl border border-sky-200 bg-sky-50 p-3 text-center sm:col-span-1">
                        <span class="block text-[11px] font-semibold text-sky-700">صافي فرق الكميات</span>
                        <span class="block text-base font-black text-sky-800">@Signed(TotalDelta)</span>
                    </div>
                </div>

                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                    <table class="w-full text-right text-sm">
                        <thead class="bg-slate-50 text-[11px] font-bold text-slate-500">
                            <tr>
                                <th class="px-3 py-2 font-bold">المنتج</th>
                                <th class="px-3 py-2 font-bold">الحالي</th>
                                <th class="px-3 py-2 font-bold">المقترح</th>
                                <th class="px-3 py-2 font-bold">الفرق</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var diff in _diffs)
                            {
                                <tr class="@(diff.Changed ? "bg-amber-50/40" : string.Empty)">
                                    <td class="px-3 py-2 align-top" style="overflow-wrap:anywhere">
                                        <span class="block font-bold text-slate-900">@diff.ProductName</span>
                                        @foreach (var allocation in diff.Allocations.Where(allocation => allocation.Changed))
                                        {
                                            <span class="@($"mt-1 inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[11px] font-bold {AllocationTag(allocation.Delta)}")">
                                                @allocation.Label: @Signed(allocation.Delta)
                                            </span>
                                        }
                                    </td>
                                    <td class="px-3 py-2 align-top font-bold text-slate-700">@Format(diff.CurrentQty)</td>
                                    <td class="px-3 py-2 align-top font-bold text-slate-900">@Format(diff.ProposedQty)</td>
                                    <td class="@($"px-3 py-2 align-top font-black {DeltaClass(diff.Delta)}")">@Signed(diff.Delta)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <MudTextField T="string"
                              @bind-Value="_note"
                              Label="ملاحظة القرار (مطلوبة عند الرفض)"
                              Immediate="true"
                              MaxLength="200"
                              HelperText="@NoteCounter"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Disabled="_submitting" />

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton Disabled="_submitting" OnClick="Cancel" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">
                إلغاء
            </MudButton>
            <div class="flex flex-wrap items-center gap-2">
                <MudButton Class="oh-btn oh-btn--danger"
                           Disabled="@(!CanDecide)"
                           OnClick="@(() => SubmitAsync(false))">
                    رفض التعديل
                </MudButton>
                <MudButton Class="oh-btn oh-btn--primary"
                           Disabled="@(!CanDecide)"
                           OnClick="@(() => SubmitAsync(true))">
                    @(_submitting ? "جاري التنفيذ…" : "اعتماد التعديل")
                </MudButton>
            </div>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Inject] private IRequestExecutor Executor { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private ILogger<EditPayloadReviewDialog> Logger { get; set; } = null!;

    [Parameter, EditorRequired] public InventoryApprovalProjectionRow Row { get; set; } = null!;

    private sealed record AllocationDiff(
        string Label,
        int CurrentQty,
        int ProposedQty)
    {
        public int Delta => ProposedQty - CurrentQty;

        public bool Changed => Delta != 0;
    }

    private sealed record ProductDiff(
        string ProductName,
        int CurrentQty,
        int ProposedQty,
        IReadOnlyList<AllocationDiff> Allocations)
    {
        public int Delta => ProposedQty - CurrentQty;

        public bool Changed => Delta != 0 || Allocations.Any(allocation => allocation.Changed);
    }

    private IReadOnlyList<ProductDiff> _diffs = [];
    private string? _note;
    private string? _loadError;
    private string? _error;
    private bool _loading = true;
    private bool _submitting;

    private int TotalDelta => _diffs.Sum(diff => diff.Delta);

    private string NoteCounter => $"{(_note?.Length ?? 0).ToString(CultureInfo.InvariantCulture)} / 200";

    private bool CanDecide => !_loading && !_submitting && _loadError is null;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(new GetApprovalDetailsQuery(Row.Id));
            if (!result.IsSuccess)
            {
                _diffs = [];
                _loadError = result.ErrorMessage;
                return;
            }

            _diffs = BuildDiffs(result.Value);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load the edit payload for approval {ApprovalId}", Row.Id);
            _diffs = [];
            _loadError = "تعذر تحميل فروقات التعديل. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static IReadOnlyList<ProductDiff> BuildDiffs(ApprovalDetailsResult details)
    {
        var products = new List<(int ProductId, string ProductName, ApprovalItemView? Current, ApprovalItemView? Proposed)>();
        foreach (var proposed in details.ProposedItems)
        {
            var current = details.CurrentItems.FirstOrDefault(item => item.ProductId == proposed.ProductId);
            products.Add((proposed.ProductId, proposed.ProductName, current, proposed));
        }

        foreach (var current in details.CurrentItems.Where(item =>
                     details.ProposedItems.All(proposed => proposed.ProductId != item.ProductId)))
        {
            products.Add((current.ProductId, current.ProductName, current, null));
        }

        return products
            .Select(entry =>
            {
                ApprovalItemView? current = entry.Current;
                ApprovalItemView? proposed = entry.Proposed;
                var keys = (proposed?.Allocations ?? [])
                    .Select(allocation => AllocationKey(allocation))
                    .Concat((current?.Allocations ?? []).Select(allocation => AllocationKey(allocation)))
                    .Distinct()
                    .ToList();

                var allocations = keys
                    .Select(key =>
                    {
                        ApprovalAllocationView? proposedAllocation = proposed?.Allocations
                            .FirstOrDefault(allocation => AllocationKey(allocation) == key);
                        ApprovalAllocationView? currentAllocation = current?.Allocations
                            .FirstOrDefault(allocation => AllocationKey(allocation) == key);
                        return new AllocationDiff(
                            AllocationLabel(proposedAllocation ?? currentAllocation),
                            currentAllocation?.Qty ?? 0,
                            proposedAllocation?.Qty ?? 0);
                    })
                    .ToList();

                return new ProductDiff(
                    proposed?.ProductName ?? current?.ProductName ?? "منتج",
                    current?.Quantity ?? 0,
                    proposed?.Quantity ?? 0,
                    allocations);
            })
            .ToList();
    }

    private static string AllocationKey(ApprovalAllocationView allocation) =>
        $"{allocation.SourceKind}:{allocation.WarehouseId}:{allocation.SupplierName}";

    private static string AllocationLabel(ApprovalAllocationView? allocation)
    {
        if (allocation is null)
            return "توزيع";

        if (allocation.SourceKind == AllocationSourceKind.Supplier)
            return string.IsNullOrWhiteSpace(allocation.SupplierName)
                ? "مورد"
                : $"مورد {allocation.SupplierName}";

        return string.IsNullOrWhiteSpace(allocation.WarehouseName)
            ? "مخزن"
            : allocation.WarehouseName;
    }

    private async Task SubmitAsync(bool approve)
    {
        if (!CanDecide)
            return;

        if (!approve && string.IsNullOrWhiteSpace(_note))
        {
            _error = "سبب الرفض مطلوب.";
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(
                new DecideApprovalCommand(Row.Id, approve, _note?.Trim(), Row.Version));
            if (!result.IsSuccess)
            {
                if (result.ErrorCode is "Stale" or "Conflict")
                {
                    Snackbar.Add(result.ErrorMessage, Severity.Warning);
                    Dialog.Close(DialogResult.Ok(false));
                    return;
                }

                _error = result.ErrorMessage;
                return;
            }

            Snackbar.Add(approve ? "تم اعتماد تعديل الطلب." : "تم رفض تعديل الطلب.", Severity.Success);
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to decide the edit approval {ApprovalId}", Row.Id);
            _error = "تعذر تنفيذ القرار. حاول مرة أخرى.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();

    private static string Format(int value) => value.ToString(CultureInfo.InvariantCulture);

    private static string Signed(int value) =>
        value > 0
            ? $"+{Format(value)}"
            : Format(value);

    private static string DeltaClass(int delta) => delta switch
    {
        > 0 => "text-emerald-700",
        < 0 => "text-rose-700",
        _ => "text-slate-400"
    };

    private static string AllocationTag(int delta) => delta switch
    {
        > 0 => "border-emerald-200 bg-emerald-50 text-emerald-700",
        < 0 => "border-rose-200 bg-rose-50 text-rose-700",
        _ => "border-slate-200 bg-slate-50 text-slate-600"
    };
}
