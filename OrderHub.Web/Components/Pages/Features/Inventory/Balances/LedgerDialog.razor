@implements IDisposable

@inject IRequestExecutor Executor
@inject ILogger<LedgerDialog> Logger
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog Class="flex max-h-[92vh] w-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@ProductName</h2>
                    <p class="mt-1 flex flex-wrap items-center gap-x-2 text-xs font-medium text-slate-500">
                        <span dir="ltr">@ProductCode</span>
                        @if (_page is not null)
                        {
                            <span>· @_page.WarehouseName</span>
                        }
                    </p>
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="Close"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto bg-slate-50/70 p-5">
            @if (_page is not null)
            {
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                    <div class="rounded-xl border border-slate-200 bg-white p-3 text-center">
                        <span class="block text-[11px] font-semibold text-slate-500">الكلي</span>
                        <span class="block text-base font-black text-slate-900">@Format(_page.Product.StockOnHand)</span>
                    </div>
                    <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-3 text-center">
                        <span class="block text-[11px] font-semibold text-emerald-700">المتاح</span>
                        <span class="block text-base font-black text-emerald-800">@Format(_page.Product.Available)</span>
                    </div>
                    <div class="rounded-xl border border-sky-100 bg-sky-50 p-3 text-center">
                        <span class="block text-[11px] font-semibold text-sky-700">المحجوز</span>
                        <span class="block text-base font-black text-sky-800">@Format(_page.Product.ReservedOnHand)</span>
                    </div>
                    <div class="rounded-xl border border-amber-100 bg-amber-50 p-3 text-center">
                        <span class="block text-[11px] font-semibold text-amber-700">التالف</span>
                        <span class="block text-base font-black text-amber-800">@Format(_page.Product.DamagedQty)</span>
                    </div>
                </div>
            }

            @if (_error is not null)
            {
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3">
                    <p class="text-sm font-bold text-rose-800">@_error</p>
                    <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm" @onclick="ReloadAsync">
                        إعادة المحاولة
                    </button>
                </div>
            }

            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
                <MudTable T="WarehouseLedgerRow"
                          @ref="_table"
                          ServerData="LoadServerDataAsync"
                          RowsPerPage="@_pageSize"
                          Loading="_loading"
                          Dense="true"
                          Hover="true"
                          Elevation="0"
                          Square="true"
                          Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh Class="text-xs font-bold text-slate-500">التاريخ</MudTh>
                        <MudTh Class="text-xs font-bold text-slate-500">الحركة</MudTh>
                        <MudTh Class="text-xs font-bold text-slate-500">الكمية</MudTh>
                        <MudTh Class="text-xs font-bold text-slate-500">المرجع</MudTh>
                        <MudTh Class="text-xs font-bold text-slate-500">المنفذ</MudTh>
                        <MudTh Class="text-xs font-bold text-slate-500">ملاحظات</MudTh>
                        @if (CanRequestReversal)
                        {
                            <MudTh Class="w-24 text-xs font-bold text-slate-500">
                                <span class="sr-only">إجراءات</span>
                            </MudTh>
                        }
                    </HeaderContent>

                    <RowTemplate Context="row">
                        <MudTd DataLabel="التاريخ">
                            <UserLocalTime Value="row.EffectiveAtUtc" />
                        </MudTd>
                        <MudTd DataLabel="الحركة">
                            <span class="block text-sm font-bold text-slate-800">@InventoryPresentation.MovementTypeLabel(row.MovementType)</span>
                            <span class="mt-0.5 flex flex-wrap items-center gap-1 text-[11px]">
                                <span class="@DirectionTag(row.Direction)">
                                    @InventoryPresentation.MovementDirectionLabel(row.Direction)
                                </span>
                                @if (row.Status == InventoryMovementStatus.Reversed)
                                {
                                    <span class="rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 font-bold text-rose-700">
                                        @InventoryPresentation.MovementStatusLabel(row.Status)
                                    </span>
                                }
                            </span>
                        </MudTd>
                        <MudTd DataLabel="الكمية">
                            <span class="@QuantityClass(row.Direction)">
                                @QuantityLabel(row)
                            </span>
                        </MudTd>
                        <MudTd DataLabel="المرجع" Style="overflow-wrap:anywhere">
                            @if (ReferenceLabel(row) is string reference)
                            {
                                <span class="text-xs font-medium text-slate-700">@reference</span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-400">—</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="المنفذ">
                            <span class="text-xs text-slate-700">@(string.IsNullOrWhiteSpace(row.PerformedByName) ? "—" : row.PerformedByName)</span>
                        </MudTd>
                        <MudTd DataLabel="ملاحظات" Style="overflow-wrap:anywhere">
                            @if (string.IsNullOrWhiteSpace(row.Note))
                            {
                                <span class="text-xs text-slate-400">—</span>
                            }
                            else
                            {
                                <span class="text-xs text-slate-600">@row.Note</span>
                            }
                        </MudTd>
                        @if (CanRequestReversal)
                        {
                            <MudTd DataLabel="إجراءات">
                                @if (IsReversible(row))
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Size="Size.Small"
                                               Class="oh-btn oh-btn--secondary oh-btn--sm"
                                               OnClick="@(() => OpenReversalAsync(row))">
                                        طلب عكس
                                    </MudButton>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">—</span>
                                }
                            </MudTd>
                        }
                    </RowTemplate>

                    <NoRecordsContent>
                        <div class="px-4 py-8 text-center text-sm text-slate-500">
                            @(_error is null ? "لا توجد حركات مسجلة لهذا المنتج في المخزن." : "تعذر تحميل سجل الحركات.")
                        </div>
                    </NoRecordsContent>

                    <PagerContent>
                        <TableFooter TotalItems="@_totalCount"
                                     CurrentPage="@_pageIndex"
                                     CurrentPageChanged="OnFooterPageChanged"
                                     RowsPerPage="@_pageSize"
                                     RowsPerPageChanged="OnFooterRowsPerPageChanged" />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <footer class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-100 bg-white p-4">
            <MudButton OnClick="Close" Variant="Variant.Text" Class="oh-btn oh-btn--secondary">إغلاق</MudButton>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public int WarehouseId { get; set; }
    [Parameter] public int ProductId { get; set; }
    [Parameter] public string ProductName { get; set; } = string.Empty;
    [Parameter] public string ProductCode { get; set; } = string.Empty;
    [Parameter] public bool CanRequestReversal { get; set; }

    private MudTable<WarehouseLedgerRow>? _table;
    private readonly CancellationTokenSource _lifetime = new();
    private WarehouseLedgerPage? _page;
    private string? _error;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private long _requestVersion;
    private bool _loading = true;
    private bool _disposed;

    private async Task<TableData<WarehouseLedgerRow>> LoadServerDataAsync(
        TableState state,
        CancellationToken tableCancellation)
    {
        if (_disposed)
        {
            return new TableData<WarehouseLedgerRow> { Items = [], TotalItems = 0 };
        }

        long version = ++_requestVersion;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(
            tableCancellation,
            _lifetime.Token);
        _loading = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(
                new GetWarehouseLedgerQuery(WarehouseId, ProductId, _pageIndex, _pageSize),
                cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();

            if (version != _requestVersion || _disposed)
            {
                return CurrentData();
            }

            if (!result.IsSuccess)
            {
                _page = null;
                _error = result.ErrorMessage;
                _totalCount = 0;
                return CurrentData();
            }

            _page = result.Value;
            _totalCount = result.Value.TotalCount;

            int lastPage = Math.Max(1, (result.Value.TotalCount + result.Value.PageSize - 1) / result.Value.PageSize);
            if (_pageIndex <= lastPage)
            {
                return CurrentData();
            }

            _pageIndex = lastPage;
            result = await Executor.ExecuteAsync(
                new GetWarehouseLedgerQuery(WarehouseId, ProductId, _pageIndex, _pageSize),
                cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();

            if (version != _requestVersion || _disposed)
            {
                return CurrentData();
            }

            if (result.IsSuccess)
            {
                _page = result.Value;
                _totalCount = result.Value.TotalCount;
            }

            return CurrentData();
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return CurrentData();
        }
        catch (Exception exception)
        {
            if (version == _requestVersion && !_disposed)
            {
                Logger.LogError(
                    exception,
                    "Failed to load ledger for product {ProductId} in warehouse {WarehouseId}",
                    ProductId,
                    WarehouseId);
                _page = null;
                _error = "تعذر تحميل سجل الحركات. يرجى المحاولة مرة أخرى.";
                _totalCount = 0;
            }

            return CurrentData();
        }
        finally
        {
            if (version == _requestVersion && !_disposed)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private TableData<WarehouseLedgerRow> CurrentData() => new()
    {
        Items = _page?.Rows ?? [],
        TotalItems = _totalCount
    };

    private async Task ReloadAsync()
    {
        if (_disposed || _table is null)
        {
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task OnFooterPageChanged(int page)
    {
        _pageIndex = Math.Max(1, page);
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _pageSize = rowsPerPage;
        _pageIndex = 1;
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private void Close() => Dialog.Close();

    private static bool IsReversible(WarehouseLedgerRow row) =>
        row.Status == InventoryMovementStatus.Active &&
        row.MovementType != InventoryMovementType.Reversal;

    private async Task OpenReversalAsync(WarehouseLedgerRow row)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            DialogParameters<RequestReversalDialog> parameters = new()
            {
                { dialog => dialog.MovementId, row.Id },
                { dialog => dialog.ProductName, ProductName },
                { dialog => dialog.MovementLabel, MovementLabel(row) }
            };
            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            var dialog = await Dialogs.ShowAsync<RequestReversalDialog>("طلب عكس حركة", parameters, options);
            DialogResult? result = await dialog.Result;
            if (result is { Canceled: false } && !_disposed)
            {
                Snackbar.Add("تم إرسال طلب العكس إلى المدير للاعتماد.", Severity.Success);
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open the reversal dialog for movement {MovementId}",
                row.Id);
            Snackbar.Add("تعذر فتح نافذة طلب العكس. يرجى المحاولة مرة أخرى.", Severity.Error);
        }
    }

    private static string MovementLabel(WarehouseLedgerRow row) =>
        $"{InventoryPresentation.MovementTypeLabel(row.MovementType)} · {InventoryPresentation.MovementDirectionLabel(row.Direction)} {row.Quantity.ToString(CultureInfo.InvariantCulture)}";

    private static string? ReferenceLabel(WarehouseLedgerRow row)
    {
        if (row.IssueOrderNumber is long number && row.IssueOrderYear is int year && row.IssueOrderMonth is int month)
        {
            return $"أمر صرف {InventoryPresentation.IssueOrderNumberLabel(number, year, month)}";
        }

        if (!string.IsNullOrWhiteSpace(row.ReceiptReferenceNote))
        {
            return $"مرجع التوريد: {row.ReceiptReferenceNote}";
        }

        if (row.ReversalOfMovementId is int reversalId)
        {
            return $"عكس حركة #{reversalId.ToString(CultureInfo.InvariantCulture)}";
        }

        return null;
    }

    private static string QuantityLabel(WarehouseLedgerRow row)
    {
        string quantity = row.Quantity.ToString(CultureInfo.InvariantCulture);
        return row.Direction == InventoryDirection.In ? $"+{quantity}" : $"-{quantity}";
    }

    private static string QuantityClass(InventoryDirection direction) =>
        direction == InventoryDirection.In
            ? "text-sm font-black text-emerald-700"
            : "text-sm font-black text-rose-700";

    private static string DirectionTag(InventoryDirection direction) =>
        direction == InventoryDirection.In
            ? "rounded-full border border-emerald-200 bg-emerald-50 px-2 py-0.5 font-bold text-emerald-700"
            : "rounded-full border border-rose-200 bg-rose-50 px-2 py-0.5 font-bold text-rose-700";

    private static string Format(int value) => value.ToString(CultureInfo.InvariantCulture);

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        ++_requestVersion;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
