@page "/inventory"

@attribute [PermissionAuthorize(
    PermissionFeature.Inventory,
    PermissionLevel.Read)]

@inject IRequestExecutor Executor
@inject NavigationManager Navigation
@inject ILogger<Index> Logger

<PageTitle>أرصدة المخزون</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="أرصدة المخزون"
                  Description="@(_state?.ScopeLabel ?? "أرصدة المنتجات في المخازن المتاحة لك")"
                  Crumbs="_crumbs"
                  Count="@_state?.Warehouses.Count">
        <Actions>
            @if (_state?.CanRecordStockIn == true)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="oh-btn oh-btn--primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="/inventory/stock-in">
                    تسجيل توريد
                </MudButton>
            }
        </Actions>
    </PageScaffold>

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل أرصدة المخزون" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل أرصدة المخزون...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-2xl border border-rose-200 bg-rose-50 p-5">
            <p class="text-sm font-bold text-rose-800">@_error</p>
            <button type="button" class="oh-btn oh-btn--secondary oh-btn--sm mt-3" @onclick="LoadAsync">
                إعادة المحاولة
            </button>
        </div>
    }
    else if (_state is null || _state.Warehouses.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-50 text-teal-600">
                <MudIcon Icon="@Icons.Material.Filled.Warehouse" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">لا توجد مخازن متاحة لعرض أرصدتها.</p>
            <p class="mt-1 text-sm text-slate-500">تواصل مع المدير لربط حسابك بمخزن أو لمنحك صلاحية عرض المخزون.</p>
        </div>
    }
    else
    {
        <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <span class="text-xs font-semibold text-slate-500">إجمالي الكميات</span>
                <p class="mt-1 text-2xl font-black text-slate-900">@Format(_state.Warehouses.Sum(item => item.StockOnHand))</p>
            </div>
            <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-4 shadow-sm">
                <span class="text-xs font-semibold text-emerald-700">المتاح</span>
                <p class="mt-1 text-2xl font-black text-emerald-800">@Format(_state.Warehouses.Sum(item => item.Available))</p>
            </div>
            <div class="rounded-2xl border border-sky-100 bg-sky-50 p-4 shadow-sm">
                <span class="text-xs font-semibold text-sky-700">المحجوز</span>
                <p class="mt-1 text-2xl font-black text-sky-800">@Format(_state.Warehouses.Sum(item => item.ReservedOnHand))</p>
            </div>
            <div class="rounded-2xl border border-amber-100 bg-amber-50 p-4 shadow-sm">
                <span class="text-xs font-semibold text-amber-700">التالف</span>
                <p class="mt-1 text-2xl font-black text-amber-800">@Format(_state.Warehouses.Sum(item => item.DamagedQty))</p>
            </div>
        </section>

        <section class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var warehouse in _state.Warehouses)
            {
                <a href="@($"/inventory/warehouses/{warehouse.Id}")"
                   class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-2.5">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                                <MudIcon Icon="@Icons.Material.Filled.Warehouse" />
                            </span>
                            <div class="min-w-0">
                                <span class="block truncate text-sm font-bold text-slate-900 group-hover:text-brand-700">@warehouse.Name</span>
                                <span class="mt-0.5 block truncate text-xs text-slate-500">@warehouse.KeeperDisplayName</span>
                            </div>
                        </div>

                        @if (warehouse.IsActive)
                        {
                            <span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700">نشط</span>
                        }
                        else
                        {
                            <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600">متوقف</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(warehouse.Location) || !string.IsNullOrWhiteSpace(warehouse.PhoneNumber))
                    {
                        <p class="mt-2 truncate text-xs text-slate-500">
                            @warehouse.Location
                            @if (!string.IsNullOrWhiteSpace(warehouse.PhoneNumber))
                            {
                                <span dir="ltr"> · @warehouse.PhoneNumber</span>
                            }
                        </p>
                    }

                    <div class="mt-3 grid grid-cols-4 gap-2 rounded-xl bg-slate-50 p-2 text-center">
                        <div>
                            <span class="block text-[11px] font-semibold text-slate-500">الكلي</span>
                            <span class="block text-sm font-black text-slate-900">@Format(warehouse.StockOnHand)</span>
                        </div>
                        <div>
                            <span class="block text-[11px] font-semibold text-slate-500">متاح</span>
                            <span class="block text-sm font-black text-emerald-700">@Format(warehouse.Available)</span>
                        </div>
                        <div>
                            <span class="block text-[11px] font-semibold text-slate-500">محجوز</span>
                            <span class="block text-sm font-black text-sky-700">@Format(warehouse.ReservedOnHand)</span>
                        </div>
                        <div>
                            <span class="block text-[11px] font-semibold text-slate-500">تالف</span>
                            <span class="block text-sm font-black text-amber-700">@Format(warehouse.DamagedQty)</span>
                        </div>
                    </div>

                    <p class="mt-2 text-[11px] font-medium text-slate-500">
                        @Format(warehouse.ProductCount) سجل رصيد · @Format(warehouse.WithStockCount) برصيد فعلي
                    </p>
                </a>
            }
        </section>
    }
</div>

@code {
    private static readonly PageScaffold.CrumbItem[] _crumbs = [new("المخزون")];

    private AccessibleWarehousesResult? _state;
    private string? _error;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Executor.ExecuteAsync(new GetAccessibleWarehousesQuery());
            if (!result.IsSuccess)
            {
                _state = null;
                _error = result.ErrorMessage;
                return;
            }

            _state = result.Value;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load accessible warehouses");
            _error = "تعذر تحميل أرصدة المخزون. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Format(int value) =>
        value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
