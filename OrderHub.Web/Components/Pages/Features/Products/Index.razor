@page "/products"
@implements IDisposable
@attribute [PermissionAuthorize(PermissionFeature.Products, PermissionLevel.Read)]

@using System.Globalization

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>المنتجات</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="المنتجات"
                  Description="إدارة المنتجات والأقسام والموردين والخصائص"
                  Crumbs="_scaffoldCrumbs"
                  Count="@_totalItems">
        <Actions>
            @if (_canWrite)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="rounded-xl px-5 font-bold shadow-sm"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="IsBusy"
                           OnClick="Create">
                    إضافة منتج
                </MudButton>
            }
        </Actions>
    </PageScaffold>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        @* ============================================================
           Toolbar: search + refresh
           ============================================================ *@
        <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 px-4 py-3">
            <MudTextField T="string"
                          Value="_search"
                          ValueChanged="SearchChangedAsync"
                          Placeholder="ابحث بالاسم أو الكود أو القسم أو المورد"
                          aria-label="البحث عن منتج"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Disabled="_deleting"
                          Class="w-full sm:max-w-xs" />

            <div class="flex-1"></div>

            <MudTooltip Text="تحديث القائمة">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshAsync"
                               aria-label="تحديث القائمة"
                               Disabled="IsBusy"
                               Class="rounded-lg text-slate-500" />
            </MudTooltip>
        </div>

        @if (_error is not null)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-red-100 bg-red-50 px-4 py-3">
                <p class="text-sm font-bold text-red-800">@_error</p>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="rounded-lg font-bold"
                           OnClick="RefreshAsync"
                           Disabled="IsBusy">
                    إعادة المحاولة
                </MudButton>
            </div>
        }

        @* ============================================================
           Products table
           ============================================================ *@
        <MudTable T="ProductIndexItem"
                  @ref="_table"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@_pageSize"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Square="true"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="text-xs font-bold text-slate-500">المنتج</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الكود</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">القسم</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">السعر</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الموردون</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الخصائص</MudTh>
                @if (_canWrite)
                {
                    <MudTh Class="w-24 text-xs font-bold text-slate-500">
                        <span class="sr-only">الإجراءات</span>
                    </MudTh>
                }
            </HeaderContent>

            <RowTemplate Context="product">
                <MudTd DataLabel="المنتج" Style="overflow-wrap:anywhere">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-black text-brand-600">
                            @FirstLetter(product.Name)
                        </span>
                        <span class="text-sm font-bold text-slate-900">@product.Name</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="الكود">
                    <span class="font-mono text-xs font-semibold text-slate-700" dir="ltr">@product.Code</span>
                </MudTd>

                <MudTd DataLabel="القسم"
                       Class="text-sm text-slate-700"
                       Style="overflow-wrap:anywhere">@product.CategoryName</MudTd>

                <MudTd DataLabel="السعر">
                    <span class="inline-flex items-baseline gap-1">
                        <span class="tabular-nums text-sm font-bold text-slate-900" dir="ltr">@product.Price.ToString("N2", CultureInfo.InvariantCulture)</span>
                        <span class="text-xs text-slate-500">ر.س</span>
                    </span>
                </MudTd>

                <MudTd DataLabel="الموردون">
                    <span class="inline-flex min-w-8 items-center justify-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700">
                        @product.SuppliersCount.ToString(CultureInfo.InvariantCulture)
                    </span>
                </MudTd>

                <MudTd DataLabel="الخصائص">
                    <span class="inline-flex min-w-8 items-center justify-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-700">
                        @product.PropertiesCount.ToString(CultureInfo.InvariantCulture)
                    </span>
                </MudTd>

                @if (_canWrite)
                {
                    <MudTd DataLabel="الإجراءات">
                        <div class="flex items-center justify-end gap-1.5">
                            <MudTooltip Text="تعديل المنتج">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Class="rounded-lg text-brand-600 shadow-none hover:bg-brand-50"
                                               aria-label="تعديل المنتج"
                                               OnClick="@(() => Edit(product.Id))"
                                               Disabled="IsBusy" />
                            </MudTooltip>

                            <MudTooltip Text="حذف المنتج">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Class="rounded-lg shadow-none"
                                               aria-label="حذف المنتج"
                                               OnClick="@(() => DeleteAsync(product))"
                                               Disabled="IsBusy" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                }
            </RowTemplate>

            <NoRecordsContent>
                <div class="py-8 text-center">
                    <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" aria-hidden="true" />
                    </span>
                    <p class="text-base font-bold text-slate-900">@EmptyTitle</p>
                    <p class="mt-1 text-sm text-slate-500">@EmptyHint</p>
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="flex flex-col items-center gap-2 py-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <p class="text-sm text-slate-500">جاري تحميل المنتجات...</p>
                </div>
            </LoadingContent>

            <PagerContent>
                <TableFooter TotalItems="@(_totalItems ?? 0)"
                             CurrentPage="_pageIndex"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="_pageSize"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>
        </MudTable>
    </section>
</div>

@code {
    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs = [new("المنتجات")];

    private MudTable<ProductIndexItem>? _table;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _searchDelay;
    private CancellationTokenSource? _loadCancellation;
    private TableData<ProductIndexItem> _latestData = new() { Items = [], TotalItems = 0 };
    private string? _search;
    private string? _activeSearch;
    private string? _error;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private int? _totalItems;
    private long _requestVersion;
    private bool _loading = true;
    private bool _canWrite;
    private bool _deleting;
    private bool _disposed;

    private bool IsBusy => _loading || _deleting;

    private string EmptyTitle
    {
        get
        {
            if (_loading)
            {
                return "جاري تحميل المنتجات...";
            }
            if (_error is not null)
            {
                return "تعذر تحميل المنتجات.";
            }
            return HasSearch ? "لا توجد نتائج مطابقة" : "لم تتم إضافة منتجات بعد.";
        }
    }

    private string EmptyHint => _loading
        ? "يتم جلب بيانات المنتجات من الخادم."
        : _error is not null
            ? "حدّث القائمة أو حاول مرة أخرى."
            : HasSearch
                ? "جرّب تعديل عبارة البحث للحصول على نتائج."
                : "أضف منتجًا جديدًا ليظهر في القائمة.";

    private bool HasSearch => !string.IsNullOrWhiteSpace(_activeSearch);

    private static string FirstLetter(string name)
    {
        string trimmed = name.Trim();

        return trimmed.Length == 0 ? "—" : trimmed[..1];
    }

    private async Task RefreshAsync()
    {
        if (IsBusy || _table is null)
        {
            return;
        }

        await _table.ReloadServerData();
    }

    private async Task<TableData<ProductIndexItem>> LoadServerDataAsync(TableState state, CancellationToken tableCancellation)
    {
        if (_disposed)
        {
            return _latestData;
        }

        long version = ++_requestVersion;
        _loadCancellation?.Cancel();
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(tableCancellation, _lifetime.Token);
        _loadCancellation = cancellation;
        _loading = true;
        _error = null;
        try
        {
            bool canWrite = await PermissionAccess.IsAllowedAsync(PermissionFeature.Products, PermissionLevel.Write);
            cancellation.Token.ThrowIfCancellationRequested();

            var result = await RequestExecutor.ExecuteAsync(
                new GetProductIndexQuery(_activeSearch, _pageIndex, _pageSize), cancellation.Token);
            cancellation.Token.ThrowIfCancellationRequested();

            // A deletion can shrink the last page; re-query the clamped page once.
            int lastPage = Math.Max(1, result.TotalPages);
            if (_pageIndex > lastPage)
            {
                _pageIndex = lastPage;
                result = await RequestExecutor.ExecuteAsync(
                    new GetProductIndexQuery(_activeSearch, _pageIndex, _pageSize), cancellation.Token);
                cancellation.Token.ThrowIfCancellationRequested();
            }

            if (version != _requestVersion || _disposed)
            {
                return _latestData;
            }

            _canWrite = canWrite;
            _totalItems = result.TotalCount;
            _latestData = new TableData<ProductIndexItem>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
            return _latestData;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            return _latestData;
        }
        catch (AuthorizationDeniedException)
        {
            if (version == _requestVersion && !_disposed)
            {
                Navigation.NavigateTo("/access-denied");
            }
            return _latestData;
        }
        catch (Exception exception)
        {
            if (version == _requestVersion && !_disposed)
            {
                Logger.LogError(exception, "Failed to load products");
                _error = "تعذر تحميل المنتجات. يرجى المحاولة مرة أخرى.";
                _totalItems = 0;
                _latestData = new TableData<ProductIndexItem> { Items = [], TotalItems = 0 };
            }
            return _latestData;
        }
        finally
        {
            if (version == _requestVersion && !_disposed)
            {
                _loading = false;
                await InvokeAsync(StateHasChanged);
            }
            if (ReferenceEquals(_loadCancellation, cancellation))
            {
                _loadCancellation = null;
            }
        }
    }

    private async Task SearchChangedAsync(string? text)
    {
        if (_disposed)
        {
            return;
        }
        _search = text;
        ++_requestVersion;
        _loadCancellation?.Cancel();
        _searchDelay?.Cancel();
        using var delay = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _searchDelay = delay;
        try
        {
            await Task.Delay(400, delay.Token);
            delay.Token.ThrowIfCancellationRequested();
            _activeSearch = text;
            _pageIndex = 1;
            if (_table is not null && !_disposed)
            {
                await _table.ReloadServerData();
            }
        }
        catch (OperationCanceledException) when (delay.IsCancellationRequested)
        {
            // Superseded input or disposal: do not execute delayed work.
        }
        finally
        {
            if (ReferenceEquals(_searchDelay, delay))
            {
                _searchDelay = null;
            }
        }
    }

    private async Task OnFooterPageChanged(int page)
    {
        _pageIndex = Math.Max(1, page);
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _pageSize = rowsPerPage;
        _pageIndex = 1;
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }
        _disposed = true;
        ++_requestVersion;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private void Create()
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }
        Navigation.NavigateTo("/products/create");
    }

    private void Edit(int id)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }
        Navigation.NavigateTo($"/products/{id}/edit");
    }

    private async Task DeleteAsync(ProductIndexItem product)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }
        _deleting = true;
        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync("حذف المنتج",
                $"هل تريد حذف المنتج \"{product.Name}\"؟", yesText: "حذف", cancelText: "إلغاء");
            if (confirmed != true)
            {
                return;
            }
            var result = await RequestExecutor.ExecuteAsync(new DeleteProductCommand(product.Id));
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }
            Snackbar.Add("تم حذف المنتج بنجاح.", Severity.Success);
            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete product {Id}", product.Id);
            Snackbar.Add("تعذر حذف المنتج. يرجى المحاولة مرة أخرى.", Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
