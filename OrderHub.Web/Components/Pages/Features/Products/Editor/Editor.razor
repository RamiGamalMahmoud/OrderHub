@page "/products/create"
@page "/products/{Id:int}/edit"
@attribute [PermissionAuthorize(PermissionFeature.Products, PermissionLevel.Write)]

@using System.Globalization
@using OrderHub.Web.Components.Pages.Features.Categories.Editor

@inject IRequestExecutor RequestExecutor
@inject PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<Editor> Logger

<PageTitle>@Title</PageTitle>

<div class="space-y-4">
    <section class="flex flex-col gap-3 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs md:flex-row md:items-center md:justify-between"
             data-purpose="page-intro-header">
        <div>
            <nav aria-label="مسار التنقل" class="mb-1 flex items-center gap-2 text-xs font-medium text-slate-600">
                <a href="/" class="flex items-center gap-1 transition-colors hover:text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.Home" Class="text-[12px]" />
                    الرئيسية
                </a>
                <span class="text-slate-400">/</span>
                <a href="/products" class="transition-colors hover:text-brand-600">المنتجات</a>
                <span class="text-slate-400">/</span>
                <span class="font-bold text-slate-900">@Title</span>
            </nav>
            <div class="flex items-center gap-2.5">
                <h1 class="text-xl font-extrabold tracking-tight text-slate-900">@Title</h1>
                <span class="rounded-md px-2 py-0.5 text-[11px] font-bold @(Id.HasValue ? "border border-slate-200 bg-slate-100 text-slate-700" : "border border-brand-200 bg-brand-100 text-brand-700")">
                    @(Id.HasValue ? "تعديل" : "جديد")
                </span>
                <p class="mr-0.5 hidden border-r border-slate-300 pr-2.5 text-xs font-medium text-slate-600 sm:inline-block">
                    تحديد بيانات الصنف، الأقسام، الموردين المعتمدين والمواصفات التفصيلية
                </p>
            </div>
        </div>
        <div class="flex items-center gap-2 self-end md:self-center">
            <button type="button"
                    class="oh-btn oh-btn--secondary oh-btn--sm"
                    disabled="@_saving"
                    @onclick="Cancel">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="text-[12px]" />
                العودة للمنتجات
            </button>
            <button type="button"
                    class="oh-btn oh-btn--secondary oh-btn--sm"
                    disabled="@SaveDisabled"
                    aria-busy="@_saving"
                    @onclick="() => SaveAsync(addAnother: false)">
                @if (_saving)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Save" Class="text-[12px]" />
                }
                @SaveText
            </button>
        </div>
    </section>

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-xs">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="تحميل بيانات المنتج" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل بيانات المنتج...</p>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
            <p class="text-sm font-bold text-red-800">@_loadError</p>
            <button type="button"
                    class="oh-btn oh-btn--secondary mt-3"
                    @onclick="LoadAsync">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="text-[16px]" />
                <span>إعادة المحاولة</span>
            </button>
        </div>
    }
    else
    {
        <MudForm @ref="_form" @key="_formVersion">
            <div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-12">
                @* ================= RIGHT COLUMN (7 Cols) ================= *@
                <div class="space-y-4 lg:col-span-7">
                    @* ---------- Card 1: Basic information ---------- *@
                    <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5" data-purpose="product-info-card">
                        <header class="mb-3.5 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-blue-100 bg-blue-50 text-sm text-brand-600">
                                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Class="text-[18px]" />
                                </div>
                                <div>
                                    <h2 class="text-sm font-bold text-slate-800">بيانات المنتج الأساسية</h2>
                                    <p class="text-[11px] text-slate-600">الاسم، الكود، وتسعير الوحدة قبل الضريبة</p>
                                </div>
                            </div>
                            <span class="inline-flex items-center rounded border border-amber-200 bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-700">
                                مطلوب
                            </span>
                        </header>

                        <div class="grid grid-cols-1 gap-3.5 sm:grid-cols-12">
                            <div class="sm:col-span-12">
                                <MudTextField T="string"
                                              @bind-Value="_state.Name"
                                              Label="اسم المنتج"
                                              Required="true"
                                              RequiredError="اسم المنتج مطلوب."
                                              MaxLength="100"
                                              Validation="@(new Func<string, string?>(ProductEditorState.ValidateName))"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Disabled="_saving" />
                            </div>

                            <div class="-mb-2 flex items-center justify-end sm:col-span-12">
                                <button type="button"
                                        disabled
                                        title="توليد الكود تلقائيًا سيتوفر لاحقًا"
                                        class="flex cursor-not-allowed items-center gap-0.5 text-[10px] font-bold text-slate-400">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Class="text-[10px]" />
                                    توليد تلقائي
                                </button>
                            </div>

                            <div class="sm:col-span-6">
                                <MudTextField T="string"
                                              @bind-Value="_state.Code"
                                              Label="كود المنتج (SKU)"
                                              Required="true"
                                              RequiredError="كود المنتج مطلوب."
                                              MaxLength="10"
                                              Validation="@(new Func<string, string?>(ProductEditorState.ValidateCode))"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Class="font-mono uppercase"
                                              Disabled="_saving" />
                                <p class="mt-1 flex items-center gap-1 text-[10px] text-slate-600">
                                    <MudIcon Icon="@Icons.Material.Outlined.Info" Class="text-[10px]" />
                                    رمز قصير فريد يسهل البحث في المخزون
                                </p>
                            </div>

                            <div class="sm:col-span-6">
                                <MudNumericField T="decimal"
                                                 @bind-Value="_state.Price"
                                                 Label="سعر الوحدة قبل الضريبة"
                                                 Min="0"
                                                 Adornment="Adornment.End"
                                                 AdornmentText="ر.س"
                                                 Validation="@(new Func<decimal, string?>(ProductEditorState.ValidatePrice))"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Disabled="_saving" />
                            </div>
                        </div>
                    </article>

                    @* ---------- Card 2: Category ---------- *@
                    <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5" data-purpose="category-card">
                        <header class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-indigo-100 bg-indigo-50 text-sm text-indigo-600">
                                    <MudIcon Icon="@Icons.Material.Outlined.Category" Class="text-[18px]" />
                                </div>
                                <div>
                                    <h2 class="text-sm font-bold text-slate-800">قسم وتصنيف المنتج</h2>
                                    <p class="text-[11px] text-slate-600">اختر القسم الذي يندرج تحته الصنف</p>
                                </div>
                            </div>
                            @if (_canManageCategories)
                            {
                                <button type="button"
                                        class="flex items-center gap-1 text-xs font-bold text-brand-600 transition-colors hover:text-brand-700 hover:underline disabled:cursor-not-allowed disabled:opacity-60"
                                        disabled="@BrowserDisabled"
                                        @onclick="OpenCreateCategoryAsync">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-[10px]" />
                                    قسم جديد
                                </button>
                            }
                        </header>

                        <div class="mb-3.5 flex items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 p-2.5">
                            <div class="flex min-w-0 items-center gap-2 text-xs">
                                <span class="shrink-0 font-medium text-slate-600">القسم المختار:</span>
                                <span class="inline-flex min-w-0 items-center gap-1 rounded-full border border-brand-200 bg-white px-2.5 py-0.5 text-[11px] font-bold text-brand-700 shadow-2xs">
                                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Class="shrink-0 text-[13px] text-brand-500" />
                                    <span class="truncate">@SelectedCategoryText</span>
                                </span>
                            </div>
                            @if (_state.CategoryId.HasValue)
                            {
                                <button type="button"
                                        class="shrink-0 text-[11px] font-semibold text-rose-500 transition-colors hover:text-rose-700 disabled:cursor-not-allowed disabled:opacity-60"
                                        disabled="@BrowserDisabled"
                                        @onclick="ClearCategory">
                                    إلغاء التحديد
                                </button>
                            }
                        </div>

                        <div class="space-y-2">
                            <div class="flex flex-wrap items-center gap-1 text-[11px] font-semibold text-slate-500">
                                <button type="button"
                                        class="rounded-md px-2 py-1 transition-colors hover:bg-slate-100 hover:text-slate-800 disabled:cursor-not-allowed disabled:opacity-50 @(_browserId is null ? "text-slate-800" : "")"
                                        disabled="@BrowserDisabled"
                                        @onclick="@(() => BrowseAsync(null))">كل الأقسام</button>
                                @foreach (var segment in _browse.Path)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Class="text-[12px] text-slate-300" />
                                    <button type="button"
                                            class="rounded-md px-2 py-1 transition-colors hover:bg-slate-100 hover:text-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
                                            disabled="@BrowserDisabled"
                                            @onclick="@(() => BrowseAsync(segment.Id))">@segment.Name</button>
                                }
                            </div>

                            @if (_browseError is not null)
                            {
                                <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-red-100 bg-red-50 px-3 py-2">
                                    <p class="text-xs font-bold text-red-800">@_browseError</p>
                                    <button type="button"
                                            class="oh-btn oh-btn--danger oh-btn--sm"
                                            disabled="@BrowserDisabled"
                                            @onclick="RetryBrowseAsync">إعادة المحاولة</button>
                                </div>
                            }

                            @if (_browsing)
                            {
                                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="تحميل الأقسام" />
                            }

                            <div class="flex items-center justify-between text-xs font-bold text-slate-600">
                                <span>تصفح الأقسام المتاحة:</span>
                                <span class="text-[11px] font-normal text-slate-600">اختر القسم بنقرة واحدة</span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                                @foreach (var category in _browse.Categories)
                                {
                                    bool isSelected = _state.CategoryId == category.Id;

                                    <div class="flex items-center gap-1 rounded-lg border transition-all @(isSelected ? "border-brand-500 bg-brand-50 ring-1 ring-brand-500" : "border-slate-200 hover:border-brand-500 hover:bg-brand-50/50")">
                                        <button type="button"
                                                class="flex min-w-0 flex-1 justify-start items-center gap-2 p-2 text-right disabled:cursor-not-allowed disabled:opacity-60"
                                                disabled="@BrowserDisabled"
                                                @onclick="@(() => SelectCategory(category))">
                                            <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: @category.Color;"></span>
                                            <span class="truncate text-xs font-bold @(isSelected ? "text-brand-700" : "text-slate-800")">@category.Name</span>
                                        </button>
                                        @if (category.HasChildren)
                                        {
                                            <button type="button"
                                                    class="p-1.5 text-slate-400 transition-transform hover:text-brand-600 hover:-translate-x-0.5 disabled:cursor-not-allowed disabled:opacity-60"
                                                    disabled="@BrowserDisabled"
                                                    aria-label="عرض الأقسام الفرعية"
                                                    @onclick="@(() => BrowseAsync(category.Id))">
                                                <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Class="text-[12px]" />
                                            </button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (_browse.Categories.Count == 0 && !_browsing)
                            {
                                <p class="rounded-lg border border-dashed border-slate-200 bg-slate-50 px-4 py-6 text-center text-xs text-slate-500">
                                    لا توجد أقسام فرعية هنا.
                                </p>
                            }
                        </div>
                    </article>
                </div>

                @* ================= LEFT COLUMN (5 Cols) ================= *@
                <div class="space-y-4 lg:col-span-5">
                    @* ---------- Card 3: Suppliers ---------- *@
                    <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5" data-purpose="suppliers-card">
                        <header class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-teal-100 bg-teal-50 text-sm text-teal-600">
                                    <MudIcon Icon="@Icons.Material.Outlined.LocalShipping" Class="text-[18px]" />
                                </div>
                                <div>
                                    <h2 class="text-sm font-bold text-slate-800">الموردون المعتمدون</h2>
                                    <p class="text-[11px] text-slate-600">ربط الموردين المتاحين لتوريد هذا الصنف</p>
                                </div>
                            </div>
                            <span class="rounded-full border border-teal-200 bg-teal-50 px-2.5 py-0.5 text-[11px] font-bold text-teal-700">
                                @_state.SupplierIds.Count.ToString(CultureInfo.InvariantCulture) مورد محدد
                            </span>
                        </header>

                        <div class="mb-3">
                            <MudTextField T="string"
                                          @bind-Value="_supplierSearch"
                                          Placeholder="ابحث عن مورد..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Clearable="true"
                                          Margin="Margin.Dense"
                                          Disabled="_saving" />
                        </div>

                        <div class="grid max-h-44 grid-cols-2 gap-2 overflow-y-auto pl-1">
                            @foreach (var supplier in VisibleSuppliers)
                            {
                                bool selected = _state.SupplierIds.Contains(supplier.Id);

                                <label class="flex cursor-pointer items-center gap-2 rounded-lg border p-2 text-xs transition-colors @(selected ? "border-brand-500 bg-brand-50/60" : "border-slate-200/80 hover:bg-slate-50")">
                                    <input type="checkbox"
                                           class="h-3.5 w-3.5 shrink-0 accent-brand-600"
                                           checked="@selected"
                                           disabled="@_saving"
                                           @onchange="@(e => SetSupplier(supplier.Id, e.Value is true))" />
                                    <span class="truncate font-semibold text-slate-700">@supplier.Name</span>
                                </label>
                            }
                        </div>

                        @if (_suppliers.Count == 0)
                        {
                            <p class="mt-2 rounded-lg border border-dashed border-slate-200 bg-slate-50 px-4 py-4 text-center text-xs text-slate-500">
                                لا يوجد موردون متاحون.
                            </p>
                        }
                        else if (!VisibleSuppliers.Any())
                        {
                            <p class="mt-2 rounded-lg border border-dashed border-slate-200 bg-slate-50 px-4 py-4 text-center text-xs text-slate-500">
                                لا توجد نتائج مطابقة.
                            </p>
                        }

                        <div class="mt-3 flex items-center justify-between border-t border-slate-100 pt-2.5 text-[11px] text-slate-600">
                            <span class="flex items-center gap-1">
                                <MudIcon Icon="@Icons.Material.Outlined.Lock" Class="text-[11px] text-slate-400" />
                                تبقى التحديدات محفوظة
                            </span>
                            @if (SupplierPages > 1)
                            {
                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            class="flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
                                            disabled="@(_supplierPage <= 1 || _saving)"
                                            aria-label="الصفحة السابقة"
                                            @onclick="() => SetSupplierPage(_supplierPage - 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="text-[12px]" />
                                    </button>
                                    @foreach (var pageNumber in PageWindow(_supplierPage, SupplierPages))
                                    {
                                        <button type="button"
                                                class="flex h-6 w-6 items-center justify-center rounded text-[10px] font-bold disabled:cursor-not-allowed disabled:opacity-60 @(pageNumber == _supplierPage ? "border border-brand-200 bg-brand-50 text-brand-700" : "border border-slate-200 text-slate-600 hover:bg-slate-100")"
                                                disabled="@_saving"
                                                @onclick="() => SetSupplierPage(pageNumber)">@pageNumber.ToString(CultureInfo.InvariantCulture)</button>
                                    }
                                    <button type="button"
                                            class="flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
                                            disabled="@(_supplierPage >= SupplierPages || _saving)"
                                            aria-label="الصفحة التالية"
                                            @onclick="() => SetSupplierPage(_supplierPage + 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Class="text-[12px]" />
                                    </button>
                                </div>
                            }
                        </div>
                    </article>

                    @* ---------- Card 4: Attributes ---------- *@
                    <article class="rounded-2xl border border-slate-200/90 bg-white p-4 shadow-xs sm:p-5" data-purpose="attributes-card">
                        <header class="mb-3 flex items-center justify-between border-b border-slate-100 pb-3">
                            <div class="flex items-center gap-2.5">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border border-purple-100 bg-purple-50 text-sm text-purple-700">
                                    <MudIcon Icon="@Icons.Material.Outlined.Tune" Class="text-[18px]" />
                                </div>
                                <div>
                                    <h2 class="text-sm font-bold text-slate-800">خصائص ومواصفات المنتج</h2>
                                    <p class="text-[11px] text-slate-600">تحديد الخيارات والمحددات المطلوبة عند الطلب</p>
                                </div>
                            </div>
                            <span class="rounded-full border border-purple-200 bg-purple-50 px-2.5 py-0.5 text-[11px] font-bold text-purple-700">
                                @AssignedProperties.Count().ToString(CultureInfo.InvariantCulture) خاصية
                            </span>
                        </header>

                        <div class="mb-3">
                            <MudTextField T="string"
                                          @bind-Value="_propertySearch"
                                          Placeholder="ابحث أو أضف خاصية جديدة..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Clearable="true"
                                          Margin="Margin.Dense"
                                          Disabled="_saving" />
                        </div>

                        <div class="space-y-1.5">
                            <span class="block text-[11px] font-semibold text-slate-600">خصائص شائعة مقترحة:</span>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var property in AvailableProperties)
                                {
                                    <button type="button"
                                            class="inline-flex items-center gap-1 rounded-md border border-slate-200 bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-700 transition-colors hover:bg-brand-50 hover:text-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
                                            disabled="@_saving"
                                            @onclick="@(() => AddProperty(property))">
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-[9px]" />
                                        @property.Definition.Name (@TypeName(property.Definition.Type))
                                    </button>
                                }
                            </div>
                        </div>

                        @if (AssignedProperties.Any())
                        {
                            <div class="mt-3 space-y-2">
                                @foreach (var assignment in AssignedProperties)
                                {
                                    <div class="flex items-start justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50/60 p-2.5">
                                        <div class="min-w-0">
                                            <span class="flex items-center gap-1.5 text-xs font-bold text-slate-800">
                                                <span class="truncate">@assignment.Definition.Name</span>
                                                <span class="font-medium text-slate-500">(@TypeName(assignment.Definition.Type))</span>
                                            </span>
                                            @if (assignment.Definition.Type == PropertyType.List)
                                            {
                                                <div class="mt-1 flex flex-wrap gap-1">
                                                    @foreach (var option in assignment.Definition.Options)
                                                    {
                                                        <span class="rounded border border-slate-200 bg-white px-1.5 py-0.5 text-[10px] text-slate-600">@option.Value</span>
                                                    }
                                                </div>
                                            }
                                            else if (assignment.Definition.Type == PropertyType.Boolean)
                                            {
                                                <p class="mt-1 text-[10px] text-slate-500">اختيار نعم أو لا عند الطلب.</p>
                                            }
                                            else
                                            {
                                                <p class="mt-1 text-[10px] text-slate-500">إدخال قيمة نصية عند الطلب.</p>
                                            }
                                        </div>
                                        <div class="flex shrink-0 items-center gap-1.5">
                                            <label class="flex cursor-pointer items-center gap-1 text-[11px] font-semibold text-slate-600">
                                                <input type="checkbox"
                                                       class="h-3.5 w-3.5 accent-brand-600"
                                                       checked="@assignment.Required"
                                                       disabled="@_saving"
                                                       @onchange="@(e => assignment.Required = e.Value is true)" />
                                                مطلوبة
                                            </label>
                                            <button type="button"
                                                    class="rounded p-1 text-rose-500 transition-colors hover:bg-rose-50 hover:text-rose-700 disabled:cursor-not-allowed disabled:opacity-60"
                                                    disabled="@_saving"
                                                    aria-label="إزالة الخاصية"
                                                    @onclick="@(() => RemoveProperty(assignment))">
                                                <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Class="text-[16px]" />
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mt-3 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-2.5 text-center">
                                <p class="text-xs font-medium text-slate-600">لم يتم إضافة أي خصائص لهذا المنتج حتى الآن.</p>
                            </div>
                        }

                        @if (PropertyPages > 1)
                        {
                            <div class="mt-3 flex justify-end">
                                <div class="flex items-center gap-1">
                                    <button type="button"
                                            class="flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
                                            disabled="@(_propertyPage <= 1 || _saving)"
                                            aria-label="الصفحة السابقة"
                                            @onclick="() => SetPropertyPage(_propertyPage - 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="text-[12px]" />
                                    </button>
                                    @foreach (var pageNumber in PageWindow(_propertyPage, PropertyPages))
                                    {
                                        <button type="button"
                                                class="flex h-6 w-6 items-center justify-center rounded text-[10px] font-bold disabled:cursor-not-allowed disabled:opacity-60 @(pageNumber == _propertyPage ? "border border-brand-200 bg-brand-50 text-brand-700" : "border border-slate-200 text-slate-600 hover:bg-slate-100")"
                                                disabled="@_saving"
                                                @onclick="() => SetPropertyPage(pageNumber)">@pageNumber.ToString(CultureInfo.InvariantCulture)</button>
                                    }
                                    <button type="button"
                                            class="flex h-6 w-6 items-center justify-center rounded border border-slate-200 text-slate-600 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-40"
                                            disabled="@(_propertyPage >= PropertyPages || _saving)"
                                            aria-label="الصفحة التالية"
                                            @onclick="() => SetPropertyPage(_propertyPage + 1)">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Class="text-[12px]" />
                                    </button>
                                </div>
                            </div>
                        }
                    </article>
                </div>
            </div>

            @* ---------- Form actions bar ---------- *@
            <section class="mt-4 flex flex-col items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-3.5 shadow-sm sm:flex-row" data-purpose="form-actions-bar">
                <div class="w-full text-xs text-slate-600 sm:w-auto">
                    @if (_saveError is not null)
                    {
                        <p class="flex items-center gap-1.5 font-bold text-red-700" role="alert">
                            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="text-[14px]" />
                            @_saveError
                        </p>
                    }
                </div>
                <div class="flex w-full items-center justify-end gap-2.5 sm:w-auto">
                    <button type="button"
                            class="w-full oh-btn oh-btn--secondary sm:w-auto"
                            disabled="@_saving"
                            @onclick="Cancel">
                        إلغاء والتراجع
                    </button>
                    @if (!Id.HasValue)
                    {
                        <button type="button"
                                class="oh-btn oh-btn--secondary w-full sm:w-auto"
                                disabled="@SaveDisabled"
                                @onclick="() => SaveAsync(addAnother: true)">
                            <MudIcon Icon="@Icons.Material.Filled.Layers" Class="text-[12px]" />
                            حفظ وإضافة آخر
                        </button>
                    }
                    <button type="button"
                            class="oh-btn oh-btn--primary w-full sm:w-auto"
                            disabled="@SaveDisabled"
                            aria-busy="@_saving"
                            @onclick="() => SaveAsync(addAnother: false)">
                        @if (_saving)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Inherit" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Save" Class="text-[12px]" />
                        }
                        @SaveText
                    </button>
                </div>
            </section>
        </MudForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProductEditorState _state = new();
    private IReadOnlyList<ProductEditorSupplier> _suppliers = [];
    private GetCategoriesResponse _browse = new(true, [], []);
    private MudForm? _form;
    private string? _loadError;
    private string? _saveError;
    private string? _browseError;
    private string? _supplierTerm;
    private string? _propertyTerm;
    private int? _browserId;
    private int? _requestedBrowserId;
    private int _supplierPage = 1;
    private int _propertyPage = 1;
    private int _formVersion;
    private bool _loading = true;
    private bool _saving;
    private bool _browsing;
    private bool _canManageCategories;
    private bool _categoryDialogOpen;

    private string Title => Id.HasValue ? "تعديل المنتج" : "إضافة منتج جديد";
    private string SaveText => _saving ? "جاري الحفظ..." : "حفظ المنتج";
    private string SelectedCategoryText => string.IsNullOrWhiteSpace(_state.CategoryPath) ? "لم يتم اختيار قسم بعد" : _state.CategoryPath;
    private bool BrowserDisabled => _loading || _saving || _browsing;
    private bool SaveDisabled => BrowserDisabled || _loadError is not null;

    private string? _supplierSearch
    {
        get => _supplierTerm;
        set
        {
            _supplierTerm = value;
            _supplierPage = 1;
        }
    }

    private string? _propertySearch
    {
        get => _propertyTerm;
        set
        {
            _propertyTerm = value;
            _propertyPage = 1;
        }
    }

    private IEnumerable<ProductEditorSupplier> MatchingSuppliers => _suppliers.Where(item => Matches(item.Name, _supplierTerm));
    private IEnumerable<ProductEditorSupplier> VisibleSuppliers => MatchingSuppliers.Skip((_supplierPage - 1) * 10).Take(10);
    private int SupplierPages => Math.Max(1, (MatchingSuppliers.Count() + 9) / 10);
    private IEnumerable<ProductPropertyEditorState> AssignedProperties => _state.Properties.Where(item => item.Assigned);
    private IEnumerable<ProductPropertyEditorState> MatchingProperties => _state.Properties.Where(item => !item.Assigned && Matches(item.Definition.Name, _propertyTerm));
    private IEnumerable<ProductPropertyEditorState> AvailableProperties => MatchingProperties.Skip((_propertyPage - 1) * 9).Take(9);
    private int PropertyPages => Math.Max(1, (MatchingProperties.Count() + 8) / 9);

    private static bool Matches(string name, string? term) => string.IsNullOrWhiteSpace(term) || name.Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string TypeName(PropertyType type) => type switch
    {
        PropertyType.Boolean => "نعم / لا",
        PropertyType.List => "قائمة",
        _ => "نص"
    };

    private static IEnumerable<int> PageWindow(int currentPage, int totalPages)
    {
        const int windowSize = 5;
        int start = Math.Max(1, Math.Min(currentPage - 2, totalPages - windowSize + 1));
        int end = Math.Min(totalPages, start + windowSize - 1);
        return Enumerable.Range(start, Math.Max(0, end - start + 1));
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _browseError = null;
        _supplierSearch = null;
        _propertySearch = null;
        try
        {
            var data = await RequestExecutor.ExecuteAsync(new GetProductEditorQuery(Id));
            if (data is null)
            {
                _loadError = "المنتج غير موجود أو لم يعد متاحًا.";
                return;
            }

            _canManageCategories = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Categories,
                PermissionLevel.Write);

            _state = ProductEditorState.FromRead(data);
            _suppliers = data.Suppliers;
            _browserId = _state.CategoryId;
            _requestedBrowserId = _browserId;
            _browse = await RequestExecutor.ExecuteAsync(new GetProductEditorCategoriesQuery(_browserId));
            if (!_browse.ParentExists)
            {
                _browserId = null;
                _browse = await RequestExecutor.ExecuteAsync(new GetProductEditorCategoriesQuery());
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load product editor {Id}", Id);
            _loadError = "تعذر تحميل بيانات المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task RetryBrowseAsync() => BrowseAsync(_requestedBrowserId);

    private async Task BrowseAsync(int? id)
    {
        if (BrowserDisabled)
        {
            return;
        }

        _browsing = true;
        _browseError = null;
        _requestedBrowserId = id;

        try
        {
            var response = await RequestExecutor.ExecuteAsync(new GetProductEditorCategoriesQuery(id));
            if (!response.ParentExists)
            {
                _browseError = "القسم لم يعد موجودًا. يمكنك العودة إلى كل الأقسام.";
                return;
            }

            _browserId = id;
            _browse = response;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to browse product category {Id}", id);
            _browseError = "تعذر تحميل الأقسام. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _browsing = false;
        }
    }

    private void SelectCategory(CategoryIndexItem category)
    {
        if (BrowserDisabled)
        {
            return;
        }

        _state.CategoryId = category.Id;
        _state.CategoryPath = string.Join(" / ", _browse.Path.Select(segment => segment.Name).Append(category.Name));
    }

    private void ClearCategory()
    {
        if (BrowserDisabled)
        {
            return;
        }

        _state.CategoryId = null;
        _state.CategoryPath = "";
    }

    private async Task OpenCreateCategoryAsync()
    {
        if (!_canManageCategories || _categoryDialogOpen || BrowserDisabled)
        {
            return;
        }

        _categoryDialogOpen = true;

        try
        {
            DialogParameters<CategoryEditorDialog> parameters = new()
            {
                { dialog => dialog.CategoryId, null },
                { dialog => dialog.ParentId, _browserId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            var dialog = await DialogService.ShowAsync<CategoryEditorDialog>("إضافة قسم", parameters, options);
            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await BrowseAsync(_browserId);
                Snackbar.Add("تم إنشاء القسم.", Severity.Success);
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to open category editor from product editor");
            Snackbar.Add("تعذر فتح محرر القسم. يرجى المحاولة مرة أخرى.", Severity.Error);
        }
        finally
        {
            _categoryDialogOpen = false;
        }
    }

    private void SetSupplier(int id, bool selected)
    {
        if (_saving)
        {
            return;
        }

        if (selected)
        {
            _state.SupplierIds.Add(id);
        }
        else
        {
            _state.SupplierIds.Remove(id);
        }
    }

    private void SetSupplierPage(int page) => _supplierPage = Math.Clamp(page, 1, SupplierPages);
    private void SetPropertyPage(int page) => _propertyPage = Math.Clamp(page, 1, PropertyPages);

    private void AddProperty(ProductPropertyEditorState property)
    {
        if (_saving)
        {
            return;
        }

        property.Assigned = true;
        _propertyPage = Math.Min(_propertyPage, PropertyPages);
    }

    private void RemoveProperty(ProductPropertyEditorState property)
    {
        if (_saving)
        {
            return;
        }

        property.Assigned = false;
        property.Required = false;
    }

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        Navigation.NavigateTo("/products");
    }

    private async Task SaveAsync(bool addAnother)
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();
            _saveError = _state.Validate();
            if (!_form.IsValid || _saveError is not null)
            {
                return;
            }

            Result<int> result;
            if (Id is int id)
            {
                result = await RequestExecutor.ExecuteAsync(_state.UpdateCommand(id));
            }
            else
            {
                result = await RequestExecutor.ExecuteAsync(_state.CreateCommand());
            }

            if (!result.IsSuccess)
            {
                _saveError = result.ErrorMessage;
                return;
            }

            if (!addAnother || Id.HasValue)
            {
                Snackbar.Add("تم حفظ المنتج بنجاح.", Severity.Success);
                Navigation.NavigateTo("/products");
                return;
            }

            ResetForAnother();
            Snackbar.Add("تم حفظ المنتج. يمكنك إضافة منتج آخر.", Severity.Success);
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to save product {Id}", Id);
            _saveError = "تعذر حفظ المنتج. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void ResetForAnother()
    {
        _state.Name = "";
        _state.Code = "";
        _state.Price = 0;
        _state.SupplierIds.Clear();

        foreach (var property in _state.Properties)
        {
            property.Assigned = false;
            property.Required = false;
        }

        _supplierTerm = null;
        _propertyTerm = null;
        _supplierPage = 1;
        _propertyPage = 1;
        _saveError = null;
        _formVersion++;
    }
}
