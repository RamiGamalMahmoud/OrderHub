@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Read)]
@page "/admin/roles"

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using OrderHub.Application.Features.Administration.Roles.Delete
@using OrderHub.Application.Features.Administration.Roles.GetRoles
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Common

@attribute [Authorize(Roles = "Admin")]

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>إدارة الأدوار</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="الأدوار والصلاحيات"
                  Description="إدارة أدوار المستخدمين والصلاحيات المرتبطة بكل دور"
                  Crumbs="_scaffoldCrumbs"
                  Count="@BadgeCount">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="oh-btn oh-btn--primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Disabled="IsBusy"
                       OnClick="CreateRole">
                دور جديد
            </MudButton>
        </Actions>
    </PageScaffold>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        @* ============================================================
           Toolbar: search + refresh
           ============================================================ *@
        <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 px-4 py-3">
            <MudTextField T="string"
                          Value="_searchTerm"
                          ValueChanged="SearchChangedAsync"
                          Placeholder="ابحث باسم الدور"
                          aria-label="البحث عن دور"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Disabled="IsBusy"
                          Class="w-full sm:max-w-xs" />

            <div class="flex-1"></div>

            <MudTooltip Text="تحديث القائمة">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshAsync"
                               aria-label="تحديث القائمة"
                               Disabled="IsBusy"
                               Class="oh-btn oh-btn--icon oh-btn--secondary oh-btn--sm" />
            </MudTooltip>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary"
                               aria-label="تحميل الأدوار" />
        }

        @if (_error is not null)
        {
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-red-100 bg-red-50 px-4 py-3">
                <p class="text-sm font-bold text-red-800">@_error</p>
                <button type="button"
                        class="oh-btn oh-btn--secondary oh-btn--sm"
                        disabled="@(_loading || _deleting)"
                        @onclick="LoadAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="text-[14px]" />
                    إعادة المحاولة
                </button>
            </div>
        }

        @* ============================================================
           Roles table
           ============================================================ *@
        <MudTable T="RoleListItem"
                  @ref="_table"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@_pageSize"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Square="true"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="text-xs font-bold text-slate-500">الدور</MudTh>
                <MudTh Class="text-xs font-bold text-slate-500">الصلاحيات</MudTh>
                <MudTh Class="w-24 text-xs font-bold text-slate-500">
                    <span class="sr-only">الإجراءات</span>
                </MudTh>
            </HeaderContent>

            <RowTemplate Context="role">
                <MudTd DataLabel="الدور" Style="overflow-wrap:anywhere">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-black text-brand-600">
                            @FirstLetter(role.Name)
                        </span>
                        <span class="text-sm font-bold text-slate-900">@role.Name</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="الصلاحيات">
                    @if (role.PermissionCount > 0)
                    {
                        <span class="inline-flex items-center rounded-full border border-brand-100 bg-brand-50 px-2.5 py-0.5 text-[11px] font-bold text-brand-700">
                            @GetPermissionsText(role.PermissionCount)
                        </span>
                    }
                    else
                    {
                        <span class="text-xs font-semibold text-slate-400">بدون صلاحيات</span>
                    }
                </MudTd>

                <MudTd DataLabel="الإجراءات">
                    <div class="flex items-center justify-end gap-1.5">
                        <MudTooltip Text="تعديل الدور">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost"
                                           aria-label="تعديل الدور"
                                           OnClick="@(() => EditRole(role.Id))"
                                           Disabled="IsBusy" />
                        </MudTooltip>

                        <MudTooltip Text="حذف الدور">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost oh-btn--danger"
                                           aria-label="حذف الدور"
                                           OnClick="@(() => ConfirmDeleteAsync(role))"
                                           Disabled="IsBusy" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="py-8 text-center">
                    <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" aria-hidden="true" />
                    </span>
                    <p class="text-base font-bold text-slate-900">@EmptyTitle</p>
                    <p class="mt-1 text-sm text-slate-500">@EmptyHint</p>
                    @if (string.IsNullOrWhiteSpace(_searchTerm) && _error is null)
                    {
                        <button type="button"
                                class="oh-btn oh-btn--secondary oh-btn--sm mt-4"
                                @onclick="CreateRole">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-[14px]" />
                            إضافة دور
                        </button>
                    }
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="flex flex-col items-center gap-2 py-8">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <p class="text-sm text-slate-500">جاري تحميل الأدوار...</p>
                </div>
            </LoadingContent>

            <PagerContent>
                <TableFooter TotalItems="@TotalCount"
                             CurrentPage="_pageIndex"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="_pageSize"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>
        </MudTable>
    </section>
</div>

@code {
    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs = [new("الأدوار")];

    private MudTable<RoleListItem>? _table;
    private IReadOnlyList<RoleListItem> _roles = [];
    private string? _searchTerm;
    private string? _error;
    private int _pageIndex = 1;
    private int _pageSize = 10;
    private bool _loading;
    private bool _deleting;

    private bool IsBusy =>
        _loading || _deleting;

    private List<RoleListItem> FilteredRoles
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _roles.ToList();
            }

            string searchTerm = _searchTerm.Trim();

            return _roles
                .Where(role => role.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private int TotalCount => FilteredRoles.Count;
    private int? BadgeCount => _loading && _roles.Count == 0 ? null : TotalCount;

    private string EmptyTitle
    {
        get
        {
            if (_error is not null)
            {
                return "تعذر تحميل الأدوار.";
            }

            return string.IsNullOrWhiteSpace(_searchTerm) ? "لا توجد أدوار" : "لا توجد نتائج";
        }
    }

    private string EmptyHint
    {
        get
        {
            if (_error is not null)
            {
                return "حدّث القائمة أو حاول مرة أخرى.";
            }

            return string.IsNullOrWhiteSpace(_searchTerm)
                ? "أضف دورًا جديدًا لتحديد صلاحيات المستخدمين."
                : "لا يوجد دور مطابق لعملية البحث.";
        }
    }

    private static string FirstLetter(string name)
    {
        string trimmed = name.Trim();

        return trimmed.Length == 0 ? "—" : trimmed[..1];
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _roles = await RequestExecutor.ExecuteAsync(new GetRolesQuery());

            if (_table is not null)
            {
                await _table.ReloadServerData();
            }
        }
        catch (Exception)
        {
            _error = "تعذر تحميل الأدوار.";
            Snackbar.Add("تعذر تحميل الأدوار.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Task<TableData<RoleListItem>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        var filtered = FilteredRoles;
        int lastPage = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)_pageSize));
        _pageIndex = Math.Clamp(_pageIndex, 1, lastPage);

        return Task.FromResult(new TableData<RoleListItem>
        {
            Items = filtered.Skip((_pageIndex - 1) * _pageSize).Take(_pageSize).ToList(),
            TotalItems = filtered.Count
        });
    }

    private async Task SearchChangedAsync(string? value)
    {
        _searchTerm = value;
        _pageIndex = 1;

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task RefreshAsync()
    {
        if (IsBusy)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task OnFooterPageChanged(int page)
    {
        _pageIndex = Math.Max(1, page);

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _pageSize = rowsPerPage;
        _pageIndex = 1;

        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private void CreateRole()
    {
        NavigationManager.NavigateTo("/admin/roles/create");
    }

    private void EditRole(int roleId)
    {
        NavigationManager.NavigateTo($"/admin/roles/{roleId}/edit");
    }

    private async Task ConfirmDeleteAsync(RoleListItem role)
    {
        if (IsBusy)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "حذف الدور",
            $"هل تريد حذف الدور \"{role.Name}\"؟",
            yesText: "حذف",
            cancelText: "إلغاء");

        if (confirmed != true)
        {
            return;
        }

        await DeleteAsync(role);
    }

    private async Task DeleteAsync(RoleListItem role)
    {
        _deleting = true;

        try
        {
            Result result = await RequestExecutor.ExecuteAsync(new DeleteRoleCommand(role.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add($"تم حذف الدور \"{role.Name}\" بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("حدث خطأ أثناء حذف الدور.", Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string GetPermissionsText(int count)
    {
        return count switch
        {
            1 => "صلاحية واحدة",
            2 => "صلاحيتان",
            >= 3 and <= 10 => $"{count} صلاحيات",
            _ => $"{count} صلاحية"
        };
    }
}
