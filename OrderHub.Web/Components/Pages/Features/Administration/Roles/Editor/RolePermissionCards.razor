@using System.Globalization
@using MudBlazor
@using OrderHub.Domain.Enums

<section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-[0_1px_3px_rgba(0,0,0,0.03)]">

    @* ============================================================
       Section header & bulk presets
       ============================================================ *@

    <div class="flex flex-col gap-4 border-b border-slate-100 pb-5 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <div class="flex items-center gap-2">
                <h2 class="text-base font-bold text-slate-900">مصفوفة الصلاحيات ومستويات الوصول</h2>
                <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">
                    @FmtCount(Permissions.Count) قسماً
                </span>
            </div>
            <p class="mt-0.5 text-xs text-slate-500">
                حدد مستوى الوصول المسموح به لكل ميزة وجزء في النظام بدقة ومرونة كاملة
            </p>
        </div>

        @if (ShowBulkActions)
        {
            <div class="flex flex-wrap items-center gap-2">
                <span class="ml-1 text-xs font-medium text-slate-500">تحديد سريع:</span>

                <button type="button"
                        class="flex items-center gap-1.5 rounded-md bg-slate-100 px-2.5 py-1.5 text-xs font-medium text-slate-700 transition-colors hover:bg-slate-200 disabled:cursor-not-allowed disabled:opacity-60"
                        title="إعادة ضبط كافة الصلاحيات إلى لا شيء"
                        disabled="@Disabled"
                        @onclick="() => SetAllLevelsAsync(PermissionLevel.None)">
                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    <span>إعادة ضبط (لا شيء)</span>
                </button>

                <button type="button"
                        class="flex items-center gap-1.5 rounded-md bg-blue-50 px-2.5 py-1.5 text-xs font-medium text-blue-700 transition-colors hover:bg-blue-100 disabled:cursor-not-allowed disabled:opacity-60"
                        title="منح صلاحية القراءة لكافة الأقسام"
                        disabled="@Disabled"
                        @onclick="() => SetAllLevelsAsync(PermissionLevel.Read)">
                    <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                    <span>الكل: قراءة فقط</span>
                </button>

                <button type="button"
                        class="flex items-center gap-1.5 rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-medium text-indigo-700 transition-colors hover:bg-indigo-100 disabled:cursor-not-allowed disabled:opacity-60"
                        title="منح صلاحية الكتابة الكاملة لكافة الأقسام"
                        disabled="@Disabled"
                        @onclick="() => SetAllLevelsAsync(PermissionLevel.Write)">
                    <span class="h-1.5 w-1.5 rounded-full bg-indigo-600"></span>
                    <span>الكل: كتابة كاملة</span>
                </button>
            </div>
        }
    </div>

    @* ============================================================
       Search & visible counter
       ============================================================ *@

    <div class="mt-4 flex flex-col items-center justify-between gap-3 sm:flex-row">
        <div class="relative w-full sm:max-w-md">
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="text-[16px]" aria-hidden="true" />
            </div>
            <input type="text"
                   placeholder="بحث سريع في الصلاحيات والأقسام..."
                   aria-label="بحث في الصلاحيات والأقسام"
                   class="block w-full rounded-lg border border-slate-200 bg-slate-50/50 py-2 pl-3.5 pr-9 text-xs text-slate-800 placeholder-slate-400 focus:border-blue-500 focus:ring-blue-500"
                   @bind="_search"
                   @bind:event="oninput" />
        </div>

        <div class="self-end text-xs font-medium text-slate-400 sm:self-center">
            عرض <span class="font-bold text-slate-700">@FmtCount(VisiblePermissions.Count)</span>
            من أصل @FmtCount(Permissions.Count) قسماً
        </div>
    </div>

    @* ============================================================
       Cards grid
       ============================================================ *@

    @if (VisiblePermissions.Count == 0)
    {
        <div class="mt-5 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-10 text-center">
            <p class="text-sm font-medium text-slate-500">لا يوجد قسم مطابق للبحث</p>
        </div>
    }
    else
    {
        <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            @foreach (RolePermissionEditorState permission in VisiblePermissions)
            {
                <div class="flex flex-col justify-between rounded-xl border p-4 transition-all @CardClass(permission.Level)">
                    <div>
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-2.5">
                                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg @RoleFeatureCatalog.Tone(permission.Feature)">
                                    <MudIcon Icon="@RoleFeatureCatalog.Icon(permission.Feature)" Class="text-[16px]" aria-hidden="true" />
                                </div>
                                <div class="min-w-0">
                                    <h3 class="text-sm font-bold leading-snug text-slate-900">
                                        @RoleFeatureCatalog.Name(permission.Feature)
                                    </h3>
                                    <p class="line-clamp-1 text-[11px] text-slate-500">
                                        @RoleFeatureCatalog.Description(permission.Feature)
                                    </p>
                                </div>
                            </div>

                            <span class="shrink-0 rounded px-2 py-0.5 text-[11px] font-semibold @BadgeClass(permission.Level)">
                                @BadgeLabel(permission.Level)
                            </span>
                        </div>
                    </div>

                    <div class="mt-4 border-t border-slate-100 pt-3">
                        <div class="grid grid-cols-3 gap-1 rounded-lg bg-slate-100/80 p-1 text-xs font-semibold">
                            <button type="button"
                                    class="rounded py-1 text-center transition-all disabled:cursor-not-allowed disabled:opacity-60 @SegmentedClass(permission.Level, PermissionLevel.None)"
                                    disabled="@Disabled"
                                    aria-pressed="@(permission.Level == PermissionLevel.None ? "true" : "false")"
                                    @onclick="() => SetLevelAsync(permission, PermissionLevel.None)">
                                لا شيء
                            </button>
                            <button type="button"
                                    class="rounded py-1 text-center transition-all disabled:cursor-not-allowed disabled:opacity-60 @SegmentedClass(permission.Level, PermissionLevel.Read)"
                                    disabled="@Disabled"
                                    aria-pressed="@(permission.Level == PermissionLevel.Read ? "true" : "false")"
                                    @onclick="() => SetLevelAsync(permission, PermissionLevel.Read)">
                                قراءة
                            </button>
                            <button type="button"
                                    class="rounded py-1 text-center transition-all disabled:cursor-not-allowed disabled:opacity-60 @SegmentedClass(permission.Level, PermissionLevel.Write)"
                                    disabled="@Disabled"
                                    aria-pressed="@(permission.Level == PermissionLevel.Write ? "true" : "false")"
                                    @onclick="() => SetLevelAsync(permission, PermissionLevel.Write)">
                                كتابة
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code
{
    // ============================================================
    // Parameters
    // ============================================================

    [Parameter]
    public IList<RolePermissionEditorState> Permissions { get; set; } = [];

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ShowBulkActions { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }


    // ============================================================
    // State
    // ============================================================

    private string? _search;


    // ============================================================
    // Filtering
    // ============================================================

    private List<RolePermissionEditorState> VisiblePermissions
    {
        get
        {
            string term = _search?.Trim() ?? string.Empty;

            if (term.Length == 0)
            {
                return Permissions.ToList();
            }

            return Permissions
                .Where(permission =>
                    RoleFeatureCatalog.Name(permission.Feature)
                        .Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    RoleFeatureCatalog.Description(permission.Feature)
                        .Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }


    // ============================================================
    // Number formatting (InvariantCulture — Latin digits)
    // ============================================================

    private static string FmtCount(int value) =>
        value.ToString("N0", CultureInfo.InvariantCulture);


    // ============================================================
    // Visual state
    // ============================================================

    private static string CardClass(PermissionLevel level)
    {
        return level switch
        {
            PermissionLevel.Read =>
                "border-blue-700 bg-blue-50/40",

            PermissionLevel.Write =>
                "border-indigo-700 bg-indigo-50/40",

            _ =>
                "border-slate-200/90 bg-white hover:border-slate-300"
        };
    }

    private static string BadgeClass(PermissionLevel level)
    {
        return level switch
        {
            PermissionLevel.Read =>
                "bg-blue-100 text-blue-700",

            PermissionLevel.Write =>
                "bg-indigo-100 text-indigo-700",

            _ =>
                "bg-slate-100 text-slate-600"
        };
    }

    private static string BadgeLabel(PermissionLevel level)
    {
        return level switch
        {
            PermissionLevel.Read => "قراءة",
            PermissionLevel.Write => "كتابة",
            _ => "لا شيء"
        };
    }

    private static string SegmentedClass(
        PermissionLevel current,
        PermissionLevel option)
    {
        if (current != option)
        {
            return "text-slate-600 hover:text-slate-900";
        }

        return option switch
        {
            PermissionLevel.Read =>
                "bg-white font-bold text-blue-700 shadow-sm",

            PermissionLevel.Write =>
                "bg-white font-bold text-indigo-700 shadow-sm",

            _ =>
                "bg-white font-bold text-slate-800 shadow-sm"
        };
    }


    // ============================================================
    // Selection
    // ============================================================

    private async Task SetAllLevelsAsync(PermissionLevel level)
    {
        if (Disabled)
        {
            return;
        }

        foreach (RolePermissionEditorState permission in Permissions)
        {
            permission.Level = level;
        }

        await OnChanged.InvokeAsync();
    }

    private async Task SetLevelAsync(
        RolePermissionEditorState permission,
        PermissionLevel level)
    {
        if (Disabled || permission.Level == level)
        {
            return;
        }

        permission.Level = level;

        await OnChanged.InvokeAsync();
    }
}
