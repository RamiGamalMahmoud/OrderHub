@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Write)]
@page "/admin/roles/create"
@page "/admin/roles/{RoleId:int}/edit"

@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using MudBlazor

@using OrderHub.Application.Features.Administration.Roles
@using OrderHub.Application.Features.Administration.Roles.Create
@using OrderHub.Application.Features.Administration.Roles.GetRole
@using OrderHub.Application.Features.Administration.Roles.Update
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Enums

@attribute [Authorize(Roles = "Admin")]

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar


<PageTitle>@PageTitleText</PageTitle>


<div class="space-y-5">
    <PageScaffold Title="@PageTitleText"
                  Description="@PageDescription"
                  Crumbs="ScaffoldCrumbs">
        <Actions>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700">
                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" />
                صلاحيات RBAC
            </span>
        </Actions>
    </PageScaffold>


    @* ============================================================
       Loading
       ============================================================ *@

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل بيانات الدور...</p>
        </div>
    }

    @* ============================================================
       Role not found
       ============================================================ *@

    else if (IsEditMode && !_roleFound)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-50 text-rose-600">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">الدور غير موجود</p>
            <p class="mt-1 text-sm text-slate-500">تعذر العثور على الدور المطلوب.</p>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowForward"
                       Class="mt-4 rounded-xl font-bold"
                       OnClick="GoBack">
                العودة إلى الأدوار
            </MudButton>
        </div>
    }

    @* ============================================================
       Editor
       ============================================================ *@

    else
    {
        <MudForm @ref="_form"
                 Model="_state"
                 ValidationDelay="0">

            <div class="space-y-5">


                @* ==================================================
                   Role information
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">بيانات الدور</h3>
                            <p class="mt-0.5 text-xs text-slate-500">أدخل اسمًا واضحًا يعبّر عن مسؤوليات المستخدمين التابعين لهذا الدور</p>
                        </div>
                    </div>

                    <MudTextField T="string"
                                  @bind-Value="_state.Name"
                                  Label="اسم الدور"
                                  Placeholder="مثال: المبيعات"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true"
                                  RequiredError="اسم الدور مطلوب."
                                  MaxLength="100"
                                  Immediate="true"
                                  Disabled="_saving"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge" />

                    <div class="mt-1 flex items-center gap-1 text-xs font-medium text-slate-500">
                        <span class="tabular-nums">@FmtCount(_state.Name.Length)</span>
                        <span>/ 100</span>
                    </div>
                </section>


                @* ==================================================
                   Permissions
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" />
                            </span>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">الصلاحيات</h3>
                                <p class="mt-0.5 text-xs text-slate-500">حدد مستوى الوصول لكل جزء من النظام</p>
                            </div>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Class="rounded-lg text-xs font-bold"
                                       Disabled="_saving"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       OnClick="@(() => SetAllLevels(null))">
                                إعادة تعيين
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Size="Size.Small"
                                       Class="rounded-lg text-xs font-bold"
                                       Disabled="_saving"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => SetAllLevels(PermissionLevel.Read))">
                                قراءة للجميع
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Class="rounded-lg text-xs font-bold"
                                       Disabled="_saving"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => SetAllLevels(PermissionLevel.Write))">
                                كتابة للجميع
                            </MudButton>
                        </div>
                    </div>

                    <div class="divide-y divide-slate-100">
                        @foreach (RolePermissionEditorState permission
                                            in _state.Permissions)
                        {
                            <div class="flex flex-wrap items-center justify-between gap-3 px-5 py-4">
                                <div class="flex min-w-0 items-center gap-3">
                                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl @FeatureTone(permission.Feature)">
                                        <MudIcon Icon="@GetFeatureIcon(permission.Feature)" Size="Size.Small" />
                                    </span>

                                    <div class="min-w-0">
                                        <p class="text-sm font-bold text-slate-900">
                                            @GetFeatureName(permission.Feature)
                                        </p>

                                        <p class="mt-0.5 text-xs text-slate-500">
                                            @GetFeatureDescription(permission.Feature)
                                        </p>
                                    </div>
                                </div>

                                <div class="flex items-center gap-2">
                                    <MudToggleGroup T="PermissionLevel"
                                                    Value="permission.Level"
                                                    ValueChanged="@(value => SetLevel(permission, value))"
                                                    Color="Color.Primary"
                                                    Size="Size.Small"
                                                    Disabled="_saving"
                                                    Class="rounded-xl text-xs font-bold">
                                        <MudToggleItem T="PermissionLevel"
                                                       Value="PermissionLevel.None">لا شيء</MudToggleItem>
                                        <MudToggleItem T="PermissionLevel"
                                                       Value="PermissionLevel.Read">قراءة</MudToggleItem>
                                        <MudToggleItem T="PermissionLevel"
                                                       Value="PermissionLevel.Write">كتابة</MudToggleItem>
                                    </MudToggleGroup>
                                </div>
                            </div>
                        }
                    </div>
                </section>


                @* ==================================================
                   Permission explanation
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <p class="mb-3 text-sm font-bold text-slate-900">مستويات الوصول الثلاثة</p>

                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                        <div class="rounded-xl border border-slate-200/85 bg-slate-50 p-3">
                            <div class="mb-1.5 flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-slate-400"></span>
                                <p class="text-xs font-bold text-slate-700">لا شيء</p>
                            </div>
                            <p class="text-xs text-slate-500">لا يمكن للمستخدم الوصول إلى الميزة.</p>
                        </div>

                        <div class="rounded-xl border border-sky-100 bg-sky-50 p-3">
                            <div class="mb-1.5 flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span>
                                <p class="text-xs font-bold text-sky-700">قراءة</p>
                            </div>
                            <p class="text-xs text-slate-600">يمكن عرض البيانات والبحث فيها دون تعديلها.</p>
                        </div>

                        <div class="rounded-xl border border-brand-100 bg-brand-50 p-3">
                            <div class="mb-1.5 flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full bg-brand-500"></span>
                                <p class="text-xs font-bold text-brand-700">كتابة</p>
                            </div>
                            <p class="text-xs text-slate-600">تشمل القراءة بالإضافة إلى عمليات الإضافة والتعديل والحذف والعمليات التي تغيّر البيانات.</p>
                        </div>
                    </div>
                </section>


                @* ==================================================
                   Summary
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-sm font-bold text-slate-900">ملخص الصلاحيات</p>
                            <p class="mt-0.5 text-xs text-slate-500">
                                @if (GrantedPermissionCount == 0)
                                {
                                    @:لم يتم منح أي صلاحيات لهذا الدور
                                }
                                else
                                {
                                    @:تم تحديد @FmtCount(GrantedPermissionCount) صلاحية
                                }
                            </p>
                        </div>

                        <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
                            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-slate-500">
                                <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                                لا شيء: <span class="tabular-nums">@FmtCount(NoPermissionCount)</span>
                            </span>

                            <span class="inline-flex items-center gap-1.5 rounded-full border border-sky-200 bg-sky-50 px-2.5 py-1 text-sky-700">
                                <span class="h-1.5 w-1.5 rounded-full bg-sky-500"></span>
                                قراءة: <span class="tabular-nums">@FmtCount(ReadPermissionCount)</span>
                            </span>

                            <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-brand-50 px-2.5 py-1 text-brand-700">
                                <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
                                كتابة: <span class="tabular-nums">@FmtCount(WritePermissionCount)</span>
                            </span>
                        </div>
                    </div>
                </section>


                @* ==================================================
                   No permissions warning
                   ================================================== *@

                @if (GrantedPermissionCount == 0)
                {
                    <div class="flex items-start gap-2.5 rounded-xl border border-amber-100 bg-amber-50 p-4 text-sm text-amber-800">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" class="mt-0.5 shrink-0" />
                        <p>
                            لم يتم منح أي صلاحيات لهذا الدور.
                            يمكن حفظ الدور بهذه الحالة، لكن المستخدمين المرتبطين به
                            لن يحصلوا على صلاحيات وصول من خلاله.
                        </p>
                    </div>
                }


                @* ==================================================
                   Sticky actions
                   ================================================== *@

                <div class="sticky bottom-0 z-10 -mx-px mt-6 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-sm backdrop-blur">
                    <div class="flex flex-wrap items-center justify-end gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Disabled="_saving"
                                   Class="rounded-xl text-slate-600"
                                   StartIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="GoBack">
                            إلغاء والعودة
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="_saving"
                                   Class="rounded-xl px-5 font-bold shadow-sm"
                                   OnClick="SaveAsync">

                            @if (_saving)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Class="me-2" />

                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <span>@SaveButtonText</span>
                            }

                        </MudButton>
                    </div>
                </div>

            </div>

        </MudForm>
    }
</div>


@code
{

    // ============================================================
    // Parameters
    // ============================================================

    [Parameter]
    public int? RoleId { get; set; }


    // ============================================================
    // State
    // ============================================================

    private MudForm? _form;

    private RoleEditorState _state = new();

    private bool _loading = true;

    private bool _saving;

    private bool _roleFound;


    // ============================================================
    // Mode
    // ============================================================

    private bool IsEditMode =>
        RoleId.HasValue;


    private string PageTitleText =>
        IsEditMode
            ? "تعديل الدور"
            : "إضافة دور";


    private string PageDescription =>
        IsEditMode
            ? "تعديل بيانات الدور وصلاحيات الوصول الخاصة به"
            : "إنشاء دور جديد وتحديد صلاحيات الوصول الخاصة به";


    private string SaveButtonText =>
        IsEditMode
            ? "حفظ التعديلات"
            : "إضافة الدور";


    private PageScaffold.CrumbItem[] ScaffoldCrumbs =>
    [
        new("إدارة الأدوار", "/admin/roles"),
        new(PageTitleText)
    ];


    // ============================================================
    // Permission summary
    // ============================================================

    private int NoPermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.None);


    private int ReadPermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.Read);


    private int WritePermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.Write);


    private int GrantedPermissionCount =>
        ReadPermissionCount + WritePermissionCount;


    // ============================================================
    // Number formatting (InvariantCulture — Latin digits)
    // ============================================================

    private static string FmtCount(int value) =>
        value.ToString("N0", CultureInfo.InvariantCulture);


    // ============================================================
    // Bulk level selection
    // ============================================================

    /// <summary>يحدد مستوى دالة صريحًا للجميع، أو يجمع كل شيء إلى «لا شيء» عند تمرير null.</summary>
    private void SetAllLevels(PermissionLevel? level)
    {
        if (_saving)
        {
            return;
        }

        foreach (RolePermissionEditorState permission in _state.Permissions)
        {
            permission.Level = level ?? PermissionLevel.None;
        }

        StateHasChanged();
    }

    private void SetLevel(RolePermissionEditorState permission, PermissionLevel level)
    {
        if (_saving)
        {
            return;
        }

        permission.Level = level;
        StateHasChanged();
    }


    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnParametersSetAsync()
    {
        await InitializeAsync();
    }


    // ============================================================
    // Initialization
    // ============================================================

    private async Task InitializeAsync()
    {
        _loading = true;

        try
        {
            _state = new RoleEditorState();

            if (!IsEditMode)
            {
                _roleFound = true;
                return;
            }

            await LoadRoleAsync();
        }
        catch (Exception)
        {
            _roleFound = false;

            Snackbar.Add(
                "تعذر تحميل بيانات الدور.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    // ============================================================
    // Load existing role
    // ============================================================

    private async Task LoadRoleAsync()
    {
        if (!RoleId.HasValue)
            return;

        GetRoleResponse? role =
            await RequestExecutor.ExecuteAsync(
                new GetRoleQuery(RoleId.Value));

        if (role is null)
        {
            _roleFound = false;
            return;
        }

        _state.Name = role.Name;

        ApplyPermissions(role.Permissions);

        _roleFound = true;
    }


    // ============================================================
    // Apply existing permissions
    // ============================================================

    private void ApplyPermissions(
        IReadOnlyList<RolePermissionItem> permissions)
    {
        foreach (RolePermissionEditorState editorPermission
                 in _state.Permissions)
        {
            editorPermission.Level =
                PermissionLevel.None;
        }

        foreach (RolePermissionItem permission in permissions)
        {
            RolePermissionEditorState? editorPermission =
                _state.Permissions.FirstOrDefault(
                    x => x.Feature == permission.Feature);

            if (editorPermission is null)
                continue;

            editorPermission.Level =
                permission.Level;
        }
    }


    // ============================================================
    // Save
    // ============================================================

    private async Task SaveAsync()
    {
        if (_saving || _form is null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            _saving = true;

            if (IsEditMode)
                await UpdateAsync();
            else
                await CreateAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(
                IsEditMode
                    ? "حدث خطأ أثناء حفظ تعديلات الدور."
                    : "حدث خطأ أثناء إضافة الدور.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }


    // ============================================================
    // Create
    // ============================================================

    private async Task CreateAsync()
    {
        IReadOnlyList<RolePermissionInput> permissions =
            BuildPermissionInputs();

        var request = new CreateRoleRequest(
            _state.Name.Trim(),
            permissions);

        var result =
            await RequestExecutor.ExecuteAsync(
                new CreateRoleCommand(request));

        if (!result.IsSuccess)
        {
            Snackbar.Add(
                result.ErrorMessage,
                Severity.Error);

            return;
        }

        Snackbar.Add(
            "تمت إضافة الدور بنجاح.",
            Severity.Success);

        NavigateToRoles();
    }


    // ============================================================
    // Update
    // ============================================================

    private async Task UpdateAsync()
    {
        if (!RoleId.HasValue)
            return;

        IReadOnlyList<RolePermissionInput> permissions =
            BuildPermissionInputs();

        var request = new UpdateRoleRequest(
            _state.Name.Trim(),
            permissions);

        var result =
            await RequestExecutor.ExecuteAsync(
                new UpdateRoleCommand(
                    RoleId.Value,
                    request));

        if (!result.IsSuccess)
        {
            Snackbar.Add(
                result.ErrorMessage,
                Severity.Error);

            return;
        }

        Snackbar.Add(
            "تم حفظ تعديلات الدور بنجاح.",
            Severity.Success);

        NavigateToRoles();
    }


    // ============================================================
    // Build application input
    // ============================================================

    private IReadOnlyList<RolePermissionInput> BuildPermissionInputs()
    {
        return _state.Permissions
            .Where(
                x => x.Level != PermissionLevel.None)
            .Select(
                x => new RolePermissionInput(
                    x.Feature,
                    x.Level))
            .ToList();
    }


    // ============================================================
    // Navigation
    // ============================================================

    private void GoBack()
    {
        NavigateToRoles();
    }


    private void NavigateToRoles()
    {
        NavigationManager.NavigateTo(
            "/admin/roles");
    }


    // ============================================================
    // Feature name
    // ============================================================

    private static string GetFeatureName(
        PermissionFeature feature)
    {
        return feature switch
        {
            PermissionFeature.Orders =>
                "الطلبات",

            PermissionFeature.Documents =>
                "المستندات",

            PermissionFeature.Products =>
                "المنتجات",

            PermissionFeature.Categories =>
                "الأقسام",

            PermissionFeature.Properties =>
                "خصائص المنتجات",

            PermissionFeature.Clients =>
                "العملاء",

            PermissionFeature.Suppliers =>
                "الموردون",

            PermissionFeature.Deliverymen =>
                "المناديب",

            PermissionFeature.ShippingCarriers =>
                "شركات الشحن",

            PermissionFeature.Cities =>
                "المدن",

            PermissionFeature.PaymentMethods =>
                "طرق الدفع",

            PermissionFeature.Logs =>
                "سجلات النظام",

            PermissionFeature.Users =>
                "إدارة المستخدمين",

            PermissionFeature.Settings =>
                "إعدادات النظام",

            _ => feature.ToString()
        };
    }


    // ============================================================
    // Feature description
    // ============================================================

    private static string GetFeatureDescription(
        PermissionFeature feature)
    {
        return feature switch
        {
            PermissionFeature.Orders =>
                "عرض وإدارة الطلبات",

            PermissionFeature.Documents =>
                "عروض الأسعار والفواتير والمستندات",

            PermissionFeature.Products =>
                "عرض وإدارة المنتجات",

            PermissionFeature.Categories =>
                "إدارة أقسام المنتجات",

            PermissionFeature.Properties =>
                "إدارة خصائص وخيارات المنتجات",

            PermissionFeature.Clients =>
                "عرض وإدارة بيانات العملاء",

            PermissionFeature.Suppliers =>
                "عرض وإدارة الموردين",

            PermissionFeature.Deliverymen =>
                "عرض وإدارة المناديب",

            PermissionFeature.ShippingCarriers =>
                "عرض وإدارة شركات الشحن",

            PermissionFeature.Cities =>
                "إدارة المدن",

            PermissionFeature.PaymentMethods =>
                "إدارة طرق الدفع",

            PermissionFeature.Logs =>
                "عرض سجلات النظام",

            PermissionFeature.Users =>
                "إدارة حسابات المستخدمين",

            PermissionFeature.Settings =>
                "إدارة إعدادات النظام",

            _ => string.Empty
        };
    }


    // ============================================================
    // Feature icon
    // ============================================================

    private static string GetFeatureIcon(
        PermissionFeature feature)
    {
        return feature switch
        {
            PermissionFeature.Orders =>
                Icons.Material.Filled.ShoppingCart,

            PermissionFeature.Documents =>
                Icons.Material.Filled.Description,

            PermissionFeature.Products =>
                Icons.Material.Filled.Inventory2,

            PermissionFeature.Categories =>
                Icons.Material.Filled.Category,

            PermissionFeature.Properties =>
                Icons.Material.Filled.Tune,

            PermissionFeature.Clients =>
                Icons.Material.Filled.People,

            PermissionFeature.Suppliers =>
                Icons.Material.Filled.Store,

            PermissionFeature.Deliverymen =>
                Icons.Material.Filled.DeliveryDining,

            PermissionFeature.ShippingCarriers =>
                Icons.Material.Filled.LocalShipping,

            PermissionFeature.Cities =>
                Icons.Material.Filled.LocationCity,

            PermissionFeature.PaymentMethods =>
                Icons.Material.Filled.Payments,

            PermissionFeature.Logs =>
                Icons.Material.Filled.ReceiptLong,

            PermissionFeature.Users =>
                Icons.Material.Filled.ManageAccounts,

            PermissionFeature.Settings =>
                Icons.Material.Filled.Settings,

            _ =>
                Icons.Material.Filled.Security
        };
    }


    // ============================================================
    // Feature tile tone (fixed color per feature, per template)
    // ============================================================

    private static string FeatureTone(
        PermissionFeature feature)
    {
        return feature switch
        {
            PermissionFeature.Orders =>
                "bg-blue-50 text-blue-600 border border-blue-100",

            PermissionFeature.Documents =>
