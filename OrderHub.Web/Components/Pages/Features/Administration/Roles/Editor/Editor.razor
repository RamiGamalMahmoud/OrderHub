@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Write)]
@page "/admin/roles/create"
@page "/admin/roles/{RoleId:int}/edit"

@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using MudBlazor

@using OrderHub.Application.Features.Administration.Roles
@using OrderHub.Application.Features.Administration.Roles.Create
@using OrderHub.Application.Features.Administration.Roles.GetRole
@using OrderHub.Application.Features.Administration.Roles.Update
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Enums

@attribute [Authorize(Roles = "Admin")]

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar


<PageTitle>@PageTitleText</PageTitle>


<div class="space-y-5">

    @* ============================================================
       Breadcrumb & title
       ============================================================ *@

    <div class="space-y-4">
        <nav aria-label="مسار التنقل"
             class="flex items-center gap-2 text-xs font-medium text-slate-500">
            <a href="/" class="transition-colors hover:text-brand-600">الرئيسية</a>
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft"
                     Class="h-3.5 w-3.5 text-slate-400"
                     aria-hidden="true" />
            <a href="/admin/roles" class="transition-colors hover:text-brand-600">الأدوار والصلاحيات</a>
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft"
                     Class="h-3.5 w-3.5 text-slate-400"
                     aria-hidden="true" />
            <span class="font-semibold text-slate-800">@PageTitleText</span>
        </nav>

        <div class="flex flex-col gap-4 rounded-xl border border-slate-200/80 bg-white p-5 shadow-[0_1px_3px_rgba(0,0,0,0.03)] sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="flex items-center gap-2.5">
                    <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">@PageTitleText</h1>
                    <span class="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-bold tracking-wider text-blue-700">
                        <MudIcon Icon="@Icons.Material.Filled.Security"
                                 Class="text-[12px]"
                                 aria-hidden="true" />
                        RBAC
                    </span>
                </div>
                <p class="mt-1 text-xs text-slate-500 sm:text-sm">@PageDescription</p>
            </div>

            <div>
                <a href="/admin/roles"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-sm transition-all hover:border-slate-300 hover:bg-slate-50">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                             Class="text-[16px] text-slate-500"
                             aria-hidden="true" />
                    <span>الرجوع لقائمة الأدوار</span>
                </a>
            </div>
        </div>
    </div>


    @* ============================================================
       Loading
       ============================================================ *@

    @if (_loading)
    {
        <div class="rounded-xl border border-slate-200/80 bg-white p-8 text-center shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل بيانات الدور...</p>
        </div>
    }

    @* ============================================================
       Role not found
       ============================================================ *@

    else if (IsEditMode && !_roleFound)
    {
        <div class="rounded-xl border border-slate-200/80 bg-white p-8 text-center shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-50 text-rose-600">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">الدور غير موجود</p>
            <p class="mt-1 text-sm text-slate-500">تعذر العثور على الدور المطلوب.</p>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ArrowForward"
                       Class="oh-btn oh-btn--secondary mt-4"
                       OnClick="GoBack">
                العودة إلى الأدوار
            </MudButton>
        </div>
    }

    @* ============================================================
       Editor
       ============================================================ *@

    else
    {
        <div class="space-y-5">

            @* ==================================================
               Role basic info
               ================================================== *@

            <section class="rounded-xl border border-slate-200/80 bg-white p-5 shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
                <div class="flex items-center gap-2.5 border-b border-slate-100 pb-4">
                    <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                        <MudIcon Icon="@Icons.Material.Filled.Badge"
                                 Class="text-[16px]"
                                 aria-hidden="true" />
                    </div>
                    <div>
                        <h2 class="text-sm font-bold leading-none text-slate-900">بيانات الدور الأساسية</h2>
                        <p class="mt-1 text-[11px] leading-none text-slate-500">
                            أدخل اسمًا واضحًا يعبّر عن مسؤوليات المستخدمين التابعين لهذا الدور
                        </p>
                    </div>
                </div>

                <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-12">
                    <div class="space-y-1.5 md:col-span-8">
                        <div class="flex items-center justify-between text-xs font-semibold text-slate-700">
                            <label for="role-name" class="flex items-center gap-1">
                                اسم الدور
                                <span class="font-bold text-rose-500">*</span>
                            </label>
                            <span class="font-mono text-[11px] font-normal text-slate-400">
                                @FmtCount(_state.Name.Length) / 100
                            </span>
                        </div>

                        <div class="relative rounded-lg shadow-sm">
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400">
                                <MudIcon Icon="@Icons.Material.Filled.Person"
                                         Class="text-[16px]"
                                         aria-hidden="true" />
                            </div>
                            <input id="role-name"
                                   type="text"
                                   maxlength="100"
                                   placeholder="مثال: مسؤول مبيعات، مدير عمليات، محاسب مالي..."
                                   class="block w-full rounded-lg border border-slate-200 py-2 pl-3.5 pr-10 text-xs text-slate-800 placeholder-slate-400 transition-colors focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
                                   disabled="@_saving"
                                   @bind="RoleName"
                                   @bind:event="oninput" />
                        </div>

                        @if (_nameError is not null)
                        {
                            <p class="text-[11px] font-semibold text-rose-600" role="alert">@_nameError</p>
                        }

                        <p class="text-[11px] text-slate-500">
                            سيظهر هذا الاسم في بطاقات المستخدمين وقوائم التعيين والتقارير الرقابية.
                        </p>
                    </div>
                </div>
            </section>


            @* ==================================================
               Permissions matrix
               ================================================== *@

            <RolePermissionCards Permissions="_state.Permissions"
                                 Disabled="_saving"
                                 OnChanged="StateHasChanged" />


            @* ==================================================
               Access levels legend
               ================================================== *@

            <section class="rounded-xl border border-blue-100 bg-blue-50/60 p-4">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white">
                        <MudIcon Icon="@Icons.Material.Filled.Info"
                                 Class="text-[14px]"
                                 aria-hidden="true" />
                    </div>
                    <div class="grid w-full grid-cols-1 gap-3 text-xs md:grid-cols-3">
                        <div class="rounded-lg border border-blue-100/60 bg-white/80 p-2.5">
                            <div class="flex items-center gap-1.5 font-bold text-slate-800">
                                <span class="h-2 w-2 rounded-full bg-slate-400"></span>
                                <span>لا شيء (حظر الوصول)</span>
                            </div>
                            <p class="mt-1 text-[11px] leading-relaxed text-slate-600">
                                لا يمكن للمستخدم الوصول إلى القسم نهائياً أو استعراض بياناته أو رؤية روابطه.
                            </p>
                        </div>

                        <div class="rounded-lg border border-blue-100/60 bg-white/80 p-2.5">
                            <div class="flex items-center gap-1.5 font-bold text-blue-700">
                                <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                                <span>قراءة (اطلاع فقط)</span>
                            </div>
                            <p class="mt-1 text-[11px] leading-relaxed text-slate-600">
                                يسمح باستعراض وتصفح البيانات، البحث، والفلترة دون أي صلاحية للتعديل أو الإضافة.
                            </p>
                        </div>

                        <div class="rounded-lg border border-blue-100/60 bg-white/80 p-2.5">
                            <div class="flex items-center gap-1.5 font-bold text-indigo-700">
                                <span class="h-2 w-2 rounded-full bg-indigo-600"></span>
                                <span>كتابة (صلاحية كاملة)</span>
                            </div>
                            <p class="mt-1 text-[11px] leading-relaxed text-slate-600">
                                تشمل القراءة بالإضافة إلى عمليات الإضافة، التعديل، الحذف، والعمليات التنفيذية.
                            </p>
                        </div>
                    </div>
                </div>
            </section>


            @* ==================================================
               Summary
               ================================================== *@

            <section class="rounded-xl border border-slate-200/80 bg-white p-4 shadow-[0_1px_3px_rgba(0,0,0,0.03)]">
                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                    <div>
                        <h3 class="text-xs font-bold text-slate-800">ملخص الصلاحيات المحددة</h3>
                        <p class="mt-0.5 text-[11px] text-slate-500">
                            تم تفعيل
                            <span class="font-bold text-blue-600">@FmtCount(GrantedPermissionCount)</span>
                            صلاحية نشطة من أصل @FmtCount(TotalFeatureCount) قسماً
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-xs font-medium text-slate-500">توزيع المستويات:</span>

                        <div class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
                            <span>لا شيء:</span>
                            <span class="font-bold">@FmtCount(NoPermissionCount)</span>
                        </div>

                        <div class="inline-flex items-center gap-1.5 rounded-md bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-800">
                            <span>قراءة:</span>
                            <span class="font-bold">@FmtCount(ReadPermissionCount)</span>
                        </div>

                        <div class="inline-flex items-center gap-1.5 rounded-md bg-indigo-100 px-2.5 py-1 text-xs font-semibold text-indigo-800">
                            <span>كتابة:</span>
                            <span class="font-bold">@FmtCount(WritePermissionCount)</span>
                        </div>
                    </div>
                </div>

                @if (GrantedPermissionCount <= 1)
                {
                    <div class="mt-3 flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 p-2.5 text-[11px] font-medium text-amber-800"
                         role="alert">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                                 Class="shrink-0 text-[16px] text-amber-600"
                                 aria-hidden="true" />
                        <span>
                            تنبيه: تم منح صلاحيات وصول محدودة جداً لهذا الدور. المستخدمون المرتبطون به قد يواجهون قيوداً واسعة في تصفح النظام.
                        </span>
                    </div>
                }
            </section>


            @* ==================================================
               Actions
               ================================================== *@

            <section class="flex flex-col items-center justify-between gap-3 rounded-xl border border-slate-200/80 bg-white p-4 shadow-[0_1px_3px_rgba(0,0,0,0.03)] sm:flex-row">
                <div class="order-2 sm:order-1">
                    <button type="button"
                            class="rounded-lg px-4 py-2 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-800 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@_saving"
                            @onclick="GoBack">
                        إلغاء والعودة
                    </button>
                </div>

                <div class="order-1 flex w-full items-center justify-end gap-2.5 sm:order-2 sm:w-auto">
                    <button type="button"
                            class="flex w-full items-center justify-center gap-1.5 rounded-lg bg-blue-600 px-5 py-2 text-xs font-bold text-white shadow-sm shadow-blue-500/20 transition-colors hover:bg-blue-700 active:bg-blue-800 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
                            disabled="@_saving"
                            @onclick="SaveAsync">
                        @if (_saving)
                        {
                            <MudProgressCircular Indeterminate="true"
                                                 Size="Size.Small"
                                                 Color="Color.Inherit" />
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check"
                                     Class="text-[16px]"
                                     aria-hidden="true" />
                            <span>@SaveButtonText</span>
                        }
                    </button>
                </div>
            </section>

        </div>
    }
</div>


@code
{

    // ============================================================
    // Parameters
    // ============================================================

    [Parameter]
    public int? RoleId { get; set; }


    // ============================================================
    // State
    // ============================================================

    private RoleEditorState _state = new();

    private bool _loading = true;

    private bool _saving;

    private bool _roleFound;

    private string? _nameError;


    // ============================================================
    // Role name binding
    // ============================================================

    private string RoleName
    {
        get => _state.Name;
        set
        {
            _state.Name = value;
            _nameError = null;
        }
    }


    // ============================================================
    // Mode
    // ============================================================

    private bool IsEditMode =>
        RoleId.HasValue;


    private string PageTitleText =>
        IsEditMode
            ? "تعديل الدور"
            : "إضافة دور جديد";


    private string PageDescription =>
        IsEditMode
            ? "تعديل بيانات الدور وصلاحيات الوصول الخاصة به"
            : "إنشاء وتخصيص مستويات صلاحيات الوصول لأقسام ووحدات النظام بدقة وسلاسة";


    private string SaveButtonText =>
        IsEditMode
            ? "حفظ التعديلات"
            : "حفظ وإضافة الدور";


    // ============================================================
    // Permission summary
    // ============================================================

    private int TotalFeatureCount =>
        _state.Permissions.Count;


    private int NoPermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.None);


    private int ReadPermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.Read);


    private int WritePermissionCount =>
        _state.Permissions.Count(
            x => x.Level == PermissionLevel.Write);


    private int GrantedPermissionCount =>
        ReadPermissionCount + WritePermissionCount;


    // ============================================================
    // Number formatting (InvariantCulture — Latin digits)
    // ============================================================

    private static string FmtCount(int value) =>
        value.ToString("N0", CultureInfo.InvariantCulture);


    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnParametersSetAsync()
    {
        await InitializeAsync();
    }


    // ============================================================
    // Initialization
    // ============================================================

    private async Task InitializeAsync()
    {
        _loading = true;

        try
        {
            _state = new RoleEditorState();
            _nameError = null;

            if (!IsEditMode)
            {
                _roleFound = true;
                return;
            }

            await LoadRoleAsync();
        }
        catch (Exception)
        {
            _roleFound = false;

            Snackbar.Add(
                "تعذر تحميل بيانات الدور.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }


    // ============================================================
    // Load existing role
    // ============================================================

    private async Task LoadRoleAsync()
    {
        if (!RoleId.HasValue)
            return;

        GetRoleResponse? role =
            await RequestExecutor.ExecuteAsync(
                new GetRoleQuery(RoleId.Value));

        if (role is null)
        {
            _roleFound = false;
            return;
        }

        _state.Name = role.Name;

        ApplyPermissions(role.Permissions);

        _roleFound = true;
    }


    // ============================================================
    // Apply existing permissions
    // ============================================================

    private void ApplyPermissions(
        IReadOnlyList<RolePermissionItem> permissions)
    {
        foreach (RolePermissionEditorState editorPermission
                 in _state.Permissions)
        {
            editorPermission.Level =
                PermissionLevel.None;
        }

        foreach (RolePermissionItem permission in permissions)
        {
            RolePermissionEditorState? editorPermission =
                _state.Permissions.FirstOrDefault(
                    x => x.Feature == permission.Feature);

            if (editorPermission is null)
                continue;

            editorPermission.Level =
                permission.Level;
        }
    }


    // ============================================================
    // Save
    // ============================================================

    private async Task SaveAsync()
    {
        if (_saving)
            return;

        if (string.IsNullOrWhiteSpace(_state.Name))
        {
            _nameError = "اسم الدور مطلوب.";
            return;
        }

        _nameError = null;

        try
        {
            _saving = true;

            if (IsEditMode)
                await UpdateAsync();
            else
                await CreateAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(
                IsEditMode
                    ? "حدث خطأ أثناء حفظ تعديلات الدور."
                    : "حدث خطأ أثناء إضافة الدور.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }


    // ============================================================
    // Create
    // ============================================================

    private async Task CreateAsync()
    {
        IReadOnlyList<RolePermissionInput> permissions =
            _state.BuildPermissionInputs();

        var request = new CreateRoleRequest(
            _state.Name.Trim(),
            permissions);

        var result =
            await RequestExecutor.ExecuteAsync(
                new CreateRoleCommand(request));

        if (!result.IsSuccess)
        {
            Snackbar.Add(
                result.ErrorMessage,
                Severity.Error);

            return;
        }

        Snackbar.Add(
            "تمت إضافة الدور بنجاح.",
            Severity.Success);

        NavigateToRoles();
    }


    // ============================================================
    // Update
    // ============================================================

    private async Task UpdateAsync()
    {
        if (!RoleId.HasValue)
            return;

        IReadOnlyList<RolePermissionInput> permissions =
            _state.BuildPermissionInputs();

        var request = new UpdateRoleRequest(
            _state.Name.Trim(),
            permissions);

        var result =
            await RequestExecutor.ExecuteAsync(
                new UpdateRoleCommand(
                    RoleId.Value,
                    request));

        if (!result.IsSuccess)
        {
            Snackbar.Add(
                result.ErrorMessage,
                Severity.Error);

            return;
        }

        Snackbar.Add(
            "تم حفظ تعديلات الدور بنجاح.",
            Severity.Success);

        NavigateToRoles();
    }


    // ============================================================
    // Navigation
    // ============================================================

    private void GoBack()
    {
        NavigateToRoles();
    }


    private void NavigateToRoles()
    {
        NavigationManager.NavigateTo(
            "/admin/roles");
    }

}
