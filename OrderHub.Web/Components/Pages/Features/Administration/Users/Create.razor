@page "/admin/users/create"
@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Write)]

@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using MudBlazor
@using OrderHub.Application.Authorization
@using OrderHub.Application.Features.Administration.Roles.GetRoles
@using OrderHub.Application.Features.Administration.Users.Create
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Common
@using OrderHub.Web.Components.Pages.Features.Administration.Roles.Editor

@attribute [Authorize(Roles = "Admin")]

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>إضافة مستخدم</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="إضافة مستخدم"
                  Description="إنشاء حساب مستخدم جديد وتحديد الدور وحالة الحساب"
                  Crumbs="_scaffoldCrumbs" />

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل البيانات...</p>
        </div>
    }
    else
    {
        <MudForm @ref="_form"
                 Model="_model"
                 ValidationDelay="0">

            <div class="space-y-5">

                @* ==================================================
                   Account information
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">بيانات المستخدم</h3>
                            <p class="mt-0.5 text-xs text-slate-500">البيانات الأساسية المستخدمة لتسجيل الدخول والتعريف بالمستخدم</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <MudTextField T="string"
                                      @bind-Value="_model.UserName"
                                      Label="اسم المستخدم"
                                      Placeholder="أدخل اسم المستخدم"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="اسم المستخدم مطلوب."
                                      MaxLength="100"
                                      Counter="100"
                                      Immediate="true"
                                      Disabled="_saving"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.AccountCircle" />

                        <MudTextField T="string"
                                      @bind-Value="_model.DisplayName"
                                      Label="الاسم"
                                      Placeholder="أدخل اسم المستخدم للعرض"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="الاسم مطلوب."
                                      MaxLength="150"
                                      Counter="150"
                                      Immediate="true"
                                      Disabled="_saving"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />

                        <div class="space-y-2">
                            <MudTextField T="string"
                                          @bind-Value="_model.Password"
                                          Label="كلمة المرور"
                                          Placeholder="أدخل كلمة المرور"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="@(_showPassword
                                              ? InputType.Text
                                              : InputType.Password)"
                                          Required="true"
                                          RequiredError="كلمة المرور مطلوبة."
                                          Immediate="true"
                                          Disabled="_saving"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPassword
                                              ? Icons.Material.Filled.VisibilityOff
                                              : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="TogglePasswordVisibility" />

                            @* UI-only password strength bar: computed from length + variety, never persisted and not validated server-side *@
                            @if (!string.IsNullOrEmpty(_model.Password))
                            {
                                <div class="space-y-1" dir="ltr">
                                    <div class="h-1.5 w-full rounded-full bg-slate-100">
                                        <div class="h-full rounded-full transition-all duration-300 @StrengthBarClass"
                                             style="width:@StrengthPercent"></div>
                                    </div>
                                    <p class="text-xs font-bold @StrengthTextClass">@StrengthLabel</p>
                                </div>
                            }
                        </div>

                        <div>
                            <MudTextField T="string"
                                          @bind-Value="_model.ConfirmPassword"
                                          Label="تأكيد كلمة المرور"
                                          Placeholder="أعد إدخال كلمة المرور"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="@(_showConfirmPassword
                                              ? InputType.Text
                                              : InputType.Password)"
                                          Required="true"
                                          RequiredError="تأكيد كلمة المرور مطلوب."
                                          Immediate="true"
                                          Disabled="_saving"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showConfirmPassword
                                              ? Icons.Material.Filled.VisibilityOff
                                              : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="ToggleConfirmPasswordVisibility"
                                          Validation="@((string value) => ValidateConfirmPassword(value))" />
                        </div>
                    </div>

                    <p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-500">
                        لزيادة قوة كلمة المرور: 8 خانات على الأقل مع أحرف كبيرة وصغيرة وأرقام ورموز.
                    </p>
                </section>

                @* ==================================================
                   Access
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">الصلاحيات والوصول</h3>
                            <p class="mt-0.5 text-xs text-slate-500">حدد دور المستخدم وطريقة وصوله إلى النظام</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <MudSelect T="int?"
                                       @bind-Value="_model.RoleId"
                                       Label="الدور"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="_saving">

                                @foreach (RoleListItem role in _roles)
                                {
                                    <MudSelectItem T="int?"
                                                   Value="@role.Id">
                                        @role.Name
                                    </MudSelectItem>
                                }

                            </MudSelect>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ManageAccounts"
                                       Disabled="@(_saving || _creatingRole)"
                                       OnClick="CreateRoleAsync"
                                       Class="oh-btn oh-btn--secondary oh-btn--sm mt-2">
                                إنشاء دور جديد…
                            </MudButton>

                            <p class="mt-1 text-xs text-slate-500">
                                المستخدم بدون دور لا يحصل على صلاحيات الدور.
                            </p>
                        </div>

                        <div class="space-y-1">
                            <MudSwitch T="bool"
                                       @bind-Value="_model.IsAdmin"
                                       Label="مدير النظام"
                                       Color="Color.Error"
                                       Disabled="_saving" />

                            <p class="text-xs text-slate-500">
                                مدير النظام يمتلك وصولًا كاملًا ولا يعتمد وصوله على صلاحيات الدور.
                            </p>
                        </div>

                        <div class="md:col-span-2">
                            <MudSwitch T="bool"
                                       @bind-Value="_model.IsActive"
                                       Label="الحساب نشط"
                                       Color="Color.Success"
                                       Disabled="_saving" />

                            <p class="text-xs text-slate-500">
                                المستخدم غير النشط لا يمكنه تسجيل الدخول إلى النظام.
                            </p>
                        </div>
                    </div>

                    @if (_model.IsAdmin)
                    {
                        <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-blue-100 bg-blue-50 p-3 text-sm text-blue-800">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" class="mt-0.5 shrink-0" />
                            <p>
                                هذا المستخدم مدير للنظام، لذلك يمتلك وصولًا كاملًا
                                بغض النظر عن الدور المحدد.

                                @if (_model.RoleId.HasValue)
                                {
                                    <span>
                                        سيظل الدور محفوظًا ويمكن استخدامه إذا أزيلت
                                        صلاحية مدير النظام لاحقًا.
                                    </span>
                                }
                            </p>
                        </div>
                    }
                    else if (!_model.RoleId.HasValue)
                    {
                        <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-amber-100 bg-amber-50 p-3 text-sm text-amber-800">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" class="mt-0.5 shrink-0" />
                            <p>
                                لم يتم تحديد دور لهذا المستخدم.
                                سيتم إنشاء الحساب بدون صلاحيات وصول إلى الميزات
                                المحمية بالصلاحيات.
                            </p>
                        </div>
                    }
                </section>

                @* ==================================================
                   Actions
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    <div class="flex flex-wrap items-center justify-end gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Disabled="_saving"
                                   OnClick="GoBack"
                                   Class="oh-btn oh-btn--secondary">
                            إلغاء
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="_saving"
                                   OnClick="@(() => SaveAsync(true))"
                                   Class="oh-btn oh-btn--secondary">
                            حفظ وإضافة مستخدم آخر
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PersonAdd"
                                   Disabled="_saving"
                                   OnClick="@(() => SaveAsync(false))"
                                   Class="oh-btn oh-btn--primary">

                            @if (_saving)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Class="me-2" />

                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <span>إضافة المستخدم</span>
                            }

                        </MudButton>
                    </div>
                </section>

            </div>

        </MudForm>
    }
</div>

@code
{

    // ============================================================
    // State
    // ============================================================

    private MudForm? _form;

    private readonly UserFormModel _model = new();

    private IReadOnlyList<RoleListItem> _roles = [];

    private bool _loading = true;

    private bool _saving;

    private bool _creatingRole;

    private bool _showPassword;

    private bool _showConfirmPassword;

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("إدارة المستخدمين", "/admin/users"),
        new("إضافة مستخدم")
    ];

    // ============================================================
    // UI-only password strength (length + variety; not persisted)
    // ============================================================

    private int StrengthScore
    {
        get
        {
            string password = _model.Password ?? string.Empty;

            if (password.Length == 0)
            {
                return 0;
            }

            int score = 0;

            if (password.Length >= 8)
            {
                score++;
            }
            else if (password.Length >= 6)
            {
                score++;
            }

            if (password.Any(char.IsLower))
            {
                score++;
            }

            if (password.Any(char.IsUpper))
            {
                score++;
            }

            if (password.Any(char.IsDigit))
            {
                score++;
            }

            if (password.Any(character => !char.IsLetterOrDigit(character)))
            {
                score++;
            }

            return Math.Min(score, 4);
        }
    }

    private string StrengthPercent =>
        $"{Math.Max(StrengthScore, 1) * 25}%";

    private string StrengthLabel => StrengthScore switch
    {
        0 or 1 => "ضعيفة",
        2 => "متوسطة",
        3 => "جيدة",
        _ => "قوية"
    };

    private string StrengthBarClass => StrengthScore switch
    {
        0 or 1 => "bg-rose-500",
        2 => "bg-amber-500",
        3 => "bg-lime-500",
        _ => "bg-emerald-600"
    };

    private string StrengthTextClass => StrengthScore switch
    {
        0 or 1 => "text-rose-600",
        2 => "text-amber-600",
        3 => "text-lime-700",
        _ => "text-emerald-600"
    };

    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // ============================================================
    // Loading
    // ============================================================

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;

            _roles = await RequestExecutor.ExecuteAsync(
                new GetRolesQuery());
        }
        catch (Exception)
        {
            Snackbar.Add(
                "تعذر تحميل الأدوار.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ============================================================
    // Inline role creation
    // ============================================================

    private async Task CreateRoleAsync()
    {
        if (_saving || _creatingRole)
        {
            return;
        }

        try
        {
            _creatingRole = true;

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            var dialog =
                await DialogService.ShowAsync<RoleEditorDialog>(
                    "إضافة دور",
                    new DialogParameters(),
                    options);

            DialogResult? result = await dialog.Result;

            if (result is not { Canceled: false, Data: int newRoleId })
            {
                return;
            }

            _roles = await RequestExecutor.ExecuteAsync(
                new GetRolesQuery());

            _model.RoleId = newRoleId;
        }
        catch (AuthorizationDeniedException)
        {
            NavigationManager.NavigateTo(
                "/access-denied");
        }
        catch (Exception)
        {
            Snackbar.Add(
                "تعذر إنشاء الدور.",
                Severity.Error);
        }
        finally
        {
            _creatingRole = false;
        }
    }

    // ============================================================
    // Save
    // ============================================================

    private async Task SaveAsync(bool saveAndAddAnother)
    {
        if (_saving)
            return;

        if (_form is null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        if (_model.Password != _model.ConfirmPassword)
        {
            Snackbar.Add(
                "كلمتا المرور غير متطابقتين.",
                Severity.Warning);

            return;
        }

        try
        {
            _saving = true;

            var request = new CreateUserRequest(
                _model.UserName.Trim(),
                _model.DisplayName.Trim(),
                _model.Password,
                _model.IsActive,
                _model.IsAdmin,
                _model.RoleId);

            Result result = await RequestExecutor.ExecuteAsync(
                new CreateUserCommand(request));

            if (!result.IsSuccess)
            {
                Snackbar.Add(
                    result.ErrorMessage,
                    Severity.Error);

                return;
            }

            if (saveAndAddAnother)
            {
                Snackbar.Add(
                    $"تمت إضافة المستخدم {_model.DisplayName.Trim()} بنجاح. أضف المستخدم التالي.",
                    Severity.Success);

                await ResetFormAsync();
            }
            else
            {
                Snackbar.Add(
                    "تمت إضافة المستخدم بنجاح.",
                    Severity.Success);

                NavigationManager.NavigateTo(
                    "/admin/users");
            }
        }
        catch (Exception)
        {
            Snackbar.Add(
                "حدث خطأ أثناء إضافة المستخدم.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetFormAsync()
    {
        _model.UserName = string.Empty;
        _model.DisplayName = string.Empty;
        _model.Password = string.Empty;
        _model.ConfirmPassword = string.Empty;
        _model.IsActive = true;
        _model.IsAdmin = false;
        _model.RoleId = null;

        if (_form is not null)
        {
            await _form.ResetValidationAsync();
        }
    }

    // ============================================================
    // Validation
    // ============================================================

    private string? ValidateConfirmPassword(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "تأكيد كلمة المرور مطلوب.";

        if (value != _model.Password)
            return "كلمتا المرور غير متطابقتين.";

        return null;
    }


    // ============================================================
    // Password visibility
    // ============================================================

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }


    private void ToggleConfirmPasswordVisibility()
    {
        _showConfirmPassword = !_showConfirmPassword;
    }


    // ============================================================
    // Navigation
    // ============================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/admin/users");
    }


    // ============================================================
    // Form Model
    // ============================================================

    private sealed class UserFormModel
    {
        public string UserName { get; set; } = string.Empty;

        public string DisplayName { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;

        public bool IsAdmin { get; set; }

        public int? RoleId { get; set; }
    }
}
