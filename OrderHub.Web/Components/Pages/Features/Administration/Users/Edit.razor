@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Write)]
@page "/admin/users/{UserId:int}/edit"

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using OrderHub.Application.Features.Administration.Roles.GetRoles
@using OrderHub.Application.Features.Administration.Users.GetUser
@using OrderHub.Application.Features.Administration.Users.Update
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Common

@attribute [HigherManagerAuthorize]

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>تعديل المستخدم</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="تعديل المستخدم"
                  Description="تعديل بيانات المستخدم والدور وحالة الحساب"
                  Crumbs="_scaffoldCrumbs" />

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل بيانات المستخدم...</p>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-red-100 bg-red-50 p-4 shadow-sm">
            <p class="text-sm font-bold text-red-800">@_loadError</p>
            <button type="button"
                    class="oh-btn oh-btn--secondary oh-btn--sm"
                    disabled="@_saving"
                    @onclick="LoadAsync">
                <MudIcon Icon="@Icons.Material.Filled.Refresh" Class="text-[14px]" />
                إعادة المحاولة
            </button>
        </div>
    }
    else if (!_found)
    {
        <div class="space-y-3 rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-600">
                <MudIcon Icon="@Icons.Material.Filled.PersonOff" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">المستخدم غير موجود.</p>
            <p class="text-sm text-slate-500">قد يكون الحساب قد حُذف أو أن الرابط غير صحيح.</p>
            <button type="button"
                    class="oh-btn oh-btn--secondary oh-btn--sm"
                    @onclick="GoBack">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="text-[14px]" />
                العودة إلى المستخدمين
            </button>
        </div>
    }
    else
    {
        <MudForm @ref="_form"
                 Model="_model"
                 ValidationDelay="0">

            <div class="space-y-5">

                @* ==================================================
                   User information
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">بيانات المستخدم</h3>
                            <p class="mt-0.5 text-xs text-slate-500">البيانات الأساسية الخاصة بالحساب</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <MudTextField T="string"
                                      @bind-Value="_model.UserName"
                                      Label="اسم المستخدم"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="اسم المستخدم مطلوب."
                                      MaxLength="100"
                                      Counter="100"
                                      Immediate="true"
                                      Disabled="_saving"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.AccountCircle" />

                        <MudTextField T="string"
                                      @bind-Value="_model.DisplayName"
                                      Label="الاسم"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="الاسم مطلوب."
                                      MaxLength="150"
                                      Counter="150"
                                      Immediate="true"
                                      Disabled="_saving"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                    </div>
                </section>

                @* ==================================================
                   Access
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">الصلاحيات والوصول</h3>
                            <p class="mt-0.5 text-xs text-slate-500">تحديد دور المستخدم وحالة الحساب</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div>
                            <MudSelect T="int?"
                                       @bind-Value="_model.RoleId"
                                       Label="الدور"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true"
                                       Disabled="@(_saving || _model.IsAdmin)">

                                @if (SealedRoles.Count > 0)
                                {
                                    <MudListSubheader>أدوار جاهزة</MudListSubheader>

                                    @foreach (RoleListItem role in SealedRoles)
                                    {
                                        <MudSelectItem T="int?"
                                                       Value="@role.Id">
                                            @role.Name
                                        </MudSelectItem>
                                    }
                                }

                                @if (CustomRoles.Count > 0)
                                {
                                    <MudListSubheader>أدوار مخصصة</MudListSubheader>

                                    @foreach (RoleListItem role in CustomRoles)
                                    {
                                        <MudSelectItem T="int?"
                                                       Value="@role.Id">
                                            @role.Name
                                        </MudSelectItem>
                                    }
                                }

                            </MudSelect>

                            <p class="mt-1 text-xs text-slate-500">
                                المستخدم بدون دور لا يحصل على صلاحيات الدور.
                            </p>

                            <div class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-3">
                                <p class="text-xs font-bold text-slate-700">ملخص صلاحيات الدور</p>

                                @if (_model.IsAdmin)
                                {
                                    <p class="mt-1 text-xs text-slate-600">
                                        وصول كامل — يتجاوز جميع الصلاحيات.
                                    </p>
                                }
                                else if (SelectedRole is null)
                                {
                                    <p class="mt-1 text-xs text-slate-500">
                                        لم يتم تحديد دور؛ لا توجد صلاحيات.
                                    </p>
                                }
                                else
                                {
                                    <p class="mt-1 text-xs text-slate-600">
                                        @SelectedRole.Name —
                                        @(SelectedRole.IsSealed ? "دور جاهز" : "دور مخصص")
                                    </p>
                                    <p class="mt-1 text-xs font-medium text-slate-700">
                                        قراءة @SelectedRole.ReadCount ·
                                        كتابة @SelectedRole.WriteCount ·
                                        اعتماد @SelectedRole.ApproveCount
                                    </p>
                                    <p class="mt-0.5 text-xs text-slate-500">
                                        الإجمالي: @SelectedRole.PermissionCount صلاحية
                                    </p>
                                }
                            </div>
                        </div>

                        <div class="space-y-1">
                            <MudSwitch T="bool"
                                       @bind-Value="_model.IsAdmin"
                                       Label="مدير أعلى"
                                       Color="Color.Error"
                                       Disabled="_saving" />

                            <p class="text-xs text-slate-500">
                                مدير أعلى يمتلك وصولًا كاملًا بغض النظر عن الدور.
                            </p>
                        </div>

                        <div class="md:col-span-2">
                            <MudSwitch T="bool"
                                       @bind-Value="_model.IsActive"
                                       Label="الحساب نشط"
                                       Color="Color.Success"
                                       Disabled="_saving" />

                            <p class="text-xs text-slate-500">
                                تعطيل الحساب يمنع عمليات تسجيل الدخول الجديدة.
                            </p>
                        </div>
                    </div>

                    @if (_model.IsAdmin)
                    {
                        <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-blue-100 bg-blue-50 p-3 text-sm text-blue-800">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" class="mt-0.5 shrink-0" />
                            <p>
                                المستخدم مدير أعلى ويمتلك وصولًا كاملًا بغض النظر عن الدور المحدد.
                                @if (_model.RoleId.HasValue)
                                {
                                    <span>
                                        سيظل الدور محفوظًا ويُطبَّق تلقائيًا إذا أُزيلت صفة مدير أعلى لاحقًا.
                                    </span>
                                }
                            </p>
                        </div>
                    }
                    else if (!_model.RoleId.HasValue)
                    {
                        <div class="mt-4 flex items-start gap-2.5 rounded-xl border border-amber-100 bg-amber-50 p-3 text-sm text-amber-800">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" class="mt-0.5 shrink-0" />
                            <p>
                                لن يحصل هذا المستخدم على أي صلاحيات حتى يتم تعيين دور له.
                            </p>
                        </div>
                    }
                </section>

                @* ==================================================
                   Account information
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                    <div class="mb-4 flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-600">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                        </span>
                        <div>
                            <h3 class="text-sm font-bold text-slate-900">معلومات الحساب</h3>
                            <p class="mt-0.5 text-xs text-slate-500">بيانات للقراءة فقط عن تاريخ الإنشاء والمعرّف</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/70 px-3 py-2.5">
                            <p class="text-[11px] font-semibold text-slate-500">تاريخ إنشاء الحساب</p>
                            <p class="mt-0.5 text-sm font-bold text-slate-800" dir="ltr">
                                @_createdAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture)
                            </p>
                        </div>

                        <div class="rounded-xl border border-slate-100 bg-slate-50/70 px-3 py-2.5">
                            <p class="text-[11px] font-semibold text-slate-500">رقم المستخدم</p>
                            <p class="mt-0.5 text-sm font-bold text-slate-800" dir="ltr">
                                #@UserId.ToString(CultureInfo.InvariantCulture)
                            </p>
                        </div>
                    </div>
                </section>

                @* ==================================================
                   Actions
                   ================================================== *@

                <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                    @if (_saveError is not null)
                    {
                        <div class="mb-3 rounded-lg border border-red-100 bg-red-50 px-3 py-2">
                            <p class="text-xs font-bold text-red-800" role="alert">@_saveError</p>
                        </div>
                    }

                    <div class="flex flex-wrap items-center justify-end gap-2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Disabled="_saving"
                                   OnClick="GoBack"
                                   Class="oh-btn oh-btn--secondary">
                            إلغاء
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="_saving"
                                   OnClick="SaveAsync"
                                   Class="oh-btn oh-btn--primary">

                            @if (_saving)
                            {
                                <MudProgressCircular Indeterminate="true"
                                                     Size="Size.Small"
                                                     Class="me-2" />

                                <span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <span>حفظ التعديلات</span>
                            }

                        </MudButton>
                    </div>
                </section>

            </div>

        </MudForm>
    }
</div>

@code {

    // ============================================================
    // State
    // ============================================================

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("إدارة المستخدمين", "/admin/users"),
        new("تعديل المستخدم")
    ];

    [Parameter]
    public int UserId { get; set; }

    private MudForm? _form;

    private readonly UserFormModel _model = new();

    private IReadOnlyList<RoleListItem> _roles = [];

    private IReadOnlyList<RoleListItem> SealedRoles =>
        _roles.Where(role => role.IsSealed).ToList();

    private IReadOnlyList<RoleListItem> CustomRoles =>
        _roles.Where(role => !role.IsSealed).ToList();

    private RoleListItem? SelectedRole =>
        _model.RoleId.HasValue
            ? _roles.FirstOrDefault(role => role.Id == _model.RoleId.Value)
            : null;

    private DateTime _createdAt;

    private string? _loadError;

    private string? _saveError;

    private bool _loading = true;

    private bool _saving;

    private bool _found;

    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    // ============================================================
    // Loading
    // ============================================================

    private async Task LoadAsync()
    {
        _loading = true;
        _found = false;
        _loadError = null;
        _saveError = null;

        try
        {
            Task<GetUserResponse?> userTask =
                RequestExecutor.ExecuteAsync(
                    new GetUserQuery(UserId));

            Task<IReadOnlyList<RoleListItem>> rolesTask =
                RequestExecutor.ExecuteAsync(
                    new GetRolesQuery());

            await Task.WhenAll(
                userTask,
                rolesTask);

            GetUserResponse? user = await userTask;

            _roles = await rolesTask;

            if (user is null)
            {
                return;
            }

            _model.UserName = user.UserName;
            _model.DisplayName = user.DisplayName;
            _model.IsActive = user.IsActive;
            _model.IsAdmin = user.IsAdmin;
            _model.RoleId = user.RoleId;

            _createdAt = user.CreatedAt;

            _found = true;
        }
        catch (Exception)
        {
            _loadError = "تعذر تحميل بيانات المستخدم.";
            Snackbar.Add(
                "تعذر تحميل بيانات المستخدم.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ============================================================
    // Save
    // ============================================================

    private async Task SaveAsync()
    {
        if (_saving || _form is null)
            return;

        await _form.ValidateAsync();

        if (!_form.IsValid)
            return;

        try
        {
            _saving = true;
            _saveError = null;

            var request = new UpdateUserRequest(
                _model.UserName.Trim(),
                _model.DisplayName.Trim(),
                _model.IsActive,
                _model.IsAdmin,
                _model.RoleId);

            Result result = await RequestExecutor.ExecuteAsync(
                new UpdateUserCommand(
                    UserId,
                    request));

            if (!result.IsSuccess)
            {
                _saveError = result.ErrorMessage;
                return;
            }

            Snackbar.Add(
                "تم حفظ تعديلات المستخدم بنجاح.",
                Severity.Success);

            NavigationManager.NavigateTo(
                "/admin/users");
        }
        catch (Exception)
        {
            _saveError = "حدث خطأ أثناء حفظ بيانات المستخدم. يرجى المحاولة مرة أخرى.";
            Snackbar.Add(
                "حدث خطأ أثناء حفظ بيانات المستخدم.",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // ============================================================
    // Navigation
    // ============================================================

    private void GoBack()
    {
        NavigationManager.NavigateTo(
            "/admin/users");
    }

    // ============================================================
    // Form model
    // ============================================================

    private sealed class UserFormModel
    {
        public string UserName { get; set; } = string.Empty;

        public string DisplayName { get; set; } = string.Empty;

        public bool IsActive { get; set; }

        public bool IsAdmin { get; set; }

        public int? RoleId { get; set; }
    }
}
