@page "/admin/users"
@attribute [PermissionAuthorize(PermissionFeature.Users, PermissionLevel.Read)]
@attribute [HigherManagerAuthorize]

@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using OrderHub.Application.Features.Administration.Users.GetUsers
@using OrderHub.Application.Features.Administration.Users.ActivateUser
@using OrderHub.Application.Features.Administration.Users.DeactivateUser
@using OrderHub.Application.Interfaces
@using OrderHub.Domain.Common
@using MudBlazor

@inject IRequestExecutor RequestExecutor
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>إدارة المستخدمين</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="إدارة المستخدمين"
                  Description="إدارة حسابات المستخدمين والأدوار وحالة الحساب"
                  Crumbs="_scaffoldCrumbs"
                  Count="@_users.Count">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Class="oh-btn oh-btn--primary"
                       StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="CreateUser"
                       Disabled="IsBusy">
                مستخدم جديد
            </MudButton>
        </Actions>
    </PageScaffold>

    @* Stats bar: real numbers derived from the loaded list *@
    <section aria-label="إحصائيات المستخدمين"
             class="grid grid-cols-2 gap-4 xl:grid-cols-4">

        <article class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">إجمالي المستخدمين</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">@Fmt(TotalUsers)</p>
                    <p class="text-xs font-medium text-slate-500">جميع الحسابات المسجلة</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.People" aria-hidden="true" />
                </span>
            </div>
        </article>

        <article class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">مستخدمون نشطون</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">@Fmt(ActiveUsers)</p>
                    <p class="text-xs font-medium text-slate-500">حسابات مفعلة حاليًا</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" aria-hidden="true" />
                </span>
            </div>
        </article>

        <article class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">مديرون أعلى</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">@Fmt(AdminUsers)</p>
                    <p class="text-xs font-medium text-slate-500">حسابات بوصول كامل</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" aria-hidden="true" />
                </span>
            </div>
        </article>

        <article class="h-full rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">الأدوار المستخدمة</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">@Fmt(RoleCount)</p>
                    <p class="text-xs font-medium text-slate-500">
                        @Fmt(SealedRoleCount) جاهزة · @Fmt(CustomRoleCount) مخصصة
                    </p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-rose-50 text-rose-600">
                    <MudIcon Icon="@Icons.Material.Filled.Workspaces" aria-hidden="true" />
                </span>
            </div>
        </article>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-wrap items-center gap-3 border-b border-slate-100 px-4 py-3">

            <MudTextField T="string"
                          @bind-Value="_searchTerm"
                          Placeholder="ابحث باسم المستخدم أو الاسم..."
                          aria-label="البحث عن مستخدم"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Clearable="true"
                          Class="w-full max-w-xs" />

            <MudSelect T="UserStatusFilter"
                       @bind-Value="_statusFilter"
                       aria-label="تصفية حسب حالة الحساب"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="w-full sm:w-44">
                <MudSelectItem Value="@UserStatusFilter.All">جميع الحالات</MudSelectItem>
                <MudSelectItem Value="@UserStatusFilter.Active">نشط</MudSelectItem>
                <MudSelectItem Value="@UserStatusFilter.Inactive">غير نشط</MudSelectItem>
            </MudSelect>

            <MudSelect T="int?"
                       @bind-Value="_roleId"
                       aria-label="تصفية حسب الدور"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Class="w-full sm:w-52">
                @foreach (var role in AvailableRoles)
                {
                    <MudSelectItem T="int?"
                                   Value="@role.Id">
                        @role.Name
                    </MudSelectItem>
                }
            </MudSelect>

            <div class="flex-1"></div>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="IsBusy"
                           aria-label="تحديث القائمة"
                           OnClick="LoadAsync"
                           Class="oh-btn oh-btn--icon oh-btn--secondary oh-btn--sm" />
        </div>

        <MudTable T="UserListItem"
                  Items="FilteredUsers"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Square="true"
                  Breakpoint="Breakpoint.Sm"
                  Loading="_loading"
                  @bind-CurrentPage="_currentPage"
                  @bind-RowsPerPage="_rowsPerPage">

            <HeaderContent>
                <MudTh Class="text-xs font-bold text-slate-500">
                    المستخدم
                </MudTh>

                <MudTh Class="text-xs font-bold text-slate-500">
                    الاسم
                </MudTh>

                <MudTh Class="text-xs font-bold text-slate-500">
                    الدور
                </MudTh>

                <MudTh Class="text-xs font-bold text-slate-500">
                    النوع
                </MudTh>

                <MudTh Class="text-xs font-bold text-slate-500">
                    الحالة
                </MudTh>

                <MudTh Class="text-xs font-bold text-slate-500">
                    تاريخ الإنشاء
                </MudTh>

                <MudTh Class="w-20 text-xs font-bold text-slate-500">
                    <span class="sr-only">إجراءات</span>
                </MudTh>
            </HeaderContent>

            <RowTemplate Context="user">
                <MudTd DataLabel="المستخدم"
                       Class="text-sm text-slate-700">
                    <div class="flex items-center gap-2.5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                        </span>
                        <span class="font-bold text-slate-900">@user.UserName</span>
                    </div>
                </MudTd>

                <MudTd DataLabel="الاسم"
                       Class="text-sm text-slate-700"
                       Style="overflow-wrap:anywhere">
                    @user.DisplayName
                </MudTd>

                <MudTd DataLabel="الدور">
                    @if (user.RoleId.HasValue)
                    {
                        <span class="inline-flex items-center gap-1.5">
                            <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                                @user.RoleName
                            </span>
                            @if (user.IsRoleSealed)
                            {
                                <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700">
                                    جاهز
                                </span>
                            }
                        </span>
                    }
                    else if (user.IsAdmin)
                    {
                        <span class="text-sm text-slate-400">—</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-bold text-amber-700">
                            بدون دور — لا صلاحيات
                        </span>
                    }
                </MudTd>

                <MudTd DataLabel="النوع">
                    @if (user.IsAdmin)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" />
                            مدير أعلى
                        </span>
                    }
                    else
                    {
                        <span class="text-sm text-slate-500">مستخدم</span>
                    }
                </MudTd>

                <MudTd DataLabel="الحالة">
                    @if (user.IsActive)
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                            نشط
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-500">
                            <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                            غير نشط
                        </span>
                    }
                </MudTd>

                <MudTd DataLabel="تاريخ الإنشاء"
                       Class="text-sm text-slate-700">
                    <span class="tabular-nums" style="direction:ltr">
                        @user.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd", CultureInfo.InvariantCulture)
                    </span>
                </MudTd>

                <MudTd DataLabel="إجراءات">
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             Size="Size.Small"
                             AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Disabled="IsBusy"
                             aria-label="إجراءات المستخدم">

                        <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                     OnClick="@(() => EditUser(user.Id))">
                            تعديل
                        </MudMenuItem>

                        @if (user.IsActive)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.PersonOff"
                                         OnClick="@(() => ConfirmDeactivateAsync(user))">
                                تعطيل الحساب
                            </MudMenuItem>
                        }
                        else
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Person"
                                         OnClick="@(() => ActivateAsync(user))">
                                تفعيل الحساب
                            </MudMenuItem>
                        }

                    </MudMenu>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <div class="py-8 text-center">
                    <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                        <MudIcon Icon="@Icons.Material.Filled.PeopleOutline" aria-hidden="true" />
                    </span>
                    <p class="text-base font-bold text-slate-900">
                        @if (HasFilters)
                        {
                            @:لا توجد نتائج مطابقة لمعايير البحث.
                        }
                        else
                        {
                            @:لم تتم إضافة مستخدمين بعد.
                        }
                    </p>
                    <p class="mt-1 text-sm text-slate-500">
                        @if (HasFilters)
                        {
                            @:جرّب تعديل البحث أو التصفية للحصول على نتائج.
                        }
                        else
                        {
                            @:أضف أول مستخدم ليظهر في الجدول أعلاه.
                        }
                    </p>
                </div>
            </NoRecordsContent>

            <LoadingContent>
                <div class="flex flex-col items-center gap-2 py-8">
                    <MudProgressCircular Indeterminate="true"
                                         Color="Color.Primary" />
                    <p class="text-sm text-slate-500">جاري تحميل المستخدمين...</p>
                </div>
            </LoadingContent>

            <PagerContent>
                <TableFooter TotalItems="@(FilteredUsers.Count)"
                             CurrentPage="@FooterCurrentPage"
                             CurrentPageChanged="OnFooterPageChanged"
                             RowsPerPage="@_rowsPerPage"
                             RowsPerPageChanged="OnFooterRowsPerPageChanged" />
            </PagerContent>

        </MudTable>
    </section>
</div>

@code
{
    private IReadOnlyList<UserListItem> _users = [];

    private string? _searchTerm;

    private UserStatusFilter _statusFilter = UserStatusFilter.All;

    private int? _roleId;

    private bool _loading = true;

    private bool _statusChanging;

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("إدارة المستخدمين")
    ];

    private int _currentPage;
    private int _rowsPerPage = 10;

    /// <summary>مجدد PageScaffold (1-based) مقابل CurrentPage (0-based) في MudTable.</summary>
    private int FooterCurrentPage => _currentPage + 1;

    private bool IsBusy =>
        _loading || _statusChanging;

    // ============================================================
    // Stats (derived from the loaded list — real numbers)
    // ============================================================

    private int TotalUsers => _users.Count;

    private int ActiveUsers => _users.Count(user => user.IsActive);

    private int AdminUsers => _users.Count(user => user.IsAdmin);

    private int RoleCount =>
        _users
            .Where(user => user.RoleId.HasValue)
            .Select(user => user.RoleId!.Value)
            .Distinct()
            .Count();

    private int SealedRoleCount =>
        _users
            .Where(user => user.RoleId.HasValue && user.IsRoleSealed)
            .Select(user => user.RoleId!.Value)
            .Distinct()
            .Count();

    private int CustomRoleCount =>
        _users
            .Where(user => user.RoleId.HasValue && !user.IsRoleSealed)
            .Select(user => user.RoleId!.Value)
            .Distinct()
            .Count();

    private static string Fmt(int value) =>
        value.ToString("N0", CultureInfo.InvariantCulture);

    // ============================================================
    // Lifecycle
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    // ============================================================
    // Data
    // ============================================================

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;

            _users = await RequestExecutor.ExecuteAsync(
                new GetUsersQuery());

            _currentPage = 0;
        }
        catch (Exception)
        {
            Snackbar.Add(
                "تعذر تحميل المستخدمين.",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ============================================================
    // Filtering
    // ============================================================

    private IReadOnlyList<UserListItem> FilteredUsers
    {
        get
        {
            IEnumerable<UserListItem> query = _users;

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                string searchTerm = _searchTerm.Trim();

                query = query.Where(user =>
                    user.UserName.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase) ||
                    user.DisplayName.Contains(
                        searchTerm,
                        StringComparison.OrdinalIgnoreCase));
            }

            query = _statusFilter switch
            {
                UserStatusFilter.Active =>
                    query.Where(user => user.IsActive),

                UserStatusFilter.Inactive =>
                    query.Where(user => !user.IsActive),

                _ => query
            };

            if (_roleId.HasValue)
            {
                query = query.Where(
                    user => user.RoleId == _roleId.Value);
            }

            return query.ToList();
        }
    }

    private IReadOnlyList<RoleFilterItem> AvailableRoles =>
        _users
            .Where(user =>
                user.RoleId.HasValue &&
                !string.IsNullOrWhiteSpace(user.RoleName))
            .GroupBy(user => user.RoleId!.Value)
            .Select(group => new RoleFilterItem(
                group.Key,
                group.First().RoleName!))
            .OrderBy(role => role.Name)
            .ToList();

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        _statusFilter != UserStatusFilter.All ||
        _roleId.HasValue;

    // ============================================================
    // Footer paging (TableFooter is 1-based, MudTable is 0-based)
    // ============================================================

    private Task OnFooterPageChanged(int page)
    {
        _currentPage = page - 1;
        return Task.CompletedTask;
    }

    private Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _rowsPerPage = rowsPerPage;
        _currentPage = 0;
        return Task.CompletedTask;
    }

    // ============================================================
    // Navigation
    // ============================================================

    private void CreateUser()
    {
        NavigationManager.NavigateTo(
            "/admin/users/create");
    }

    private void EditUser(int userId)
    {
        NavigationManager.NavigateTo(
            $"/admin/users/{userId}/edit");
    }

    // ============================================================
    // Activate
    // ============================================================

    private async Task ActivateAsync(
        UserListItem user)
    {
        if (IsBusy)
        {
            return;
        }

        _statusChanging = true;

        try
        {
            Result result = await RequestExecutor.ExecuteAsync(
                new ActivateUserCommand(user.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(
                    result.ErrorMessage,
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                $"تم تفعيل حساب {user.DisplayName}.",
                Severity.Success);

            await LoadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(
                "تعذر تفعيل المستخدم.",
                Severity.Error);
        }
        finally
        {
            _statusChanging = false;
        }
    }

    // ============================================================
    // Deactivate
    // ============================================================

    private async Task ConfirmDeactivateAsync(
        UserListItem user)
    {
        if (IsBusy)
        {
            return;
        }

        _statusChanging = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "تعطيل المستخدم",
                $"هل تريد تعطيل حساب \"{user.DisplayName}\"؟",
                yesText: "تعطيل",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            await DeactivateCoreAsync(user);
        }
        finally
        {
            _statusChanging = false;
        }
    }

    private async Task DeactivateCoreAsync(
        UserListItem user)
    {
        try
        {
            Result result = await RequestExecutor.ExecuteAsync(
                new DeactivateUserCommand(user.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(
                    result.ErrorMessage,
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                $"تم تعطيل حساب {user.DisplayName}.",
                Severity.Success);

            await LoadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(
                "تعذر تعطيل المستخدم.",
                Severity.Error);
        }
    }

    // ============================================================
    // Local UI Types
    // ============================================================

    private enum UserStatusFilter
    {
        All,
        Active,
        Inactive
    }

    private sealed record RoleFilterItem(
        int Id,
        string Name);
}
