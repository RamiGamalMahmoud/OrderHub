@page "/cities"

@attribute [PermissionAuthorize(
    PermissionFeature.Cities,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>المدن</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="المدن"
                  Description="إدارة المدن المتاحة في النظام"
                  Crumbs="_scaffoldCrumbs"
                  Count="@_cities.Count">
        <Actions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="rounded-xl px-5 font-bold shadow-sm"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="IsBusy"
                           OnClick="OpenCreateDialogAsync">
                    إضافة مدينة
                </MudButton>
            }
        </Actions>
    </PageScaffold>

    @if (_loading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary" />
            <p class="mt-2 text-sm text-slate-500">جاري تحميل المدن...</p>
        </div>
    }
    else if (_error is not null)
    {
        <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
            <MudAlert Severity="Severity.Error"
                      Dense="true">
                @_error
            </MudAlert>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="mt-3"
                       OnClick="LoadAsync">
                إعادة المحاولة
            </MudButton>
        </div>
    }
    else if (_cities.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                <MudIcon Icon="@Icons.Material.Filled.LocationCity" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">لم تتم إضافة مدن بعد.</p>
            <p class="mt-1 text-sm text-slate-500">أضف أول مدينة لتظهر في الجدول أعلاه.</p>
        </div>
    }
    else
    {
        <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="ابحث عن مدينة..."
                              aria-label="البحث عن مدينة"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Class="w-full max-w-xs" />

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="IsBusy"
                               aria-label="تحديث القائمة"
                               OnClick="LoadAsync"
                               Class="rounded-lg" />
            </div>

            <MudTable T="CityListItem"
                      Items="FilteredCities"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Square="true"
                      Breakpoint="Breakpoint.Sm"
                      @bind-CurrentPage="_currentPage"
                      @bind-RowsPerPage="_rowsPerPage">
                <HeaderContent>
                    <MudTh Class="text-xs font-bold text-slate-500">
                        اسم المدينة
                    </MudTh>

                    @if (_canWrite)
                    {
                        <MudTh Class="w-24 text-xs font-bold text-slate-500">
                            <span class="sr-only">الإجراءات</span>
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate Context="city">
                    <MudTd DataLabel="اسم المدينة" Style="overflow-wrap:anywhere">
                        <div class="flex items-center gap-2.5">
                            <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-sm font-black text-brand-600">
                                @FirstLetter(city.Name)
                            </span>
                            <span class="text-sm font-bold text-slate-900">@city.Name</span>
                        </div>
                    </MudTd>

                    @if (_canWrite)
                    {
                        <MudTd DataLabel="الإجراءات">
                            <div class="flex items-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Disabled="IsBusy"
                                               aria-label="تعديل المدينة"
                                               OnClick="@(() => OpenEditDialogAsync(city))" />

                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="IsBusy"
                                               aria-label="حذف المدينة"
                                               OnClick="@(() => ConfirmDeleteAsync(city))" />
                            </div>
                        </MudTd>
                    }
                </RowTemplate>

                <NoRecordsContent>
                    <div class="py-6 text-center text-sm text-slate-500">
                        لا توجد مدن تطابق البحث.
                    </div>
                </NoRecordsContent>

                <PagerContent>
                    <TableFooter TotalItems="@(FilteredCities.Count())"
                                 CurrentPage="@FooterCurrentPage"
                                 CurrentPageChanged="OnFooterPageChanged"
                                 RowsPerPage="@_rowsPerPage"
                                 RowsPerPageChanged="OnFooterRowsPerPageChanged" />
                </PagerContent>
            </MudTable>
        </section>
    }
</div>

@code
{
    private IReadOnlyList<CityListItem> _cities = [];
    private string? _searchTerm;
    private string? _error;
    private bool _loading = true;
    private bool _canWrite;
    private bool _dialogOpen;
    private bool _deleting;

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("المدن")
    ];

    private int _currentPage;
    private int _rowsPerPage = 10;

    /// <summary>مجدد PageScaffold (1-based) مقابل CurrentPage (0-based) في MudTable.</summary>
    private int FooterCurrentPage => _currentPage + 1;

    private bool CanCreate =>
        _canWrite && !_loading && _error is null;

    private bool IsBusy =>
        _loading || _dialogOpen || _deleting;

    private IEnumerable<CityListItem> FilteredCities
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _cities;
            }

            string searchTerm = _searchTerm.Trim();

            return _cities.Where(city =>
                city.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
    }

    private static string FirstLetter(string name)
    {
        string trimmed = name.Trim();

        return trimmed.Length == 0 ? "—" : trimmed[..1];
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _canWrite = false;
        _error = null;
        _currentPage = 0;

        try
        {
            var cities = await RequestExecutor.ExecuteAsync(new GetAllCitiesQuery());
            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Cities,
                PermissionLevel.Write);

            _cities = cities.ToList();
            _canWrite = canWrite;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load cities");
            _error = "تعذر تحميل المدن. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnFooterPageChanged(int page)
    {
        _currentPage = page - 1;
        return Task.CompletedTask;
    }

    private Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _rowsPerPage = rowsPerPage;
        _currentPage = 0;
        return Task.CompletedTask;
    }

    private Task OpenCreateDialogAsync() => OpenEditorAsync(null);

    private Task OpenEditDialogAsync(CityListItem city) => OpenEditorAsync(city.Id);

    private async Task OpenEditorAsync(int? cityId)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _dialogOpen = true;

        try
        {
            DialogParameters<CityEditorDialog> parameters = new()
            {
                { dialog => dialog.CityId, cityId }
            };

            DialogOptions options = new()
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                CloseButton = false,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };

            string title = cityId.HasValue ? "تعديل المدينة" : "إضافة مدينة";

            var dialog = await DialogService.ShowAsync<CityEditorDialog>(
                title,
                parameters,
                options);

            DialogResult? result = await dialog.Result;

            if (result is { Canceled: false, Data: true })
            {
                await LoadAsync();
            }
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to open city editor for {CityId}",
                cityId);

            Snackbar.Add(
                "تعذر فتح بيانات المدينة. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _dialogOpen = false;
        }
    }

    private async Task ConfirmDeleteAsync(CityListItem city)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف المدينة",
                $"هل تريد حذف المدينة \"{city.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            Result result = await RequestExecutor.ExecuteAsync(new DeleteCityCommand(city.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add("تم حذف المدينة بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete city {CityId}",
                city.Id);

            Snackbar.Add(
                "تعذر حذف المدينة. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
