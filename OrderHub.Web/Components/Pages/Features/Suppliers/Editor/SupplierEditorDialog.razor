@inject IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<SupplierEditorDialog> Logger

<MudDialog Class="flex max-h-[92vh] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl max-w-[40rem] w-full"
           TitleClass="p-0"
           ContentClass="p-0"
           ActionsClass="p-0"
           Gutters="false">
    <TitleContent>
        <header class="flex items-center justify-between gap-3 border-b border-slate-100 p-5">
            <div class="flex min-w-0 items-center gap-3">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-blue-100 bg-blue-50 text-blue-600">
                    <MudIcon Icon="@(SupplierId.HasValue ? Icons.Material.Filled.Edit : Icons.Material.Filled.Storefront)"
                             Size="Size.Small" />
                </span>
                <div class="min-w-0">
                    <h2 class="text-lg font-bold leading-tight text-slate-900">@DialogTitle</h2>
                    <p class="mt-1 text-xs font-medium text-slate-500">
                        بيانات التواصل ومواعيد العمل والمنتجات المرتبطة بالمورد
                    </p>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           Disabled="_saving"
                           OnClick="Cancel"
                           aria-label="إغلاق النافذة"
                           Class="oh-btn oh-btn--icon oh-btn--sm oh-btn--ghost" />
        </header>
    </TitleContent>

    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true"
                               Color="Color.Primary" />

            <MudText Typo="Typo.body2" Class="p-6 text-sm text-slate-500">
                جاري تحميل بيانات المورد...
            </MudText>
        }
        else if (_loadError is not null)
        {
            <div class="space-y-3 p-6">
                <MudAlert Severity="Severity.Error"
                          Dense="true">
                    @_loadError
                </MudAlert>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="LoadAsync"
                           Class="oh-btn oh-btn--secondary oh-btn--sm">
                    إعادة المحاولة
                </MudButton>
            </div>
        }
        else
        {
            <MudForm @ref="_form">
                <div class="min-h-0 flex-1 space-y-5 overflow-y-auto bg-slate-50/70 p-5">

                    <section class="rounded-xl border border-slate-200/85 bg-white p-5 shadow-xs">
                        <div class="mb-4 flex items-center gap-2.5">
                            <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                            </span>
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">بيانات المورد</h3>
                                <p class="mt-0.5 text-xs text-slate-500">بيانات التواصل وموقع المورد.</p>
                            </div>
                        </div>

                        <div class="space-y-4">
                            @if (_saveError is not null)
                            {
                                <MudAlert Severity="Severity.Error"
                                          Dense="true">
                                    @_saveError
                                </MudAlert>
                            }

                            <MudTextField T="string"
                                          @bind-Value="_state.Name"
                                          Label="اسم المورد"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="اسم المورد مطلوب."
                                          MaxLength="100"
                                          Validation="@(new Func<string, string?>(SupplierEditorState.ValidateName))"
                                          Immediate="true"
                                          Disabled="_saving" />

                            @if (_cities.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info"
                                          Dense="true">
                                    لا توجد مدن متاحة. يرجى إضافة مدينة أولًا ثم إعادة المحاولة.
                                </MudAlert>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           OnClick="LoadAsync"
                                           Disabled="_saving"
                                           Class="oh-btn oh-btn--secondary oh-btn--sm">
                                    إعادة المحاولة
                                </MudButton>
                            }

                            <MudSelect T="int?"
                                       @bind-Value="_state.CityId"
                                       Label="المدينة"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Required="true"
                                       RequiredError="اختر المدينة."
                                       Disabled="_saving">
                                @foreach (var city in _cities)
                                {
                                    <MudSelectItem T="int?"
                                                   Value="@((int?)city.Id)">
                                        @city.Name
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField T="string"
                                          @bind-Value="_state.Street"
                                          Label="العنوان"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true"
                                          RequiredError="العنوان مطلوب."
                                          MaxLength="150"
                                          Disabled="_saving" />

                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-4">
                                <div class="sm:col-span-1">
                                    <MudTextField T="string"
                                                  @bind-Value="_state.CountryCode"
                                                  Label="مفتاح الدولة"
                                                  Placeholder="+20 أو +966"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Required="true"
                                                  RequiredError="مفتاح الدولة مطلوب."
                                                  MaxLength="4"
                                                  Validation="@(new Func<string, string?>(_state.ValidateCountryCode))"
                                                  Immediate="true"
                                                  Disabled="_saving" />
                                </div>

                                <div class="sm:col-span-3">
                                    <MudTextField T="string"
                                                  @bind-Value="_state.PhoneNumber"
                                                  Label="رقم الهاتف"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Required="true"
                                                  RequiredError="رقم الهاتف مطلوب."
                                                  MaxLength="14"
                                                  Validation="@(new Func<string, string?>(_state.ValidatePhone))"
                                                  Immediate="true"
                                                  Disabled="_saving" />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="rounded-xl border border-slate-200/85 bg-white p-5 shadow-xs">
                        <div class="mb-4 flex items-center justify-between gap-2.5">
                            <div class="flex items-center gap-2.5">
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                    <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" />
                                </span>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">مواعيد العمل</h3>
                                    <p class="mt-0.5 text-xs text-slate-500">أوقات استقبال التوريدات.</p>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <MudTimePicker @bind-Time="_state.OpenAt"
                                           Label="وقت الافتتاح"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           Disabled="_saving" />

                            <MudTimePicker @bind-Time="_state.CloseAt"
                                           Label="وقت الإغلاق"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Editable="true"
                                           Disabled="_saving" />
                        </div>
                    </section>

                    <section class="rounded-xl border border-slate-200/85 bg-white p-5 shadow-xs">
                        <div class="mb-4 flex items-center justify-between gap-2.5">
                            <div class="flex items-center gap-2.5">
                                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                                </span>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">المنتجات المرتبطة</h3>
                                    <p class="mt-0.5 text-xs text-slate-500">اختيار المنتجات اختياري؛ تبقى المنتجات المحددة مرتبطة بالمورد.</p>
                                </div>
                            </div>

                            <span class="inline-flex shrink-0 items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">
                                @(string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{_state.ProductIds.Count} منتج"))
                            </span>
                        </div>

                        <div class="space-y-3">
                            <MudTextField T="string"
                                          @bind-Value="_productSearch"
                                          Placeholder="ابحث عن منتج"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          Immediate="true"
                                          Clearable="true"
                                          Margin="Margin.Dense"
                                          Disabled="_saving" />

                            @if (_products.Count == 0)
                            {
                                <p class="py-2 text-sm text-slate-500">لا توجد منتجات متاحة.</p>
                            }

                            <div class="divide-y divide-slate-100 rounded-lg border border-slate-100">
                                @foreach (var product in VisibleProducts)
                                {
                                    <MudCheckBox T="bool"
                                                 Value="@_state.ProductIds.Contains(product.Id)"
                                                 Class="checkbox-between w-full p-3"
                                                 Size="Size.Small"
                                                 ValueChanged="@(value => SetProduct(product.Id, value))"
                                                 Label="@product.Name"
                                                 Dense="true"
                                                 Disabled="_saving || _state.IsProductLocked(product.Id)" />
                                }
                            </div>

                            @if (ProductPages > 1)
                            {
                                <MudPagination Count="ProductPages"
                                               Rectangular="true"
                                               Selected="_productPage"
                                               SelectedChanged="SetProductPage"
                                               Disabled="_saving"
                                               Class="justify-center" />
                            }
                        </div>
                    </section>
                </div>
            </MudForm>
        }
    </DialogContent>

    <DialogActions>
        <footer class="flex items-center justify-between gap-3 border-t border-slate-100 bg-white p-4">
            <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
                <span class="inline-flex h-2.5 w-2.5 rounded-full @(SaveDisabled ? "bg-slate-300" : "bg-emerald-500")"></span>
                <span>@(SaveDisabled ? "غير جاهز للحفظ" : "جاهز للحفظ")</span>
            </div>

            <div class="flex items-center gap-2">
                <MudButton Disabled="_saving"
                           OnClick="Cancel"
                           Variant="Variant.Text"
                           Class="oh-btn oh-btn--secondary">
                    إلغاء
                </MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="SaveDisabled"
                           OnClick="SaveAsync"
                           StartIcon="@Icons.Material.Filled.Save"
                           Class="oh-btn oh-btn--primary">
                    @SaveButtonText
                </MudButton>
            </div>
        </footer>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int? SupplierId { get; set; }

    [Parameter]
    public int? PreselectedProductId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private SupplierEditorState _state = new();
    private MudForm? _form;
    private IReadOnlyList<CityInfo> _cities = [];
    private IReadOnlyList<ProductInfo> _products = [];
    private string? _productTerm;
    private int _productPage = 1;
    private string? _loadError;
    private string? _saveError;
    private bool _loading = true;
    private bool _saving;

    private string? _productSearch
    {
        get => _productTerm;
        set
        {
            _productTerm = value;
            _productPage = 1;
        }
    }

    private IEnumerable<ProductInfo> MatchingProducts =>
        _products.Where(product => Matches(product.Name, _productTerm));

    private IEnumerable<ProductInfo> VisibleProducts =>
        MatchingProducts.Skip((_productPage - 1) * 8).Take(8);

    private int ProductPages => Math.Max(1, (MatchingProducts.Count() + 7) / 8);

    private static bool Matches(string name, string? term) =>
        string.IsNullOrWhiteSpace(term) || name.Contains(term.Trim(), StringComparison.OrdinalIgnoreCase);

    private string DialogTitle =>
        SupplierId.HasValue
            ? "تعديل المورد"
            : "إضافة مورد";

    private string SaveButtonText
    {
        get
        {
            if (_saving)
            {
                return "جاري الحفظ...";
            }

            return SupplierId.HasValue ? "حفظ التعديلات" : "إضافة";
        }
    }

    private bool SaveDisabled =>
        _loading || _saving || _loadError is not null || _cities.Count == 0;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _saveError = null;
        _state = new SupplierEditorState(PreselectedProductId);

        try
        {
            if (SupplierId is int supplierId)
            {
                var supplier = await RequestExecutor.ExecuteAsync(new GetSupplierForEditQuery(supplierId));

                if (supplier is null)
                {
                    _loadError = "تعذر العثور على المورد المطلوب.";
                    return;
                }

                _state = SupplierEditorState.FromRead(supplier, PreselectedProductId);
            }

            var cities = await RequestExecutor.ExecuteAsync(new GetSupplierEditorCitiesQuery());
            _cities = cities.OrderBy(city => city.Name).ThenBy(city => city.Id).ToList();

            var products = await RequestExecutor.ExecuteAsync(new GetSupplierEditorProductsQuery());
            _products = products.OrderBy(product => product.Name).ThenBy(product => product.Id).ToList();
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to load supplier {SupplierId}",
                SupplierId);

            _loadError = "تعذر تحميل بيانات المورد. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Cancel()
    {
        if (_saving)
        {
            return;
        }

        MudDialog.Cancel();
    }

    private async Task SaveAsync()
    {
        if (SaveDisabled || _form is null)
        {
            return;
        }

        _saving = true;
        _saveError = null;

        try
        {
            await _form.ValidateAsync();

            if (!_form.IsValid)
            {
                return;
            }

            _saveError = _state.ValidateAdditional();

            if (_saveError is not null)
            {
                return;
            }

            Result<int> result;

            if (SupplierId is int supplierId)
            {
                result = await RequestExecutor.ExecuteAsync(
                    _state.UpdateCommand(supplierId));
            }
            else
            {
                result = await RequestExecutor.ExecuteAsync(
                    _state.CreateCommand());
            }

            if (!result.IsSuccess)
            {
                _saveError = result.ErrorMessage;
                return;
            }

            Snackbar.Add("تم حفظ المورد بنجاح.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result.Value));
        }
        catch (AuthorizationDeniedException)
        {
            MudDialog.Cancel();
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to save supplier {SupplierId}",
                SupplierId);

            _saveError = "تعذر حفظ المورد. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void SetProduct(int productId, bool selected)
    {
        if (_saving)
        {
            return;
        }

        _state.SetProduct(productId, selected);
    }

    private void SetProductPage(int page) => _productPage = page;
}
