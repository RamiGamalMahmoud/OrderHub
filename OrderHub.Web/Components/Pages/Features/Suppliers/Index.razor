@page "/suppliers"

@attribute [PermissionAuthorize(
    PermissionFeature.Suppliers,
    PermissionLevel.Read)]

@inject IRequestExecutor RequestExecutor
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>الموردون</PageTitle>

<div class="space-y-5">
    <PageScaffold Title="الموردون"
                  Description="إدارة الموردين المتاحين في النظام"
                  Crumbs="_scaffoldCrumbs"
                  Count="@_suppliers.Count">
        <Actions>
            @if (CanCreate)
            {
                <SupplierEditorButton ButtonText="إضافة مورد"
                                      Variant="Variant.Filled"
                                      Color="Color.Primary"
                                      Size="Size.Large"
                                      Class="rounded-xl px-5 font-bold shadow-sm"
                                      Disabled="IsBusy"
                                      OnSaved="LoadAsync" />
            }
        </Actions>
    </PageScaffold>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true"
                           Color="Color.Primary" />

        <MudText Typo="Typo.body2">
            جاري تحميل الموردين...
        </MudText>
    }
    else if (_error is not null)
    {
        <div class="rounded-2xl border border-red-100 bg-red-50 p-5">
            <MudAlert Severity="Severity.Error"
                      Dense="true">
                @_error
            </MudAlert>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="mt-3"
                       OnClick="LoadAsync">
                إعادة المحاولة
            </MudButton>
        </div>
    }
    else if (_suppliers.Count == 0)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
            <span class="mx-auto mb-3 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" aria-hidden="true" />
            </span>
            <p class="text-base font-bold text-slate-900">لم تتم إضافة موردين بعد.</p>
            <p class="mt-1 text-sm text-slate-500">أضف أول مورد ليظهر في الجدول أعلاه.</p>
        </div>
    }
    else
    {
        <!-- Unified table card: toolbar (search + refresh) + table + unified footer -->
        <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-4 py-3">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Placeholder="ابحث عن مورد..."
                              aria-label="البحث عن مورد"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Class="w-full max-w-xs" />

                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="IsBusy"
                               aria-label="تحديث القائمة"
                               OnClick="LoadAsync"
                               Class="rounded-lg" />
            </div>

            <MudTable T="SupplierListItem"
                      Items="FilteredSuppliers"
                      Dense="true"
                      Hover="true"
                      Elevation="0"
                      Square="true"
                      Breakpoint="Breakpoint.Sm"
                      @bind-CurrentPage="_currentPage"
                      @bind-RowsPerPage="_rowsPerPage">
                <HeaderContent>
                    <MudTh Class="text-xs font-bold text-slate-500">
                        اسم المورد
                    </MudTh>

                    <MudTh Class="text-xs font-bold text-slate-500">
                        الهاتف
                    </MudTh>

                    <MudTh Class="text-xs font-bold text-slate-500">
                        العنوان
                    </MudTh>

                    @if (_canWrite)
                    {
                        <MudTh Class="text-xs font-bold text-slate-500">
                            الإجراءات
                        </MudTh>
                    }
                </HeaderContent>

                <RowTemplate Context="supplier">
                    <MudTd DataLabel="اسم المورد"
                           Class="text-sm text-slate-700"
                           Style="overflow-wrap:anywhere">
                        @supplier.Name
                    </MudTd>

                    <MudTd DataLabel="الهاتف"
                           Class="text-sm text-slate-700"
                           Style="overflow-wrap:anywhere; direction:ltr">
                        @ContactText(supplier.PhoneNumber)
                    </MudTd>

                    <MudTd DataLabel="العنوان"
                           Class="text-sm text-slate-700"
                           Style="overflow-wrap:anywhere">
                        @ContactText(supplier.Address)
                    </MudTd>

                    @if (_canWrite)
                    {
                        <MudTd DataLabel="الإجراءات">
                            <div class="flex items-center">
                                <SupplierEditorButton SupplierId="supplier.Id"
                                                      Variant="Variant.Text"
                                                      Color="Color.Default"
                                                      StartIcon="@Icons.Material.Filled.Edit"
                                                      Disabled="IsBusy"
                                                      OnSaved="LoadAsync" />

                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Disabled="IsBusy"
                                               aria-label="حذف المورد"
                                               OnClick="@(() => ConfirmDeleteAsync(supplier))" />
                            </div>
                        </MudTd>
                    }
                </RowTemplate>

                <NoRecordsContent>
                    <div class="py-6 text-center text-sm text-slate-500">
                        لا توجد موردين تطابق البحث.
                    </div>
                </NoRecordsContent>

                <PagerContent>
                    <TableFooter TotalItems="@(FilteredSuppliers.Count())"
                                 CurrentPage="@FooterCurrentPage"
                                 CurrentPageChanged="OnFooterPageChanged"
                                 RowsPerPage="@_rowsPerPage"
                                 RowsPerPageChanged="OnFooterRowsPerPageChanged" />
                </PagerContent>
            </MudTable>
        </section>
    }

</div>

@code
{
    private IReadOnlyList<SupplierListItem> _suppliers = [];
    private string? _searchTerm;
    private string? _error;
    private bool _loading = true;
    private bool _canWrite;
    private bool _deleting;

    private static readonly PageScaffold.CrumbItem[] _scaffoldCrumbs =
    [
        new("الموردون")
    ];

    private int _currentPage;
    private int _rowsPerPage = 10;

    /// <summary>مجدد PageScaffold (1-based) مقابل CurrentPage (0-based) في MudTable.</summary>
    private int FooterCurrentPage => _currentPage + 1;

    private bool CanCreate =>
        _canWrite && !_loading && _error is null;

    private bool IsBusy =>
        _loading || _deleting;

    private IEnumerable<SupplierListItem> FilteredSuppliers
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_searchTerm))
            {
                return _suppliers;
            }

            string searchTerm = _searchTerm.Trim();

            return _suppliers.Where(supplier =>
                supplier.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (supplier.PhoneNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                (supplier.Address?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
        }
    }

    private static string ContactText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private Task OnFooterPageChanged(int page)
    {
        _currentPage = page - 1;
        return Task.CompletedTask;
    }

    private Task OnFooterRowsPerPageChanged(int rowsPerPage)
    {
        _rowsPerPage = rowsPerPage;
        _currentPage = 0;
        return Task.CompletedTask;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _canWrite = false;
        _error = null;

        try
        {
            var suppliers = await RequestExecutor.ExecuteAsync(new GetAllSuppliersQuery());
            bool canWrite = await PermissionAccess.IsAllowedAsync(
                PermissionFeature.Suppliers,
                PermissionLevel.Write);

            _suppliers = suppliers.ToList();
            _canWrite = canWrite;
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load suppliers");
            _error = "تعذر تحميل الموردين. يرجى المحاولة مرة أخرى.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ConfirmDeleteAsync(SupplierListItem supplier)
    {
        if (IsBusy || !_canWrite)
        {
            return;
        }

        _deleting = true;

        try
        {
            bool? confirmed = await DialogService.ShowMessageBoxAsync(
                "حذف المورد",
                $"هل تريد حذف المورد \"{supplier.Name}\"؟",
                yesText: "حذف",
                cancelText: "إلغاء");

            if (confirmed != true)
            {
                return;
            }

            Result result = await RequestExecutor.ExecuteAsync(new DeleteSupplierCommand(supplier.Id));

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage, Severity.Error);
                return;
            }

            Snackbar.Add("تم حذف المورد بنجاح.", Severity.Success);
            await LoadAsync();
        }
        catch (AuthorizationDeniedException)
        {
            Navigation.NavigateTo("/access-denied");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Failed to delete supplier {SupplierId}",
                supplier.Id);

            Snackbar.Add(
                "تعذر حذف المورد. يرجى المحاولة مرة أخرى.",
                Severity.Error);
        }
        finally
        {
            _deleting = false;
        }
    }
}
