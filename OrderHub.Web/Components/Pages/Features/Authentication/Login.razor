@page "/login"
@using System.Globalization
@using OrderHub.Web.Components.Layout
@layout StandaloneLayout

<PageTitle>تسجيل الدخول | OrderHub - نظام إدارة العمليات والطلبات</PageTitle>

<div class="relative flex min-h-dvh flex-col overflow-hidden bg-slate-50 text-slate-800 antialiased">

    @* ---------- Background: 32px grid + ambient glows ---------- *@
    <div aria-hidden="true"
         class="pointer-events-none absolute inset-0"
         style="background-image: linear-gradient(to right, rgba(226,232,240,0.45) 1px, transparent 1px), linear-gradient(to bottom, rgba(226,232,240,0.45) 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div aria-hidden="true"
         class="pointer-events-none absolute -top-[150px] start-[25%] h-[500px] w-[500px] rounded-full blur-[40px]"
         style="background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, rgba(255,255,255,0) 70%);"></div>
    <div aria-hidden="true"
         class="pointer-events-none absolute -bottom-[150px] end-[20%] h-[450px] w-[450px] rounded-full blur-[40px]"
         style="background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, rgba(255,255,255,0) 70%);"></div>

    @* ---------- Main ---------- *@
    <main class="relative z-10 flex flex-1 items-center justify-center px-4 py-8">
        <div class="w-full max-w-[480px]">

            @* ---------- Brand identity ---------- *@
            <div class="mb-7 text-center">
                <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-tr from-blue-700 via-brand-600 to-blue-500 shadow-xl shadow-blue-500/25">
                    <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                        <path d="m3.3 7 8.7 5 8.7-5"></path>
                        <path d="M12 22V12"></path>
                    </svg>
                </div>

                <div class="flex items-center justify-center gap-1.5 text-2xl font-bold tracking-tight">
                    <span class="text-slate-900">Hub</span><span class="text-brand-600">Order</span>
                </div>

                <p class="mt-1 text-xs font-semibold tracking-wide text-slate-500">
                    نظام إدارة العمليات والطلبات المتكامل
                </p>
            </div>

            @* ---------- Login card ---------- *@
            <div class="rounded-3xl border border-slate-200/90 bg-white p-8 shadow-[0_12px_40px_-10px_rgba(15,23,42,0.08)] sm:p-9">
                <div class="mb-6">
                    <h1 class="text-xl font-bold leading-snug text-slate-900">تسجيل الدخول</h1>
                    <p class="mt-1 text-xs leading-relaxed text-slate-500">
                        أدخل بيانات اعتماد حسابك للمتابعة إلى لوحة التحكم
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Error))
                {
                    <div class="mb-5 rounded-xl border border-rose-100 bg-rose-50 px-3.5 py-2.5" role="alert">
                        <p class="text-xs font-bold text-rose-800">اسم المستخدم أو كلمة المرور غير صحيحة.</p>
                    </div>
                }

                <form method="post" action="/auth/login" class="space-y-5">

                    @* ---------- Username ---------- *@
                    <div class="space-y-1.5">
                        <label for="username" class="flex items-center gap-1 text-xs font-semibold text-slate-700">
                            <span>اسم المستخدم</span>
                            <span class="text-rose-500">*</span>
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-400">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round"
                                     stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </span>

                            <input id="username"
                                   name="username"
                                   type="text"
                                   autocomplete="username"
                                   required
                                   placeholder="أدخل اسم المستخدم"
                                   class="w-full rounded-lg border border-slate-200 bg-slate-50/60 py-3 ps-11 pe-4 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 hover:bg-slate-50 focus:border-brand-600 focus:bg-white focus:ring-4 focus:ring-blue-100" />
                        </div>
                    </div>

                    @* ---------- Password ---------- *@
                    <div class="space-y-1.5">
                        <label for="password" class="flex items-center gap-1 text-xs font-semibold text-slate-700">
                            <span>كلمة المرور</span>
                            <span class="text-rose-500">*</span>
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-400">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round"
                                     stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </span>

                            <input id="password"
                                   name="password"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="current-password"
                                   required
                                   placeholder="أدخل كلمة المرور الخاصة بك"
                                   class="w-full rounded-lg border border-slate-200 bg-slate-50/60 py-3 ps-11 pe-11 text-sm text-slate-900 outline-none transition-all placeholder:text-slate-400 hover:bg-slate-50 focus:border-brand-600 focus:bg-white focus:ring-4 focus:ring-blue-100" />

                            <button type="button"
                                    aria-label="إظهار أو إخفاء كلمة المرور"
                                    class="absolute inset-y-0 end-0 flex items-center pe-3.5 text-slate-400 transition-colors hover:text-slate-600 focus:outline-none"
                                    @onclick="TogglePasswordVisibility">
                                @if (_showPassword)
                                {
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round"
                                         stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round"
                                         stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                        <path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                    </svg>
                                }
                            </button>
                        </div>
                    </div>

                    @* ---------- Remember me ---------- *@
                    <div class="flex items-center justify-between pt-1">
                        <label class="flex cursor-pointer select-none items-center gap-2">
                            <input id="remember"
                                   name="rememberMe"
                                   type="checkbox"
                                   value="true"
                                   class="h-4 w-4 cursor-pointer rounded border-slate-300 accent-brand-600" />
                            <span class="text-xs font-medium text-slate-600">تذكر تسجيل دخولي على هذا الجهاز</span>
                        </label>
                    </div>

                    @* ---------- Submit ---------- *@
                    <button type="submit"
                            class="oh-btn oh-btn--primary oh-btn--block group">
                        <span>تسجيل الدخول</span>
                        <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none"
                             stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                             viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </button>
                </form>

                @* ---------- Security note ---------- *@
                <div class="mt-6 flex items-center justify-center gap-1.5 border-t border-slate-100 pt-5 text-[11px] text-slate-400">
                    <svg class="h-3.5 w-3.5 text-emerald-500" fill="none" stroke="currentColor"
                         stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                    <span>جلستك محمية بمصادقة كوكيز آمنة</span>
                </div>
            </div>

            @* ---------- Support note ---------- *@
            <p class="mt-6 text-center text-xs text-slate-500">
                ليس لديك حساب بعد أو تواجه صعوبة بالدخول؟
                <span class="me-1 font-semibold text-brand-600">تواصل مع مسؤول النظام</span>
            </p>
        </div>
    </main>

    @* ---------- Footer ---------- *@
    <footer class="relative z-10 w-full border-t border-slate-200/50 bg-white/40 px-4 py-6 text-center">
        <p class="text-xs text-slate-500">
            <span class="font-semibold text-slate-700">OrderHub</span>
            <span class="mx-1">•</span>
            <span>نظام إدارة العمليات والطلبات © @CurrentYear. جميع الحقوق محفوظة.</span>
        </p>
    </footer>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    private bool _showPassword;

    private static string CurrentYear =>
        DateTime.Now.Year.ToString(CultureInfo.InvariantCulture);

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
    }
}
