@page "/"
@using Microsoft.AspNetCore.Authorization
@using OrderHub.Web.Components.Common
@attribute [Authorize]

<PageTitle>لوحة التحكم</PageTitle>

<MudStack Spacing="4">
    <PageScaffold Title="لوحة التحكم"
                  Description="نظرة سريعة على حالة العمل اليوم"
                  Crumbs="_crumbs">
        <Actions>
            <PermissionView Feature="PermissionFeature.Orders" Level="PermissionLevel.Write">
                <MudButton Class="min-h-11 rounded-lg px-4 font-bold shadow-sm"
                           Size="Size.Small"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddShoppingCart"
                           Href="/orders/create">
                    إضافة طلب
                </MudButton>
            </PermissionView>
            <PermissionView Feature="PermissionFeature.Products" Level="PermissionLevel.Write">
                <MudButton Class="min-h-11 rounded-lg px-4 font-bold shadow-sm"
                           Size="Size.Small"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddBox"
                           Href="/products/create">
                    إضافة منتج
                </MudButton>
            </PermissionView>
            <PermissionView Feature="PermissionFeature.Clients" Level="PermissionLevel.Write">
                <ClientEditorButton Size="Size.Small"
                                    Color="Color.Primary"
                                    Class="min-h-11 rounded-lg px-4 font-bold shadow-sm" />
            </PermissionView>
        </Actions>
    </PageScaffold>

    <section aria-label="إحصائيات سريعة" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @* placeholder: dashboard totals are not backed by summary queries yet *@
        <article class="h-full rounded-2xl border border-slate-200 bg-white pa-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">إجمالي الطلبات</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">35</p>
                    <p class="text-xs font-semibold text-emerald-600">+5 هذا الأسبوع</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" aria-hidden="true" />
                </span>
            </div>
        </article>

        <article class="h-full rounded-2xl border border-slate-200 bg-white pa-5 shadow-sm">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">المنتجات</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">56</p>
                    <p class="text-xs font-semibold text-slate-500">+3 منتجات جديدة</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" aria-hidden="true" />
                </span>
            </div>
        </article>

        <article class="h-full rounded-2xl border border-slate-200 bg-white pa-5 shadow-sm sm:col-span-2 xl:col-span-1">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-2">
                    <p class="text-sm font-medium text-slate-500">العملاء</p>
                    <p class="text-3xl font-black tracking-tight text-slate-900">18</p>
                    <p class="text-xs font-semibold text-emerald-600">+2 عملاء جدد</p>
                </div>
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.Groups" aria-hidden="true" />
                </span>
            </div>
        </article>
    </section>

    <section aria-label="نشاط الطلبات" class="grid grid-cols-1 gap-4 lg:grid-cols-3">
        <article class="min-h-[330px] rounded-2xl border border-slate-200 bg-white pa-5 shadow-sm lg:col-span-2">
            <div class="mb-4 flex items-center justify-between gap-3">
                <h2 class="text-lg font-bold text-slate-900">نشاط الطلبات</h2>
                <span class="text-xs font-medium text-slate-500">آخر 7 أيام</span>
            </div>
            <div class="overflow-hidden rounded-2xl border border-slate-100 bg-slate-50 p-2">
                @* placeholder: chart values are illustrative until daily order totals are queried *@
                <MudChart T="double"
                          ChartType="ChartType.Bar"
                          ChartSeries="@_orderSeries"
                          ChartLabels="@_orderLabels"
                          ChartOptions="@_chartOptions"
                          Width="100%"
                          Height="250px" />
            </div>
        </article>

        <article class="min-h-[330px] rounded-2xl border border-slate-200 bg-white pa-5 shadow-sm">
            <div class="flex h-full flex-col items-start gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" aria-hidden="true" />
                </span>
                <div class="space-y-2">
                    <h2 class="text-lg font-bold text-slate-900">متابعة الطلبات</h2>
                    <p class="text-sm leading-6 text-slate-500">
                        افتح الطلب لمراجعة حالته وخطوات التوصيل والإجراءات المتاحة.
                    </p>
                </div>
                <PermissionView Feature="PermissionFeature.Orders" Level="PermissionLevel.Read">
                    <MudButton Class="mt-auto rounded-xl px-4 font-bold"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowBack"
                               Href="/orders">
                        عرض الطلبات
                    </MudButton>
                </PermissionView>
            </div>
        </article>
    </section>
</MudStack>

@code
{
    private static readonly PageScaffold.CrumbItem[] _crumbs =
    [
        new("لوحة التحكم")
    ];

    private readonly ChartOptions _chartOptions = new()
    {
        ChartPalette = ["#2563EB"]
    };

    private readonly List<ChartSeries<double>> _orderSeries =
    [
        new()
        {
            Name = "الطلبات",
            Data = new([5, 8, 6, 11, 9, 13, 10])
        }
    ];

    private readonly string[] _orderLabels =
    [
        "السبت",
        "الأحد",
        "الاثنين",
        "الثلاثاء",
        "الأربعاء",
        "الخميس",
        "الجمعة"
    ];
}
