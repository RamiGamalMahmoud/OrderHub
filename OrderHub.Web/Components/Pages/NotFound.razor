@page "/not-found"
@using OrderHub.Web.Components.Layout
@layout StandaloneLayout

<PageTitle>الصفحة غير موجودة</PageTitle>

<div class="flex min-h-dvh items-center justify-center bg-slate-50 px-4 py-10">
    <section class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-100 bg-brand-50 text-brand-600">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="h-7 w-7" />
        </span>

        <p class="mt-4 text-4xl font-black tracking-tight text-slate-900">404</p>
        <h1 class="mt-1 text-xl font-extrabold text-slate-900">الصفحة غير موجودة</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            الصفحة التي تبحث عنها غير متاحة أو تم نقلها. تحقق من الرابط ثم حاول مرة أخرى.
        </p>

        <MudButton Href="/"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="oh-btn oh-btn--primary mt-6"
                   StartIcon="@Icons.Material.Filled.Home">
            العودة للرئيسية
        </MudButton>
    </section>
</div>
