@page "/Error"
@using System.Diagnostics

<PageTitle>حدث خطأ</PageTitle>

<div class="flex min-h-[60vh] items-center justify-center px-4 py-10">
    <section class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-8 text-center shadow-sm">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl border border-rose-100 bg-rose-50 text-rose-600">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="h-7 w-7" />
        </span>

        <h1 class="mt-4 text-xl font-extrabold text-slate-900">حدث خطأ غير متوقع</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
            تعذر إكمال العملية أثناء معالجة الطلب. أعد المحاولة، وإذا استمرت المشكلة تواصل مع مسؤول النظام.
        </p>

        @if (ShowRequestId)
        {
            <p class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-[11px] font-medium text-slate-500" dir="ltr">
                Request ID: <code class="font-mono">@RequestId</code>
            </p>
        }

        <MudButton Href="/"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Class="oh-btn oh-btn--primary mt-6"
                   StartIcon="@Icons.Material.Filled.Home">
            العودة للرئيسية
        </MudButton>
    </section>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
