<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <!-- No runtime font fetching: the app runs locally; fonts are the local multi-weight Tajawal set (wwwroot/fonts/). -->
    <!-- Design-system CSS order (Option B): MudBlazor → base app.css → mud-blazor-overrides (T-A2)
         → Tailwind utilities LAST and unlayered (they beat MudBlazor + our defaults without !important) → razor-scoped styles -->
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/mud-blazor-overrides.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["OrderHub.Web.styles.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>

</body>

</html>
