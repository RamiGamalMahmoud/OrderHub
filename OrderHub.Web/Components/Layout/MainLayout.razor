@inherits LayoutComponentBase
@using OrderHub.Web.Components.Layout
@using OrderHub.Web.Services
@using OrderHub.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Globalization
@using System.Security.Claims
@inject PermissionAccess PermissionAccess
@inject NavigationManager Navigation

<MudRTLProvider RightToLeft=true>
    @* تفعيل خيارات الثيم من مصدر واحد مشترك (OrderHubTheme) لدعم RTL والهوية البصرية الموحدة *@
    <MudThemeProvider Theme="OrderHubTheme.Current" DefaultScrollbar="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout Class="min-h-dvh flex flex-col">

        <!-- شريط علوي ثابت (72px): الشعار يمين (RTL) ثم قوائم التنقل، والبطاقة الحالية والإجراءات يسارًا -->
        <header class="sticky top-0 z-50 border-b border-slate-200 bg-white shadow-nav">
            <div class="mx-auto flex h-[72px] max-w-[1720px] items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">

                <!-- الشعار + قوائم التنقل -->
                <div class="flex min-w-0 items-center gap-4 xl:gap-8">
                    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label="الصفحة الرئيسية">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-tr from-brand-700 via-brand-600 to-blue-400 text-white shadow-md shadow-brand-500/20 transition-transform duration-200 group-hover:scale-105">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linejoin="round" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
                                <path d="M12 2l9 5v10l-9 5-9-5V7l9-5z" />
                                <path d="M12 22V12l9-5M12 12L3 7" />
                            </svg>
                        </span>
                        <span class="flex flex-col">
                            <span class="flex items-center gap-1.5">
                                <span class="text-xl font-extrabold tracking-tight text-slate-900">Order<span class="text-brand-600">Hub</span></span>
                            </span>
                            <span class="-mt-0.5 hidden text-[11px] font-medium text-slate-400 sm:block">نظام إدارة العمليات والطلبات</span>
                        </span>
                    </a>

                    <div class="hidden h-8 w-px bg-slate-200 xl:block"></div>

                    <div class="hidden min-w-0 lg:block">
                        <NavMenu @ref="_desktopNav"
                                 Variant="NavMenu.NavVariant.Desktop"
                                 OnMenuOpened="CloseUserMenu" />
                    </div>
                </div>

                <!-- الإجراءات: إنشاء طلب + بطاقة المستخدم + همبرغر الهاتف -->
                <div class="flex shrink-0 items-center gap-2 sm:gap-3.5">
                    @if (_canCreateOrder)
                    {
                        <a href="/orders/create"
                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-3 py-2 text-xs font-bold text-white shadow-md shadow-brand-500/25 transition-all duration-150 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-500/35 sm:px-4 sm:py-2.5 sm:text-sm">
                            <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Class="text-sm" />
                            <span>إضافة طلب</span>
                        </a>
                    }

                    <div class="relative z-50">
                        <button type="button"
                                class="@UserChipClass"
                                aria-haspopup="menu"
                                aria-expanded="@(_userMenuOpen ? "true" : "false")"
                                aria-label="قائمة المستخدم"
                                @onclick="ToggleUserMenu">
                            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-tr from-slate-700 to-slate-900 text-xs font-bold text-white shadow-inner">@_initials</span>
                            <span class="hidden flex-col text-start leading-tight xl:flex">
                                <span class="text-xs font-bold text-slate-900">@_displayName</span>
                                <span class="text-xs font-medium text-slate-500">@(_isAdmin ? "مدير النظام" : "مستخدم")</span>
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="hidden text-[11px] text-slate-400 xl:inline" />
                        </button>

                        @if (_userMenuOpen)
                        {
                            <div class="oh-nav-panel absolute end-0 top-full z-50 mt-2 w-56 overflow-hidden rounded-xl border border-slate-200/90 bg-white shadow-menu">
                                <div class="border-b border-slate-100 px-4 py-2.5">
                                    <div class="text-xs text-slate-500">مسجّل الدخول باسم</div>
                                    <div class="text-sm font-bold text-slate-800">@_displayName</div>
                                </div>
                                <div class="p-1.5">
                                    <form method="post" action="/auth/logout">
                                        <button type="submit"
                                                class="oh-btn oh-btn--danger oh-btn--block">
                                            تسجيل الخروج
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="lg:hidden">
                        <NavMenu @ref="_mobileNav"
                                 Variant="NavMenu.NavVariant.Mobile"
                                 OnMenuOpened="CloseUserMenu" />
                    </div>
                </div>
            </div>

            @if (_userMenuOpen)
            {
                <div class="fixed inset-0 z-40" aria-hidden="true" @onclick="CloseUserMenu"></div>
            }
        </header>

        <!-- منطقة المحتوى الرئيسية مع خلفية ناعمة مريحة للعين لتبرز بداخلها الـ Cards -->
        <MudMainContent Class="flex-1 min-w-0">
            <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
                <MudContainer MaxWidth="MaxWidth.Large">
                    @Body
                </MudContainer>
            </div>
        </MudMainContent>

        <!-- تذييل الموقع -->
        <footer class="border-t border-slate-200 bg-white py-4 text-xs text-slate-500">
            <div class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col-reverse sm:flex-row items-center justify-between gap-2">
                <p>@(string.Format(CultureInfo.InvariantCulture, "نظام إدارة الطلبات — OrderHub © {0}", DateTime.Now.ToString("yyyy", CultureInfo.InvariantCulture)))</p>
                <nav class="flex items-center gap-5" aria-label="روابط التذييل">
                    @* placeholder: informational footer links *@
                    <span>عن النظام</span>
                    <span>دليل الاستخدام</span>
                    <span>الدعم</span>
                </nav>
            </div>
        </footer>

    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع في النظام.
    <a href="." class="reload">إعادة تحميل</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private string _displayName = "مستخدم";
    private string _initials = "؟";
    private bool _isAdmin;
    private bool _identityResolved;
    private bool _canCreateOrder;
    private bool _userMenuOpen;
    private NavMenu? _desktopNav;
    private NavMenu? _mobileNav;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_identityResolved || AuthenticationStateTask is null)
        {
            return;
        }

        var user = (await AuthenticationStateTask).User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName =
                user.FindFirst("DisplayName")?.Value ??
                user.Identity.Name ??
                "مستخدم";
            _initials = ComputeInitials(_displayName);
            _isAdmin = user.IsInRole("Admin");
            _canCreateOrder = await PermissionAccess.IsAllowedAsync(PermissionFeature.Orders, PermissionLevel.Write);
        }

        _identityResolved = true;
    }

    private string UserChipClass =>
        _userMenuOpen
            ? "flex items-center gap-2.5 rounded-xl border border-slate-200 bg-slate-100 py-1.5 pe-2 ps-1 transition-colors"
            : "flex items-center gap-2.5 rounded-xl border border-transparent py-1.5 pe-2 ps-1 transition-colors hover:border-slate-200 hover:bg-slate-100";

    /// <summary>فتح قائمة المستخدم يغلق أي قائمة تنقل مفتوحة (والعكس).</summary>
    private void ToggleUserMenu()
    {
        if (!_userMenuOpen)
        {
            _desktopNav?.CloseAll();
            _mobileNav?.CloseAll();
        }

        _userMenuOpen = !_userMenuOpen;
    }

    private void CloseUserMenu()
    {
        if (!_userMenuOpen)
        {
            return;
        }

        _userMenuOpen = false;
        StateHasChanged();
    }

    /// <summary>حرفا الاعتماد في دائرة الأفاتار: أول حرف من أول كلمتين.</summary>
    private static string ComputeInitials(string displayName)
    {
        var letters = displayName
            .Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0])
            .ToArray();

        return letters.Length > 0 ? new string(letters) : "؟";
    }
}
