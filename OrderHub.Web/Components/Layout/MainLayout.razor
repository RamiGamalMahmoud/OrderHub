@inherits LayoutComponentBase
@using OrderHub.Web.Components.Layout

<MudRTLProvider RightToLeft=true>
    @* تفعيل خيارات الثيم الحديثة ودعم اللغة العربية *@
    <MudThemeProvider Theme="_customTheme" DefaultScrollbar="true" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>

        <!-- شريط علوي عصري: العنوان + القوائم المنسدلة (حاسوب) + الهامبرغر (هاتف) -->
        <MudAppBar Elevation="0" Class="top-appbar border-bottom-subtle px-4" Color="Color.Surface">

            <!-- زر فتح الدرّج يظهر على الشاشات الصغيرة فقط -->
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Default"
                           Edge="Edge.Start"
                           OnClick="ToggleDrawer"
                           Class="me-2 d-sm-none align-self-center" />

            <!-- العنوان رابط إلى الصفحة الرئيسية -->
            <MudLink Href="/"
                     Underline="Underline.None"
                     Typo="Typo.h5"
                     Class="top-nav-brand font-weight-bold tracking-tight text-primary align-self-center">
                OrderHub
            </MudLink>

            <MudSpacer />

            <!-- القوائم المنسدلة للحاسوب (بمنتصف الشريط) -->
            <NavMenu Variant="NavMenu.NavVariant.Dropdown" Class="d-none d-sm-flex align-self-center" />

            <MudSpacer />

            <form method="post" action="/auth/logout" class="d-flex align-items-center">
                <MudButton ButtonType="ButtonType.Submit">
                    تسجيل الخروج
                </MudButton>
            </form>
        </MudAppBar>

        <!-- درّج الملاحة للهاتف فقط (نفس العناصر) -->
        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Responsive"
                   Class="border-inline-subtle">
            <NavMenu Variant="NavMenu.NavVariant.Drawer" />
        </MudDrawer>

        <!-- منطقة المحتوى الرئيسية مع خلفية ناعمة مريحة للعين لتبرز بداخلها الـ Cards -->
        <MudMainContent Class="main-content-bg">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4 px-md-8">
                @Body
            </MudContainer>
        </MudMainContent>

    </MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع في النظام.
    <a href="." class="reload">إعادة تحميل</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private bool _drawerOpen = false;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    // إعداد الـ Theme ليدعم اتجاه اليمين لليسار (RTL) بشكل تلقائي وتخصيص الألوان الأساسية
    private MudTheme _customTheme = new MudTheme()
    {
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Tajawal", "sans-serif"]
            }
        },
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",       // لون أزرق عصري (Tailwind Blue 600) بدلاً من البنفسجي
            Secondary = "#64748B",     // لون رمادي هادئ للنصوص الثانوية والعناوين
            Background = "#F8FAFC",    // خلفية ثلجية مريحة جداً للمحتوى (Slate 50)
            Surface = "#FFFFFF",       // اللون الأبيض للبطاقات، القائمة والهيدر
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            DrawerBackground = "#FFFFFF"
        }
    };
}
