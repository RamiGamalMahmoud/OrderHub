@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using OrderHub.Domain.Enums
@using OrderHub.Application.Features.Inventory.GetStockInContext
@using System.Collections.Generic
@using System.Linq
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject OrderHub.Application.Interfaces.IRequestExecutor RequestExecutor
@inject NavigationManager Navigation
@implements IDisposable

@if (Variant == NavVariant.Desktop)
{
    @* حاسوب: شريط قوائم منسدلة غنية (عنوان مجموعة + بطاقات روابط + زر إنشاء).
       التنقل كله HTML عادي + Tailwind، والتوجيه يتولاه راوتر Blazor. *@
    var desktopGroups = VisibleGroups;

    <nav class="relative z-40 flex items-center gap-1 @Class" aria-label="التنقل الرئيسي">
        @for (var index = 0; index < desktopGroups.Count; index++)
        {
            var group = desktopGroups[index];
            var isOpen = _openGroup == group.Title;
            var panelId = $"nav-panel-{index}";

            <div class="relative" @key="group.Title">
                <button type="button"
                        class="group @TriggerClass(group)"
                        aria-haspopup="true"
                        aria-expanded="@(isOpen ? "true" : "false")"
                        aria-controls="@panelId"
                        @onclick="() => ToggleGroupAsync(group.Title)">
                    <MudIcon Icon="@group.Icon" Class="@TriggerIconClass(group)" />
                    <span>@group.Title</span>
                    @if (isOpen)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="rotate-180 text-xs text-brand-600 transition-transform duration-150" />
                    }
                </button>

                @if (isOpen)
                {
                    <div id="@panelId"
                         role="menu"
                         class="oh-nav-panel absolute start-0 top-full z-50 mt-2.5 w-80 divide-y divide-slate-100 rounded-2xl border border-slate-200/90 bg-white py-2.5 shadow-menu">
                        <div class="flex items-center justify-between px-4 py-2">
                            <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400">@group.Subtitle</span>
                            <a href="@group.ViewAllHref"
                               class="text-xs font-normal text-brand-600 hover:underline"
                               @onclick="CloseAll">عرض الكل</a>
                        </div>

                        <div class="space-y-1 p-1.5">
                            @foreach (var item in VisibleItems(group))
                            {
                                var isCurrent = IsItemActive(item);

                                <a href="@item.Href"
                                   role="menuitem"
                                   class="group flex items-start gap-3 rounded-xl p-2.5 transition-colors hover:bg-slate-50 @(isCurrent ? "bg-brand-50/60" : string.Empty)"
                                   @onclick="CloseAll">
                                    <div class="@ItemTileClass(item.Tone)">
                                        <MudIcon Icon="@item.Icon" Class="text-sm" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-center justify-between gap-2">
                                            <p class="@ItemTitleClass(item)">@item.Label</p>
                                            @if (isCurrent)
                                            {
                                                <span class="rounded bg-brand-50 px-1.5 py-0.5 text-[11px] font-bold text-brand-700">الحالية</span>
                                            }
                                        </div>
                                        <p class="mt-0.5 truncate text-xs text-slate-500">@item.Description</p>
                                    </div>
                                </a>
                            }
                        </div>

                        @if (group.Create is not null && IsAllowed(group.Create))
                        {
                            <div class="rounded-b-2xl bg-slate-50/70 p-2">
                                <a href="@group.Create.Href"
                                   class="flex w-full items-center justify-center gap-2 rounded-lg border border-brand-200 bg-white px-3 py-2 text-xs font-bold text-brand-600 shadow-sm transition-all hover:border-brand-600 hover:bg-brand-600 hover:text-white"
                                   @onclick="CloseAll">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-xs" />
                                    <span>@group.Create.Label</span>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </nav>

    @if (_openGroup is not null)
    {
        <div class="fixed inset-0 z-30" aria-hidden="true" @onclick="CloseAll"></div>
    }
}
else
{
    @* هاتف: زر همبرغر يفتح لوحة بعرض الشاشة تحت الشريط، بنفس منطق تصميم القوائم. *@
    <div class="relative z-40 @Class">
        <button type="button"
                class="flex h-10 w-10 items-center justify-center rounded-lg text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-800 lg:hidden"
                aria-label="فتح قائمة التنقل"
                aria-haspopup="true"
                aria-expanded="@(_mobileOpen ? "true" : "false")"
                @onclick="ToggleMobileAsync">
            <MudIcon Icon="@(_mobileOpen ? Icons.Material.Filled.Close : Icons.Material.Filled.Menu)" Class="text-xl" />
        </button>

        @if (_mobileOpen)
        {
            <div class="fixed inset-x-0 top-[72px] z-40 max-h-[calc(100dvh-72px)] overflow-y-auto border-b border-slate-200 bg-white shadow-menu">
                <div class="divide-y divide-slate-100 px-4 py-3 sm:px-6">
                    @foreach (var group in VisibleGroups)
                    {
                        var isGroupCurrent = IsGroupActive(group);

                        <div class="py-3 first:pt-0 last:pb-0">
                            <div class="@(isGroupCurrent ? "text-[11px] font-bold uppercase tracking-widest text-brand-600" : "text-[11px] font-bold uppercase tracking-widest text-slate-400")">
                                @group.Title
                            </div>

                            <div class="mt-1.5 space-y-1">
                                @foreach (var item in VisibleItems(group))
                                {
                                    var isCurrent = IsItemActive(item);

                                    <a href="@item.Href"
                                       class="group flex items-start gap-3 rounded-xl p-2.5 transition-colors hover:bg-slate-50 @(isCurrent ? "bg-brand-50/60" : string.Empty)"
                                       @onclick="CloseAll">
                                        <div class="@ItemTileClass(item.Tone)">
                                            <MudIcon Icon="@item.Icon" Class="text-sm" />
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center justify-between gap-2">
                                                <p class="@ItemTitleClass(item)">@item.Label</p>
                                                @if (isCurrent)
                                                {
                                                    <span class="rounded bg-brand-50 px-1.5 py-0.5 text-[11px] font-bold text-brand-700">الحالية</span>
                                                }
                                            </div>
                                            <p class="mt-0.5 truncate text-xs text-slate-500">@item.Description</p>
                                        </div>
                                    </a>
                                }
                            </div>

                            @if (group.Create is not null && IsAllowed(group.Create))
                            {
                                <a href="@group.Create.Href"
                                   class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg border border-brand-200 bg-white px-3 py-2 text-xs font-bold text-brand-600 shadow-sm transition-all hover:border-brand-600 hover:bg-brand-600 hover:text-white"
                                   @onclick="CloseAll">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Class="text-xs" />
                                    <span>@group.Create.Label</span>
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="fixed inset-0 z-30" aria-hidden="true" @onclick="CloseAll"></div>
        }
    </div>
}

@code
{
    public enum NavVariant
