            new("إعادة بناء الأرصدة", "/inventory/rebuild", Icons.Material.Outlined.Build, PermissionFeature.Inventory, "amber",
                "أداة إصلاح يدوية للأرصدة من دفتر الحركات — للمدير الأعلى", PermissionLevel.Approve, AdminOnly: true)
        ],
        new("تسجيل توريد", "/inventory/stock-in", Icons.Material.Filled.Add, PermissionFeature.Inventory, "teal",
            "تسجيل توريد أو رصيد افتتاحي للمخزن المرتبط بك", PermissionLevel.Write, KeeperOnly: true)),
        new("جهات التعامل", Icons.Material.Filled.Groups, "بيانات العملاء والموردين والتوصيل", "/clients",
        [
            new("العملاء", "/clients", Icons.Material.Outlined.Person, PermissionFeature.Clients, "blue",
                "بيانات العملاء وأرقام التواصل"),
            new("الموردون", "/suppliers", Icons.Material.Outlined.Storefront, PermissionFeature.Suppliers, "teal",
                "الموردون وحالات التوريد"),
            new("المناديب", "/deliverymen", Icons.Material.Outlined.Moped, PermissionFeature.Deliverymen, "amber",
                "مندوبو التوصيل ومدنهم"),
            new("شركات الشحن", "/shipping-carriers", Icons.Material.Outlined.LocalShipping, PermissionFeature.ShippingCarriers, "indigo",
                "شركات الشحن وأتعاب التوصيل")
        ]),
        new("المشاوير", Icons.Material.Outlined.Route, "مشاوير المناديب", "/trips",
        [
            new("كل المشاوير", "/trips", Icons.Material.Outlined.Route, PermissionFeature.Trips, "amber",
                "كل مشاوير المناديب، المستقلة والمرتبطة بالطلبات")
        ],
        new("إنشاء مشوار", "/trips/create", Icons.Material.Filled.Add, PermissionFeature.Trips, "amber",
            "إنشاء مشوار مستقل لمندوب", PermissionLevel.Write)),
        new("المستندات والوثائق", Icons.Material.Filled.Description, "الفواتير وعروض الأسعار والوثائق", "/invoices",
        [
            new("الفواتير", "/invoices", Icons.Material.Outlined.ReceiptLong, PermissionFeature.Documents, "blue",
                "فواتير المبيعات الصادرة"),
            new("عروض الأسعار", "/quotations", Icons.Material.Outlined.RequestPage, PermissionFeature.Documents, "teal",
                "عروض الأسعار المرسلة للعملاء"),
            new("الفواتير الأولية", "/proforma-invoices", Icons.Material.Outlined.FactCheck, PermissionFeature.Documents, "indigo",
                "فواتير أولية قبل الإصدار النهائي")
        ]),
        new("الإدارة", Icons.Material.Filled.AdminPanelSettings, "إعدادات النظام والصلاحيات", "/cities",
        [
            new("المدن", "/cities", Icons.Material.Outlined.LocationOn, PermissionFeature.Cities, "blue",
                "المدن ومناطق التوصيل"),
            new("المستخدمون", "/admin/users", Icons.Material.Outlined.PeopleOutline, PermissionFeature.Users, "indigo",
                "حسابات المستخدمين وأدوارهم", AdminOnly: true),
            new("الصلاحيات", "/admin/roles", Icons.Material.Outlined.GppGood, PermissionFeature.Users, "purple",
                "أدوار النظام ومستويات الوصول", AdminOnly: true)
        ])
    ];

    private readonly HashSet<(PermissionFeature Feature, PermissionLevel Level)> _allowedPermissions = [];
    private bool _permissionsEvaluated;
    private bool _isAdmin;
    private bool _isKeeper;
    private string? _openGroup;
    private bool _mobileOpen;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_permissionsEvaluated)
        {
            return;
        }

        var combinations = Groups
            .SelectMany(group => group.Items.Concat(group.Create is not null ? [group.Create] : []))
            .Select(item => (item.Feature, item.Level))
            .Distinct();

        foreach (var (feature, level) in combinations)
        {
            if (await PermissionAccess.IsAllowedAsync(feature, level))
            {
                _allowedPermissions.Add((feature, level));
            }
        }

        _isAdmin = await PermissionAccess.IsHigherManagerAsync();

        if (_allowedPermissions.Contains((PermissionFeature.Inventory, PermissionLevel.Write)))
        {
            try
            {
                var stockInContext = await RequestExecutor.ExecuteAsync(new GetStockInContextQuery());
                _isKeeper = stockInContext.IsSuccess;
            }
            catch (Exception)
            {
                _isKeeper = false;
            }
        }

        _permissionsEvaluated = true;
    }

    private List<NavGroupModel> VisibleGroups => Groups.Where(GroupVisible).ToList();

    private bool GroupVisible(NavGroupModel group) => VisibleItems(group).Any();

    private IEnumerable<NavItemModel> VisibleItems(NavGroupModel group) =>
        group.Items.Where(IsAllowed);

    private bool IsAllowed(NavItemModel item) =>
        (!item.AdminOnly || _isAdmin) &&
        (!item.KeeperOnly || _isKeeper) &&
        _allowedPermissions.Contains((item.Feature, item.Level));

    /// <summary>هل مجموعة القائمة تحتوي الصفحة الحالية؟ لتلوين زر المجموعة في الشريط العلوي.</summary>
    private bool IsGroupActive(NavGroupModel group)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;

        if (path == "/")
        {
            return false;
        }

        return group.Items.Any(item => IsPathWithin(path, item.Href));
    }

    /// <summary>هل هذا العنصر هو الصفحة الحالية نفسها؟ يُلوَّن العنصر المطابق فقط.</summary>
    private bool IsItemActive(NavItemModel item)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;

        if (path.Equals(item.Href, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // A sibling item matching the path exactly wins over a broader parent
        // match (e.g. /orders/create is not also «الطلبات»).
        var exactSibling = Groups
            .SelectMany(group => group.Items)
            .Any(candidate => path.Equals(candidate.Href, StringComparison.OrdinalIgnoreCase));

        return !exactSibling && IsPathWithin(path, item.Href);
    }

    private static bool IsPathWithin(string path, string href) =>
        path.Equals(href, StringComparison.OrdinalIgnoreCase) ||
        path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);

    private string TriggerClass(NavGroupModel group)
    {
        if (_openGroup == group.Title)
        {
            return "flex items-center gap-2 rounded-lg border border-blue-200/70 bg-blue-50/80 px-3.5 py-2 text-sm font-bold text-brand-700 shadow-sm ring-2 ring-brand-500/20 outline-none transition-all duration-150";
        }

        if (IsGroupActive(group))
        {
            return "flex items-center gap-2 rounded-lg border border-blue-200/60 bg-blue-50/60 px-3.5 py-2 text-sm font-bold text-brand-700 outline-none transition-all duration-150 hover:bg-blue-50/80";
        }

        return "flex items-center gap-2 rounded-lg border border-transparent px-3.5 py-2 text-sm font-semibold text-slate-700 outline-none transition-all duration-150 hover:bg-slate-50 hover:text-brand-600";
    }

    private string TriggerIconClass(NavGroupModel group) =>
        _openGroup == group.Title || IsGroupActive(group)
            ? "text-[15px] text-brand-600"
            : "text-[15px] text-slate-400 transition-colors group-hover:text-brand-600";

    private static string ItemTileClass(string tone) => tone switch
    {
        "emerald" => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600 shadow-sm transition-all duration-200 group-hover:bg-emerald-600 group-hover:text-white",
        "teal" => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-teal-600 shadow-sm transition-all duration-200 group-hover:bg-teal-600 group-hover:text-white",
        "indigo" => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 shadow-sm transition-all duration-200 group-hover:bg-indigo-600 group-hover:text-white",
        "purple" => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-purple-600 shadow-sm transition-all duration-200 group-hover:bg-purple-600 group-hover:text-white",
        "amber" => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600 shadow-sm transition-all duration-200 group-hover:bg-amber-600 group-hover:text-white",
        _ => "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-brand-600 shadow-sm transition-all duration-200 group-hover:bg-brand-600 group-hover:text-white"
    };

    private static string ItemTitleClass(NavItemModel item) => item.Tone switch
    {
        "emerald" => "text-sm font-bold text-slate-900 group-hover:text-emerald-700",
        "teal" => "text-sm font-bold text-slate-900 group-hover:text-teal-700",
        "indigo" => "text-sm font-bold text-slate-900 group-hover:text-indigo-700",
        "purple" => "text-sm font-bold text-slate-900 group-hover:text-purple-700",
        "amber" => "text-sm font-bold text-slate-900 group-hover:text-amber-700",
        _ => "text-sm font-bold text-slate-900 group-hover:text-brand-700"
    };

    private async Task ToggleGroupAsync(string title)
    {
        _openGroup = _openGroup == title ? null : title;

        if (_openGroup is not null)
        {
            await OnMenuOpened.InvokeAsync();
        }
    }

    private async Task ToggleMobileAsync()
    {
        _mobileOpen = !_mobileOpen;

        if (_mobileOpen)
        {
            await OnMenuOpened.InvokeAsync();
        }
    }

    /// <summary>إغلاق كل قوائم هذا المكوّن (يُستدعى من الشريط عند فتح قائمة أخرى).</summary>
    public void CloseAll()
    {
        if (_openGroup is null && !_mobileOpen)
        {
            return;
        }

        _openGroup = null;
        _mobileOpen = false;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _openGroup = null;
        _mobileOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }
}
