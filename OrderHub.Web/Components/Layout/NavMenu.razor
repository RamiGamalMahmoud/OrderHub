        bool AdminOnly = false,
        bool KeeperOnly = false);

    private sealed record NavGroupModel(
        string Title,
        string Icon,
        string Subtitle,
        string ViewAllHref,
        NavItemModel[] Items,
        NavItemModel? Create = null);

    [Parameter]
    public NavVariant Variant { get; set; } = NavVariant.Desktop;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>يُستدعى عند فتح أي قائمة حتى يغلق صاحب التخطيط قوائمه الأخرى.</summary>
    [Parameter]
    public EventCallback OnMenuOpened { get; set; }

    /// <summary>مصدر واحد لعناصر التنقل؛ الترتيب من اليمين إلى اليسار في RTL.</summary>
    private static readonly NavGroupModel[] Groups =
    [
