        new("إضافة منتج جديد للكتالوج", "/products/create", Icons.Material.Filled.Add, PermissionFeature.Products, "blue",
            "إضافة منتج جديد للكتالوج", PermissionLevel.Write)),
        new("المخزون", Icons.Material.Filled.Warehouse, "المخازن والأرصدة وأوامر الصرف", "/warehouses",
        [
            new("أرصدة المنتجات", "/inventory/balances", Icons.Material.Outlined.Inventory, PermissionFeature.Inventory, "teal",
                "أرصدة كل منتج مجمعة من المخازن المتاحة لك"),
            new("أرصدة المخازن", "/inventory", Icons.Material.Outlined.Inventory2, PermissionFeature.Inventory, "teal",
