@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using OrderHub.Domain.Enums
@using System.Collections.Generic
@using System.Linq
@inject OrderHub.Web.Services.PermissionAccess PermissionAccess
@inject NavigationManager Navigation
@implements IDisposable

@if (Variant == NavVariant.Dropdown)
{
    <div class="top-nav @Class">
        @foreach (var group in Groups)
        {
            if (GroupVisible(group))
            {
                <MudMenu Label="@group.Title"
                         StartIcon="@group.Icon"
                         Color="Color.Primary"
                         Variant="@MudBlazor.Variant.Text"
                         Dense="true"
                         Class="@GetGroupClass(group)"
                         PopoverClass="top-nav-popover">
                    @foreach (var item in VisibleItems(group))
                    {
                        <MudMenuItem Href="@item.Href"
                                     Icon="@item.Icon"
                                     IconColor="Color.Inherit">
                            @item.Label
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        }
    </div>
}
else
{
    <MudNavMenu Class="@DrawerContainerClass"
                Bordered="false">
        @foreach (var group in Groups)
        {
            if (GroupVisible(group))
            {
                <MudNavGroup Title="@group.Title"
                             Icon="@group.Icon"
                             ExpandIcon="@Icons.Material.Filled.ExpandMore">
                    @foreach (var item in VisibleItems(group))
                    {
                        <MudNavLink Href="@item.Href"
                                    Icon="@item.Icon">
                            @item.Label
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
        }
    </MudNavMenu>
}

@code {
    public enum NavVariant
    {
        /// <summary>شريط تنقل أفقي بقوائم منسدلة (للحاسوب).</summary>
        Dropdown,

        /// <summary>قائمة عمودية داخل درّج جانبي (للهاتف).</summary>
        Drawer
    }

    private sealed record NavItemModel(
        string Label,
        string Href,
        string Icon,
        PermissionFeature Feature,
        PermissionLevel Level = PermissionLevel.Read,
        bool AdminOnly = false);

    private sealed record NavGroupModel(
        string Title,
        string Icon,
        NavItemModel[] Items);

    [Parameter]
    public NavVariant Variant { get; set; } = NavVariant.Drawer;

    [Parameter]
    public string? Class { get; set; }

    private string DrawerContainerClass =>
        string.Join(" ", "orderhub-nav", "custom-modern-nav", Class).Trim();

    /// <summary>مصدر واحد لعناصر التنقل؛ الترتيب من اليمين إلى اليسار في RTL.</summary>
    private static readonly NavGroupModel[] Groups =
    [
        new("الطلبات", Icons.Material.Filled.ShoppingBag,
        [
            new("الطلبات", "/orders", Icons.Material.Outlined.ShoppingBag, PermissionFeature.Orders),
            new("إنشاء طلب", "/orders/create", Icons.Material.Filled.Add, PermissionFeature.Orders, PermissionLevel.Write)
        ]),
        new("المنتجات", Icons.Material.Filled.Inventory2,
        [
            new("المنتجات", "/products", Icons.Material.Outlined.Layers, PermissionFeature.Products),
            new("الأقسام", "/categories", Icons.Material.Outlined.Category, PermissionFeature.Categories),
            new("خصائص المنتجات", "/properties", Icons.Material.Outlined.Tune, PermissionFeature.Properties)
        ]),
        new("جهات التعامل", Icons.Material.Filled.Groups,
        [
            new("العملاء", "/clients", Icons.Material.Outlined.Person, PermissionFeature.Clients),
            new("الموردون", "/suppliers", Icons.Material.Outlined.Storefront, PermissionFeature.Suppliers),
            new("المناديب", "/deliverymen", Icons.Material.Outlined.Moped, PermissionFeature.Deliverymen),
            new("شركات الشحن", "/shipping-carriers", Icons.Material.Outlined.LocalShipping, PermissionFeature.ShippingCarriers)
        ]),
        new("المستندات والوثائق", Icons.Material.Filled.Description,
        [
            new("الفواتير", "/invoices", Icons.Material.Outlined.ReceiptLong, PermissionFeature.Documents),
            new("عروض الأسعار", "/quotations", Icons.Material.Outlined.RequestPage, PermissionFeature.Documents),
            new("الفواتير الأولية", "/proforma-invoices", Icons.Material.Outlined.FactCheck, PermissionFeature.Documents)
        ]),
        new("الإدارة", Icons.Material.Filled.AdminPanelSettings,
        [
            new("المدن", "/cities", Icons.Material.Outlined.LocationOn, PermissionFeature.Cities),
            new("المستخدمون", "/admin/users", Icons.Material.Outlined.PeopleOutline, PermissionFeature.Users, AdminOnly: true),
            new("الصلاحيات", "/admin/roles", Icons.Material.Outlined.GppGood, PermissionFeature.Users, AdminOnly: true)
        ])
    ];

    private readonly HashSet<(PermissionFeature Feature, PermissionLevel Level)> _allowedPermissions = [];
    private bool _permissionsEvaluated;
    private bool _isAdmin;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_permissionsEvaluated)
        {
            return;
        }

        var combinations = Groups
            .SelectMany(group => group.Items)
            .Select(item => (item.Feature, item.Level))
            .Distinct();

        foreach (var (feature, level) in combinations)
        {
            if (await PermissionAccess.IsAllowedAsync(feature, level))
            {
                _allowedPermissions.Add((feature, level));
            }
        }

        if (AuthenticationStateTask is not null)
        {
            var user = (await AuthenticationStateTask).User;
            _isAdmin = user?.IsInRole("Admin") ?? false;
        }

        _permissionsEvaluated = true;
    }

    private bool GroupVisible(NavGroupModel group) => VisibleItems(group).Any();

    private IEnumerable<NavItemModel> VisibleItems(NavGroupModel group) =>
        group.Items.Where(item =>
            (!item.AdminOnly || _isAdmin) &&
            _allowedPermissions.Contains((item.Feature, item.Level)));

    /// <summary>هل مجموعة القائمة تحتوي الصفحة الحالية؟ لتلوين زر المجموعة في الشريط العلوي.</summary>
    private bool IsGroupActive(NavGroupModel group)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;

        if (path == "/")
        {
            return false;
        }

        return group.Items.Any(item =>
            path.Equals(item.Href, StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith(item.Href + "/", StringComparison.OrdinalIgnoreCase));
    }

    private string GetGroupClass(NavGroupModel group) =>
        IsGroupActive(group) ? "top-nav-group-active" : string.Empty;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        InvokeAsync(StateHasChanged);
}
