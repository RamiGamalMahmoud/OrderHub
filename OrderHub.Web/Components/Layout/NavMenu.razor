            new("المخازن", "/warehouses", Icons.Material.Outlined.Warehouse, PermissionFeature.Warehouses, "amber",
                "المخازن وأمناء المخزون وحالة التشغيل"),
            new("أوامر الصرف", "/inventory/issue-orders", Icons.Material.Outlined.Output, PermissionFeature.Inventory, "teal",
