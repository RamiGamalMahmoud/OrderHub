        ],
        new("إنشاء طلب جديد", "/orders/create", Icons.Material.Filled.Add, PermissionFeature.Orders, "emerald",
            "بدء طلب جديد لعميل", PermissionLevel.Write)),
        new("المنتجات", Icons.Material.Filled.Inventory2, "إدارة المستودع والكتالوج", "/products",
        [
            new("المنتجات", "/products", Icons.Material.Outlined.Layers, PermissionFeature.Products, "blue",
