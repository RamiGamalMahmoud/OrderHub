@inject OrderHub.Web.Services.PermissionAccess PermissionAccess

@if (_allowed)
{
    @ChildContent
}

@code {
    [Parameter, EditorRequired] public OrderHub.Domain.Enums.PermissionFeature Feature { get; set; }
    [Parameter] public OrderHub.Domain.Enums.PermissionLevel Level { get; set; } = OrderHub.Domain.Enums.PermissionLevel.Read;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _allowed;

    protected override async Task OnParametersSetAsync()
    {
        _allowed = await PermissionAccess.IsAllowedAsync(Feature, Level);
    }
}
