@namespace OrderHub.Web.Components.Common
@using System.Globalization

@* Unified page scaffold (redesign task T-A4 — registry decision §7):
   breadcrumb «الرئيسية / القسم / الصفحة» + title card (h1 + count badge + actions).
   Pages render this at the top of their existing container; body content stays in the page. *@

<div class="space-y-4">
    <nav aria-label="مسار التنقل"
         class="flex items-center gap-2 text-xs font-medium text-slate-500">
        <a href="/" class="transition-colors hover:text-brand-600">الرئيسية</a>
        @foreach (var crumb in Crumbs ?? Enumerable.Empty<CrumbItem>())
        {
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft"
                     Class="w-3.5 h-3.5 text-slate-400"
                     aria-hidden="true" />
            @if (crumb.Href is null)
            {
                <span class="font-semibold text-slate-800">@crumb.Label</span>
            }
            else
            {
                <a href="@crumb.Href" class="transition-colors hover:text-brand-600">@crumb.Label</a>
            }
        }
    </nav>

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">@Title</h1>
            @if (Count is not null)
            {
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-50 text-brand-700 border border-brand-200">
                    @Count.Value.ToString(CultureInfo.InvariantCulture) عنصر
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <span class="text-xs text-slate-500">@Description</span>
            }
        </div>
        @if (Actions is not null)
        {
            <div class="flex flex-wrap items-center gap-2.5">
                @Actions
            </div>
        }
    </div>
</div>

@code
{
    /// <summary>Crumbs between «الرئيسية» and the current page. A Href-less item renders as the (bold) current page.</summary>
    public sealed record CrumbItem(string Label, string? Href = null);

    /// <summary>Page title (h1). Required.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Breadcrumb trail after «الرئيسية»; last item without Href is the current page.</summary>
    [Parameter]
    public IEnumerable<CrumbItem>? Crumbs { get; set; }

    /// <summary>Live items count badge (InvariantCulture, Latin digits). Null = no badge.</summary>
    [Parameter]
    public int? Count { get; set; }

    /// <summary>Optional short description shown beside the title.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>Right side of the title card in RTL — buttons area (add/new etc.).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
