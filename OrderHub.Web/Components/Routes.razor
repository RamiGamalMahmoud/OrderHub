@using Microsoft.AspNetCore.Components.Authorization
@using OrderHub.Web.Components.Common
@using OrderHub.Web.Components.Layout
@using OrderHub.Web.Components.Pages

<Router AppAssembly="typeof(Program).Assembly">

    <Found Context="routeData">
        <PermissionErrorBoundary>
        <AuthorizeRouteView  RouteData="routeData" DefaultLayout="typeof(MainLayout)">

            <NotAuthorized>
                <AuthorizeView Context="identity">
                    <Authorized><MudAlert Severity="Severity.Warning">غير مصرح لك بتنفيذ هذه العملية.</MudAlert></Authorized>
                    <NotAuthorized><RedirectToLogin /></NotAuthorized>
                </AuthorizeView>
            </NotAuthorized>

        </AuthorizeRouteView>
        </PermissionErrorBoundary>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            @* Directly render your component inside the layout placeholder *@
            <NotFound />
        </LayoutView>
    </NotFound>

</Router>
