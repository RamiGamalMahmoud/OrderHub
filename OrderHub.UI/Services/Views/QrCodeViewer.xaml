<UserControl
    x:Class="OrderHub.UI.Services.Views.QrCodeViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Services.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border MinWidth="400" Padding="22">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  QR Code  -->

            <Border
                Grid.Row="1"
                Margin="0,14,0,0"
                Padding="8"
                HorizontalAlignment="Center"
                Background="White"
                BorderBrush="#DCE8FA"
                BorderThickness="1"
                CornerRadius="10">

                <Image
                    Width="500"
                    Height="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Source="{Binding Image}"
                    Stretch="Uniform" />

            </Border>


            <!--  Instructions  -->

            <Border
                Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12,9"
                Background="#F8FAFC"
                CornerRadius="6">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="17"
                        Height="17"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="ScanHelper" />

                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource Primary}"
                        Text="امسح الرمز بكاميرا الهاتف"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>