<UserControl
    x:Class="OrderHub.UI.Components.Buttons.ButtonAdd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        Background="Transparent"
        BorderBrush="{StaticResource SuccessBrush}"
        Command="{Binding ShowCreateCommand}"
        Cursor="Hand"
        Foreground="{StaticResource SuccessBrush}"
        Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={converters:BoolToVisibilityConverter}}">
        <StackPanel Orientation="Horizontal">
            <icons:MaterialIcon
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Kind="PlusCircle" />

            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Arial"
                FontSize="16"
                FontWeight="Bold"
                Text="إضافة" />
        </StackPanel>
    </Button>

</UserControl>
