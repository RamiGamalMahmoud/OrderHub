<Window
    x:Class="OrderHub.UI.Features.Confirm.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Confirm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="View"
    d:DataContext="{d:DesignInstance Type=local:View}"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Background>
        <SolidColorBrush Opacity="0.5" Color="Black" />
    </Window.Background>

    <Border
        Padding="50,20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{StaticResource WhiteBrush}"
        CornerRadius="5"
        FlowDirection="RightToLeft">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="5"
                Background="{StaticResource LightBlueBrush}"
                CornerRadius="5">
                <TextBlock
                    FontFamily="arial"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource MaterialDesign.Brush.Primary}"
                    Text="رسالة تأكيد"
                    TextAlignment="Center" />
            </Border>

            <Border
                Grid.Row="1"
                Margin="0,10"
                Padding="10"
                Background="{StaticResource WhiteBrush}"
                CornerRadius="5">
                <TextBlock
                    Grid.Row="1"
                    Margin="0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="arial"
                    FontSize="20"
                    Foreground="{StaticResource BlackBrush}"
                    Text="{Binding Message}" />
            </Border>

            <StackPanel
                Grid.Row="2"
                Margin="0,5"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="5,0"
                    Background="{StaticResource SuccessBrush}"
                    Command="{Binding ConfirmCommand}"
                    Content="موافق"
                    FontFamily="Arial"
                    FontSize="16"
                    FontWeight="Bold"
                    IsDefault="True" />
                <Button
                    Width="100"
                    Margin="5,0"
                    BorderBrush="{StaticResource WarningBrush}"
                    Command="{Binding CancelCommand}"
                    Content="الغاء"
                    FontFamily="Arial"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource WarningBrush}"
                    IsCancel="True"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

        </Grid>
    </Border>

</Window>
