<UserControl
    x:Class="OrderHub.UI.Features.Confirm.ConfirmDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Confirm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ConfirmDialogViewModel}"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <Border
        Width="420"
        Background="{DynamicResource RegionBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  =========================================================  -->
            <!--  Header  -->
            <!--  =========================================================  -->

            <Grid Grid.Row="0" Margin="16,14,16,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <!--  Icon  -->

                <Border
                    Width="42"
                    Height="42"
                    Background="{DynamicResource WarningBrush}"
                    CornerRadius="21">

                    <icons:MaterialIcon
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="AlertOutline" />

                </Border>


                <!--  Title  -->

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="تأكيد العملية" />

                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="يرجى تأكيد اختيارك للمتابعة" />

                </StackPanel>


                <!--  Close  -->

                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CancelCommand}"
                    Cursor="Hand"
                    ToolTip="إغلاق">

                    <icons:MaterialIcon
                        Width="17"
                        Height="17"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Kind="Close" />

                </Button>

            </Grid>


            <!--  =========================================================  -->
            <!--  Content  -->
            <!--  =========================================================  -->

            <StackPanel Grid.Row="1" Margin="16,8,16,16">

                <Border
                    Padding="14"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">

                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        LineHeight="22"
                        Text="{Binding Message}"
                        TextWrapping="Wrap" />

                </Border>

            </StackPanel>


            <!--  =========================================================  -->
            <!--  Footer  -->
            <!--  =========================================================  -->

            <Border
                Grid.Row="2"
                Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  Cancel  -->

                    <Button
                        Grid.Column="0"
                        Width="95"
                        Height="34"
                        HorizontalAlignment="Left"
                        Command="{Binding CancelCommand}"
                        Content="إلغاء"
                        Cursor="Hand"
                        IsCancel="True" />


                    <!--  Confirm  -->

                    <Button
                        Grid.Column="1"
                        Width="105"
                        Height="34"
                        Margin="8,0,0,0"
                        Command="{Binding ConfirmCommand}"
                        Content="موافق"
                        Cursor="Hand"
                        IsDefault="True"
                        Style="{StaticResource ButtonPrimary}" />

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>