<UserControl
    x:Class="OrderHub.UI.Features.Categories.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Categories.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border
        Width="400"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FlowDirection="RightToLeft">

        <StackPanel>

            <!--  Category Name  -->
            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="اسم القسم" />

            <TextBox
                MinHeight="40"
                Padding="10,6"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Parent Category  -->
            <Grid Margin="0,24,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="القسم الرئيسي" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.65"
                    Text="اختياري" />

                <TextBlock
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,5,0,10"
                    FontSize="12"
                    Opacity="0.7"
                    Text="{Binding SelectedParent.FullPath}" />

            </Grid>

            <!--  Root Category  -->
            <ComboBox
                MinHeight="40"
                DisplayMemberPath="Name"
                ItemsSource="{Binding CategorySelection.RootCategories}"
                SelectedItem="{Binding SelectedParent}" />

            <!--  Child Categories  -->
            <ItemsControl ItemsSource="{Binding CategorySelection.SubCategories}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <ComboBox
                            MinHeight="40"
                            Margin="0,8,0,0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Value}"
                            SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.SelectedParent}" />

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

            <!--  Actions  -->

            <Button
                MinHeight="40"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Content="حفظ"
                Cursor="Hand"
                FontSize="14"
                FontWeight="SemiBold"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />

        </StackPanel>

    </Border>

</UserControl>