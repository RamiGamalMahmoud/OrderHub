<Window
    x:Class="OrderHub.UI.Features.Categories.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Categories.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="Arial"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Width="360"
        Margin="12"
        Padding="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12"
        FlowDirection="RightToLeft">
        <Grid>

            <StackPanel>

                <TextBlock Margin="0,16,0,4" Text="اسم اقسم" />

                <TextBox Height="32" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,12,0,4" Text="القسم الرئيسي (اختياري)" />

                <ComboBox
                    Height="32"
                    DisplayMemberPath="FullPath"
                    IsEditable="False"
                    ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding SelectedParent}" />

                <StackPanel
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,12,0"
                        Padding="16,6"
                        Command="{Binding SaveCommand}"
                        Content="حفظ"
                        FontFamily="Arial"
                        FontWeight="Bold"
                        IsDefault="True" />
                    <Button
                        Width="80"
                        Padding="16,6"
                        BorderBrush="{StaticResource DangerBrush}"
                        Click="Button_Click"
                        Content="إلغاء"
                        FontFamily="Arial"
                        FontWeight="Bold"
                        Foreground="{StaticResource DangerBrush}" />
                </StackPanel>

            </StackPanel>

        </Grid>
    </Border>

</Window>
