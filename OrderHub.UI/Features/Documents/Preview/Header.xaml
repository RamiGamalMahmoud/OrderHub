<UserControl
    x:Class="OrderHub.UI.Features.Documents.Preview.Header"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Documents.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="14,10"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,0,1">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!--  Document Information  -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <Border
                    Width="36"
                    Height="36"
                    Background="#FEF2F2"
                    CornerRadius="6">

                    <icons:MaterialIcon
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource DangerBrush}"
                        Kind="FilePdfBox" />

                </Border>

                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">

                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        Text="{Binding DocumentName, FallbackValue='مستند'}"
                        TextTrimming="CharacterEllipsis" />

                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">

                        <TextBlock
                            FontSize="11"
                            Foreground="#94A3B8"
                            Text="المرسل إليه: " />

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Text="{Binding RecipientName, FallbackValue='أحمد محمد علي'}" />

                    </StackPanel>

                </StackPanel>

            </StackPanel>


            <!--  Actions  -->
            <local:Actions Grid.Column="1" />

        </Grid>

    </Border>

</UserControl>
