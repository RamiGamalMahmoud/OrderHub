<UserControl
    x:Class="OrderHub.UI.Features.Documents.Preview.Actions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="clr-namespace:OrderHub.UI.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Documents.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PreviewDocumentViewModel}"
    mc:Ignorable="d">

    <StackPanel
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        FlowDirection="RightToLeft"
        Orientation="Horizontal">

        <!--  Send  -->
        <Button
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding SendDocumentCommand}"
            Cursor="Hand"
            FontWeight="SemiBold"
            Style="{StaticResource ButtonPrimary}">

            <StackPanel Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="14"
                    Height="14"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Kind="Send" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="إرسال المستند" />

            </StackPanel>

        </Button>


        <!--  Download  -->
        <Button
            Width="100"
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding Source={x:Static commands:AppCommands.Instance}, Path=Documents.SaveFileFromUrlCommand}"
            CommandParameter="{Binding DocumentUri}"
            Cursor="Hand"
            Style="{StaticResource ButtonPrimary}"
            ToolTip="تنزيل">

            <StackPanel Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="15"
                    Height="15"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Kind="Download" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="تنزيل" />

            </StackPanel>

        </Button>


        <!--  Open in Browser  -->
        <Button
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding Source={x:Static commands:AppCommands.Instance}, Path=Documents.OpenInBrowserCommand}"
            CommandParameter="{Binding DocumentUri}"
            Cursor="Hand"
            Style="{StaticResource ButtonPrimary}"
            ToolTip="عرض المستند في المتصفح">

            <StackPanel Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="15"
                    Height="15"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Kind="GoogleChrome" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="عرض في المتصفح" />

            </StackPanel>

        </Button>

        <!--  Create QR Code  -->
        <Button
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding Source={x:Static commands:AppCommands.Instance}, Path=Documents.CreateQrCodeCommand}"
            CommandParameter="{Binding DocumentUri}"
            Cursor="Hand"
            Style="{StaticResource ButtonPrimary}"
            ToolTip="عرض المستند في المتصفح">

            <StackPanel Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="15"
                    Height="15"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Kind="Qrcode" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="إنشاء QR Code" />

            </StackPanel>

        </Button>

    </StackPanel>

</UserControl>
