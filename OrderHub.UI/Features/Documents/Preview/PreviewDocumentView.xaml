<UserControl
    x:Class="OrderHub.UI.Features.Documents.Preview.PreviewDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commands="clr-namespace:OrderHub.UI.Commands"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Documents.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Height="800"
    MinWidth="800"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=local:PreviewDocumentViewModel}"
    FontFamily="{StaticResource Cairo}"
    mc:Ignorable="d">

    <Border Background="{DynamicResource RegionBrush}" FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="*" />
                <!--  PDF  -->
            </Grid.RowDefinitions>


            <!--  =====================================================  -->
            <!--  1. Header  -->
            <!--  =====================================================  -->

            <local:Header Grid.Row="0" />


            <!--  =====================================================  -->
            <!--  2. PDF Viewer  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="1"
                Margin="14"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">

                <Grid>

                    <wv2:WebView2
                        Name="PdfWebView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Source="{Binding DocumentUri}" />

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>