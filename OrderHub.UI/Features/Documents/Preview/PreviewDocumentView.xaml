<UserControl
    x:Class="OrderHub.UI.Features.Documents.Preview.PreviewDocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Documents.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Height="800"
    MinWidth="800"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=local:PreviewDocumentViewModel}"
    FontFamily="{StaticResource Cairo}"
    mc:Ignorable="d">

    <Border Background="{DynamicResource RegionBrush}" FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Header  -->
                <RowDefinition Height="*" />
                <!--  PDF  -->
                <RowDefinition Height="Auto" />
                <!--  Footer  -->
            </Grid.RowDefinitions>


            <!--  =====================================================  -->
            <!--  1. Header  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="0"
                Padding="14,10"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  Document Information  -->

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <Border
                            Width="36"
                            Height="36"
                            Background="#FEF2F2"
                            CornerRadius="6">

                            <icons:MaterialIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource DangerBrush}"
                                Kind="FilePdfBox" />

                        </Border>


                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">

                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#334155"
                                Text="{Binding DocumentName, FallbackValue='مستند'}"
                                TextTrimming="CharacterEllipsis" />

                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">

                                <TextBlock
                                    FontSize="11"
                                    Foreground="#94A3B8"
                                    Text="المرسل إليه: " />

                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#64748B"
                                    Text="{Binding RecipientName, FallbackValue='أحمد محمد علي'}" />

                            </StackPanel>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!--  =====================================================  -->
            <!--  2. PDF Viewer  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="1"
                Margin="14"
                Background="#F1F5F9"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="6">

                <Grid>

                    <wv2:WebView2
                        Name="PdfWebView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Source="{Binding DocumentUri}" />

                </Grid>

            </Border>


            <!--  =====================================================  -->
            <!--  3. Footer  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="2"
                Padding="14,10"
                HorizontalAlignment="Center"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  Send  -->
                    <Button
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="20,0"
                        Command="{Binding SendDocumentCommand}"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Style="{StaticResource ButtonPrimary}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Send" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="إرسال المستند" />

                        </StackPanel>

                    </Button>



                    <!--  Show in Folder  -->
                    <Button
                        Height="36"
                        Padding="14,0"
                        Command="{Binding ShowInFolderCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="عرض المستند في المجلد">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="FolderOpen" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="عرض في المجلد" />

                        </StackPanel>

                    </Button>

                    <!--  Show in Folder  -->
                    <Button
                        Height="36"
                        Margin="10,0,0,0"
                        Padding="14,0"
                        Command="{Binding OpenInBrowserCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="عرض المستند في المتصفح">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="GoogleChrome" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="عرض في المتصفح" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>