<Window
    x:Class="OrderHub.UI.Features.Cities.Create.CreateCityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Cities.Create"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="إضافة مدينة"
    d:DataContext="{d:DesignInstance Type=local:CreateCityViewModel}"
    FontFamily="{StaticResource FontFamily}"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <Border Padding="20">
        <Grid Width="210" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    Cursor="Hand"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    Cursor="Hand"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>

</Window>
