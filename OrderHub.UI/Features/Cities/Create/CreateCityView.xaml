<UserControl
    x:Class="OrderHub.UI.Features.Cities.Create.CreateCityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Cities.Create"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:CreateCityViewModel}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border
        Width="420"
        Padding="24"
        Background="White"
        FlowDirection="RightToLeft">

        <StackPanel>

            <!--  Name  -->
            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="اسم المدينة" />

            <hc:TextBox
                MinHeight="40"
                Padding="10,6"
                hc:InfoElement.Necessary="True"
                hc:InfoElement.Placeholder="أدخل اسم المدينة"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Actions  -->

            <Button
                MinHeight="40"
                Margin="0,20,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Content="حفظ"
                Cursor="Hand"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />

        </StackPanel>

    </Border>

</UserControl>