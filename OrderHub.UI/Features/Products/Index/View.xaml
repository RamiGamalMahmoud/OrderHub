<UserControl
    x:Class="OrderHub.UI.Features.Products.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="إدارة المنتجات" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن منتج ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <ToggleButton
                    x:Name="FilterButton"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    IsChecked="{Binding Filter}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </ToggleButton>

            </StackPanel>

            <Button
                Grid.Column="2"
                Height="40"
                hc:BorderElement.CornerRadius="7"
                Background="#facc15"
                Command="{Binding ShowCreateCommand}"
                Cursor="Hand"
                Foreground="Black">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Margin="5,0"
                        Kind="Plus" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="DemiBold"
                        Text="إضافة منتج" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Row="0"
                d:ItemsSource="{d:SampleData}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Products, IsAsync=True}">

                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Name}" Header="الاسم" />

                    <DataGridTextColumn Binding="{Binding Code}" Header="الكود" />

                    <DataGridTextColumn Binding="{Binding CategoryName}" Header="القسم" />

                    <DataGridTextColumn Binding="{Binding Price}" Header="السعر" />

                    <DataGridTemplateColumn Header="خيارات">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <buttons:ButtonEdit />
                                    <buttons:ButtonDelete Margin="5,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Column="1"
                Width="400"
                Margin="10,0,0,0"
                Visibility="{Binding ElementName=FilterButton, Converter={converters:BoolToVisibilityConverter}, Path=IsChecked}">
                <StackPanel Orientation="Vertical">
                    <Border
                        Padding="12"
                        Background="{StaticResource WhiteBrush}"
                        CornerRadius="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="DemiBold"
                            Foreground="{StaticResource Primary}"
                            Text="القسم" />
                    </Border>
                    <ComboBox
                        Height="40"
                        Margin="0,5"
                        DisplayMemberPath="Name"
                        FontSize="16"
                        FontWeight="DemiBold"
                        ItemsSource="{Binding RootCategories}"
                        SelectedItem="{Binding SelectedCategory}" />

                    <ItemsControl ItemsSource="{Binding SubCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ComboBox
                                    Height="40"
                                    Margin="0,5"
                                    DisplayMemberPath="Name"
                                    FontSize="16"
                                    FontWeight="DemiBold"
                                    ItemsSource="{Binding Value}"
                                    SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SelectedCategory}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Border>

        </Grid>
    </Grid>

</UserControl>
