<Window
    x:Class="OrderHub.UI.Features.Products.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Height="650"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    Background="#F5F6FA"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="Width"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="20" FlowDirection="RightToLeft">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Content  -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <components:ProductDetails Grid.Column="0" />

            <components:SuppliersCard Grid.Column="2" />

            <components:ProductPropertiesCard Grid.Column="4" />

        </Grid>

        <!--  Footer  -->

        <components:Footer Grid.Row="2" />

    </Grid>

</Window>