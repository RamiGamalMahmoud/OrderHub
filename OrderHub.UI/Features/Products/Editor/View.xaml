<Window
    x:Class="OrderHub.UI.Features.Products.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Height="650"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    Background="#F5F6FA"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="Width"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Margin="20" FlowDirection="RightToLeft">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Content  -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  =========================  -->
            <!--  Product Information Card  -->
            <!--  =========================  -->

            <Border
                Grid.Column="0"
                Padding="20"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.08"
                        ShadowDepth="1" />
                </Border.Effect>

                <StackPanel>

                    <TextBlock
                        Margin="0,0,0,18"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="بيانات المنتج" />

                    <!--  Product Name  -->

                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="اسم المنتج" />

                    <TextBox Height="36" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Price + Code  -->

                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Price  -->

                        <StackPanel Grid.Column="0">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="السعر" />

                            <TextBox Height="36" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <!--  Code  -->

                        <StackPanel Grid.Column="2">

                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="الكود" />

                            <TextBox Height="36" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                    </Grid>

                    <!--  Category  -->

                    <DockPanel Margin="0,0,0,6">

                        <TextBlock
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="القسم" />

                        <Border
                            Padding="8,3"
                            Background="#F3F4F6"
                            CornerRadius="5"
                            DockPanel.Dock="Right"
                            Visibility="{Binding IsFullPathVisible, Converter={StaticResource Boolean2VisibilityConverter}}">

                            <TextBlock
                                FontSize="12"
                                Foreground="Gray"
                                Text="{Binding SelectedCategory.FullPath}" />

                        </Border>

                    </DockPanel>

                    <!--  Root Category  -->

                    <ComboBox
                        Height="36"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        FontSize="15"
                        FontWeight="SemiBold"
                        ItemsSource="{Binding CategorySelection.RootCategories}"
                        SelectedItem="{Binding SelectedCategory}" />

                    <!--  Sub Categories  -->

                    <ItemsControl ItemsSource="{Binding CategorySelection.SubCategories}">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <ComboBox
                                    Height="36"
                                    Margin="0,0,0,10"
                                    DisplayMemberPath="Name"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    ItemsSource="{Binding Value}"
                                    SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectedCategory}" />

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>
            <!--  =========================  -->
            <!--  Suppliers Card  -->
            <!--  =========================  -->

            <Border
                Grid.Column="2"
                Padding="20"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="12">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="15"
                        Opacity="0.08"
                        ShadowDepth="1" />
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="الموردون" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Suppliers}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                        Height="40"
                                        Margin="4"
                                        Padding="10,6"
                                        Background="#FAFAFA"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="6">

                                        <CheckBox
                                            MinWidth="130"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectSupplierCommand}"
                                            Content="{Binding Value.Name}"
                                            Cursor="Hand"
                                            IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

        <!--  Footer  -->

        <Border
            Grid.Row="2"
            Margin="0,20,0,0"
            Padding="0,16,0,0"
            BorderBrush="#E5E7EB"
            BorderThickness="0,1,0,0">

            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="Gray"
                    Text="{Binding Title}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">


                    <Button
                        Width="120"
                        Height="38"
                        Margin="0,0,8,0"
                        Command="{Binding SaveCommand}"
                        Content="حفظ"
                        Cursor="Hand"
                        IsDefault="True"
                        Style="{StaticResource ButtonPrimary}" />

                    <Button
                        Width="120"
                        Height="38"
                        Command="{Binding CloseEditorCommand}"
                        Content="إلغاء"
                        Cursor="Hand"
                        IsCancel="True" />

                </StackPanel>
            </Grid>

        </Border>

    </Grid>

</Window>