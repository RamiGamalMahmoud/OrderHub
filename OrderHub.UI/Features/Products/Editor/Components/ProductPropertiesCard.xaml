<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.ProductPropertiesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Padding="20"
        d:Width="300"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="TuneVariant" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="خصائص المننج" />
                </StackPanel>

                <hc:SearchBar
                    Height="40"
                    Margin="0,12,0,0"
                    hc:InfoElement.Placeholder="البحث عن خاصية ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Properties}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="4"
                                Padding="10,6"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Vertical">

                                        <StackPanel Orientation="Horizontal">
                                            <icons:MaterialIcon
                                                Width="14"
                                                Margin="0,0,5,0"
                                                Foreground="{StaticResource SuccessBrush}"
                                                Kind="CheckBox"
                                                Visibility="{Binding IsAssigned, Converter={converters:BoolToVisibilityConverter}}" />
                                            <TextBlock
                                                Cursor="Hand"
                                                FontSize="12"
                                                FontWeight="DemiBold"
                                                Text="{Binding Name}" />
                                        </StackPanel>

                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            Cursor="Hand"
                                            FontSize="10"
                                            Foreground="{StaticResource Primary}"
                                            Text="{Binding PropertyType}" />
                                    </StackPanel>

                                    <hc:ComboBox
                                        Grid.Column="1"
                                        Height="10"
                                        Margin="5,0"
                                        hc:InfoElement.Placeholder="حالة الخاصية"
                                        Cursor="Hand"
                                        DisplayMemberPath="DisplayName"
                                        FontSize="10"
                                        ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext. PropertyRequirements}"
                                        SelectedItem="{Binding PropertyRequirement}" />

                                    <Button
                                        Grid.Column="2"
                                        Padding="5"
                                        BorderThickness="0"
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.AddPropertyCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        IsEnabled="{Binding CanBeAdded}"
                                        Validation.ErrorTemplate="{x:Null}"
                                        Visibility="{Binding IsAssigned, Converter={converters:BoolToVisibilityConverter ForFalse=Visible, ForTrue=Collapsed}}">
                                        <icons:MaterialIcon Foreground="{StaticResource Primary}" Kind="PlusBox" />
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Padding="5"
                                        BorderThickness="0"
                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.RemovePropertyCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        Validation.ErrorTemplate="{x:Null}"
                                        Visibility="{Binding IsAssigned, Converter={converters:BoolToVisibilityConverter}}">
                                        <icons:MaterialIcon Foreground="{StaticResource DangerBrush}" Kind="Trash" />
                                    </Button>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>
</UserControl>
