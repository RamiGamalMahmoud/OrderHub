<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.ProductPropertiesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Padding="20"
        d:Width="300"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">


        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.08"
                ShadowDepth="1" />
        </Border.Effect>

    </Border>
</UserControl>
