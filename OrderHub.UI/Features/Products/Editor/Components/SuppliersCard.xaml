<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.SuppliersCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="20"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <StackPanel Margin="0,0,0,16">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="Domain" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="الموردون" />

                </StackPanel>

                <hc:SearchBar
                    Height="40"
                    Margin="0,12,0,0"
                    hc:InfoElement.Placeholder="البحث عن مورد..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}" />

            </StackPanel>

            <!--  Suppliers  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Suppliers}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Margin="0,0,0,8"
                                Padding="10,6"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6">

                                <CheckBox
                                    MinHeight="28"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.SelectSupplierCommand}"
                                    Content="{Binding Value.Name}"
                                    Cursor="Hand"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>