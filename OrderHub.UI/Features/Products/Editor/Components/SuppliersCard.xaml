<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.SuppliersCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Grid.Column="2"
        Padding="20"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.08"
                ShadowDepth="1" />
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="Domain" />
                    <TextBlock
                        Margin="8,0,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="الموردون" />
                </StackPanel>

                <hc:SearchBar
                    Height="35"
                    Margin="0,0,0,8"
                    hc:InfoElement.Placeholder="البحث عن مورد"
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}" />

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding Suppliers}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Height="40"
                                Margin="4"
                                Padding="10,6"
                                Background="#FAFAFA"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="6">

                                <CheckBox
                                    MinWidth="130"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectSupplierCommand}"
                                    Content="{Binding Value.Name}"
                                    Cursor="Hand"
                                    IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Border>
</UserControl>
