<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.ProductDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="20"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <StackPanel>

            <!--  Header  -->
            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Primary}"
                    Kind="PackageVariantClosed" />

                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="بيانات المنتج" />

            </StackPanel>

            <!--  Product Name  -->
            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="اسم المنتج" />

            <hc:TextBox
                MinHeight="40"
                Padding="10,6"
                hc:InfoElement.Placeholder="أدخل اسم المنتج"
                hc:InfoElement.ShowClearButton="True"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Price + Code  -->
            <Grid Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!--  Price  -->
                <StackPanel Grid.Column="0">

                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="السعر" />

                    <hc:TextBox
                        MinHeight="40"
                        Padding="10,6"
                        hc:InfoElement.Placeholder="سعر المنتج"
                        Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <!--  Code  -->
                <StackPanel Grid.Column="2">

                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="الكود" />

                    <hc:TextBox
                        MinHeight="40"
                        Padding="10,6"
                        hc:InfoElement.Placeholder="كود المنتج"
                        Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

            </Grid>

            <!--  Category  -->
            <Grid Margin="0,24,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="القسم" />

                <Border
                    Grid.Column="1"
                    Padding="8,3"
                    Background="#F3F4F6"
                    CornerRadius="5"
                    Visibility="{Binding IsFullPathVisible, Converter={StaticResource Boolean2VisibilityConverter}}">

                    <TextBlock
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding SelectedCategory.FullPath}" />

                </Border>

            </Grid>

            <!--  Root Category  -->
            <hc:ComboBox
                MinHeight="40"
                Margin="0,0,0,10"
                hc:InfoElement.Placeholder="القسم الرئيسي"
                hc:InfoElement.ShowClearButton="True"
                DisplayMemberPath="Name"
                ItemsSource="{Binding CategorySelection.RootCategories}"
                SelectedItem="{Binding SelectedCategory}" />

            <!--  Sub Categories  -->
            <ItemsControl ItemsSource="{Binding CategorySelection.SubCategories}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <hc:ComboBox
                            MinHeight="40"
                            Margin="0,0,0,10"
                            hc:InfoElement.Placeholder="القسم الفرعي"
                            hc:InfoElement.ShowClearButton="True"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Value}"
                            SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectedCategory}" />

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </Border>

</UserControl>