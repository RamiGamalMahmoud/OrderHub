<UserControl
    x:Class="OrderHub.UI.Features.Products.Editor.Components.ProductDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Products.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Padding="20"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Opacity="0.08"
                ShadowDepth="1" />
        </Border.Effect>

        <StackPanel>

            <TextBlock
                Margin="0,0,0,18"
                FontSize="18"
                FontWeight="SemiBold"
                Text="بيانات المنتج" />

            <!--  Product Name  -->

            <TextBlock
                Margin="0,0,0,6"
                FontWeight="SemiBold"
                Text="اسم المنتج" />

            <TextBox Height="36" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Price + Code  -->

            <Grid Margin="0,8,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Price  -->

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="السعر" />

                    <TextBox Height="36" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <!--  Code  -->

                <StackPanel Grid.Column="2">

                    <TextBlock
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"
                        Text="الكود" />

                    <TextBox Height="36" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

            </Grid>

            <!--  Category  -->

            <DockPanel Margin="0,0,0,6">

                <TextBlock
                    DockPanel.Dock="Left"
                    FontWeight="SemiBold"
                    Text="القسم" />

                <Border
                    Padding="8,3"
                    Background="#F3F4F6"
                    CornerRadius="5"
                    DockPanel.Dock="Right"
                    Visibility="{Binding IsFullPathVisible, Converter={StaticResource Boolean2VisibilityConverter}}">

                    <TextBlock
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding SelectedCategory.FullPath}" />

                </Border>

            </DockPanel>

            <!--  Root Category  -->

            <ComboBox
                Height="36"
                Margin="0,0,0,10"
                DisplayMemberPath="Name"
                FontSize="15"
                FontWeight="SemiBold"
                ItemsSource="{Binding CategorySelection.RootCategories}"
                SelectedItem="{Binding SelectedCategory}" />

            <!--  Sub Categories  -->

            <ItemsControl ItemsSource="{Binding CategorySelection.SubCategories}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <ComboBox
                            Height="36"
                            Margin="0,0,0,10"
                            DisplayMemberPath="Name"
                            FontSize="15"
                            FontWeight="SemiBold"
                            ItemsSource="{Binding Value}"
                            SelectedItem="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.SelectedCategory}" />

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </Border>
</UserControl>
