<Window
    x:Class="OrderHub.UI.Features.Splash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500"
    Height="250"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arial"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Padding="20"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="8">

        <Border.Background>
            <ImageBrush ImageSource="/Resources/Images/OrderHub.png" Stretch="UniformToFill" />
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Width="34"
                Height="34"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#CCB71C1C"
                BorderBrush="#00FFFFFF"
                BorderThickness="0"
                Click="CloseButton_Click"
                Content="X"
                Cursor="Hand"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White" />

            <TextBlock
                Grid.Row="2"
                Margin="0,8"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="{Binding Message}" />

            <ProgressBar
                Grid.Row="3"
                Height="20"
                VerticalAlignment="Bottom"
                Background="#CCFFFFFF"
                BorderThickness="0"
                Foreground="#1976D2"
                Maximum="100"
                Minimum="0"
                Value="{Binding Value}" />
        </Grid>

    </Border>

</Window>
