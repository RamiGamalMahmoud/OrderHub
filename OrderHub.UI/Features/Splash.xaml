<Window
    x:Class="OrderHub.UI.Features.Splash"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500"
    Height="250"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Arial"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Padding="20"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="8">

        <Border.Background>
            <ImageBrush ImageSource="/Resources/Images/OrderHub.png" Stretch="UniformToFill" />
        </Border.Background>

        <ProgressBar
            Height="5"
            VerticalAlignment="Bottom"
            Background="White"
            BorderThickness="0"
            Foreground="#1976D2"
            IsIndeterminate="True" />

    </Border>

</Window>
