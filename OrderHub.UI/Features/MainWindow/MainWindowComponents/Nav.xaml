<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.Nav"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.MainWindow"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <ListBox
        Grid.Row="1"
        ItemsSource="{Binding NavigationCommands}"
        SelectedItem="{Binding SelectedNavigationCommand}">

        <ListBox.ItemContainerStyle>
            <Style BasedOn="{StaticResource ListBoxItemBaseStyle}" TargetType="ListBoxItem">

                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinHeight" Value="38" />

                <Style.Triggers>

                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>

                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>

                </Style.Triggers>

            </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>

            <DataTemplate>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Kind="{Binding Icon}" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />

                </Grid>

            </DataTemplate>

        </ListBox.ItemTemplate>

    </ListBox>

</UserControl>