<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.SideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Grid.Row="0"
        Grid.RowSpan="4"
        Grid.Column="0"
        Padding="5"
        Background="White"
        CornerRadius="5">
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="1" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <Image
                    Height="30"
                    Cursor="Hand"
                    Opacity="0.7"
                    Source="/Resources/Images/order-hub-banner.png" />
            </StackPanel>

            <local:Nav Grid.Row="2" />

        </Grid>
    </Border>

</UserControl>
