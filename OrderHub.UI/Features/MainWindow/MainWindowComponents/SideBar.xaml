<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.SideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Grid.Row="0"
        Grid.RowSpan="4"
        Grid.Column="0"
        Padding="5"
        Background="White"
        CornerRadius="5">
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="1" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <Image
                    Height="30"
                    Cursor="Hand"
                    Opacity="0.7"
                    Source="/Resources/Images/order-hub-banner.png" />
            </StackPanel>

            <local:Nav Grid.Row="2" />

            <Button
                Grid.Row="3"
                Height="auto"
                Margin="0,5"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SuccessBrush}"
                Command="{Binding OpenWhatappCommand}"
                Cursor="Hand"
                Foreground="White">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Margin="5,0"
                        Kind="Whatsapp" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="DemiBold"
                        Text="فتح واتساب" />
                </StackPanel>
            </Button>

        </Grid>
    </Border>

</UserControl>
