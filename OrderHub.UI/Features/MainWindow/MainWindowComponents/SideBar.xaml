<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.SideBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Grid.Row="0"
        Grid.RowSpan="4"
        Grid.Column="0"
        Margin="0"
        Padding="8"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Logo  -->

            <Grid Grid.Row="0">

                <Image
                    Height="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Opacity="0.8"
                    Source="/Resources/Images/order-hub-banner.png" />

            </Grid>

            <!--  Navigation  -->

            <local:Nav Grid.Row="2" />

            <!--  WhatsApp  -->

            <Button
                Grid.Row="3"
                Height="38"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                Background="{StaticResource SuccessBrush}"
                Command="{Binding OpenWhatappCommand}"
                Cursor="Hand"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"
                IsEnabled="{Binding AppState.IsConnected}">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        Margin="0,0,6,0"
                        Kind="Whatsapp" />

                    <TextBlock VerticalAlignment="Center" Text="فتح واتساب" />

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>