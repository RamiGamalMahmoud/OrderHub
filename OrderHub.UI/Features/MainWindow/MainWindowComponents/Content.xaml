<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.Content"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="10,5"
        Background="White"
        CornerRadius="5">

        <ContentControl Content="{Binding NavigationService.Instance.CurrentView}" />
    </Border>

</UserControl>
