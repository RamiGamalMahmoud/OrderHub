<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.TopBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="5"
        Background="White"
        CornerRadius="5">
        <Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="Gray"
                    Text="{Binding NavigationCommand.Name}" />

            </StackPanel>

            <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="auto"
                    Height="auto"
                    Margin="10,0"
                    Padding="2"
                    Cursor="Hand"
                    Foreground="{StaticResource DangerBrush}">
                    <icons:MaterialIcon
                        Grid.Column="0"
                        Width="20"
                        Height="20"
                        Cursor="Hand"
                        Kind="NotificationsNone" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="Username" />
            </Grid>

        </Grid>
    </Border>

</UserControl>
