<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.BottomBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:OrderHub.UI.Features.MainWindow"
    d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="SallaConnectionIcon" TargetType="icons:MaterialIcon">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="ToolTip" Value="Connected to Salla" />
                    <Setter Property="Kind" Value="Basket" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="ToolTip" Value="Not connected to Salla" />
                    <Setter Property="Kind" Value="BasketOff" />
                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <Border
        Margin="0,4,0,0"
        Padding="8,4"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="6,6,0,0">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Status Icons -->

            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <Button
                    Width="26"
                    Height="26"
                    Padding="0"
                    Margin="0,0,4,0"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    Command="{Binding LoginSallaCommand}"
                    Visibility="{Binding IsAppInDebug, Converter={converters:BoolToVisibilityConverter}}">

                    <icons:MaterialIcon Style="{StaticResource SallaConnectionIcon}" />

                </Button>

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Kind="Internet">

                    <icons:MaterialIcon.Style>

                        <Style TargetType="icons:MaterialIcon">

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding AppState.IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding AppState.IsConnected}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </icons:MaterialIcon.Style>

                </icons:MaterialIcon>

            </StackPanel>

            <!-- Status Message -->

            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#4B5563"
                Text="{Binding Message}"
                TextTrimming="CharacterEllipsis" />

        </Grid>

    </Border>

</UserControl>