<UserControl
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowComponents.BottomBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:OrderHub.UI.Features.MainWindow"
    d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
    FlowDirection="RightToLeft"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Salla Status  -->

        <Style x:Key="SallaConnectionIcon" TargetType="icons:MaterialIcon">

            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter Property="ToolTip" Value="متصل بـ Salla" />
                    <Setter Property="Kind" Value="Basket" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsAuthenticated}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="ToolTip" Value="غير متصل بـ Salla" />
                    <Setter Property="Kind" Value="BasketOff" />
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!--  Status Icon  -->

        <Style x:Key="StatusIconStyle" TargetType="icons:MaterialIcon">

            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />

        </Style>

    </UserControl.Resources>

    <Border
        Margin="0,4,0,0"
        Padding="8,4"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1,1,1,0"
        CornerRadius="6,6,0,0">

        <Grid>

            <Grid.ColumnDefinitions>
                <!--  User  -->
                <ColumnDefinition Width="Auto" />

                <!--  Main / Update  -->
                <ColumnDefinition Width="*" />

                <!--  Application Status  -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>


            <!--  =========================================================  -->
            <!--  User  -->
            <!--  =========================================================  -->

            <Button
                Grid.Column="0"
                Height="32"
                Padding="5,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand">

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                    <Border
                        Width="32"
                        Height="32"
                        Background="#F3F4F6"
                        CornerRadius="16">

                        <icons:MaterialIcon
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <icons:MaterialIcon.Style>

                                <Style TargetType="icons:MaterialIcon">

                                    <Setter Property="Kind" Value="User" />

                                    <Setter Property="Foreground" Value="{StaticResource Primary}" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding ApplicationContext.User.IsAdmin}" Value="True">

                                            <Setter Property="Kind" Value="AdministratorOutline" />

                                            <Setter Property="Foreground" Value="#7C3AED" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </icons:MaterialIcon.Style>

                        </icons:MaterialIcon>

                    </Border>

                    <StackPanel
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Cairo}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1F2937"
                            Text="{Binding ApplicationContext.User.DisplayName}"
                            TextTrimming="CharacterEllipsis" />

                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Cairo}"
                            FontSize="11"
                            FontWeight="Medium"
                            Foreground="#7C3AED"
                            Text="مدير النظام"
                            Visibility="{Binding ApplicationContext.User.IsAdmin, Converter={converters:BoolToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

            </Button>


            <!--  =========================================================  -->
            <!--  Update  -->
            <!--  =========================================================  -->

            <Grid
                Grid.Column="1"
                Margin="20,0"
                VerticalAlignment="Center"
                Visibility="{Binding CanUpdate, Converter={converters:BoolToVisibilityConverter}}">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ApplicationContext.Update.NeedToUpdate, Converter={converters:BoolToVisibilityConverter}}">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="Update" />

                    <TextBlock
                        Margin="6,0,10,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="#4B5563"
                        Text="يتوفر تحديث جديد للبرنامج" />

                    <!--  Update  -->

                    <Button
                        Height="25"
                        Padding="8,0"
                        BorderThickness="0"
                        Command="{Binding UpdateCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonInfo}"
                        Visibility="{Binding IsUpdating, Converter={converters:BoolToVisibilityConverter ForTrue=Collapsed, ForFalse=Visible}}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="14"
                                Height="14"
                                Kind="Download" />

                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="تحديث الآن" />

                        </StackPanel>

                    </Button>

                    <!--  Progress  -->

                    <ProgressBar
                        Width="100"
                        Height="20"
                        Margin="10,0,0,0"
                        Maximum="100"
                        Minimum="0"
                        Visibility="{Binding IsUpdating, Converter={converters:BoolToVisibilityConverter}}"
                        Value="{Binding UpdateProgress}" />

                    <!--  Cancel  -->

                    <Button
                        Height="25"
                        Margin="10,0,0,0"
                        Padding="8,0"
                        BorderThickness="0"
                        Command="{Binding CancelUpdateCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonDashedDanger}"
                        Visibility="{Binding IsUpdating, Converter={converters:BoolToVisibilityConverter}}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="14"
                                Height="14"
                                Kind="CloseBox" />

                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="إلغاء التحديث" />


                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>


            <!--  =========================================================  -->
            <!--  Application Status  -->
            <!--  =========================================================  -->

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">


                <!--  Version  -->

                <Border
                    Height="28"
                    Margin="0,0,4,0"
                    Padding="8,0"
                    Background="#F9FAFB"
                    CornerRadius="5">

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="#6B7280"
                            Kind="InformationOutline" />

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#6B7280"
                            Text="الإصدار" />

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#6B7280"
                            Text="{Binding ApplicationContext.Application.Version}" />

                    </StackPanel>

                </Border>


                <!--  Database  -->

                <Button
                    Height="28"
                    Margin="2,0"
                    Padding="7,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding OpenDataFolderCommand}"
                    Cursor="Hand"
                    Foreground="#4B5563">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Text="قاعدة البيانات" />

                        <icons:MaterialIcon
                            Width="17"
                            Height="17"
                            Margin="5,0,0,0"
                            Kind="Database" />

                    </StackPanel>

                </Button>


                <!--  Connection  -->

                <Border
                    Height="28"
                    Margin="2,0"
                    Padding="7,0"
                    Background="#F9FAFB"
                    CornerRadius="5">

                    <StackPanel Orientation="Horizontal">

                        <icons:MaterialIcon VerticalAlignment="Center" Kind="Internet">

                            <icons:MaterialIcon.Style>

                                <Style BasedOn="{StaticResource StatusIconStyle}" TargetType="icons:MaterialIcon">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding AppState.IsConnected}" Value="True">

                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />

                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding AppState.IsConnected}" Value="False">

                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </icons:MaterialIcon.Style>

                        </icons:MaterialIcon>

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="#6B7280"
                            Text="الاتصال" />

                    </StackPanel>

                </Border>


                <!--  Salla  -->

                <Button
                    Width="28"
                    Height="28"
                    Margin="2,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding LoginSallaCommand}"
                    Cursor="Hand"
                    Visibility="{Binding IsAppInDebug, Converter={converters:BoolToVisibilityConverter}}">

                    <icons:MaterialIcon Style="{StaticResource SallaConnectionIcon}" />

                </Button>


                <!--  Separator  -->

                <Border
                    Width="1"
                    Height="20"
                    Margin="7,0"
                    Background="#E5E7EB" />


                <!--  Logout  -->

                <Button
                    Height="30"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding LogoutCommand}"
                    Cursor="Hand"
                    Foreground="{StaticResource DangerBrush}">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="تسجيل الخروج" />

                        <icons:MaterialIcon
                            Width="17"
                            Height="17"
                            Margin="5,0,0,0"
                            Kind="Logout" />

                    </StackPanel>

                </Button>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>
