<Window
    x:Class="OrderHub.UI.Features.MainWindow.MainWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.MainWindow"
    xmlns:mainWindowComponents="clr-namespace:OrderHub.UI.Features.MainWindow.MainWindowComponents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindowView"
    d:DataContext="{d:DesignInstance Type=local:MainWindowViewModel}"
    x:ClassModifier="internal"
    Background="{StaticResource WhiteBrush}"
    FontFamily="{StaticResource Tajawal}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border
        Padding="5"
        CornerRadius="5"
        FlowDirection="RightToLeft">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <mainWindowComponents:SideBar
                Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="0" />

            <mainWindowComponents:Content Grid.Row="0" Grid.Column="2" />

            <mainWindowComponents:BottomBanner Grid.Row="4" Grid.Column="2" />

        </Grid>
    </Border>

</Window>
