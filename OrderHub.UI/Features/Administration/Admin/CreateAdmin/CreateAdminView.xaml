<Window
    x:Class="OrderHub.UI.Features.Administration.Admin.CreateAdmin.CreateAdminView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Administration.Admin.CreateAdmin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource Cairo}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Background="#FFF7F7" FlowDirection="RightToLeft">

        <Border
            Width="560"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#F3D4D4">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->

                <StackPanel>

                    <Border
                        Width="58"
                        Height="58"
                        HorizontalAlignment="Center"
                        Background="#FFF0F0"
                        CornerRadius="29">

                        <icons:MaterialIcon
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#C62828"
                            Kind="AdministratorOutline" />

                    </Border>

                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="#252525"
                        Text="إعداد مدير النظام" />

                    <TextBlock
                        MaxWidth="430"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="#777777"
                        Text="لم يتم إنشاء حساب مدير للنظام بعد. أنشئ حساب المدير الأول للمتابعة."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,18,0,0"
                        Padding="12"
                        Background="#FFF8F8"
                        BorderBrush="#F5DADA"
                        BorderThickness="1"
                        CornerRadius="7">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,8,0"
                                VerticalAlignment="Top"
                                Foreground="#C62828"
                                Kind="InformationOutline" />

                            <TextBlock
                                FontSize="12"
                                Foreground="#6B4A4A"
                                LineHeight="20"
                                Text="حساب المدير يمتلك صلاحيات إدارة المستخدمين والصلاحيات وإعدادات النظام."
                                TextWrapping="Wrap" />

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!--  Form  -->

                <StackPanel Grid.Row="2">

                    <!--  Display Name  -->

                    <hc:TextBox
                        Height="60"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="اسم المدير"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="الاسم"
                        Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Username  -->

                    <hc:TextBox
                        Height="60"
                        Margin="0,14,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="اسم المستخدم"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="اسم المستخدم"
                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Password  -->

                    <hc:PasswordBox
                        Height="60"
                        Margin="0,14,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="كلمة المرور"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="كلمة المرور"
                        hc:ShowEyeButton="True"
                        IsSafeEnabled="False"
                        UnsafePassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Confirm Password  -->

                    <hc:PasswordBox
                        Height="60"
                        Margin="0,14,0,0"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="أعد كتابة كلمة المرور"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="تأكيد كلمة المرور"
                        hc:ShowEyeButton="True"
                        IsSafeEnabled="False"
                        UnsafePassword="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}" />

                </StackPanel>

                <!--  Footer  -->

                <StackPanel Grid.Row="4" HorizontalAlignment="Stretch">

                    <Button
                        Height="42"
                        Background="#C62828"
                        BorderBrush="#C62828"
                        Command="{Binding CreateCommand}"
                        Cursor="Hand"
                        Foreground="White">

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="19"
                                Height="19"
                                Margin="0,0,8,0"
                                Kind="ShieldCheckOutline" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="إنشاء حساب المدير" />

                        </StackPanel>

                    </Button>

                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#999999"
                        Text="سيتم تشفير كلمة المرور قبل حفظها في قاعدة البيانات." />

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
