<UserControl
    x:Class="OrderHub.UI.Features.Administration.Users.List.UsersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Administration.Users.List"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Title  -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                <TextBlock
                    FontFamily="{StaticResource Cairo}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#1F2937"
                    Text="إدارة المستخدمين" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontFamily="{StaticResource Cairo}"
                    FontSize="12"
                    Foreground="#6B7280"
                    Text="إدارة حسابات مستخدمي النظام وحالتهم" />
            </StackPanel>

            <!--  Add User  -->
            <Button
                Grid.Column="1"
                Height="40"
                MinWidth="145"
                Padding="16,0"
                VerticalAlignment="Center"
                Background="#2563EB"
                BorderThickness="0"
                Command="{Binding AddUserCommand}"
                Cursor="Hand"
                Foreground="White">

                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        Kind="AccountPlusOutline" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Cairo}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="إضافة مستخدم" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Users Table  -->
        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                CanUserSortColumns="True"
                ColumnHeaderHeight="44"
                FlowDirection="RightToLeft"
                GridLinesVisibility="Vertical"
                IsReadOnly="True"
                ItemsSource="{Binding Users}"
                RowHeaderWidth="0"
                RowHeight="40"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VerticalGridLinesBrush="LightGray">

                <DataGrid.Columns>

                    <!--  Display Name  -->
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding DisplayName}"
                        Header="الاسم" />

                    <!--  Username  -->
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding UserName}"
                        Header="اسم المستخدم" />

                    <!--  Admin  -->
                    <DataGridTemplateColumn Width="110" Header="المدير">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <icons:MaterialIcon
                                    Width="23"
                                    Height="23"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#DC2626"
                                    Kind="AdministratorOutline">

                                    <icons:MaterialIcon.Style>
                                        <Style TargetType="icons:MaterialIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </icons:MaterialIcon.Style>

                                </icons:MaterialIcon>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!--  Status  -->
                    <DataGridTemplateColumn Width="120" Header="الحالة">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="10,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="6">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!--  Inactive  -->
                                            <Setter Property="Background" Value="#FEE2E2" />

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#DCFCE7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Cairo}"
                                        FontSize="11"
                                        FontWeight="SemiBold">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <!--  Inactive  -->
                                                <Setter Property="Text" Value="معطل" />
                                                <Setter Property="Foreground" Value="#DC2626" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="نشط" />
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </Border>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <!--  Actions  -->
                    <DataGridTemplateColumn Width="160" Header="الخيارات">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                    <!--  Edit  -->
                                    <Button
                                        Width="34"
                                        Height="auto"
                                        Margin="3,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Id}"
                                        Cursor="Hand"
                                        ToolTip="تعديل">

                                        <icons:MaterialIcon
                                            Width="19"
                                            Height="19"
                                            Foreground="#2563EB"
                                            Kind="PencilOutline" />
                                    </Button>

                                    <!--  Activate / Deactivate  -->
                                    <Button
                                        Width="34"
                                        Height="auto"
                                        Margin="3,0"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.ToggleUserStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand">

                                        <Button.Style>
                                            <Style BasedOn="{StaticResource ButtonBaseStyle}" TargetType="Button">

                                                <Setter Property="ToolTip" Value="تفعيل" />

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="ToolTip" Value="تعطيل" />
                                                    </DataTrigger>
                                                </Style.Triggers>

                                            </Style>
                                        </Button.Style>

                                        <icons:MaterialIcon Width="19" Height="19">

                                            <icons:MaterialIcon.Style>
                                                <Style TargetType="icons:MaterialIcon">

                                                    <Setter Property="Kind" Value="AccountCheckOutline" />
                                                    <Setter Property="Foreground" Value="#16A34A" />

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Kind" Value="AccountCancelOutline" />
                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                        </DataTrigger>
                                                    </Style.Triggers>

                                                </Style>
                                            </icons:MaterialIcon.Style>

                                        </icons:MaterialIcon>

                                    </Button>

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>
</UserControl>