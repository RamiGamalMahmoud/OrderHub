<UserControl
    x:Class="OrderHub.UI.Features.Administration.Users.Shared.Components.UserDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource Cairo}"
    mc:Ignorable="d">

    <StackPanel>

        <!--  Display Name  -->
        <hc:TextBox
            Height="60"
            hc:InfoElement.Necessary="True"
            hc:InfoElement.Placeholder="اسم المستخدم"
            hc:InfoElement.ShowClearButton="True"
            hc:InfoElement.Title="الاسم"
            IsReadOnly="{Binding IsReadOnly}"
            Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

        <!--  Username  -->
        <hc:TextBox
            Height="60"
            Margin="0,14,0,0"
            hc:InfoElement.Necessary="True"
            hc:InfoElement.Placeholder="اسم الدخول"
            hc:InfoElement.ShowClearButton="True"
            hc:InfoElement.Title="اسم المستخدم"
            IsReadOnly="{Binding IsReadOnly}"
            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

    </StackPanel>

</UserControl>
