<UserControl
    x:Class="OrderHub.UI.Features.Administration.Users.Shared.Components.Permissions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource Cairo}"
    IsEnabled="{Binding IsAdmin, Converter={converters:BoolConverter Operand=False}}"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  Permissions Header  -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Header  -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">

                <Border
                    Width="38"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#F0F0FF"
                    CornerRadius="19">

                    <icons:MaterialIcon
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="ShieldAccountOutline" />

                </Border>

                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#252525"
                        Text="صلاحيات المستخدم" />

                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="10"
                        Foreground="#8A8A8A"
                        Text="حدد ما يمكن للمستخدم الوصول إليه وتعديله." />

                </StackPanel>

            </StackPanel>

            <!--  Select All  -->
            <Button
                Grid.Column="1"
                Margin="15,0,0,0"
                Padding="10,6"
                VerticalAlignment="Center"
                Command="{Binding SelectAllCommand}"
                Cursor="Hand"
                IsEnabled="{Binding IsAdmin, Converter={converters:BoolConverter Operand=False}}">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="17"
                        Height="17"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="SelectAll" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontWeight="Medium"
                        Foreground="#555555"
                        Text="اختيار الكل" />

                </StackPanel>

            </Button>

        </Grid>

        <!--  Permissions Table  -->
        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#ECECEC"
            BorderThickness="1"
            CornerRadius="7">

            <Grid MaxHeight="450">

                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <Grid Grid.Row="0" Background="#F8F8FA">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.5" />
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="0.5" />
                        <ColumnDefinition Width="85" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="14,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#555555"
                        Text="الميزة" />

                    <StackPanel
                        Grid.Column="1"
                        Width="1"
                        Height="20"
                        Background="LightGray" />

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#555555"
                        Text="قراءة" />

                    <StackPanel
                        Grid.Column="3"
                        Width="1"
                        Height="20"
                        Background="LightGray" />

                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#555555"
                        Text="تعديل" />

                </Grid>

                <!--  Permission Items  -->
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl ItemsSource="{Binding Permissions}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    MinHeight="44"
                                    BorderBrush="#F0F0F0"
                                    BorderThickness="0,1,0,0">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="0.5" />
                                            <ColumnDefinition Width="85" />
                                            <ColumnDefinition Width="0.5" />
                                            <ColumnDefinition Width="85" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="14,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#374151"
                                            Text="{Binding Feature}" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Width="1"
                                            Height="20"
                                            Background="LightGray" />

                                        <CheckBox
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            IsChecked="{Binding CanRead, UpdateSourceTrigger=PropertyChanged}" />

                                        <StackPanel
                                            Grid.Column="3"
                                            Width="1"
                                            Height="20"
                                            Background="LightGray" />

                                        <CheckBox
                                            Grid.Column="4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            IsChecked="{Binding CanWrite, UpdateSourceTrigger=PropertyChanged}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>