<UserControl
    x:Class="OrderHub.UI.Features.Administration.Users.Shared.Components.UserEditorHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{StaticResource Cairo}"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Title  -->
        <StackPanel Grid.Column="0" Orientation="Horizontal">

            <Border
                Width="48"
                Height="48"
                Margin="0,0,12,0"
                Background="#F0F0FF"
                CornerRadius="24">

                <icons:MaterialIcon
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Primary}"
                    Kind="AccountOutline" />

            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="#252525"
                    Text="{Binding Title}" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#777777"
                    Text="إدارة بيانات حساب المستخدم داخل النظام." />

            </StackPanel>

        </StackPanel>

        <!--  Edit  -->
        <Button
            Grid.Column="1"
            Margin="15,0,0,0"
            Padding="10,6"
            VerticalAlignment="Center"
            Background="#F0F0FF"
            BorderThickness="0"
            Command="{Binding EditCommand}"
            Cursor="Hand"
            Visibility="{Binding IsReadOnly, Converter={converters:BoolToVisibilityConverter}}">

            <StackPanel Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="17"
                    Height="17"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource Primary}"
                    Kind="PencilOutline" />

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="Medium"
                    Foreground="{StaticResource Primary}"
                    Text="تعديل" />

            </StackPanel>

        </Button>

    </Grid>

</UserControl>