<UserControl
    x:Class="OrderHub.UI.Features.ShippingCarriers.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.ShippingCarriers.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border
        Width="420"
        Margin="10"
        Padding="10">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  Company Information  -->

            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Margin="0,0,0,14">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="اسم شركة الشحن" />

                <TextBox
                    Height="34"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Shipping Cost  -->

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,6,14">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="تكلفة الشحن" />

                <TextBox
                    Height="34"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding ShippingCostText, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Address Header  -->

            <TextBlock
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,4,0,10"
                FontSize="13"
                FontWeight="SemiBold"
                Opacity="0.7"
                Text="العنوان" />


            <!--  City  -->

            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,6,14">

                <DockPanel Margin="0,0,0,6">

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="المدينة" />

                    <Button
                        Margin="6,0,0,0"
                        Padding="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand"
                        ToolTip="إضافة مدينة">

                        <icons:MaterialIcon
                            Width="17"
                            Height="17"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />

                    </Button>

                </DockPanel>

                <ComboBox
                    Height="34"
                    Padding="6,0"
                    DisplayMemberPath="Name"
                    IsEditable="False"
                    ItemsSource="{Binding Cities}"
                    SelectedItem="{Binding SelectedCity}" />

            </StackPanel>


            <!--  Street  -->

            <StackPanel
                Grid.Row="3"
                Grid.Column="1"
                Margin="6,0,0,14">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="الشارع" />

                <TextBox
                    Height="34"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Contact Header  -->

            <TextBlock
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,2,0,10"
                FontSize="13"
                FontWeight="SemiBold"
                Opacity="0.7"
                Text="بيانات الاتصال" />


            <!--  Phone  -->

            <StackPanel
                Grid.Row="5"
                Grid.Column="0"
                Margin="0,0,6,16">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="رقم الهاتف" />

                <TextBox
                    Height="34"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Country Code  -->

            <StackPanel
                Grid.Row="5"
                Grid.Column="1"
                Margin="6,0,0,16">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="رمز الدولة" />

                <TextBox
                    Height="34"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Save  -->

            <Button
                Grid.Row="6"
                Grid.ColumnSpan="2"
                Height="38"
                Margin="0,2,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Content="حفظ"
                Cursor="Hand"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />

        </Grid>

    </Border>

</UserControl>