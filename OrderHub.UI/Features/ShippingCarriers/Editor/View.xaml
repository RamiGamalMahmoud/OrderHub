<Window
    x:Class="OrderHub.UI.Features.ShippingCarriers.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.ShippingCarriers.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="Arial"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border
        Width="400"
        Margin="12"
        Padding="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12"
        FlowDirection="RightToLeft">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="اسم شركة الشحن" />
                <TextBox Height="32" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,5,0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="تكلفة الشحن" />
                <TextBox Height="32" Text="{Binding ShippingCostText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.Column="0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="المدينة" />

                <ComboBox
                    Height="32"
                    DisplayMemberPath="Name"
                    IsEditable="False"
                    ItemsSource="{Binding Cities}"
                    SelectedItem="{Binding SelectedCity}" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.Column="1"
                Margin="5,0,0,0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="الشارع" />
                <TextBox Height="32" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Grid.Column="0"
                Margin="5,0,0,0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="رقم الهاتف" />
                <TextBox Height="32" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="3"
                Grid.Column="1"
                Margin="5,0,0,0"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="رمز الدولة" />
                <TextBox Height="32" Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,12,0"
                    Padding="16,6"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    FontFamily="Arial"
                    FontWeight="Bold" />
                <Button
                    Width="80"
                    Padding="16,6"
                    BorderBrush="{StaticResource DangerBrush}"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    FontFamily="Arial"
                    FontWeight="Bold"
                    Foreground="{StaticResource DangerBrush}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
