<Window
    x:Class="OrderHub.UI.Features.Suppliers.Editor.EditSupplierView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Suppliers.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CreateView"
    Width="700"
    Height="630"
    d:DataContext="{d:DesignInstance Type=local:EditSupplierViewModelBase}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource Tajawal}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border Padding="16" FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Margin="0,0,0,12"
                FontSize="22"
                FontWeight="SemiBold"
                Text="بيانات المورد" />

            <!--  Main Content  -->
            <ScrollViewer Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Orientation="Vertical">

                    <!--  Supplier Name  -->
                    <GroupBox Margin="0,0,0,10" Header="المعلومات الأساسية">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="اسم المورد:" />
                            <TextBox
                                Grid.Column="1"
                                FontSize="16"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <!--  Business Hours  -->
                    <GroupBox Margin="0,0,0,10" Header="أوقات الدوام">
                        <StackPanel Margin="10" Orientation="Horizontal">

                            <TextBlock
                                Padding="5"
                                VerticalAlignment="Center"
                                Background="{StaticResource LightBlueBrush}"
                                FontWeight="Bold"
                                Text="من:" />
                            <hc:TimePicker
                                Width="120"
                                Margin="5,0"
                                Padding="5"
                                SelectedTime="{Binding OpenAt, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                            <TextBlock
                                Padding="5"
                                VerticalAlignment="Center"
                                Background="{StaticResource LightBlueBrush}"
                                FontWeight="Bold"
                                Text="إلى:" />
                            <hc:TimePicker
                                Width="120"
                                Margin="5,0"
                                Padding="5"
                                SelectedTime="{Binding CloseAt, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{Binding ErrorMessage}" />

                        </StackPanel>
                    </GroupBox>

                    <!--  Phones  -->
                    <GroupBox Margin="0,0,0,10" Header="رقم الهاتف">
                        <DockPanel Margin="10">

                            <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <TextBox
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        FlowDirection="LeftToRight"
                                        Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Width="80"
                                        Margin="5,0,0,0"
                                        FlowDirection="LeftToRight"
                                        Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                        </DockPanel>
                    </GroupBox>

                    <!--  Addresses  -->
                    <GroupBox Header="العنوان">
                        <DockPanel Margin="10">

                            <StackPanel
                                Margin="0,0,0,8"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <TextBox Width="200" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Width="100"
                                        Margin="5,0,0,0"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Cities}"
                                        SelectedItem="{Binding City}" />
                                </StackPanel>
                                <Button
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    Command="{Binding UiCommands.ShowCreateCityCommand}">
                                    <icons:MaterialIcon Kind="PlusBox" />
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!--  Footer Actions  -->
            <StackPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="5,0"
                    Command="{Binding SaveCommand}"
                    Content="حفظ" />
                <Button
                    Width="100"
                    Margin="5,0"
                    Content="إلغاء" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
