<Window
    x:Class="OrderHub.UI.Features.Suppliers.Editor.EditSupplierView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Suppliers.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:EditSupplierViewModelBase}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Label Style  -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="DemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <Border
        Width="420"
        Margin="12"
        Padding="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Stretch"
        Background="White"
        CornerRadius="6"
        FlowDirection="RightToLeft">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Name  -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FormLabel}" Text="اسم المورد" />
                <hc:TextBox
                    Grid.Row="1"
                    Height="32"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="ادخل اسم المورد أو الشركة"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Working Hours  -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FormLabel}" Text="من" />
                    <hc:TimePicker Grid.Row="1" SelectedTime="{Binding OpenAt, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource FormLabel}" Text="إلى" />
                    <hc:TimePicker Grid.Row="1" SelectedTime="{Binding CloseAt, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>

            <!--  Phone  -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FormLabel}" Text="رقم الهاتف" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <hc:TextBox
                        Grid.Column="0"
                        hc:InfoElement.ShowClearButton="True"
                        Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

                    <hc:TextBox
                        Grid.Column="2"
                        hc:InfoElement.ShowClearButton="True"
                        FlowDirection="LeftToRight"
                        Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Grid>

            <!--  Address  -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FormLabel}" Text="العنوان" />

                <!--  City  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hc:ComboBox
                        Margin="0,4,0,0"
                        hc:InfoElement.Placeholder="اختر المدينة"
                        hc:InfoElement.ShowClearButton="True"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Cities}"
                        SelectedItem="{Binding City}" />

                    <Button
                        Grid.Column="1"
                        Margin="6,4,0,0"
                        Padding="4"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />
                    </Button>
                </Grid>

                <!--  Street  -->
                <hc:TextBox
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    hc:InfoElement.Placeholder="ادخل الشارع"
                    hc:InfoElement.ShowClearButton="True"
                    AcceptsReturn="True"
                    Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  WhatsApp  -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource FormLabel}"
                        Text="جروب الواتساب" />

                    <Button
                        Grid.Column="1"
                        Margin="6,4,0,0"
                        Padding="4"
                        Command="{Binding ShowCreateWhatsappGroupCommand}"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />
                    </Button>
                </Grid>

                <hc:ComboBox
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    hc:InfoElement.Placeholder="اختر جروب الواتساب"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding WhatsappGroups}"
                    SelectedItem="{Binding SelectedWhatsappGroup}" />
            </Grid>

            <!--  Actions  -->
            <Grid Grid.Row="6" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="1"
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    Padding="8,4"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    Grid.Column="2"
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    Padding="8,4"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    IsCancel="True" />
            </Grid>

        </Grid>
    </Border>
</Window>