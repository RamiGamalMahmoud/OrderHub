<UserControl
    x:Class="OrderHub.UI.Features.Suppliers.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Suppliers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:SuppliersViewModel}"
    x:ClassModifier="internal"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <buttons:ButtonAdd />
            <buttons:ButtonRefresh Margin="5,0" />
        </StackPanel>

        <DataGrid
            Grid.Row="1"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Suppliers, IsAsync=True}">
            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding Name}" Header="الاسم" />

                <DataGridTextColumn Binding="{Binding Address}" Header="العنوان" />

                <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="رقم الهاتف" />

                <DataGridTemplateColumn Header="أوقات الدوام">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="من : " />
                                <TextBlock VerticalAlignment="Center" Text="{Binding OpenAt}" />
                                <TextBlock VerticalAlignment="Center" Text=" | " />
                                <TextBlock VerticalAlignment="Center" Text="الى : " />
                                <TextBlock VerticalAlignment="Center" Text="{Binding CloseAt}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="خيارات">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <buttons:ButtonEdit />
                                <buttons:ButtonDelete Margin="5,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
