<Window
    x:Class="OrderHub.UI.Features.Authentication.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Authentication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding ApplicationContext.Application.InstallationType}"
    Width="520"
    MinWidth="480"
    FontFamily="{StaticResource Cairo}"
    ResizeMode="NoResize"
    ShowActivated="True"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border Background="{DynamicResource RegionBrush}" FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  =====================================================  -->
            <!--  Header  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="0"
                Padding="22,18"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Border
                            Width="44"
                            Height="44"
                            Background="#EFF6FF"
                            CornerRadius="8">

                            <icons:MaterialIcon
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#2563EB"
                                Kind="Lock" />

                        </Border>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">

                            <TextBlock
                                FontSize="19"
                                FontWeight="SemiBold"
                                Foreground="#334155"
                                Text="تسجيل الدخول" />

                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="#94A3B8"
                                Text="تسجيل الدخول إلى نظام OrderHub" />

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!--  =====================================================  -->
            <!--  Content  -->
            <!--  =====================================================  -->

            <ScrollViewer
                Grid.Row="1"
                Padding="22"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!--  Authentication Section  -->

                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="بيانات الدخول" />


                    <!--  Username  -->

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="اسم المستخدم" />

                        <hc:TextBox
                            Height="42"
                            Padding="12,0"
                            hc:InfoElement.ShowClearButton="True"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="أدخل اسم المستخدم" />

                    </StackPanel>


                    <!--  Password  -->

                    <StackPanel Margin="0,18,0,0">

                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#64748B"
                            Text="كلمة المرور" />

                        <hc:PasswordBox
                            Height="42"
                            Padding="12,0"
                            hc:InfoElement.ShowClearButton="True"
                            hc:ShowEyeButton="True"
                            IsSafeEnabled="False"
                            ToolTip="أدخل كلمة المرور"
                            UnsafePassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>


                    <!--  Remember Me  -->

                    <CheckBox
                        Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Content="تذكرني"
                        FontSize="12"
                        Foreground="#475569"
                        IsChecked="{Binding RememberMe}" />

                </StackPanel>

            </ScrollViewer>


            <!--  =====================================================  -->
            <!--  Footer  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="2"
                Padding="22,14"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  Loading  -->

                    <hc:LoadingCircle
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsBusy, Converter={StaticResource Boolean2VisibilityConverter}}" />


                    <!--  Login  -->

                    <Button
                        Grid.Column="1"
                        Height="40"
                        Padding="20,0"
                        Command="{Binding LoginCommand}"
                        Cursor="Hand"
                        IsDefault="True"
                        Style="{StaticResource ButtonPrimary}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="17"
                                Height="17"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Kind="Login" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="تسجيل الدخول" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
