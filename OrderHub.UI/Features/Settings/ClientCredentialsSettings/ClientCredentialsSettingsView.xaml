<Window
    x:Class="OrderHub.UI.Features.Settings.ClientCredentialsSettings.ClientCredentialsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Settings.ClientCredentialsSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="بيانات اعتماد عميل سلة"
    Width="500"
    Height="Auto"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Padding="20"
        Background="White"
        FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <StackPanel>

                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="بيانات اعتماد عميل سلة" />

                <Border
                    Width="40"
                    Height="3"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Background="#2563EB" />

            </StackPanel>

            <!--  Content  -->

            <StackPanel Grid.Row="2">

                <!--  Client ID  -->

                <hc:TextBox
                    Height="60"
                    Margin="0,0,0,14"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="أدخل معرف العميل"
                    hc:InfoElement.ShowClearButton="True"
                    hc:InfoElement.Title="Client ID"
                    Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Client Secret  -->

                <hc:TextBox
                    Height="60"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="أدخل المفتاح السري للعميل"
                    hc:InfoElement.ShowClearButton="True"
                    hc:InfoElement.Title="Client Secret"
                    Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

            <!--  Footer  -->

            <Grid Grid.Row="4" Margin="0,8,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="8" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <!--  Save  -->

                <Button
                    Grid.Column="1"
                    Width="120"
                    Height="38"
                    Command="{Binding SaveCredentialsCommand}"
                    Cursor="Hand"
                    Style="{StaticResource ButtonPrimary}">

                    <StackPanel Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,6,0"
                            Kind="ContentSaveOutline" />

                        <TextBlock Text="حفظ" />

                    </StackPanel>

                </Button>

                <!--  Cancel  -->

                <Button
                    Grid.Column="3"
                    Width="120"
                    Height="38"
                    Click="Button_Click"
                    Cursor="Hand">

                    <StackPanel Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,6,0"
                            Kind="Close" />

                        <TextBlock Text="إلغاء" />

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Border>

</Window>