<Window
    x:Class="OrderHub.UI.Features.Settings.ClientCredentialsSettings.ClientCredentialsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Settings.ClientCredentialsSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Client Credentials"
    Width="480"
    x:ClassModifier="internal"
    Background="#F5F7FA"
    FontFamily="Segoe UI"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Background="#F5F7FA"
        BorderBrush="#DDD"
        BorderThickness="1"
        CornerRadius="12">

        <Grid Grid.Row="1" Margin="20">
            <Border
                Padding="25"
                Background="White"
                CornerRadius="12"
                Effect="{DynamicResource DropShadow}"
                SnapsToDevicePixels="True">
                <StackPanel VerticalAlignment="Center">

                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="Client Credentials" />

                    <!--  Client ID  -->
                    <StackPanel Margin="0,10">
                        <TextBlock
                            Margin="2"
                            FontWeight="SemiBold"
                            Foreground="#555"
                            Text="Client ID" />
                        <TextBox
                            Height="38"
                            Padding="8"
                            Background="#FAFAFA"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            FontSize="15"
                            Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Enter Client ID" />
                    </StackPanel>

                    <!--  Client Secret  -->
                    <StackPanel Margin="0,10">
                        <TextBlock
                            Margin="2"
                            FontWeight="SemiBold"
                            Foreground="#555"
                            Text="Client Secret" />
                        <TextBox
                            Height="38"
                            Padding="8"
                            Background="#FAFAFA"
                            BorderBrush="#CCC"
                            BorderThickness="1"
                            FontSize="15"
                            Text="{Binding ClientSecret, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Enter Client Secret" />
                    </StackPanel>

                    <!--  Buttons  -->
                    <StackPanel
                        Margin="0,15,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="90"
                            Height="36"
                            Margin="5,0"
                            Padding="6,2"
                            Click="Button_Click"
                            Content="Cancel"
                            Foreground="{StaticResource DangerBrush}" />
                        <Button
                            Width="90"
                            Height="36"
                            Margin="5,0"
                            Padding="6,2"
                            Command="{Binding SaveCredentialsCommand}"
                            Content="Save" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!--  Drop shadow effect  -->
    <Window.Resources>
        <DropShadowEffect
            x:Key="DropShadow"
            BlurRadius="12"
            Opacity="0.15"
            ShadowDepth="2"
            Color="Black" />
    </Window.Resources>

</Window>
