<UserControl
    x:Class="OrderHub.UI.Features.Settings.Home.Components.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        Height="auto"
        Padding="0"
        BorderThickness="0"
        Command="{Binding Command}"
        Cursor="Hand">

        <Button.Template>

            <ControlTemplate TargetType="Button">

                <Border
                    x:Name="Card"
                    Padding="20"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Icon  -->

                        <Border
                            Width="54"
                            Height="54"
                            Background="#EEF4FF"
                            CornerRadius="12">

                            <icons:MaterialIcon
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#2563EB"
                                Kind="{Binding Icon}" />

                        </Border>

                        <!--  Title  -->

                        <TextBlock
                            Grid.Row="2"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#1F2937"
                            Text="{Binding Title}" />

                        <!--  Description  -->

                        <TextBlock
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            Foreground="#6B7280"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />

                        <!--  Footer  -->

                        <DockPanel Grid.Row="5">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#9CA3AF"
                                Text="{Binding Description}" />

                            <StackPanel
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">

                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#2563EB"
                                    Text="فتح" />

                                <icons:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Foreground="#2563EB"
                                    Kind="ArrowLeft" />

                            </StackPanel>

                        </DockPanel>

                    </Grid>

                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsMouseOver" Value="True">

                        <Setter TargetName="Card" Property="BorderBrush" Value="#2563EB" />

                        <Setter TargetName="Card" Property="Effect">

                            <Setter.Value>

                                <DropShadowEffect
                                    BlurRadius="18"
                                    Opacity=".18"
                                    ShadowDepth="0" />

                            </Setter.Value>

                        </Setter>

                    </Trigger>

                    <Trigger Property="IsPressed" Value="True">

                        <Setter TargetName="Card" Property="Opacity" Value=".92" />

                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>

        </Button.Template>

    </Button>

</UserControl>