<UserControl
    x:Class="OrderHub.UI.Features.Settings.Properties.Components.Header"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    mc:Ignorable="d">

    <Border
        Padding="24,18"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,0,1">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Icon  -->

            <Border
                Width="52"
                Height="52"
                Background="#EEF4FF"
                CornerRadius="10">

                <icons:MaterialIcon
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#2563EB"
                    Kind="ShapeOutline" />

            </Border>

            <!--  Title  -->

            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="#1F2937"
                    Text="خصائص المنتجات" />

                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#6B7280"
                    Text="إدارة الخصائص المستخدمة داخل المنتجات والنظام." />

            </StackPanel>

            <!--  Summary  -->

            <Border
                Grid.Column="3"
                Padding="12,6"
                VerticalAlignment="Center"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="#64748B"
                        Kind="InformationOutline" />

                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="{Binding TotalProperties, StringFormat='إجمالي الخصائص: {0}'}" />

                </StackPanel>

            </Border>

        </Grid>

    </Border>

</UserControl>