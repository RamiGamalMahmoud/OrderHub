<Window
    x:Class="OrderHub.UI.Features.Clients.Edit.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Clients.Edit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModelBase}"
    FontFamily="{StaticResource Tajawal}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Width="400"
        Margin="12"
        Padding="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="White"
        CornerRadius="5"
        FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="DemiBold"
                    Text="اسم العميل" />
                <hc:TextBox
                    Height="32"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="ادخل اسم العميل"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,12,0,4"
                    FontWeight="DemiBold"
                    Text="رقم الهاتف" />

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Orientation="Vertical">
                    <hc:TextBox hc:InfoElement.ShowClearButton="True" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Orientation="Vertical">
                    <hc:TextBox
                        hc:InfoElement.ShowClearButton="True"
                        FlowDirection="LeftToRight"
                        Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

            </Grid>

            <StackPanel
                Grid.Row="3"
                Margin="0,10"
                HorizontalAlignment="Stretch">

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,12,0,4"
                    FontWeight="DemiBold"
                    Text="العنوان" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <hc:ComboBox
                        MinWidth="200"
                        Margin="0,10"
                        hc:InfoElement.Placeholder="اختر المدينة"
                        hc:InfoElement.ShowClearButton="True"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Cities}"
                        SelectedItem="{Binding SelectedCity}" />
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />
                    </Button>
                </Grid>

                <hc:TextBox
                    Margin="0,10"
                    HorizontalAlignment="Stretch"
                    hc:InfoElement.Placeholder="ادخل الشارع"
                    hc:InfoElement.ShowClearButton="True"
                    AcceptsReturn="True"
                    Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    Cursor="Hand"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Width="100"
                    Margin="5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    Cursor="Hand"
                    IsCancel="True" />
            </StackPanel>

        </Grid>
    </Border>

</Window>
