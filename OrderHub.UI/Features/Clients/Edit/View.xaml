<Window
    x:Class="OrderHub.UI.Features.Clients.Edit.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Clients.Edit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModelBase}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Width="400"
        Margin="12"
        Padding="12"
        Background="White"
        CornerRadius="5"
        FlowDirection="RightToLeft">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Name  -->
            <StackPanel Grid.Row="0">
                <TextBlock FontWeight="DemiBold" Text="اسم العميل" />
                <hc:TextBox
                    Height="32"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="ادخل اسم العميل"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Phone  -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    FontWeight="DemiBold"
                    Text="رقم الهاتف" />

                <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

                <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    hc:InfoElement.ShowClearButton="True"
                    FlowDirection="LeftToRight"
                    Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!--  Address  -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">

                <TextBlock FontWeight="DemiBold" Text="العنوان" />

                <!--  City  -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hc:ComboBox
                        MinWidth="200"
                        hc:InfoElement.Placeholder="اختر المدينة"
                        hc:InfoElement.ShowClearButton="True"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Cities}"
                        SelectedItem="{Binding SelectedCity}" />

                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        BorderThickness="0"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />
                    </Button>
                </Grid>

                <!--  Street  -->
                <hc:TextBox
                    Margin="0,12,0,0"
                    hc:InfoElement.Placeholder="ادخل الشارع"
                    hc:InfoElement.ShowClearButton="True"
                    AcceptsReturn="True"
                    Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Location  -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">

                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Margin="0,0,6,0"
                        Foreground="{StaticResource Primary}"
                        Kind="Location" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="DemiBold"
                        Text="الموقع" />
                </StackPanel>

                <hc:TextBox
                    Margin="0,4,0,0"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="ادخل الموقع"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Actions  -->
            <StackPanel
                Grid.Row="4"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    Height="auto"
                    Padding="0"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    Cursor="Hand"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    Width="100"
                    Height="auto"
                    Margin="12,0,0,0"
                    Padding="0"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    Cursor="Hand"
                    IsCancel="True" />
            </StackPanel>

        </Grid>
    </Border>
</Window>