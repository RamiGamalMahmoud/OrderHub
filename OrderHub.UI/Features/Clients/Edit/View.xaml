<Window
    x:Class="OrderHub.UI.Features.Clients.Edit.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Clients.Edit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="700"
    d:DataContext="{d:DesignInstance Type=local:ViewModelBase}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border Padding="16" FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Margin="0,0,0,12"
                FontSize="22"
                FontWeight="SemiBold"
                Text="بيانات العميل" />

            <!--  Main Content  -->
            <ScrollViewer Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Orientation="Vertical">

                    <!--  Supplier Name  -->
                    <GroupBox Margin="0,0,0,10" Header="المعلومات الأساسية">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Text="اسم العميل:" />
                            <TextBox
                                Grid.Column="1"
                                FontSize="16"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <!--  Phone  -->
                    <GroupBox Margin="0,0,0,10" Header="رقم الهاتف">
                        <DockPanel Margin="10">

                            <Grid Margin="0,0,0,8" DockPanel.Dock="Top">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <TextBox
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        FlowDirection="LeftToRight"
                                        Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Width="80"
                                        Margin="5,0,0,0"
                                        FlowDirection="LeftToRight"
                                        Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                        </DockPanel>
                    </GroupBox>

                    <!--  Addresse  -->
                    <GroupBox Header="العنوان">
                        <DockPanel Margin="10">

                            <StackPanel
                                Margin="0,0,0,8"
                                DockPanel.Dock="Top"
                                Orientation="Horizontal">
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                    <TextBox Width="200" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Margin="5,0,0,0"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Cities}"
                                        SelectedItem="{Binding SelectedCity}" />
                                </StackPanel>
                                <Button
                                    Width="20"
                                    Height="20"
                                    Padding="0"
                                    Command="{Binding ShowCreateCityCommand}">
                                    <icons:MaterialIcon Kind="PlusBox" />
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!--  Footer Actions  -->
            <StackPanel
                Grid.Row="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Width="100"
                    Margin="5,0"
                    Command="{Binding SaveCommand}"
                    Content="حفظ" />
                <Button
                    Width="100"
                    Margin="5,0"
                    BorderBrush="{StaticResource WarningBrush}"
                    Click="Button_Click"
                    Content="إلغاء"
                    Foreground="{StaticResource WarningBrush}" />
            </StackPanel>

        </Grid>
    </Border>
</Window>
