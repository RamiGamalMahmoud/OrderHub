<UserControl
    x:Class="OrderHub.UI.Features.Clients.Edit.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Clients.Edit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModelBase}"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border Width="450" Padding="24">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Client Name  -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="اسم العميل" />

                <hc:TextBox
                    MinHeight="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="أدخل اسم العميل"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Phone  -->

            <Grid Grid.Row="1" Margin="0,18,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="رقم الهاتف" />

                <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="0"
                    MinHeight="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />

                <hc:TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    MinHeight="38"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.ShowClearButton="True"
                    FlowDirection="LeftToRight"
                    Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}" />

            </Grid>


            <!--  Address  -->

            <StackPanel Grid.Row="2" Margin="0,18,0,0">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="العنوان" />


                <!--  City  -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <hc:ComboBox
                        MinHeight="38"
                        Padding="8,0"
                        hc:InfoElement.Placeholder="اختر المدينة"
                        hc:InfoElement.ShowClearButton="True"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Cities}"
                        SelectedItem="{Binding SelectedCity}" />

                    <Button
                        Grid.Column="1"
                        Width="38"
                        Height="38"
                        Margin="8,0,0,0"
                        Padding="0"
                        BorderThickness="0"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand"
                        ToolTip="إضافة مدينة">

                        <icons:MaterialIcon
                            Width="18"
                            Height="18"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />

                    </Button>

                </Grid>


                <!--  Street  -->

                <hc:TextBox
                    MinHeight="38"
                    Margin="0,10,0,0"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Placeholder="أدخل الشارع"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Location  -->

            <StackPanel Grid.Row="3" Margin="0,18,0,0">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="17"
                        Height="17"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Primary}"
                        Kind="Location" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="الموقع" />

                </StackPanel>

                <hc:TextBox
                    MinHeight="38"
                    Margin="0,7,0,0"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="أدخل الموقع"
                    hc:InfoElement.ShowClearButton="True"
                    Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Actions  -->

            <Button
                Grid.Row="4"
                Height="38"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Content="حفظ"
                Cursor="Hand"
                FontSize="14"
                FontWeight="SemiBold"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />

        </Grid>

    </Border>

</UserControl>