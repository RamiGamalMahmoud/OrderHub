<UserControl
    x:Class="OrderHub.UI.Features.Deliverymen.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Deliverymen.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="إدارة المناديب" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن مندوب ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <Button
                Grid.Column="2"
                Height="40"
                hc:BorderElement.CornerRadius="7"
                Background="#facc15"
                Command="{Binding ShowCreateCommand}"
                Cursor="Hand"
                Foreground="Black">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Margin="5,0"
                        Kind="Plus" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="DemiBold"
                        Text="إضافة مندوب" />
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Deliverymen, IsAsync=True}">
            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding Name}" Header="الاسم" />

                <DataGridTextColumn Binding="{Binding CityName}" Header="المدينة" />

                <DataGridTemplateColumn Header="خيارات">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <buttons:ButtonEdit />
                                <buttons:ButtonDelete Margin="5,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
