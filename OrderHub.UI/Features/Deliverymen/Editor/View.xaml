<Window
    x:Class="OrderHub.UI.Features.Deliverymen.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Deliverymen.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    ResizeMode="NoResize"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border
        Width="400"
        Margin="12"
        Padding="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12"
        FlowDirection="RightToLeft">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="اسم المندوب" />
                <TextBox Height="32" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Orientation="Vertical">
                <TextBlock
                    Margin="0,12,0,4"
                    FontWeight="Bold"
                    Text="رقم الهاتف" />
                <TextBox Height="32" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="0,10"
                Orientation="Vertical">
                <DockPanel>
                    <TextBlock
                        Margin="0,12,0,4"
                        FontWeight="Bold"
                        Text="المدينة" />
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        Command="{Binding ShowCreateCityCommand}"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="PlusCircle" />
                    </Button>
                </DockPanel>

                <ComboBox
                    Height="32"
                    DisplayMemberPath="Name"
                    IsEditable="False"
                    ItemsSource="{Binding Cities}"
                    SelectedItem="{Binding SelectedCity}" />
            </StackPanel>

            <StackPanel
                Grid.Row="4"
                Grid.ColumnSpan="2"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    Cursor="Hand"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />
                <Button
                    Width="100"
                    Height="auto"
                    Margin="5,0"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    Cursor="Hand"
                    IsCancel="True" />
            </StackPanel>

        </Grid>
    </Border>

</Window>
