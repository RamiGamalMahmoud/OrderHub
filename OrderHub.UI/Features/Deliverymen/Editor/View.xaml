<UserControl
    x:Class="OrderHub.UI.Features.Deliverymen.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Deliverymen.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border
        Width="400"
        Padding="24"
        FlowDirection="RightToLeft">

        <StackPanel>

            <!--  Name  -->
            <TextBlock
                Margin="0,0,0,8"
                FontWeight="SemiBold"
                Text="اسم المندوب" />

            <TextBox
                MinHeight="40"
                Padding="10,6"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Phone  -->
            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="رقم الهاتف" />

            <TextBox
                MinHeight="40"
                Padding="10,6"
                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

            <!--  City  -->
            <Grid Margin="0,20,0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="المدينة" />

                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    BorderThickness="0"
                    Command="{Binding ShowCreateCityCommand}"
                    Cursor="Hand">

                    <icons:MaterialIcon
                        Width="20"
                        Foreground="{StaticResource Primary}"
                        Kind="PlusCircle" />

                </Button>

            </Grid>

            <ComboBox
                MinHeight="40"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Cities}"
                SelectedItem="{Binding SelectedCity}" />

            <!--  WhatsApp Group  -->
            <TextBlock
                Margin="0,20,0,8"
                FontWeight="SemiBold"
                Text="مجموعة واتساب" />

            <ComboBox
                MinHeight="40"
                DisplayMemberPath="Name"
                ItemsSource="{Binding WhatsappGroupsOptions}"
                SelectedItem="{Binding SelectedWhatsappGroup}" />

            <!--  Actions  -->
            <StackPanel
                Margin="0,28,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    Width="100"
                    MinHeight="40"
                    Command="{Binding SaveCommand}"
                    Content="حفظ"
                    Cursor="Hand"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}" />

                <Button
                    Width="100"
                    MinHeight="40"
                    Margin="10,0,0,0"
                    Command="{Binding CloseEditorCommand}"
                    Content="إلغاء"
                    Cursor="Hand"
                    IsCancel="True" />

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>