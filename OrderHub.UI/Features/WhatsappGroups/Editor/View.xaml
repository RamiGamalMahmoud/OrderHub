<UserControl
    x:Class="OrderHub.UI.Features.WhatsappGroups.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OrderHub.UI.Features.WhatsappGroups.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    FlowDirection="RightToLeft"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    mc:Ignorable="d">

    <Border Width="420" Padding="24">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Group Name  -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="اسم الجروب" />

                <TextBox
                    MinHeight="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Group Type  -->

            <StackPanel Grid.Row="1" Margin="0,18,0,0">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="نوع الجروب" />

                <ComboBox
                    MinHeight="38"
                    Padding="8,0"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding GroupTypes}"
                    SelectedItem="{Binding GroupType}" />

            </StackPanel>


            <!--  Group Link  -->

            <StackPanel Grid.Row="2" Margin="0,18,0,0">

                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="رابط الجروب" />

                <TextBox
                    MinHeight="38"
                    Padding="10,0"
                    VerticalContentAlignment="Center"
                    FlowDirection="LeftToRight"
                    Text="{Binding GroupLink, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>


            <!--  Actions  -->

            <Button
                Grid.Row="3"
                Height="38"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Content="حفظ"
                Cursor="Hand"
                FontSize="14"
                FontWeight="SemiBold"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}" />

        </Grid>

    </Border>

</UserControl>
