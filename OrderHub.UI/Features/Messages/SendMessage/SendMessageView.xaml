<UserControl
    x:Class="OrderHub.UI.Features.Messages.SendMessage.SendMessageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.SendMessage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:SendMessageViewModel}"
    FontFamily="{StaticResource Cairo}"
    mc:Ignorable="d">

    <Border
        Width="430"
        Background="{DynamicResource RegionBrush}"
        BorderBrush="#E2E8F0"
        FlowDirection="RightToLeft">

        <Grid>
            <Grid.RowDefinitions>
                <!--  نموذج البيانات الرئيسي  -->
                <RowDefinition Height="*" />
                <!--  شريط زر الإرسال السفلي  -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  =====================================================  -->
            <!--  1. Content Form  -->
            <!--  =====================================================  -->
            <ScrollViewer
                Grid.Row="0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,15,14,10">

                    <!--  حقل عنوان الرسالة (Caption)  -->
                    <hc:TextBox
                        Margin="0,0,0,14"
                        hc:InfoElement.Placeholder="أدخل عنوان الرسالة (Caption)..."
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="عنوان الرسالة"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  حقل نص الرسالة (Message)  -->
                    <hc:TextBox
                        Height="120"
                        Margin="0,0,0,14"
                        VerticalAlignment="Top"
                        VerticalContentAlignment="Top"
                        hc:InfoElement.Placeholder="اكتب نص رسالتك هنا..."
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="محتوى الرسالة"
                        AcceptsReturn="True"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <hc:ComboBox
                        HorizontalContentAlignment="Stretch"
                        hc:InfoElement.Placeholder="اختر المستلم"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.Title="المستلم"
                        IsTextSearchEnabled="True"
                        ItemsSource="{Binding Recipients}"
                        SelectedItem="{Binding SelectedRecipient}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="5" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{Binding RecipientName}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            FontWeight="SemiBold"
                                            Text="{Binding RecipientType.DisplayName}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,5,0,0"
                                        FontSize="11"
                                        Text="{Binding Destination}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </hc:ComboBox>

                    <!--  قسم المرفقات (Attachments)  -->
                    <Grid Margin="0,10,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  عنوان القسم  -->
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Text="المرفقات" />
                        <!--  منطقة إضافة المرفقات / Drag & Drop  -->
                        <Button
                            Grid.Row="1"
                            Height="auto"
                            Margin="0,8,0,0"
                            Padding="15"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            AllowDrop="True"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Command="{Binding AddAttachmentCommand}"
                            Cursor="Hand"
                            DragOver="AttachmentDropZone_DragOver"
                            Drop="AttachmentDropZone_Drop">
                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Center"
                                    Foreground="#94A3B8"
                                    Kind="Upload" />

                                <TextBlock
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#64748B"
                                    Text="اضغط لإضافة ملفات أو اسحبها هنا" />

                            </StackPanel>
                        </Button>

                        <!--  قائمة المرفقات الحالية  -->
                        <Border
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            Padding="8"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6">
                            <ScrollViewer Grid.Row="2" MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding AttachedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,6"
                                                Padding="8"
                                                Background="#F8FAFC"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!--  File Icon  -->
                                                    <Border
                                                        Width="34"
                                                        Height="34"
                                                        Background="{Binding IconBackgroundColor}"
                                                        CornerRadius="5">
                                                        <icons:MaterialIcon
                                                            Width="19"
                                                            Height="19"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding IconColor}"
                                                            Kind="{Binding Icon}" />
                                                    </Border>
                                                    <!--  File Info  -->
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="8,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="#374151"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Margin="0,3,0,0"
                                                            FontSize="10"
                                                            Foreground="#9CA3AF"
                                                            Text="{Binding Size}" />
                                                    </StackPanel>
                                                    <!--  Delete  -->
                                                    <Button
                                                        Grid.Column="2"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.RemoveAttachmentCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="حذف">
                                                        <icons:MaterialIcon
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="#EF4444"
                                                            Kind="DeleteOutline" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!--  =====================================================  -->
            <!--  2. Footer Control  -->
            <!--  =====================================================  -->
            <Border
                Grid.Row="1"
                Padding="14,10"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">
                <Button
                    Height="36"
                    Padding="20,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SendCommand}"
                    IsDefault="True"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,6,0"
                            Kind="Send" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="إرسال الرسالة" />
                    </StackPanel>
                </Button>
            </Border>

        </Grid>
    </Border>
</UserControl>
