<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.Header"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.Index">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Title  -->
        <TextBlock
            Grid.Column="0"
            VerticalAlignment="Center"
            FontSize="16"
            FontWeight="DemiBold"
            Text="سجل الرسائل" />

        <!--  Filters  -->
        <local:MessageFiltersBar Grid.Column="1" HorizontalAlignment="Center" />

        <StackPanel Grid.Column="2" Orientation="Horizontal">
            <!--  Refresh  -->
            <Button
                Grid.Column="2"
                Width="90"
                Height="40"
                hc:BorderElement.CornerRadius="7"
                Command="{Binding LoadCommand}"
                Cursor="Hand"
                Style="{StaticResource ButtonPrimary}">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="20"
                        Margin="5,0"
                        Kind="RefreshCircle" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="DemiBold"
                        Text="تحديث" />

                </StackPanel>

            </Button>

            <!--  Send New Message  -->
            <Button
                Grid.Column="2"
                Width="90"
                Height="40"
                hc:BorderElement.CornerRadius="7"
                Command="{Binding SendNewMessageCommand}"
                Cursor="Hand"
                Style="{StaticResource ButtonDashedSuccess}">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="20"
                        Margin="5,0"
                        Kind="Message" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="DemiBold"
                        Text="رسالة جديدة" />

                </StackPanel>

            </Button>
        </StackPanel>

    </Grid>

</UserControl>