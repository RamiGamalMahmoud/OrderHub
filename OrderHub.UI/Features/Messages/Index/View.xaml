<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="سجل الرسائل" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <local:MessageFiltersBar Grid.Row="1" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Grid.Column="2"
                    Height="40"
                    hc:BorderElement.CornerRadius="7"
                    Command="{Binding LoadCommand}"
                    Cursor="Hand"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="RefreshCircle" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="تحديث" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>




        <DataGrid
            Grid.Row="2"
            Margin="0,12,0,0"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Vertical"
            IsReadOnly="True"
            ItemsSource="{Binding OutboxMessages, IsAsync=True}"
            VerticalGridLinesBrush="LightGray">

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,5,5,5"
                        Padding="12"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock Foreground="Black" Text="{Binding Text}" />
                            <Button
                                Padding="10,4"
                                BorderThickness="0"
                                Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.ResendMessageCommand}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Foreground="White"
                                Style="{StaticResource ButtonDanger}">
                                <TextBlock Text="إعادة إرسال" />
                            </Button>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.Columns>

                <DataGridTextColumn
                    Binding="{Binding OrderNumber}"
                    FontWeight="DemiBold"
                    Header="رقم الطلب"
                    IsReadOnly="False" />

                <DataGridTextColumn
                    Binding="{Binding RecipientName}"
                    Header="اسم المستلم"
                    IsReadOnly="True" />

                <DataGridTextColumn Binding="{Binding RecipientType.DisplayName}" Header="المستلم" />

                <DataGridTemplateColumn Width="200" Header="حالة الإرسال">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Label
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Content="{Binding Status.DisplayName}">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource LabelDefault}" TargetType="Label">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Pending}">
                                                <Setter Property="Background" Value="#0984e3" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sent}">
                                                <Setter Property="Background" Value="#00b894" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Failed}">
                                                <Setter Property="Background" Value="#ff7675" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Title}" Header="محتوى الرسالة" />

                <DataGridTemplateColumn Header="رقم الهاتف">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                FlowDirection="LeftToRight"
                                Text="{Binding PhoneNumber}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Binding="{Binding CreatedAt}"
                    Header="التاريخ"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Header="إجراء">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,6,0"
                                    Padding="10,4"
                                    Background="#f59e0b"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.ResendMessageCommand}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Foreground="White"
                                    IsEnabled="{Binding CanResend}">
                                    <TextBlock Text="إعادة إرسال" />
                                </Button>
                                <Button
                                    Padding="10,4"
                                    Background="#dc2626"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.DeleteMessageCommand}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Foreground="White">
                                    <TextBlock Text="حذف" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock
                Margin="0,0,0,6"
                FontWeight="DemiBold"
                Text="ملخص الحالات" />
            <ItemsControl ItemsSource="{Binding StatusSummaries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,8,8"
                            Padding="12,8"
                            Background="#f1f5f9"
                            CornerRadius="8">
                            <TextBlock FontWeight="DemiBold" Text="{Binding DisplayText}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>

</UserControl>
