<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="سجل الرسائل" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن طلب باسم العميل ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Grid.Column="2"
                    Height="40"
                    hc:BorderElement.CornerRadius="7"
                    Command="{Binding LoadCommand}"
                    Cursor="Hand"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="RefreshCircle" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="تحديث" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <DataGrid
            Grid.Row="1"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Vertical"
            IsReadOnly="True"
            ItemsSource="{Binding OutboxMessages, IsAsync=True}"
            VerticalGridLinesBrush="LightGray">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Binding="{Binding OrderNumber}"
                    FontWeight="DemiBold"
                    Header="رقم الطلب"
                    IsReadOnly="False" />

                <DataGridTextColumn
                    Binding="{Binding RecipientName}"
                    Header="اسم المستلم"
                    IsReadOnly="True" />

                <DataGridTextColumn Binding="{Binding RecipientType.DisplayName}" Header="المستلم" />

                <DataGridTemplateColumn Width="200" Header="حالة الإرسال">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Label
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Content="{Binding Status.DisplayName}">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource LabelDefault}" TargetType="Label">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Pending}">
                                                <Setter Property="Background" Value="#0984e3" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sent}">
                                                <Setter Property="Background" Value="#00b894" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Failed}">
                                                <Setter Property="Background" Value="#ff7675" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Text}" Header="محتوى الرسالة" />

                <DataGridTemplateColumn Header="رقم الهاتف">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                FlowDirection="LeftToRight"
                                Text="{Binding PhoneNumber}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Binding="{Binding CreatedAt}"
                    Header="التاريخ"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Header="إجراء">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Padding="10,4"
                                Background="#f59e0b"
                                BorderThickness="0"
                                Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.ResendMessageCommand}"
                                CommandParameter="{Binding}"
                                Cursor="Hand"
                                Foreground="White"
                                IsEnabled="{Binding CanResend}">
                                <TextBlock Text="إعادة إرسال" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</UserControl>
