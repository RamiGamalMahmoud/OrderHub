<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.MessageActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="10,8"
        BorderBrush="#E5E7EB"
        BorderThickness="0,1,0,0">

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

            <!--  QR Code  -->
            <Button
                Height="34"
                Padding="10,0"
                hc:BorderElement.CornerRadius="5"
                Background="#EEF2FF"
                BorderBrush="#6366F1"
                BorderThickness="1"
                Command="{Binding GenerateMessageQrCodeCommand}"
                CommandParameter="{Binding SelectedMessage}"
                Cursor="Hand"
                Foreground="#4F46E5">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="Qrcode" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="إنشاء QR Code" />

                </StackPanel>
            </Button>


            <!--  Copy  -->
            <Button
                Height="34"
                Margin="10,0,0,0"
                Padding="10,0"
                hc:BorderElement.CornerRadius="5"
                Background="#EFF6FF"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                Command="{Binding CopyMessageCommand}"
                CommandParameter="{Binding SelectedMessage}"
                Cursor="Hand"
                Foreground="#2563EB">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="ContentCopy" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="نسخ" />

                </StackPanel>
            </Button>


            <!--  Save  -->
            <Button
                Height="34"
                Margin="10,0,0,0"
                Padding="10,0"
                hc:BorderElement.CornerRadius="5"
                Background="#FFFBEB"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                Command="{Binding SaveMessageCommand}"
                CommandParameter="{Binding SelectedMessage}"
                Cursor="Hand"
                Foreground="#B45309">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="ContentSave" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="حفظ" />

                </StackPanel>
            </Button>


            <!--  Mark Sent  -->
            <Button
                Height="34"
                Margin="10,0,0,0"
                Padding="10,0"
                hc:BorderElement.CornerRadius="5"
                Background="#ECFDF5"
                BorderBrush="#10B981"
                BorderThickness="1"
                Command="{Binding MarkMessageSentCommand}"
                CommandParameter="{Binding SelectedMessage}"
                Cursor="Hand"
                Foreground="#047857">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="CheckCircleOutline" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="تم الإرسال" />

                </StackPanel>
            </Button>

        </StackPanel>

    </Border>

</UserControl>