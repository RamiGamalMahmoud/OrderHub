<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.MessagesTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Messages.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    mc:Ignorable="d">

    <Border
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="8">

        <DataGrid
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding OutboxMessages, IsAsync=True}"
            SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
            SelectionMode="Single">

            <DataGrid.Columns>

                <!--  رقم الطلب  -->
                <DataGridTemplateColumn Width="150" Header="رقم الطلب">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding OrderNumber}" />

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!--  الحالة  -->
                <DataGridTemplateColumn Width="110" Header="الحالة">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Label
                                Height="auto"
                                HorizontalAlignment="Stretch"
                                BorderThickness="0"
                                Content="{Binding Status.DisplayName}"
                                FontWeight="SemiBold">

                                <Label.Style>

                                    <Style BasedOn="{StaticResource LabelDefault}" TargetType="Label">

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sending}">

                                                <Setter Property="Background" Value="{StaticResource LightBlueBrush}" />

                                                <Setter Property="Foreground" Value="{StaticResource Primary}" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Pending}">

                                                <Setter Property="Background" Value="#FEF3C7" />

                                                <Setter Property="Foreground" Value="#D97706" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sent}">

                                                <Setter Property="Background" Value="#DCFCE7" />

                                                <Setter Property="Foreground" Value="#16A34A" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Failed}">

                                                <Setter Property="Background" Value="#FEE2E2" />

                                                <Setter Property="Foreground" Value="#DC2626" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Label.Style>

                            </Label>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!--  اسم المستلم  -->
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding RecipientName}"
                    Header="اسم المستلم" />

                <!--  النوع  -->
                <DataGridTemplateColumn Width="150" Header="نوع المستلم">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="18"
                                    Margin="0,0,5,0"
                                    Foreground="#22C55E"
                                    Kind="Whatsapp" />

                                <TextBlock VerticalAlignment="Center" Text="{Binding RecipientType.DisplayName}" />

                            </StackPanel>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!--  محتوى الرسالة  -->
                <DataGridTextColumn
                    MinWidth="200"
                    Binding="{Binding Title}"
                    Header="محتوى الرسالة" />

                <!--  وقت الإرسال  -->
                <DataGridTemplateColumn Width="160" Header="وقت الارسال">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock VerticalAlignment="Center" Text="{Binding LastAttemptAt, StringFormat='{}{0:hh\\:mm tt}'}" />

                                <Separator Width="5" Margin="5,0" />

                                <TextBlock
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding LastAttemptAt, StringFormat='{}{0:dd/MM/yyyy}'}" />

                            </StackPanel>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <Button
                                    Grid.Column="0"
                                    Height="34"
                                    Padding="8,0"
                                    VerticalContentAlignment="Center"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SendMessageCommand}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    FontSize="11"
                                    Foreground="{StaticResource Primary}">

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <icons:MaterialIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Send" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="إرسال" />

                                    </StackPanel>
                                </Button>

                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

    </Border>

</UserControl>