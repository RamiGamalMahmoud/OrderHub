<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.MessageFiltersBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal">


        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="الحالة" />
        <ComboBox
            Width="160"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding StatusFilters}"
            SelectedItem="{Binding SelectedStatusFilter}" />

        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="من" />
        <DatePicker
            Width="140"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            SelectedDate="{Binding FromDate}" />

        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="إلى" />
        <DatePicker
            Width="140"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            SelectedDate="{Binding ToDate}" />

        <Button
            Height="auto"
            Margin="0,0,8,0"
            Command="{Binding SetTodayCommand}"
            Content="اليوم"
            Cursor="Hand" />
        <Button
            Height="auto"
            Margin="0,0,8,0"
            Command="{Binding SetCurrentWeekCommand}"
            Content="الأسبوع الحالي"
            Cursor="Hand" />
        <Button
            Height="auto"
            Command="{Binding SetCurrentMonthCommand}"
            Content="الشهر الحالي"
            Cursor="Hand" />
    </StackPanel>
</UserControl>
