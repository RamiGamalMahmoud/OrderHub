<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.MessageDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <Border
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="6"
        FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>


            <!--
            =====================================================
            Header
            =====================================================
            -->

            <Border
                Grid.Row="0"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <TextBlock
                    Margin="14,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#334155"
                    Text="تفاصيل الرسالة" />

            </Border>


            <!--
            =====================================================
            Content
            =====================================================
            -->

            <ScrollViewer
                Grid.Row="1"
                Padding="14,10,14,8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <Grid>

                    <!--
                    =================================================
                    Empty State
                    =================================================
                    -->

                    <Border
                        Padding="20"
                        Background="#F8FAFC"
                        CornerRadius="6">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel HorizontalAlignment="Center">

                            <icons:MaterialIcon
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Center"
                                Foreground="#CBD5E1"
                                Kind="MessageOutline" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="#64748B"
                                Text="اختر رسالة لعرض التفاصيل" />

                        </StackPanel>

                    </Border>


                    <!--
                    =================================================
                    Selected Message
                    =================================================
                    -->

                    <StackPanel DataContext="{Binding SelectedMessage}">

                        <StackPanel.Style>

                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </StackPanel.Style>


                        <!--
                        =================================================
                        WhatsApp + Status
                        =================================================
                        -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>


                            <!--  Status  -->

                            <Border
                                Grid.Column="2"
                                Padding="9,4"
                                Background="#D9F7E9"
                                CornerRadius="5">

                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="#00A878"
                                    Text="{Binding Status.DisplayName}" />

                            </Border>


                            <!--  WhatsApp  -->

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="#334155"
                                    Text="واتساب" />

                                <icons:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Margin="5,0,0,0"
                                    Foreground="#20C77A"
                                    Kind="Whatsapp" />

                            </StackPanel>

                        </Grid>


                        <!--
                        =================================================
                        Created At
                        =================================================
                        -->

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="10"
                            Foreground="#64748B"
                            Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy - hh:mm tt}'}" />


                        <!--
                        =================================================
                        Message Information
                        =================================================
                        -->

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="18" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>


                            <!--
                            =========================
                            Order Number
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="CalendarOutline" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="رقم الطلب:" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                Foreground="#334155"
                                Text="{Binding OrderNumber}" />


                            <!--
                            =========================
                            Recipient
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="AccountOutline" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="المستلم:" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                Foreground="#334155"
                                Text="{Binding RecipientName}" />


                            <!--
                            =========================
                            Phone
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="PhoneOutline" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="رقم الجوال:" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                FlowDirection="LeftToRight"
                                Foreground="#334155"
                                Text="{Binding PhoneNumber}" />

                        </Grid>


                        <!--
                        =================================================
                        Separator
                        =================================================
                        -->

                        <Border
                            Margin="0,12,0,9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,1,0,0" />


                        <!--
                        =================================================
                        Message Content
                        =================================================
                        -->

                        <TextBlock
                            Margin="0,0,0,7"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Primary}"
                            Text="محتوى الرسالة:" />


                        <Border
                            Padding="9"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6">

                            <TextBlock
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="#334155"
                                LineHeight="15"
                                Text="{Binding Text}"
                                TextWrapping="Wrap" />

                        </Border>


                        <!--
                        =================================================
                        Attachments
                        =================================================
                        -->

                        <TextBlock
                            Margin="0,13,0,7"
                            HorizontalAlignment="Right"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#475569"
                            Text="الوسائط المرفقة (1)" />

                    </StackPanel>

                </Grid>

            </ScrollViewer>


            <!--
            =====================================================
            Footer
            =====================================================
            -->

            <!--  Footer  -->

            <Border
                Grid.Row="2"
                Padding="10,8"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="10" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>


                    <!--  Resend  -->

                    <Button
                        Grid.Column="0"
                        Height="34"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="5"
                        Background="{StaticResource Primary}"
                        BorderThickness="0"
                        Command="{Binding ResendMessageCommand}"
                        CommandParameter="{Binding SelectedMessage}"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White"
                        IsEnabled="{Binding SelectedMessage.CanResend}">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Send" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="إعادة إرسال" />

                        </StackPanel>

                    </Button>


                    <!--  Delete  -->

                    <Button
                        Grid.Column="2"
                        Height="34"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="5"
                        Background="#EF2B2D"
                        BorderThickness="0"
                        Command="{Binding DeleteMessageCommand}"
                        CommandParameter="{Binding SelectedMessage}"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Delete" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="حذف" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>