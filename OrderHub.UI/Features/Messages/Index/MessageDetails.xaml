<UserControl
    x:Class="OrderHub.UI.Features.Messages.Index.MessageDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <Border
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="6"
        FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>


            <!--
            =====================================================
            Header
            =====================================================
            -->

            <Border
                Grid.Row="0"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <TextBlock
                    Margin="14,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#334155"
                    Text="تفاصيل الرسالة" />

            </Border>


            <!--
            =====================================================
            Content
            =====================================================
            -->

            <ScrollViewer
                Grid.Row="1"
                Padding="14,10,14,8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <Grid>

                    <!--
                    =================================================
                    Empty State
                    =================================================
                    -->

                    <Border
                        Padding="20"
                        Background="#F8FAFC"
                        CornerRadius="6">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding SelectedMessage}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel HorizontalAlignment="Center">

                            <icons:MaterialIcon
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Center"
                                Foreground="#CBD5E1"
                                Kind="MessageOutline" />

                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="#64748B"
                                Text="اختر رسالة لعرض التفاصيل" />

                        </StackPanel>

                    </Border>


                    <!--
                    =================================================
                    Selected Message
                    =================================================
                    -->

                    <StackPanel DataContext="{Binding SelectedMessage}">

                        <StackPanel.Style>

                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility" Value="Visible" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </StackPanel.Style>


                        <!--
                        =================================================
                        WhatsApp + Status
                        =================================================
                        -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>


                            <!--  Status  -->

                            <Label
                                Grid.Column="2"
                                Height="auto"
                                Padding="9,4"
                                BorderThickness="0"
                                Content="{Binding Status.DisplayName}"
                                FontWeight="SemiBold">
                                <Label.Style>

                                    <Style BasedOn="{StaticResource LabelDefault}" TargetType="Label">

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sending}">

                                                <Setter Property="Background" Value="{StaticResource LightBlueBrush}" />

                                                <Setter Property="Foreground" Value="{StaticResource Primary}" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Pending}">

                                                <Setter Property="Background" Value="#FEF3C7" />

                                                <Setter Property="Foreground" Value="#D97706" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Sent}">

                                                <Setter Property="Background" Value="#DCFCE7" />

                                                <Setter Property="Foreground" Value="#16A34A" />

                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding Status.Value}" Value="{x:Static enums:OutboxMessageStatus.Failed}">

                                                <Setter Property="Background" Value="#FEE2E2" />

                                                <Setter Property="Foreground" Value="#DC2626" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Label.Style>
                            </Label>


                            <!--  WhatsApp  -->

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="#334155"
                                    Text="واتساب" />

                                <icons:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Margin="5,0,0,0"
                                    Foreground="#20C77A"
                                    Kind="Whatsapp" />

                            </StackPanel>

                        </Grid>


                        <!--
                        =================================================
                        Created At
                        =================================================
                        -->

                        <TextBlock
                            Margin="0,0,0,12"
                            FontSize="10"
                            Foreground="#64748B"
                            Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy - hh:mm tt}'}" />


                        <!--
                        =================================================
                        Message Information
                        =================================================
                        -->

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="18" />

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>


                            <!--
                            =========================
                            Order Number
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="CalendarOutline" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="رقم الطلب:" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                Foreground="#334155"
                                Text="{Binding OrderNumber}" />


                            <!--
                            =========================
                            Recipient
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="AccountOutline" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="المستلم:" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                Foreground="#334155"
                                Text="{Binding RecipientName}" />


                            <!--
                            =========================
                            Phone
                            =========================
                            -->

                            <icons:MaterialIcon
                                Grid.Row="2"
                                Grid.Column="0"
                                Width="15"
                                Height="15"
                                VerticalAlignment="Center"
                                Foreground="#64748B"
                                Kind="PhoneOutline" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5,0,8,7"
                                Foreground="#64748B"
                                Text="رقم الجوال:" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,7"
                                FlowDirection="LeftToRight"
                                Foreground="#334155"
                                Text="{Binding PhoneNumber}" />

                        </Grid>


                        <!--
                        =================================================
                        Separator
                        =================================================
                        -->

                        <Border
                            Margin="0,12,0,9"
                            BorderBrush="#CBD5E1"
                            BorderThickness="0,1,0,0" />


                        <!--
                        =================================================
                        Message Content
                        =================================================
                        -->

                        <TextBlock
                            Margin="0,0,0,7"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Primary}"
                            Text="محتوى الرسالة:" />


                        <Border
                            Padding="9"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6">

                            <TextBlock
                                FontSize="9.5"
                                FontWeight="SemiBold"
                                Foreground="#334155"
                                LineHeight="15"
                                Text="{Binding Text}"
                                TextWrapping="Wrap" />

                        </Border>

                        <!--
                        =================================================
                        Notes
                        =================================================
                        -->

                        <Border
                            Margin="0,12,0,0"
                            Padding="10"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>


                                <!--  Header  -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                        <icons:MaterialIcon
                                            Width="18"
                                            Height="18"
                                            Foreground="{StaticResource Primary}"
                                            Kind="NoteText" />

                                        <TextBlock
                                            Margin="7,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#374151"
                                            Text="ملاحظات" />

                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="6,2"
                                            Background="#EFF6FF"
                                            CornerRadius="10">

                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#2563EB"
                                                Text="{Binding NotesCount}" />

                                        </Border>

                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                        <Button
                                            BorderThickness="0"
                                            Command="{Binding MakeTextNoteStrikethroughCommand}"
                                            Cursor="Hand"
                                            FontSize="10"
                                            FontWeight="SemiBold">
                                            <icons:MaterialIcon
                                                Width="15"
                                                Height="15"
                                                Kind="FormatStrikethrough" />
                                        </Button>

                                        <Button
                                            BorderThickness="0"
                                            Command="{Binding MakeTextNoteBoldCommand}"
                                            Cursor="Hand"
                                            FontSize="10"
                                            FontWeight="SemiBold">
                                            <icons:MaterialIcon
                                                Width="15"
                                                Height="15"
                                                Kind="FormatBold" />
                                        </Button>

                                        <Button
                                            BorderThickness="0"
                                            Command="{Binding MakeTextNoteItalicCommand}"
                                            Cursor="Hand"
                                            FontSize="10"
                                            FontWeight="SemiBold">
                                            <icons:MaterialIcon
                                                Width="15"
                                                Height="15"
                                                Kind="FormatItalic" />
                                        </Button>

                                    </StackPanel>

                                </Grid>

                                <!--  Add Note Area  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Padding="8"
                                    Background="#FAFAFA"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    CornerRadius="5">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>


                                        <!--  Note Input  -->
                                        <TextBox
                                            Name="NoteTextBox"
                                            MinHeight="34"
                                            MaxHeight="80"
                                            Padding="8,6"
                                            VerticalContentAlignment="Center"
                                            Background="White"
                                            BorderBrush="LightGray"
                                            BorderThickness="1"
                                            FontSize="12"
                                            Foreground="#374151"
                                            Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap"
                                            ToolTip="اكتب ملاحظة..."
                                            VerticalScrollBarVisibility="Auto" />


                                        <!--  Add Button  -->
                                        <Button
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Background="#EFF6FF"
                                            BorderThickness="0"
                                            Command="{Binding AddNoteCommand}"
                                            Cursor="Hand"
                                            ToolTip="إضافة الملاحظة">

                                            <icons:MaterialIcon
                                                Width="18"
                                                Height="18"
                                                Foreground="#2563EB"
                                                Kind="Plus" />

                                        </Button>

                                    </Grid>

                                </Border>

                                <!--  Notes List  -->
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">

                                    <ItemsControl ItemsSource="{Binding Notes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>


                                                        <!--  Note Icon  -->
                                                        <Border
                                                            Width="34"
                                                            Height="34"
                                                            Background="#f3e5f5"
                                                            CornerRadius="5">

                                                            <icons:MaterialIcon
                                                                Width="18"
                                                                Height="18"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="#4a148c"
                                                                Kind="NoteText" />

                                                        </Border>


                                                        <!--  Note Content  -->
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="8,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="#374151"
                                                            Text="{Binding}"
                                                            TextWrapping="Wrap" />


                                                        <!--  Delete  -->
                                                        <Button
                                                            Grid.Column="2"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SelectedMessage.RemoveNoteCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="حذف">

                                                            <icons:MaterialIcon
                                                                Width="16"
                                                                Height="16"
                                                                Foreground="#EF4444"
                                                                Kind="DeleteOutline" />

                                                        </Button>

                                                    </Grid>

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>

                            </Grid>

                        </Border>

                        <!--
                        =================================================
                        Attachments
                        =================================================
                        -->

                        <Border
                            Margin="0,12,0,0"
                            Padding="10"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                        <icons:MaterialIcon
                                            Width="18"
                                            Height="18"
                                            Foreground="#64748B"
                                            Kind="AttachFile" />

                                        <TextBlock
                                            Margin="7,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#374151"
                                            Text="المرفقات" />

                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="6,2"
                                            Background="#EFF6FF"
                                            CornerRadius="10">

                                            <TextBlock
                                                FontSize="11"
                                                Foreground="#2563EB"
                                                Text="{Binding AttachmentsCount}" />

                                        </Border>

                                    </StackPanel>

                                </Grid>


                                <!--  Attachments List  -->
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">

                                    <ItemsControl ItemsSource="{Binding Attachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,6"
                                                    Padding="8"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E5E7EB"
                                                    BorderThickness="1"
                                                    CornerRadius="5">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>


                                                        <!--  File Icon  -->
                                                        <Border
                                                            Width="34"
                                                            Height="34"
                                                            Background="{Binding IconBackgroundColor}"
                                                            CornerRadius="5">

                                                            <icons:MaterialIcon
                                                                Width="19"
                                                                Height="19"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Foreground="{Binding IconColor}"
                                                                Kind="{Binding Icon}" />

                                                        </Border>


                                                        <!--  File Info  -->
                                                        <StackPanel
                                                            Grid.Column="1"
                                                            Margin="8,0"
                                                            VerticalAlignment="Center">

                                                            <TextBlock
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="#374151"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                FontSize="10"
                                                                Foreground="#9CA3AF"
                                                                Text="{Binding Size}" />

                                                        </StackPanel>


                                                        <!--  Delete  -->
                                                        <Button
                                                            Grid.Column="2"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SelectedMessage.RemoveAttachmentCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="حذف">

                                                            <icons:MaterialIcon
                                                                Width="16"
                                                                Height="16"
                                                                Foreground="#EF4444"
                                                                Kind="DeleteOutline" />

                                                        </Button>

                                                    </Grid>

                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>


                                <!--  Add Attachments Area  -->
                                <Button
                                    Grid.Row="1"
                                    Height="auto"
                                    Margin="0,10,0,0"
                                    Padding="15"
                                    HorizontalAlignment="Stretch"
                                    AllowDrop="True"
                                    Background="#FAFAFA"
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Command="{Binding AddAttachmentsCommand}"
                                    Cursor="Hand"
                                    DragOver="Button_DragOver"
                                    Drop="Button_Drop">

                                    <StackPanel Orientation="Horizontal">

                                        <icons:MaterialIcon
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            Foreground="#94A3B8"
                                            Kind="Upload" />

                                        <TextBlock
                                            Margin="5,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            Foreground="#64748B"
                                            Text="اضغط لإضافة ملفات أو اسحبها هنا" />

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Grid>

            </ScrollViewer>


            <!--
            =====================================================
            Footer
            =====================================================
            -->

            <!--  Footer  -->

            <Border
                Grid.Row="2"
                Padding="10,8"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="5" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="5" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>


                    <!--  Resend  -->

                    <Button
                        Grid.Column="0"
                        Height="34"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="5"
                        Background="{StaticResource Primary}"
                        BorderThickness="0"
                        Command="{Binding ResendMessageCommand}"
                        CommandParameter="{Binding SelectedMessage}"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Send" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="إعادة إرسال" />

                        </StackPanel>

                    </Button>

                    <Button
                        Grid.Column="2"
                        Height="34"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                        Command="{Binding CancelSendingMessageCommand}"
                        CommandParameter="{Binding SelectedMessage}"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White"
                        Style="{StaticResource ButtonWarning}">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Cancel" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="إلغاء الإرسال" />

                        </StackPanel>

                    </Button>


                    <!--  Delete  -->

                    <Button
                        Grid.Column="4"
                        Height="34"
                        Padding="8,0"
                        HorizontalAlignment="Stretch"
                        hc:BorderElement.CornerRadius="5"
                        Background="#EF2B2D"
                        BorderThickness="0"
                        Command="{Binding DeleteMessageCommand}"
                        CommandParameter="{Binding SelectedMessage}"
                        Cursor="Hand"
                        FontSize="11"
                        Foreground="White">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Delete" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="حذف" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>