<Window
    x:Class="OrderHub.UI.Features.DatabaseConfiguration.DatabaseConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.DatabaseConfiguration"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    MinWidth="460"
    d:DataContext="{d:DesignInstance Type=local:DatabaseConfigurationViewModel}"
    FontFamily="{StaticResource Cairo}"
    ResizeMode="NoResize"
    ShowActivated="True"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Border Background="{DynamicResource RegionBrush}" FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  =====================================================  -->
            <!--  Header  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="0"
                Padding="18,14"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Border
                            Width="38"
                            Height="38"
                            Background="#EFF6FF"
                            CornerRadius="7">

                            <icons:MaterialIcon
                                Width="21"
                                Height="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="#2563EB"
                                Kind="DatabaseSettings" />

                        </Border>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">

                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#334155"
                                Text="إعدادات قاعدة البيانات" />

                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="#94A3B8"
                                Text="إعداد بيانات الاتصال بقاعدة البيانات" />

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!--  =====================================================  -->
            <!--  Content  -->
            <!--  =====================================================  -->

            <ScrollViewer
                Grid.Row="1"
                Padding="18"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!--  Connection Section  -->

                    <TextBlock
                        Margin="0,0,0,10"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="بيانات الاتصال" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>


                        <!--  Host  -->

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">

                            <TextBlock
                                Margin="0,0,0,5"
                                Foreground="#64748B"
                                Text="Host" />

                            <hc:TextBox
                                Height="36"
                                Padding="10,0"
                                hc:InfoElement.ShowClearButton="True"
                                Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="عنوان خادم قاعدة البيانات" />

                        </StackPanel>


                        <!--  Port  -->

                        <StackPanel Grid.Column="1">

                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="11"
                                Foreground="#64748B"
                                Text="Port" />

                            <hc:TextBox
                                Height="36"
                                Padding="10,0"
                                hc:InfoElement.ShowClearButton="True"
                                Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="منفذ PostgreSQL" />

                        </StackPanel>

                    </Grid>


                    <!--  Database  -->

                    <StackPanel Margin="0,14,0,0">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="11"
                            Foreground="#64748B"
                            Text="Database" />

                        <hc:TextBox
                            Height="36"
                            Padding="10,0"
                            hc:InfoElement.ShowClearButton="True"
                            Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>


                    <!--  Authentication  -->

                    <TextBlock
                        Margin="0,22,0,10"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="بيانات الدخول" />


                    <!--  Username  -->

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="11"
                            Foreground="#64748B"
                            Text="Username" />

                        <hc:TextBox
                            Height="36"
                            Padding="10,0"
                            hc:InfoElement.ShowClearButton="True"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>


                    <!--  Password  -->

                    <StackPanel Margin="0,14,0,0">

                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="11"
                            Foreground="#64748B"
                            Text="Password" />

                        <hc:PasswordBox
                            Height="36"
                            Padding="10,0"
                            hc:InfoElement.ShowClearButton="True"
                            hc:ShowEyeButton="True"
                            IsSafeEnabled="False"
                            UnsafePassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>


            <!--  =====================================================  -->
            <!--  Footer  -->
            <!--  =====================================================  -->

            <Border
                Grid.Row="2"
                Padding="18,12"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  Test Connection  -->

                    <Button
                        Grid.Column="0"
                        Height="36"
                        Padding="14,0"
                        HorizontalAlignment="Left"
                        Command="{Binding TestConnectionCommand}"
                        Cursor="Hand"
                        IsDefault="True">

                        <Button.Style>
                            <Style BasedOn="{StaticResource ButtonDefault}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.IsConnected}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Connection" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Text="اختبار الاتصال" />

                        </StackPanel>

                    </Button>

                    <hc:LoadingCircle Grid.Column="1" Visibility="{Binding IsBuisy, Converter={StaticResource Boolean2VisibilityConverter}}" />


                    <!--  Save  -->

                    <Button
                        Grid.Column="2"
                        Height="36"
                        Margin="8,0,0,0"
                        Padding="18,0"
                        Command="{Binding SaveCommand}"
                        Cursor="Hand"
                        IsDefault="True"
                        Style="{StaticResource ButtonPrimary}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="15"
                                Height="15"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="ContentSave" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="حفظ" />

                        </StackPanel>

                    </Button>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
