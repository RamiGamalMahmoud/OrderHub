<Window
    x:Class="OrderHub.UI.Features.Orders.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    PreviewKeyDown="Window_PreviewKeyDown"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border Background="{StaticResource WhiteBrush}" FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <hc:TabControl
                x:Name="TabControl"
                Padding="0"
                BorderThickness="0"
                IsTabFillEnabled="True"
                Style="{StaticResource TabControlInLine}">

                <hc:TabItem Header="المنتجات (F1)">

                    <Grid Grid.Column="1" Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <editorComponents:ProductsComponent Grid.Column="0" />

                        <editorComponents:OrderItemsComponent Grid.Column="2" />

                        <editorComponents:OrderItemDetailsPanel Grid.Column="4" />
                    </Grid>

                </hc:TabItem>

                <hc:TabItem Header="تفاصيل الطلب (F2)">
                    <Grid
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="2"
                        Background="{StaticResource WhiteBrush}">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <editorComponents:ClientsComponetn
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="6" />
                        <editorComponents:PaymentMethodsComponent
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="6" />
                        <editorComponents:DeliveryMethodComponent
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="6" />

                    </Grid>
                </hc:TabItem>

            </hc:TabControl>

            <editorComponents:OrderSummaryComponent Grid.Row="1" />

        </Grid>
    </Border>

</Window>
