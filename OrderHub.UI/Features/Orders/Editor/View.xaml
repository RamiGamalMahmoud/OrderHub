<Window
    x:Class="OrderHub.UI.Features.Orders.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="Arial"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border
        Margin="12"
        Padding="12"
        BorderBrush="LightGray"
        BorderThickness="0"
        CornerRadius="5"
        FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <editorComponents:ClientsComponetn Grid.Row="0" Margin="0,5" />

                <editorComponents:ProductsComponent Grid.Row="1" Margin="0,5" />

            </Grid>

            <DataGrid
                Grid.Row="1"
                Margin="0,5,0,0"
                d:ItemsSource="{d:SampleData}"
                hc:BorderElement.CornerRadius="5 5 0 0"
                AutoGenerateColumns="False"
                FontWeight="Bold"
                GridLinesVisibility="Vertical"
                ItemsSource="{Binding OrderBuilder.Items, IsAsync=True}"
                VerticalGridLinesBrush="LightGray">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding ProductName}"
                        Header="اسم المنتج"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding CategoryName}"
                        Header="القسم"
                        IsReadOnly="True" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Price}"
                        Header="السعر" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Quantity}"
                        Header="الكمية" />

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SubTotal}"
                        Header="إجمالي السعر"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn Header="خيارات">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="5,0"
                                        Padding="5"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor, AncestorLevel=2}, Path=DataContext.DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        FontFamily="Arial"
                                        Foreground="{StaticResource DangerBrush}"
                                        BorderThickness="0"
                                        Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=IsEnabled, Converter={converters:BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <icons:MaterialIcon Margin="0,0,0,0" Kind="Delete" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Row="2"
                Height="50"
                Padding="5"
                Background="#F3F4F8"
                BorderBrush="LightGray"
                BorderThickness="1,0,1,1"
                CornerRadius="0 0 5 5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="5"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="عدد المنتجات" />
                                <TextBlock
                                    Width="100"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BlueBrush}"
                                    Text="{Binding OrderBuilder.Count}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Padding="5"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="السعر الكلي" />
                                <TextBlock
                                    Width="100"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BlueBrush}"
                                    Text="{Binding OrderBuilder.TotalPrice}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Width="100"
                        Margin="5,0"
                        HorizontalAlignment="Right"
                        Command="{Binding CreateOrderCommand}"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="ContentSaveOutline" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Text="حفظ" />
                        </StackPanel>
                    </Button>

                </Grid>

            </Border>

        </Grid>
    </Border>

</Window>
