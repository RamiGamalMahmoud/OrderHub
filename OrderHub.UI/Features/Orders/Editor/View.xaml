<Window
    x:Class="OrderHub.UI.Features.Orders.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border Background="{StaticResource WhiteBrush}" FlowDirection="RightToLeft">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <editorComponents:ProductsComponent Grid.Column="0" />

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Height="50"
                    Padding="10"
                    Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1,1,1,0"
                    CornerRadius="10 10 0 0">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource BlueBrush}"
                            Kind="ListBoxOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="قائمة المنتجات المضافة" />
                    </StackPanel>
                </Border>

                <DataGrid
                    Grid.Row="1"
                    hc:BorderElement.CornerRadius="0 0 5 5"
                    AutoGenerateColumns="False"
                    BorderThickness="1,0,1,1"
                    ItemsSource="{Binding OrderBuilder.Items}"
                    VerticalGridLinesBrush="LightGray">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding ProductName}"
                            Header="المنتج"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding CategoryName}"
                            Header="القسم"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Quantity}"
                            Header="الكمية"
                            IsReadOnly="False" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding Price}"
                            Header="السعر"
                            IsReadOnly="True" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding SubTotal}"
                            Header="الاجمالي"
                            IsReadOnly="True" />

                        <DataGridTemplateColumn Header="إجراءات">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Padding="0"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Foreground="{StaticResource DangerBrush}">
                                        <icons:MaterialIcon Height="20" Kind="TrashCanOutline" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <editorComponents:ClientsComponetn Grid.Column="2" VerticalAlignment="Top" />

            <Border
                Grid.Column="2"
                Margin="12"
                Padding="12"
                VerticalAlignment="Bottom"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">

                    <StackPanel Height="40" Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource BlueBrush}"
                            Kind="ReceiptTextOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="ملخص الطلب" />
                    </StackPanel>

                    <Grid Margin="0,10">
                        <TextBlock Text="عدد المنتجات" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="16"
                            Text="{Binding OrderBuilder.Count}" />
                    </Grid>

                    <Grid Margin="0,10">
                        <TextBlock Text="المجموع" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="16"
                            Text="{Binding OrderBuilder.TotalPrice, StringFormat='{}{0} ر.س '}" />
                    </Grid>
                    <Button
                        Height="40"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SaveCommand}"
                        Cursor="Hand"
                        FontFamily="{StaticResource Tajawal}"
                        FontSize="16"
                        Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon
                                Width="20"
                                VerticalAlignment="Center"
                                Kind="CheckCircle" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="إتمام الطلب" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>
    </Border>

</Window>
