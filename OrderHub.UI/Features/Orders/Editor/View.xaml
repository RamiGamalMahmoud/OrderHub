<Window
    x:Class="OrderHub.UI.Features.Orders.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border Background="{StaticResource WhiteBrush}" FlowDirection="RightToLeft">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <editorComponents:ProductsComponent Grid.Column="0" />

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Height="50"
                    Padding="10"
                    Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1,1,1,0"
                    CornerRadius="10 10 0 0">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource BlueBrush}"
                            Kind="ListBoxOutline" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="قائمة المنتجات المضافة" />
                    </StackPanel>
                </Border>

                <editorComponents:OrderItemsComponent Grid.Row="1" />
            </Grid>

            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Visible">
                    <StackPanel Grid.Row="0">

                        <editorComponents:ClientsComponetn Margin="12" />
                        <editorComponents:PaymentMethodsComponent Margin="12" />
                        <editorComponents:DeliveryMethodComponent Margin="12" />

                    </StackPanel>
                </ScrollViewer>
                <editorComponents:OrderSummaryComponent Grid.Row="1" Margin="12" />
            </Grid>



        </Grid>
    </Border>

</Window>
