<Window
    x:Class="OrderHub.UI.Features.Orders.Editor.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="{Binding Title}"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="Arial"
    FontSize="14"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Border
        Margin="12"
        Padding="12"
        BorderBrush="LightGray"
        BorderThickness="0"
        CornerRadius="5"
        FlowDirection="RightToLeft">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <editorComponents:ClientsComponetn Grid.Row="0" Margin="0,5" />

                <editorComponents:ProductsComponent Grid.Row="1" Margin="0,5" />

            </Grid>

            <DataGrid
                Grid.Row="1"
                Margin="0,5"
                d:ItemsSource="{d:SampleData}"
                AutoGenerateColumns="False"
                Background="White"
                GridLinesVisibility="Vertical"
                IsReadOnly="True"
                ItemsSource="{Binding OrderItems, IsAsync=True}"
                VerticalGridLinesBrush="LightGray">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding ClientName}"
                        Header="اسم المنتج" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding ProductCategory}"
                        Header="القسم" />

                    <DataGridTextColumn Binding="{Binding ContactWay}" Header="السعر" />

                    <DataGridTextColumn Binding="{Binding TotalPrice}" Header="إجمالي السعر" />

                    <DataGridTemplateColumn Header="خيارات">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <buttons:ButtonEdit />
                                    <buttons:ButtonDelete Margin="5,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Row="2"
                Margin="0,5"
                Padding="5"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5">

                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="السعر الكلي" />
                        <Label />
                    </StackPanel>
                </StackPanel>

            </Border>

        </Grid>
    </Border>

</Window>
