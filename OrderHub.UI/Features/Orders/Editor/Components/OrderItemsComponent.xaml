<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <DataGrid
        hc:BorderElement.CornerRadius="0 0 5 5"
        AutoGenerateColumns="False"
        BorderThickness="1,0,1,1"
        GridLinesVisibility="Vertical"
        ItemsSource="{Binding OrderBuilder.Items}"
        RowHeight="70"
        VerticalGridLinesBrush="{StaticResource WhiteBrush}">
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="200"
                Binding="{Binding ProductName}"
                Header="المنتج"
                IsReadOnly="True" />
            <DataGridTextColumn
                Binding="{Binding CategoryName}"
                Header="القسم"
                IsReadOnly="True" />
            <DataGridTemplateColumn Header="الكمية">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBox
                            Width="50"
                            Margin="5,0"
                            Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>


            <DataGridTemplateColumn Header="السعر">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBox Width="100" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn
                Width="100"
                Binding="{Binding SubTotal}"
                Header="الإجمال"
                IsReadOnly="True" />

            <DataGridTemplateColumn Width="200" Header="المورد">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <hc:ComboBox
                            hc:InfoElement.ShowClearButton="True"
                            Cursor="Hand"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Suppliers}"
                            SelectedItem="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="إجراءات">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button
                            Padding="0"
                            BorderThickness="0"
                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.RemoveOrderItemCommand}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Foreground="{StaticResource DangerBrush}">
                            <icons:MaterialIcon Height="20" Kind="TrashCanOutline" />
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>
