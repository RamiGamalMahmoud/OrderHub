<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <DataGrid
        hc:BorderElement.CornerRadius="0 0 5 5"
        AutoGenerateColumns="False"
        BorderThickness="1,0,1,1"
        GridLinesVisibility="Vertical"
        ItemsSource="{Binding OrderBuilder.Items}"
        VerticalGridLinesBrush="{StaticResource WhiteBrush}">
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="300"
                Binding="{Binding ProductName}"
                Header="المنتج"
                IsReadOnly="True" />
            <DataGridTextColumn
                Width="100"
                Binding="{Binding CategoryName}"
                Header="القسم"
                IsReadOnly="True" />
            <DataGridTemplateColumn Header="الكمية">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBox
                            Width="50"
                            Margin="5,0"
                            Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>


            <DataGridTemplateColumn Header="السعر">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBox Width="100" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn
                Width="100"
                Binding="{Binding SubTotal}"
                Header="الإجمال"
                IsReadOnly="True" />

            <DataGridTemplateColumn Header="الحالة">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <icons:MaterialIcon
                            Width="20"
                            Height="20"
                            Foreground="{StaticResource WarningBrush}"
                            Kind="Alert" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>
