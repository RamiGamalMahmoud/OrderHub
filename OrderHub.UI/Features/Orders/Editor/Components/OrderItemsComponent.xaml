<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <DataGrid
        hc:BorderElement.CornerRadius="0 0 5 5"
        AutoGenerateColumns="False"
        BorderThickness="1,0,1,1"
        GridLinesVisibility="Vertical"
        ItemsSource="{Binding OrderBuilder.Items}"
        RowHeight="70"
        VerticalGridLinesBrush="{StaticResource WhiteBrush}">
        <DataGrid.Columns>
            <DataGridTextColumn
                Width="200"
                Binding="{Binding ProductName}"
                Header="المنتج"
                IsReadOnly="True" />
            <DataGridTextColumn
                Binding="{Binding CategoryName}"
                Header="القسم"
                IsReadOnly="True" />
            <DataGridTextColumn
                Width="100"
                Binding="{Binding Quantity}"
                Header="الكمية"
                IsReadOnly="False" />

            <DataGridTemplateColumn Header="تفاصيل">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock>
                                <Run Text="السعر : " />
                                <Run Text="{Binding Price}" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="الاجمالي : " />
                                <Run Text="{Binding SubTotal, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Width="200" Header="المورد">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <hc:ComboBox
                            hc:InfoElement.ShowClearButton="True"
                            Cursor="Hand"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Suppliers}"
                            SelectedItem="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTemplateColumn Header="إجراءات">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button
                            Padding="0"
                            BorderThickness="0"
                            Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=DataContext.RemoveOrderItemCommand}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            Foreground="{StaticResource DangerBrush}">
                            <icons:MaterialIcon Height="20" Kind="TrashCanOutline" />
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

        </DataGrid.Columns>

    </DataGrid>

</UserControl>
