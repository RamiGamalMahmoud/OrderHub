<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">

        <Border
            Grid.Row="0"
            Height="50"
            Padding="12"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1,1,1,0"
            CornerRadius="10 10 0 0">
            <StackPanel Orientation="Horizontal">
                <icons:MaterialIcon
                    Width="20"
                    Foreground="{StaticResource BlueBrush}"
                    Kind="ListBoxOutline" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="قائمة المنتجات المضافة" />
            </StackPanel>
        </Border>

        <DataGrid
            hc:BorderElement.CornerRadius="0 0 5 5"
            AutoGenerateColumns="False"
            BorderThickness="1,0,1,1"
            GridLinesVisibility="Vertical"
            ItemsSource="{Binding Items.Items}"
            SelectedItem="{Binding Items.SelectedItem}"
            VerticalGridLinesBrush="{StaticResource WhiteBrush}">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="300"
                    Binding="{Binding ProductName}"
                    Header="المنتج"
                    IsReadOnly="True" />

                <DataGridTextColumn
                    MinWidth="150"
                    Binding="{Binding CategoryName}"
                    Header="القسم"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Header="الكمية">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox
                                Width="50"
                                Margin="5,0"
                                Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="السعر">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Width="100" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الضريبة">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Width="100" Text="{Binding VAT, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Binding="{Binding SubTotal}"
                    Header="الإجمال"
                    IsReadOnly="True" />

            </DataGrid.Columns>

        </DataGrid>
    </StackPanel>

</UserControl>
