<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.DeliveryMethodComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <StackPanel>

        <!--  Delivery Method Card  -->

        <Border
            Padding="20"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->

                <StackPanel Grid.Row="0" Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        Foreground="{StaticResource Primary}"
                        Kind="DeliveryDiningOutline" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="آلية التوصيل" />

                </StackPanel>

                <!--  Methods  -->

                <ListView
                    Grid.Row="2"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding DeliveryMethodsViewModel.DeliveryMethods}"
                    SelectedItem="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod}">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>

                        <Style BasedOn="{StaticResource ListViewItemBaseStyle}" TargetType="ListViewItem">

                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />

                            <Style.Triggers>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>

                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Background" Value="#F8F9FA" />
                                    <Setter Property="Foreground" Value="#333" />
                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}" />

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

        <!--  Selected Method Details  -->

        <ContentControl Margin="0,15,0,0" Content="{Binding DeliveryMethodsViewModel}">

            <ContentControl.Style>

                <Style TargetType="ContentControl">

                    <Setter Property="ContentTemplate">

                        <Setter.Value>

                            <DataTemplate>

                                <Border
                                    Padding="15"
                                    Background="#FFF9E6"
                                    BorderBrush="#FFD966"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <TextBlock Foreground="#A66A00" Text="يرجى اختيار آلية التوصيل." />

                                </Border>

                            </DataTemplate>

                        </Setter.Value>

                    </Setter>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.Pickup}">

                            <Setter Property="ContentTemplate">

                                <Setter.Value>

                                    <DataTemplate>

                                        <Border
                                            Padding="15"
                                            Background="#F7FAFC"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10">

                                            <StackPanel>

                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="استلام من المقر" />

                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    Foreground="Gray"
                                                    Text="سيقوم العميل باستلام الطلب بنفسه من المقر." />

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </Setter.Value>

                            </Setter>

                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.ShippingCompany}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:ShippingCarriersComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.DeliveryMan}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:DeliverymenComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.DeliveryChain}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:DeliveryChainsComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </ContentControl.Style>

        </ContentControl>

    </StackPanel>

</UserControl>