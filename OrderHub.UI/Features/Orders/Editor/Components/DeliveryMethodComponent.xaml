<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.DeliveryMethodComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editorComponents="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Border
            Padding="12"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Orientation="Vertical">

                <StackPanel Height="40" Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Foreground="{StaticResource BlueBrush}"
                        Kind="DeliveryDiningOutline" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Text="آلية التوصيل" />
                </StackPanel>

                <hc:ComboBox
                    Height="40"
                    Margin="0,10,0,0"
                    hc:InfoElement.ShowClearButton="True"
                    Cursor="Hand"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding DeliveryMethodsViewModel.DeliveryMethods}"
                    SelectedItem="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod}" />

            </StackPanel>

        </Border>

        <ContentControl Margin="0,12,0,0" Content="{Binding DeliveryMethodsViewModel}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">

                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource DangerBrush}" Text="يرجى اختيار طريقة التوصيل المناسبة" />
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.Pickup}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock FontWeight="DemiBold" Text="استلام من المقر" />
                                            <TextBlock Foreground="Gray" Text="سوف يقوم العميل باستلام المنتجات من المقر" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.ShippingCompany}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:ShippingCarriersComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.DeliveryMan}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:DeliverymenComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding DeliveryMethodsViewModel.SelecteddDeliveryMethod.Value}" Value="{x:Static enums:DeliveryMethod.DeliveryChain}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <editorComponents:DeliveryChainsComponent />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </StackPanel>

</UserControl>
