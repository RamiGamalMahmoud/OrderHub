<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.ClientsComponetn"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <!--  Client Informations  -->
    <Border
        Padding="5"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">
        <StackPanel Orientation="Horizontal">
            <!--  Client Selection  -->
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="العملاء" />
                    <ComboBox
                        Width="250"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding Clients}"
                        SelectedItem="{Binding SelectedClient}" />
                </StackPanel>

                <Button
                    Margin="5,0"
                    Padding="5"
                    VerticalAlignment="Bottom"
                    Command="{Binding SearchClientCommand}"
                    Cursor="Hand"
                    FontFamily="Arial"
                    Foreground="{StaticResource BlueBrush}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Kind="Search" />
                    </StackPanel>
                </Button>

                <Button
                    Margin="5,0"
                    Padding="5"
                    VerticalAlignment="Bottom"
                    Command="{Binding AddClientCommand}"
                    Cursor="Hand"
                    FontFamily="Arial"
                    Foreground="{StaticResource BlueBrush}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Kind="AddBox" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="رقم الهاتف" />
                    <Label
                        Width="150"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Phone" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="0123456789" />
                        </StackPanel>
                    </Label>
                </StackPanel>

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="العنوان" />
                    <Label
                        Width="200"
                        Margin="0,5,0,0"
                        HorizontalContentAlignment="Left"
                        FontWeight="Bold">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Location" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="القاهرة" />
                        </StackPanel>
                    </Label>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
