<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:myConverters="clr-namespace:OrderHub.UI.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <myConverters:StringBoolConverter x:Key="StringBoolConverter" />
    </UserControl.Resources>

    <Border
        Width="400"
        Padding="16"
        Background="White"
        BorderBrush="#E5E5E5"
        BorderThickness="1"
        CornerRadius="5">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,16" LastChildFill="False">

                <icons:MaterialIcon
                    Width="20"
                    Height="20"
                    Margin="6,0,0,0"
                    DockPanel.Dock="Left"
                    Foreground="#3F6FF6"
                    Kind="PackageVariantClosed" />

                <TextBlock
                    Margin="5,0,0,0"
                    DockPanel.Dock="Left"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Primary}"
                    Text="تفاصيل المنتج" />

                <StackPanel
                    HorizontalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">

                    <Button
                        Margin="0,0,5,0"
                        Command="{Binding SelectePrevOrderItemCommand}"
                        Cursor="Hand"
                        ToolTip="السابق">
                        <icons:MaterialIcon Kind="ArrowRightThin" />
                    </Button>

                    <Button
                        Command="{Binding SelecteNextOrderItemCommand}"
                        Cursor="Hand"
                        ToolTip="التالي">
                        <icons:MaterialIcon Kind="ArrowLeftThin" />
                    </Button>

                </StackPanel>

            </DockPanel>

            <!--  Content  -->

            <ScrollViewer Grid.Row="1">

                <StackPanel>

                    <!--  Product  -->

                    <Border
                        Margin="0,0,0,12"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedOrderItem.ProductName}" />

                            <Border
                                Margin="0,5,0,0"
                                Padding="5,3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource WhiteBrush}"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{Binding SelectedOrderItem.CategoryName}" />
                            </Border>

                        </StackPanel>

                    </Border>

                    <!--  Supplier  -->

                    <Border
                        Margin="0,0,0,12"
                        Background="#fafbfc"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="المورد" />

                            <ComboBox
                                Height="36"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding SelectedOrderItem.Suppliers}"
                                SelectedItem="{Binding SelectedOrderItem.Supplier}" />

                        </StackPanel>

                    </Border>

                    <!--  Product Properties  -->

                    <Border
                        Margin="0,0,0,12"
                        Background="#fafbfc"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <icons:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Kind="TagOutline" />
                                <TextBlock FontWeight="SemiBold" Text="خصائص المنتج" />
                            </StackPanel>

                            <ItemsControl HorizontalAlignment="Stretch" ItemsSource="{Binding SelectedOrderItem.Properties}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="5" />
                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{StaticResource Primary}"
                                                    Text="{Binding Name}" />
                                                <icons:MaterialIcon
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Kind="Dot"
                                                    Visibility="{Binding IsRequired, Converter={converters:BoolToVisibilityConverter}}" />
                                            </StackPanel>

                                            <ContentControl
                                                Grid.Column="2"
                                                Content="{Binding}"
                                                FontSize="12">

                                                <ContentControl.Style>

                                                    <Style TargetType="ContentControl">

                                                        <Style.Triggers>

                                                            <DataTrigger Binding="{Binding PropertyType}" Value="{x:Static enums:PropertyType.Text}">
                                                                <Setter Property="ContentTemplate">

                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <hc:TextBox
                                                                                hc:InfoElement.Placeholder="ادخل قيمة الخاصية"
                                                                                hc:InfoElement.ShowClearButton="True"
                                                                                Text="{Binding SelectedOptionValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding PropertyType}" Value="{x:Static enums:PropertyType.List}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <hc:ComboBox
                                                                                hc:InfoElement.Placeholder="اختر قيمة الخاصية من القائمة"
                                                                                hc:InfoElement.ShowClearButton="True"
                                                                                Cursor="Hand"
                                                                                DisplayMemberPath="Value"
                                                                                ItemsSource="{Binding Options}"
                                                                                SelectedValue="{Binding SelectedOptionValue}"
                                                                                SelectedValuePath="Value" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>

                                                            <DataTrigger Binding="{Binding PropertyType}" Value="{x:Static enums:PropertyType.Boolean}">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <CheckBox IsChecked="{Binding SelectedOptionValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringBoolConverter}}" />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>

                                                        </Style.Triggers>

                                                    </Style>

                                                </ContentControl.Style>

                                            </ContentControl>

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!--  Footer  -->

            <Button
                Grid.Row="2"
                Height="42"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                BorderBrush="{StaticResource DangerBrush}"
                Command="{Binding RemoveOrderItemCommand}"
                CommandParameter="{Binding SelectedOrderItem}"
                FontSize="14"
                Foreground="{StaticResource DangerBrush}">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        Kind="DeleteOutline" />

                    <TextBlock Margin="8,0,0,0" Text="حذف المنتج" />

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>