<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderItemDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="340"
    mc:Ignorable="d">

    <Border
        Padding="16"
        Background="White"
        BorderBrush="#E5E5E5"
        BorderThickness="1"
        CornerRadius="5">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <StackPanel Margin="0,0,0,16" Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="20"
                    Height="20"
                    Margin="6,0,0,0"
                    DockPanel.Dock="Right"
                    Foreground="#3F6FF6"
                    Kind="PackageVariantClosed" />

                <TextBlock
                    Margin="5,0,0,0"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Primary}"
                    Text="تفاصيل المنتج" />

                <Separator Margin="0,10,0,0" />

            </StackPanel>

            <!--  Content  -->

            <ScrollViewer Grid.Row="1">

                <StackPanel>

                    <!--  Product  -->

                    <Border
                        Margin="0,0,0,12"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <TextBlock FontWeight="SemiBold" Text="تكيات أرضية بدون كرسي" />

                            <Border
                                Margin="0,5,0,0"
                                Padding="5,3"
                                HorizontalAlignment="Left"
                                Background="{StaticResource WhiteBrush}"
                                CornerRadius="3">
                                <TextBlock Foreground="Gray" Text="تكيات" />
                            </Border>

                        </StackPanel>

                    </Border>

                    <!--  Supplier  -->

                    <Border
                        Margin="0,0,0,12"
                        Background="#fafbfc"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <TextBlock
                                Margin="0,0,0,8"
                                FontWeight="SemiBold"
                                Text="المورد" />

                            <ComboBox
                                Height="36"
                                ItemsSource="{Binding Suppliers}"
                                SelectedItem="{Binding SelectedSupplier}" />

                        </StackPanel>

                    </Border>

                    <!--  Product Properties  -->

                    <Border
                        Margin="0,0,0,12"
                        Background="#fafbfc"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel Margin="12">

                            <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                <icons:MaterialIcon
                                    Width="18"
                                    Height="18"
                                    Kind="TagOutline" />
                                <TextBlock FontWeight="SemiBold" Text="خصائص المنتج" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Properties}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Grid Margin="0,0,0,10">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="120" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />

                                            <ComboBox
                                                Grid.Column="1"
                                                Height="34"
                                                ItemsSource="{Binding Options}"
                                                SelectedItem="{Binding SelectedOption}" />

                                        </Grid>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!--  Footer  -->

            <Button
                Grid.Row="2"
                Height="42"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                BorderBrush="{StaticResource DangerBrush}"
                Command="{Binding RemoveCommand}"
                FontSize="14"
                Foreground="{StaticResource DangerBrush}">

                <StackPanel Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="18"
                        Height="18"
                        Kind="DeleteOutline" />

                    <TextBlock Margin="8,0,0,0" Text="حذف المنتج" />

                </StackPanel>

            </Button>

        </Grid>

    </Border>

</UserControl>