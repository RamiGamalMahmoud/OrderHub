<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.DeliverymenComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Padding="12"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Orientation="Vertical">

            <DockPanel Height="40">
                <icons:MaterialIcon
                    Width="20"
                    Foreground="{StaticResource BlueBrush}"
                    Kind="AccountOutline" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="بيانات المندوب" />
            </DockPanel>

            <!--  Client Selection  -->
            <StackPanel Margin="0,5" Orientation="Vertical">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Text="اسم المندوب" />
                    <ComboBox
                        Height="40"
                        Margin="0,8,0,0"
                        DisplayMemberPath="Name"
                        IsEditable="True"
                        ItemsSource="{Binding Deliverymen}"
                        SelectedItem="{Binding SelectedDeliveryman}" />
                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
