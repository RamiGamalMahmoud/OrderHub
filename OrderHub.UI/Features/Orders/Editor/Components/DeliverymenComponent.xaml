<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.DeliverymenComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Padding="12"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel Orientation="Vertical">

            <DockPanel Height="40">
                <icons:MaterialIcon
                    Width="20"
                    Foreground="{StaticResource BlueBrush}"
                    Kind="AccountOutline" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="بيانات المندوب" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ToggleButton
                        x:Name="DeliverymenExpander"
                        BorderThickness="0"
                        Cursor="Hand">
                        <icons:MaterialIcon
                            Width="20"
                            Foreground="{StaticResource Primary}"
                            Kind="ExpandMore" />
                    </ToggleButton>
                </StackPanel>
            </DockPanel>

            <!--  Client Selection  -->
            <StackPanel Margin="0,5" Orientation="Vertical">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Text="اسم المندوب" />
                    <TextBox
                        Margin="0,5,0,0"
                        Padding="10,6"
                        HorizontalContentAlignment="Right"
                        Text="{Binding DeliverymanSearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Height="40"
                        Margin="0,8,0,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Deliverymen}"
                        SelectedItem="{Binding SelectedDeliveryman}" />
                </StackPanel>

            </StackPanel>

            <StackPanel Orientation="Vertical" Visibility="{Binding ElementName=DeliverymenExpander, Path=IsChecked, Converter={converters:BoolToVisibilityConverter}}">
                <StackPanel Margin="0,10" Orientation="Vertical">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Text="رقم الهاتف" />
                    <Label
                        Height="40"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Width="20" Kind="PhoneOutline" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                Text="{Binding SelectedDeliveryman.PhoneNumber}" />
                        </StackPanel>
                    </Label>
                </StackPanel>

                <StackPanel Margin="0,10" Orientation="Vertical">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="Gray"
                        Text="العنوان" />
                    <Label
                        Height="40"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Width="20" Kind="LocationOutline" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding SelectedDeliveryman.CityName}" />
                        </StackPanel>
                    </Label>
                </StackPanel>
            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
