<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.DeliveryChainsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:DeliveryMethodsViewModel}"
    mc:Ignorable="d">

    <Border
        Padding="12"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">

            <DockPanel Height="40">
                <icons:MaterialIcon
                    Width="20"
                    Foreground="{StaticResource BlueBrush}"
                    Kind="VectorSquareClose" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="سلسلة التوصيل" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                    <Button
                        Height="30"
                        Margin="5,0"
                        Padding="5,0"
                        Command="{Binding AddDeliverymanStepCommand}"
                        Content="إضافة مندوب"
                        Cursor="Hand" />
                    <Button
                        Height="30"
                        Margin="5,0"
                        Padding="5,0"
                        Command="{Binding AddShippingCarrierStepCommand}"
                        Content="إضافة شركة شحن" />

                    <Button Command="{Binding MoveDeliveryStepDownCommand}" CommandParameter="{Binding ElementName=StespListBox, Path=SelectedItem}">
                        <icons:MaterialIcon Kind="ChevronDown" />
                    </Button>

                    <Button
                        Margin="5,0"
                        Command="{Binding MoveDeliveryStepUpCommand}"
                        CommandParameter="{Binding ElementName=StespListBox, Path=SelectedItem}">
                        <icons:MaterialIcon Kind="ChevronUp" />
                    </Button>

                </StackPanel>


            </DockPanel>
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ListBox
                    x:Name="StespListBox"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding DeliverySteps}"
                    SelectedItem="{Binding SelectedDeliveryStep}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock
                                        Width="100"
                                        VerticalAlignment="Center"
                                        Text="{Binding Type}" />
                                    <TextBlock Text="{Binding StepOrder}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Margin="5,0"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Handlers}"
                                    SelectedItem="{Binding SelectedHandler}" />

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.RemoveDeliveryStepCommand}"
                                    CommandParameter="{Binding}">
                                    <icons:MaterialIcon Kind="Close" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </StackPanel>

    </Border>

</UserControl>
