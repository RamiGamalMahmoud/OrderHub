<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.ProductsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Padding="5"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource BlueBrush}"
                    Text="القسم" />
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <ComboBox
                        Width="200"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding RootCategories}"
                        SelectedItem="{Binding SelectedCategory}" />

                    <ItemsControl ItemsSource="{Binding SubCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,0" Orientation="Horizontal">
                                    <icons:MaterialIcon Foreground="{StaticResource BlueBrush}" Kind="ArrowLeftBoldCircleOutline" />
                                    <ComboBox
                                        Width="200"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Value}"
                                        SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SelectedCategory}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,5" Orientation="Horizontal">

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="المنتج" />
                    <ComboBox
                        Width="250"
                        Height="40"
                        Margin="0,5,0,0"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct}" />
                </StackPanel>

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="السعر" />
                    <hc:NumericUpDown
                        Width="150"
                        Height="40"
                        Margin="0,5,0,0"
                        FontSize="30"
                        Minimum="0"
                        Value="{Binding Price}" />
                </StackPanel>

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource BlueBrush}"
                        Text="الكمية" />
                    <hc:NumericUpDown
                        Width="100"
                        Height="40"
                        Margin="0,5,0,0"
                        FontSize="30"
                        Minimum="0"
                        Value="{Binding Quantity}" />
                </StackPanel>

                <Button
                    Margin="5,0"
                    VerticalAlignment="Bottom"
                    Command="{Binding AddProductCommand}"
                    Cursor="Hand"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Kind="PlusCircle" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Text="اضافة" />
                    </StackPanel>
                </Button>

            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
