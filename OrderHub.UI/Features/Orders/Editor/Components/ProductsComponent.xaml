<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.ProductsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Padding="5"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">
        <StackPanel Orientation="Vertical">

            <StackPanel Margin="0,5" Orientation="Horizontal">
                <ComboBox
                    Width="200"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding RootCategories}"
                    SelectedItem="{Binding SelectedCategory}" />

                <ItemsControl ItemsSource="{Binding SubCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,0" Orientation="Horizontal">
                                <icons:MaterialIcon Foreground="{StaticResource BlueBrush}" Kind="ArrowLeftBoldCircleOutline" />
                                <ComboBox
                                    Width="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Value}"
                                    SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.SelectedCategory}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <StackPanel Margin="0,5" Orientation="Horizontal">

                <StackPanel Orientation="Vertical">
                    <TextBlock VerticalAlignment="Center" Text="المنتج" />
                    <ComboBox
                        Width="200"
                        Margin="0,5,0,0"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct}" />
                </StackPanel>

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock VerticalAlignment="Center" Text="السعر" />
                    <TextBox
                        Width="100"
                        Margin="0,5,0,0"
                        Text="{Binding Price}" />
                </StackPanel>

                <StackPanel Margin="5,0" Orientation="Vertical">
                    <TextBlock VerticalAlignment="Center" Text="الكمية" />
                    <TextBox
                        Width="50"
                        Margin="0,5,0,0"
                        Text="{Binding Quantity}" />
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </Border>

</UserControl>
