<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.ProductsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    PreviewKeyDown="UserControl_PreviewKeyDown"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="MyStye"
            BasedOn="{StaticResource ListViewItemBaseStyle}"
            TargetType="ListViewItem">
            <Setter Property="Background" Value="#f1f5f9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightBlueBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="4*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Vertical">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  العنوان  -->
                    <StackPanel
                        Grid.Column="0"
                        Height="40"
                        Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="20"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource BlueBrush}"
                            Kind="InvoiceLineItems" />

                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="DemiBold"
                            Text="المنتجات" />

                    </StackPanel>


                    <!--  أزرار الإجراءات  -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <Button
                            Height="Auto"
                            Margin="0,0,5,0"
                            BorderThickness="0"
                            Command="{Binding ShowCategoresViewCommand}"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource Primary}"
                            ToolTip="اختيار القسم">

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                <TextBlock VerticalAlignment="Center" Text="اختيار القسم" />

                            </StackPanel>
                        </Button>


                        <!--  إضافة منتج  -->
                        <Button
                            Height="Auto"
                            BorderThickness="0"
                            Command="{Binding AddProductCommand}"
                            Cursor="Hand"
                            Foreground="{StaticResource Primary}"
                            ToolTip="إضافة منتج">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Margin="5,0,0,0"
                                    FontWeight="SemiBold"
                                    Text="إضافة منتج" />

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

                <hc:SearchBar
                    x:Name="ProductSearchBar"
                    Height="40"
                    VerticalAlignment="Top"
                    hc:InfoElement.Placeholder="ابحث عن منتج"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding ProductsPanel.SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

            <ListView
                x:Name="ProductListView"
                Grid.Row="1"
                Padding="5"
                Background="White"
                BorderThickness="1"
                ItemContainerStyle="{StaticResource MyStye}"
                ItemsSource="{Binding ProductsPanel.Products}"
                SelectedItem="{Binding ProductsPanel.SelectedProduct}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  معلومات المنتج  -->
                            <StackPanel>

                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />

                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="{Binding CategoryName}" />

                            </StackPanel>

                            <!--  السعر  -->
                            <Border
                                Grid.Column="1"
                                MinWidth="50"
                                Padding="5"
                                HorizontalAlignment="Left"
                                Background="White"
                                CornerRadius="3">
                                <StackPanel Orientation="Vertical">

                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Primary}"
                                        Text="{Binding Price}" />

                                    <TextBlock
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="ر.س" />

                                </StackPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">

                <Grid Margin="0,3,0,0" FlowDirection="RightToLeft">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>


                    <!--  =========================  -->
                    <!--  Inputs  -->
                    <!--  =========================  -->

                    <!--  Unit Price  -->

                    <StackPanel Grid.Row="0" Grid.Column="0">

                        <TextBlock
                            Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="سعر الوحدة" />

                        <hc:NumericUpDown
                            Name="PriceInput"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="17"
                            FontWeight="DemiBold"
                            Minimum="0"
                            Value="{Binding ProductsPanel.Price}" />

                    </StackPanel>


                    <!--  Quantity  -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,0">

                        <TextBlock
                            Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="الكمية" />

                        <hc:NumericUpDown
                            Name="QuantityInput"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="17"
                            FontWeight="DemiBold"
                            Minimum="0"
                            Value="{Binding ProductsPanel.Quantity}" />

                    </StackPanel>


                    <!--  VAT  -->

                    <StackPanel Grid.Row="0" Grid.Column="2">

                        <TextBlock
                            Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="نسبة الضريبة (%)" />

                        <hc:NumericUpDown
                            Name="VATInput"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="17"
                            FontWeight="DemiBold"
                            Minimum="0"
                            Value="{Binding ProductsPanel.VAT}" />

                    </StackPanel>


                    <!--  =========================  -->
                    <!--  Price Summary  -->
                    <!--  =========================  -->


                    <!--  Subtotal  -->

                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,2,0"
                        Padding="6,4"
                        Background="#F4F6FA"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="4">

                        <StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Text="الإجمالي الفرعي" />

                            <TextBlock
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding ProductsPanel.Pricing.Subtotal}" />

                        </StackPanel>

                    </Border>


                    <!--  VAT  -->

                    <Border
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="2,0"
                        Padding="6,4"
                        Background="#F4F6FA"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="4">

                        <StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                Text="الضريبة" />

                            <TextBlock
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding ProductsPanel.Pricing.VatAmount}" />

                        </StackPanel>

                    </Border>

                    <!--  Total  -->

                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="2,0,0,0"
                        Padding="6,4"
                        Background="#EEF3FF"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="4">

                        <StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Text="الإجمالي" />

                            <TextBlock
                                Margin="0,1,0,0"
                                HorizontalAlignment="Center"
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="#2453D4"
                                Text="{Binding ProductsPanel.Pricing.Total}" />

                        </StackPanel>

                    </Border>

                </Grid>

                <Button
                    x:Name="AddProductButton"
                    Height="40"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    Click="AddProductButton_Click"
                    Command="{Binding ProductsPanel.AddProductCommand}"
                    Cursor="Hand"
                    FontSize="16"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon VerticalAlignment="Center" Kind="PlusCircle" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="إضافة منتج" />
                    </StackPanel>
                </Button>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>
