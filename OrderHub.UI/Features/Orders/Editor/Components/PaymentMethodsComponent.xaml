<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.PaymentMethodsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">

    <Border
        Padding="20"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="12">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->

            <StackPanel Grid.Row="0" Orientation="Horizontal">

                <icons:MaterialIcon
                    Width="18"
                    Height="18"
                    Foreground="{StaticResource Primary}"
                    Kind="AccountCashOutline" />

                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="وسيلة الدفع" />

            </StackPanel>

            <!--  Payment Methods  -->

            <ListView
                Grid.Row="2"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding PartyPanel.PaymentMethods}"
                SelectedItem="{Binding PartyPanel.SelectedPaymentMethod}">

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemContainerStyle>

                    <Style BasedOn="{StaticResource ListViewItemBaseStyle}" TargetType="ListViewItem">

                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Padding" Value="12" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />

                        <Style.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter Property="Background" Value="{StaticResource Primary}" />

                                <Setter Property="Foreground" Value="White" />

                            </Trigger>

                            <Trigger Property="IsSelected" Value="False">

                                <Setter Property="Background" Value="#F8F9FA" />

                                <Setter Property="Foreground" Value="#333" />

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,6,0"
                                Kind="Cash" />

                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />

                        </StackPanel>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Grid>

    </Border>

</UserControl>