<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.PaymentMethodsComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Border
            Padding="12"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Orientation="Vertical">

                <StackPanel Height="40" Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        Foreground="{StaticResource BlueBrush}"
                        Kind="AccountCashOutline" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="DemiBold"
                        Text="وسلة الدفع" />
                </StackPanel>

                <ListView
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding PaymentMethods}"
                    SelectedItem="{Binding SelectedPaymentMethod}"
                    Validation.ErrorTemplate="{x:Null}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListViewItemBaseStyle}" TargetType="ListViewItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="Padding" Value="10" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="False">
                                    <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>

        </Border>

    </StackPanel>

</UserControl>
