<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderSummaryComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Grid.Row="2"
        Grid.Column="2"
        Padding="12"
        Background="#f0f5fe"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="6"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <TextBlock
                        FontWeight="DemiBold"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="عدد المنتجات" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding OrderBuilder.ItemsCount}" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Margin="12,0"
                Padding="6"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <TextBlock
                        FontWeight="DemiBold"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="المجموع" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding OrderBuilder.TotalPrice, StringFormat='{}{0} ر.س '}" />
                </StackPanel>
            </Border>

            <Button
                Grid.Column="2"
                Width="200"
                Height="auto"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Cursor="Hand"
                FontSize="16"
                Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        VerticalAlignment="Center"
                        Kind="CheckCircle" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ActionName, StringFormat='{}{0} (F12)'}" />
                </StackPanel>
            </Button>

        </Grid>
    </Border>

</UserControl>
