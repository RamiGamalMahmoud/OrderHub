<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderSummaryComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Grid.Row="2"
        Grid.Column="2"
        Margin="5,5"
        Padding="16,12"
        Background="#f0f5fe"
        BorderBrush="LightGray"
        FlowDirection="RightToLeft">

        <Grid>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                        <StackPanel Margin="0,0,24,0" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Style="{StaticResource TextBlockDefaultBold}"
                                Text="إجمالي الأصناف:" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding Items.ItemsCount}" />
                        </StackPanel>

                        <Border
                            Width="1"
                            Height="16"
                            Margin="0,0,24,0"
                            Background="LightGray" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Style="{StaticResource TextBlockDefaultBold}"
                                Text="المبلغ الإجمالي المطلـوب:" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding Items.TotalPrice, StringFormat='{}{0} ر.س '}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">

                    <!--  عرض سعر  -->
                    <Button
                        Height="38"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding CreateQuotationCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonDashedPrimary}"
                        Visibility="{Binding IsDocumentingReady, Converter={StaticResource Boolean2VisibilityConverter}}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="19"
                                Height="19"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Kind="FileDocumentEditOutline" />

                            <TextBlock VerticalAlignment="Center" Text="عرض سعر" />

                        </StackPanel>
                    </Button>


                    <!--  حفظ كفاتورة  -->
                    <Button
                        Height="38"
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding CreateProformaIncoidCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonDashedPrimary}"
                        Visibility="{Binding IsDocumentingReady, Converter={StaticResource Boolean2VisibilityConverter}}">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="19"
                                Height="19"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Kind="FileDocumentCheckOutline" />

                            <TextBlock VerticalAlignment="Center" Text="إنشاء فاتورة أولية" />

                        </StackPanel>
                    </Button>


                    <!--  حفظ وإرسال  -->
                    <Button
                        Height="38"
                        Padding="16,0"
                        Command="{Binding SaveCommand}"
                        Cursor="Hand"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="حفظ الطلب">

                        <StackPanel Orientation="Horizontal">

                            <icons:MaterialIcon
                                Width="19"
                                Height="19"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Kind="CheckCircleOutline" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{Binding ActionName, StringFormat='{}{0} (F12)'}" />

                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</UserControl>
