<UserControl
    x:Class="OrderHub.UI.Features.Orders.Editor.Components.OrderSummaryComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Editor.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Editor"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Grid.Row="2"
        Grid.Column="2"
        Padding="12"
        Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">

            <StackPanel Height="40" Orientation="Horizontal">
                <icons:MaterialIcon
                    Width="20"
                    Foreground="{StaticResource BlueBrush}"
                    Kind="ReceiptTextOutline" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="ملخص الطلب" />
            </StackPanel>

            <Grid Margin="0,10">
                <TextBlock Text="عدد المنتجات" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="16"
                    Text="{Binding OrderBuilder.ItemsCount}" />
            </Grid>

            <Grid Margin="0,10">
                <TextBlock Text="المجموع" />
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="16"
                    Text="{Binding OrderBuilder.TotalPrice, StringFormat='{}{0} ر.س '}" />
            </Grid>
            <Button
                Height="40"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding SaveCommand}"
                Cursor="Hand"
                FontSize="16"
                Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon
                        Width="20"
                        VerticalAlignment="Center"
                        Kind="CheckCircle" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Text="إتمام الطلب" />
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>

</UserControl>
