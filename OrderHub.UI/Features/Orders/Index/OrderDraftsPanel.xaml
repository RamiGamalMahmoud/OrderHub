<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDraftsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignData Type=local:ViewModel}"
    mc:Ignorable="d">

    <Border
        Width="400"
        Background="#FFFFFF"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6"
        FlowDirection="RightToLeft">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="95" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="65" />
            </Grid.RowDefinitions>

            <!--  =====================================================  -->
            <!--  Header  -->
            <!--  =====================================================  -->

            <Grid Grid.Row="0" Margin="20,12,20,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Close  -->
                <Button
                    Grid.RowSpan="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    BorderThickness="0"
                    Command="{Binding ShowDraftsOrdersCommand}"
                    Cursor="Hand">

                    <icons:MaterialIcon
                        Width="20"
                        Height="20"
                        Foreground="#64748B"
                        Kind="Close" />

                </Button>

                <!--  Title  -->
                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="23"
                        Height="23"
                        VerticalAlignment="Center"
                        Foreground="#315A91"
                        Kind="FileDocumentOutline" />

                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{StaticResource Primary}"
                        Text="الطلبات المعلقة" />

                </StackPanel>

                <!--  Subtitle  -->
                <TextBlock
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Foreground="#64748B"
                    Text="طلبات لم يتم إكمالها بعد, اضغط متابعة لاكمال الطلب أو حذف." />

            </Grid>


            <!--  =====================================================  -->
            <!--  Drafts  -->
            <!--  =====================================================  -->

            <ScrollViewer
                Grid.Row="1"
                Padding="12,5,12,8"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding OrderDraftsDrawerViewModel.Drafts}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <!--  Draft Card  -->
                            <Border
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="#FFFFFF"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="9">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>


                                    <!--  =================================================  -->
                                    <!--  Document Icon  -->
                                    <!--  =================================================  -->

                                    <Border
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Width="52"
                                        Height="52"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#EEF4FF"
                                        CornerRadius="8">

                                        <icons:MaterialIcon
                                            Width="27"
                                            Height="27"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#2563EB"
                                            Kind="FileDocumentOutline" />

                                    </Border>


                                    <!--  =================================================  -->
                                    <!--  Draft Information  -->
                                    <!--  =================================================  -->

                                    <Grid
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="10,0,0,0">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>


                                        <!--  Title + Menu  -->
                                        <Grid Grid.Row="0">

                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#111827"
                                                Text="{Binding UpdatedAtHumanized}" />

                                            <Button
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">

                                                <icons:MaterialIcon
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#64748B"
                                                    Kind="DotsVertical" />

                                            </Button>

                                        </Grid>


                                        <!--  Client  -->
                                        <Grid Grid.Row="1" Margin="0,7,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <icons:MaterialIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#64748B"
                                                Kind="AccountOutline" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#111827">

                                                <Run Foreground="#64748B" Text="العميل: " />

                                                <Run FontWeight="SemiBold" Text="{Binding ClientName}" />

                                            </TextBlock>

                                        </Grid>


                                        <!--  Items Count  -->
                                        <Grid Grid.Row="2" Margin="0,5,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <icons:MaterialIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#64748B"
                                                Kind="ShoppingOutline" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="#64748B">

                                                <Run Text="{Binding ItemsCount}" />

                                                <Run Text=" منتجات" />

                                            </TextBlock>

                                        </Grid>


                                        <!--  Updated  -->
                                        <Grid Grid.Row="3" Margin="0,5,0,0">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <icons:MaterialIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#64748B"
                                                Kind="ClockOutline" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11">

                                                <Run Foreground="#64748B" Text="آخر تعديل: " />

                                                <Run
                                                    FontWeight="SemiBold"
                                                    Foreground="#111827"
                                                    Text="{Binding UpdatedAtLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />

                                            </TextBlock>

                                        </Grid>

                                    </Grid>


                                    <!--  =================================================  -->
                                    <!--  Actions  -->
                                    <!--  =================================================  -->

                                    <Grid
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>


                                        <!--  Delete  -->
                                        <Button
                                            Grid.Column="0"
                                            Height="34"
                                            Background="#FFFFFF"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.OrderDraftsDrawerViewModel.DeleteDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand">

                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                                <icons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,5,0"
                                                    Foreground="#DC2626"
                                                    Kind="DeleteOutline" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#DC2626"
                                                    Text="حذف" />

                                            </StackPanel>

                                        </Button>


                                        <!--  Continue  -->
                                        <Button
                                            Grid.Column="2"
                                            Height="34"
                                            Background="#2563EB"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.OrderDraftsDrawerViewModel.OpenDraftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Foreground="White">

                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="متابعة" />

                                                <icons:MaterialIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="5,0,0,0"
                                                    Foreground="White"
                                                    Kind="ArrowLeft" />

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>


            <!--  =====================================================  -->
            <!--  Delete All  -->
            <!--  =====================================================  -->

            <Button
                Grid.Row="2"
                Height="50"
                Margin="12,0,12,10"
                HorizontalAlignment="Stretch"
                Command="{Binding OrderDraftsDrawerViewModel.DeleteAllDraftsCommand}"
                Cursor="Hand"
                FontSize="16">

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="17"
                        Height="17"
                        Margin="0,0,7,0"
                        Foreground="#DC2626"
                        Kind="DeleteSweepOutline" />

                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="#DC2626"
                        Text="حذف جميع المسودات" />

                </StackPanel>

            </Button>


        </Grid>

    </Border>

</UserControl>
