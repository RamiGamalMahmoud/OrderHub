<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.Paginator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <DockPanel LastChildFill="True">

        <TextBlock
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="#6B7280"
            Text="{Binding PaginationSummary}" />

        <StackPanel
            DockPanel.Dock="Right"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">

            <Button
                Width="100"
                Height="30"
                Margin="0,0,6,0"
                Padding="10,2"
                Command="{Binding NextPageCommand}"
                Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="ChevronLeft" />
                    <TextBlock Text="التالي" />
                </StackPanel>
            </Button>

            <Button
                Width="100"
                Height="30"
                Padding="10,2"
                Command="{Binding PreviousPageCommand}"
                Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text=" السابق" />
                    <icons:MaterialIcon Kind="ChevronRight" />
                </StackPanel>
            </Button>


        </StackPanel>

    </DockPanel>

</UserControl>
