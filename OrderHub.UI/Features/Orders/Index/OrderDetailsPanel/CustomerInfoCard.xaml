<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.CustomerInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index.OrderDetailsPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Index"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,8"
        Padding="10"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,8">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    DockPanel.Dock="Right"
                    Foreground="#2563EB"
                    Kind="AccountOutline" />

                <TextBlock
                    Margin="6,0,0,0"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="معلومات العميل" />

            </DockPanel>

            <!--  Name  -->

            <Grid Margin="0,0,0,6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <icons:MaterialIcon
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Foreground="#64748B"
                    Kind="Account" />

                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />

            </Grid>

            <!--  Phone  -->

            <Grid Margin="0,0,0,6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <icons:MaterialIcon
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    Foreground="#64748B"
                    Kind="Phone" />

                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FlowDirection="LeftToRight"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding PhoneNumber}" />

            </Grid>

            <!--  Address  -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <icons:MaterialIcon
                    Width="14"
                    Height="14"
                    VerticalAlignment="Top"
                    Foreground="#64748B"
                    Kind="MapMarker" />

                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    FontSize="12"
                    Text="{Binding Address}"
                    TextWrapping="Wrap" />

            </Grid>

        </StackPanel>

    </Border>

</UserControl>