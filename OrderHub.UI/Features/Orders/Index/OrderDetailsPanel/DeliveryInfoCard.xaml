<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.DeliveryInfoCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:OrderHub.Domain.Enums;assembly=OrderHub.Domain"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Index"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,8"
        Padding="10"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,8">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    DockPanel.Dock="Right"
                    Foreground="#2563EB"
                    Kind="TruckDeliveryOutline" />

                <TextBlock
                    Margin="6,0,0,0"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="التوصيل" />

            </DockPanel>

            <!--  Delivery Method  -->

            <Border
                Margin="0,0,0,8"
                Padding="6,2"
                HorizontalAlignment="Left"
                Background="#DBEAFE"
                CornerRadius="5">

                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#2563EB"
                    Text="{Binding DeliveryMethod}" />

            </Border>

        </StackPanel>

    </Border>

</UserControl>