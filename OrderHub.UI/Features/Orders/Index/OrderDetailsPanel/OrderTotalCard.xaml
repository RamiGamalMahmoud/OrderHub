<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.OrderTotalCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Index"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel}"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,8"
        Padding="10"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,10">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    DockPanel.Dock="Right"
                    Foreground="#2563EB"
                    Kind="CashMultiple" />

                <TextBlock
                    Margin="6,0,0,0"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="ملخص الفاتورة" />

            </DockPanel>

            <!--  Products Total  -->

            <Grid Margin="0,0,0,6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="12"
                    Foreground="#4B5563"
                    Text="إجمالي المنتجات" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding ProductsTotal, StringFormat={}{0:N0} ج}" />

            </Grid>

            <!--  Shipping  -->

            <Grid Margin="0,0,0,6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="12"
                    Foreground="#4B5563"
                    Text="تكلفة الشحن" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding ShippingCost, StringFormat={}{0:N0} ج}" />

            </Grid>

            <!--  Discount  -->

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="12"
                    Foreground="#4B5563"
                    Text="الخصم" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#DC2626"
                    Text="{Binding Discount, StringFormat=-{0:N0} ج}" />

            </Grid>

            <Separator Margin="0,0,0,10" />

            <!--  Grand Total  -->

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="13"
                    FontWeight="Bold"
                    Text="الإجمالي النهائي" />

                <TextBlock
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="#2563EB"
                    Text="{Binding GrandTotal, StringFormat={}{0:N0} ج}" />

            </Grid>

            <!--  Payment  -->

            <Border
                Padding="8,5"
                Background="#EFF6FF"
                CornerRadius="5">

                <DockPanel>

                    <icons:MaterialIcon
                        Width="14"
                        Height="14"
                        DockPanel.Dock="Right"
                        Foreground="#2563EB"
                        Kind="CreditCardOutline" />

                    <TextBlock
                        Margin="6,0,0,0"
                        DockPanel.Dock="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding PaymentMethod}" />

                </DockPanel>

            </Border>

        </StackPanel>

    </Border>

</UserControl>