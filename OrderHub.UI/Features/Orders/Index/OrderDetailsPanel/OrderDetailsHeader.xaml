<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.OrderDetailsHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Index"
    mc:Ignorable="d">

    <Border
        Padding="10"
        BorderBrush="#E5E7EB"
        BorderThickness="0,0,0,1">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Title  -->
            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="8,3"
                HorizontalAlignment="Right"
                Background="#DCFCE7"
                CornerRadius="6">

                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#16A34A"
                    Text="{Binding SelectedOrderDetails.Header.OrderStatus}" />

            </Border>

            <TextBlock
                HorizontalAlignment="Left"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#1E3A8A"
                Text="تفاصيل الطلب" />


            <!--  Order Info  -->

            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,10,0,0"
                Orientation="Horizontal">


                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    Text="رقم الطلب :" />

                <TextBlock
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="#1F2937"
                    Text="{Binding SelectedOrderDetails.Header.OrderNumber}" />



            </StackPanel>

        </Grid>

    </Border>

</UserControl>