<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.ProductsSummaryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:OrderHub.UI.Features.Orders.Index"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,8"
        Padding="10"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,8">

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                    <icons:MaterialIcon
                        Width="16"
                        Height="16"
                        Foreground="#2563EB"
                        Kind="PackageVariantClosed" />

                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="محتويات الطلب" />

                </StackPanel>

                <Border
                    Padding="6,2"
                    Background="#EEF2FF"
                    CornerRadius="10"
                    DockPanel.Dock="Left">

                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="#4338CA"
                        Text="{Binding Items.Count}" />

                </Border>

            </DockPanel>

            <!--  Column Headers  -->

            <Grid Margin="0,0,0,6">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="65" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#6B7280"
                    Text="المنتج" />

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#6B7280"
                    Text="الكمية" />

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="#6B7280"
                    Text="الإجمالي" />

            </Grid>

            <!--  Products  -->

            <ItemsControl ItemsSource="{Binding Items}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,4"
                            Padding="6"
                            Background="#F8FAFC"
                            CornerRadius="5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>

                                <!--  Product  -->

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="{Binding ProductName}"
                                    TextTrimming="CharacterEllipsis" />

                                <!--  Qty  -->

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding Quantity}" />

                                <!--  Total  -->

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#2563EB"
                                    Text="{Binding Total, StringFormat={}{0:N0}}" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </Border>

</UserControl>