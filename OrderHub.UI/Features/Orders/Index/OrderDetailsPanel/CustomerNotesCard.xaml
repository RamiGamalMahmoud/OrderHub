<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderDetailsPanel.CustomerNotesCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Margin="0,0,0,8"
        Padding="10"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>

            <!--  Header  -->

            <DockPanel Margin="0,0,0,10">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    DockPanel.Dock="Right"
                    Foreground="#2563EB"
                    Kind="NoteTextOutline" />

                <TextBlock
                    Margin="6,0,0,0"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="ملاحظات العميل" />

            </DockPanel>

            <!--  Notes  -->

            <Border
                Padding="8"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="5">

                <TextBlock
                    FontSize="12"
                    Foreground="#374151"
                    Text="{Binding Notes}"
                    TextWrapping="Wrap" />

            </Border>

        </StackPanel>

    </Border>

</UserControl>