<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
        Base style for all action buttons.
        The control is intentionally compact because
        this panel should consume as little vertical space as possible.
        -->
        <Style
            x:Key="ActionButtonStyle"
            BasedOn="{StaticResource ButtonDefault}"
            TargetType="Button">

            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#F3EEFF" />
            <Setter Property="Foreground" Value="#6D4AFF" />
            <Setter Property="BorderBrush" Value="#DDD2FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Style.Triggers>

                <!--  Hover  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9DFFF" />
                    <Setter Property="Foreground" Value="#5B3CC4" />
                    <Setter Property="BorderBrush" Value="#CBB9FF" />
                </Trigger>

                <!--  Pressed  -->
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DCCBFF" />
                    <Setter Property="Foreground" Value="#4B2FA3" />
                </Trigger>

                <!--  Disabled  -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>

            </Style.Triggers>

        </Style>


        <!--  WhatsApp buttons  -->
        <Style
            x:Key="WhatsAppButtonStyle"
            BasedOn="{StaticResource ActionButtonStyle}"
            TargetType="Button">

            <Setter Property="Background" Value="#E8F7EE" />
            <Setter Property="Foreground" Value="#16A34A" />

        </Style>

    </UserControl.Resources>


    <!--  ================================================================  -->
    <!--  Main Action Card  -->
    <!--  ================================================================  -->

    <Border
        Padding="6"
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="6">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  ============================================================  -->
            <!--  WhatsApp Group  -->
            <!--  ============================================================  -->

            <Border
                Grid.Column="2"
                Padding="8,5"
                Background="#F0FDF4"
                BorderBrush="#DCFCE7"
                BorderThickness="1"
                CornerRadius="5">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>


                    <!--  Header  -->

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="16"
                            Height="16"
                            Foreground="{StaticResource SuccessBrush}"
                            Kind="Whatsapp" />

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#166534"
                            Text="إرسال عبر واتساب" />

                    </StackPanel>


                    <!--  Buttons  -->

                    <WrapPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  =================================================  -->
                        <!--  الكل  -->
                        <!--  =================================================  -->

                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.BroadcastOrderCommand}" Content="الكل">

                            <Button.Style>

                                <Style BasedOn="{StaticResource WhatsAppButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOrder.CanBroadcastAll}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOrder.IsAllMessageSent}" Value="True">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Button.Style>

                        </Button>


                        <!--  =================================================  -->
                        <!--  العميل  -->
                        <!--  =================================================  -->

                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.BroadcastClientCommand}" CommandParameter="{Binding SelectedOrder}">

                            <Button.Style>

                                <Style BasedOn="{StaticResource WhatsAppButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOrder.HasClientRecipient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOrder.IsClientMessageSent}" Value="True">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Button.Style>

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="15"
                                    Height="15"
                                    Kind="Account" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="العميل" />

                            </StackPanel>

                        </Button>


                        <!--  =================================================  -->
                        <!--  المندوب  -->
                        <!--  =================================================  -->

                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.BroadcastDeliverymanCommand}" CommandParameter="{Binding SelectedOrder}">

                            <Button.Style>

                                <Style BasedOn="{StaticResource WhatsAppButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOrder.HasDeliverymanRecipient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOrder.IsDeliverymanMessageSent}" Value="True">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Button.Style>

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="15"
                                    Height="15"
                                    Kind="Motorcycle" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="المندوب" />

                            </StackPanel>

                        </Button>


                        <!--  =================================================  -->
                        <!--  شركة الشحن  -->
                        <!--  =================================================  -->

                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.BroadcastShippingCarrierCommand}" CommandParameter="{Binding SelectedOrder}">

                            <Button.Style>

                                <Style BasedOn="{StaticResource WhatsAppButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOrder.HasShippingCarrierRecipient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOrder.IsShippingCarrierMessageSent}" Value="True">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Button.Style>

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="15"
                                    Height="15"
                                    Kind="Truck" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="شركة الشحن" />

                            </StackPanel>

                        </Button>


                        <!--  =================================================  -->
                        <!--  المورد  -->
                        <!--  =================================================  -->

                        <Button Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.BroadcastSupplierCommand}" CommandParameter="{Binding SelectedOrder}">

                            <Button.Style>

                                <Style BasedOn="{StaticResource WhatsAppButtonStyle}" TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedOrder.HasSupplierRecipient}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedOrder.IsSupplierMessageSent}" Value="True">
                                            <Setter Property="Background" Value="#16A34A" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>

                            </Button.Style>

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="15"
                                    Height="15"
                                    Kind="PackageVariant" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="المورد" />

                            </StackPanel>

                        </Button>

                    </WrapPanel>

                </Grid>

            </Border>


            <!--  ============================================================  -->
            <!--  Order Actions Group  -->
            <!--  ============================================================  -->

            <Border
                Grid.Column="0"
                Padding="8,5"
                Background="#F5F3FF"
                BorderBrush="#E9E5FF"
                BorderThickness="1"
                CornerRadius="5">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>


                    <!--  Header  -->

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,3"
                        Orientation="Horizontal">

                        <icons:MaterialIcon
                            Width="16"
                            Height="16"
                            Foreground="{StaticResource Primary}"
                            Kind="CogOutline" />

                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#4C1D95"
                            Text="إجراءات الطلب" />

                    </StackPanel>


                    <!--  Buttons  -->

                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <!--  إنشاء فاتورة  -->

                        <Button
                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.GenerateInvoiceCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            IsEnabled="{Binding HasSelectedOrder}"
                            Style="{StaticResource ActionButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FilePdfBox" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="فاتورة" />

                            </StackPanel>

                        </Button>

                        <!--  سند تسليم  -->
                        <Button
                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.CreateDeliveryNoteCommand}"
                            IsEnabled="{Binding HasSelectedOrder}"
                            Style="{StaticResource ActionButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="19"
                                    Height="19"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    Kind="PackageVariantClosedCheck" />

                                <TextBlock VerticalAlignment="Center" Text="سند تسليم" />

                            </StackPanel>
                        </Button>


                        <!--  تعديل  -->

                        <Button
                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.ShowEditCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            IsEnabled="{Binding HasSelectedOrder}"
                            Style="{StaticResource ActionButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Kind="Edit" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="تعديل" />

                            </StackPanel>

                        </Button>


                        <!--  حذف  -->

                        <Button
                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.DeleteCommand}"
                            CommandParameter="{Binding SelectedOrder}"
                            Foreground="{StaticResource DangerBrush}"
                            IsEnabled="{Binding HasSelectedOrder}"
                            Style="{StaticResource ActionButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <icons:MaterialIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteOutline" />

                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="حذف" />

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</UserControl>