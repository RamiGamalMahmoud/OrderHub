<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="إدارة الطلبات" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن طلب باسم العميل ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Height="40"
                    Margin="0,0,8,0"
                    Command="{Binding ToggleSummaryCommand}"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="HamburgerMenu" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="{Binding SummaryToggleText}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Height="40"
                    hc:BorderElement.CornerRadius="7"
                    Background="#facc15"
                    Command="{Binding ShowCreateCommand}"
                    Cursor="Hand"
                    Foreground="Black">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="Plus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="إنشاء طلب جديد" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <local:OrderFiltersBar Grid.Row="1" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                d:ItemsSource="{d:SampleData}"
                AutoGenerateColumns="False"
                GridLinesVisibility="Vertical"
                IsReadOnly="True"
                ItemsSource="{Binding Orders, IsAsync=True}"
                VerticalGridLinesBrush="LightGray">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Binding="{Binding OrderNumber}"
                        FontWeight="DemiBold"
                        Header="رقم الطلب"
                        IsReadOnly="False" />

                    <DataGridTextColumn
                        Binding="{Binding ClientName}"
                        Header="اسم العميل"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn
                        Width="200"
                        Header="حالة الطلب"
                        SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <local:OrderStatusComponent IsEnabled="{Binding CanEdit}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="200"
                        Header="وسيلة الدفع"
                        SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    Cursor="Hand"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.PaymentMethods}"
                                    SelectedItem="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Binding="{Binding TotalPrice}" Header="إجمالي الطلب" />

                    <DataGridTemplateColumn Header="رقم الهاتف">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FlowDirection="LeftToRight"
                                    FontWeight="DemiBold"
                                    Text="{Binding ClientPhoneNumber}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd hh:mm tt}}"
                        Header="التاريخ"
                        IsReadOnly="True" />

                    <DataGridTemplateColumn Header="خيارات">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <buttons:ButtonEdit />
                                    <buttons:ButtonDelete Margin="5,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon
                                    Width="20"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Kind="Whatsapp" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Text="ارسال" />
                            </StackPanel>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <local:MessagingButtons />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel
                Grid.Row="1"
                Margin="0,10,0,0"
                LastChildFill="True">
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    FlowDirection="LeftToRight"
                    Orientation="Horizontal">
                    <Button
                        Height="auto"
                        Margin="0,0,8,0"
                        Command="{Binding PreviousPageCommand}"
                        Content="السابق" />
                    <Button
                        Height="auto"
                        Command="{Binding NextPageCommand}"
                        Content="التالي" />
                </StackPanel>

                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontWeight="DemiBold"
                    Text="{Binding PaginationSummary}" />
            </DockPanel>

            <StackPanel
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="12,0,0,0"
                Visibility="{Binding IsSummaryExpanded, Converter={converters:BoolToVisibilityConverter}}">
                <local:OrderSummaryPanel />
            </StackPanel>
        </Grid>


    </Grid>
</UserControl>
