<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <buttons:ButtonAdd />
            <buttons:ButtonRefresh Margin="5,0" />
            <Button Command="{Binding LoadCommand}" />
        </StackPanel>


        <DataGrid
            Grid.Row="1"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Vertical"
            IsReadOnly="True"
            ItemsSource="{Binding Orders, IsAsync=True}"
            VerticalGridLinesBrush="LightGray">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Binding="{Binding OrderNumber}"
                    Header="رقم الطلب"
                    IsReadOnly="True" />

                <DataGridTextColumn Binding="{Binding ClientName}" Header="اسم العميل" />

                <DataGridTextColumn Binding="{Binding ContactWay}" Header="طريقة التواصل" />

                <DataGridTemplateColumn Header="حالة الطلب" SortMemberPath="OrderStatus.DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:OrderStatusComponent />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding TotalPrice}" Header="إجمالي الطلب" />

                <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="رقم الهاتف" />

                <DataGridTextColumn Binding="{Binding CreatedAt}" Header="التاريخ" />

                <DataGridTemplateColumn Header="خيارات">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <buttons:ButtonEdit />
                                <buttons:ButtonDelete Margin="5,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
