<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="إدارة الطلبات" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن طلب باسم العميل ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Grid.Column="2"
                    Height="40"
                    hc:BorderElement.CornerRadius="7"
                    Background="#facc15"
                    Command="{Binding ShowCreateCommand}"
                    Cursor="Hand"
                    Foreground="Black">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="Plus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="إنشاء طلب جديد" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <DataGrid
            Grid.Row="1"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Vertical"
            IsReadOnly="True"
            ItemsSource="{Binding Orders, IsAsync=True}"
            VerticalGridLinesBrush="LightGray">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Binding="{Binding OrderNumber}"
                    FontWeight="DemiBold"
                    Header="رقم الطلب"
                    IsReadOnly="False" />

                <DataGridTextColumn
                    Binding="{Binding ClientName}"
                    Header="اسم العميل"
                    IsReadOnly="True" />

                <DataGridTemplateColumn
                    Width="200"
                    Header="حالة الطلب"
                    SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:OrderStatusComponent IsEnabled="{Binding CanEdit}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="200"
                    Header="وسيلة الدفع"
                    SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                Cursor="Hand"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.PaymentMethods}"
                                SelectedItem="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding TotalPrice}" Header="إجمالي الطلب" />

                <DataGridTemplateColumn Header="رقم الهاتف">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontWeight="DemiBold"
                                Text="{Binding ClientPhoneNumber}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Binding="{Binding CreatedAt}"
                    Header="التاريخ"
                    IsReadOnly="True" />

                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon
                                Width="20"
                                Foreground="{StaticResource SuccessBrush}"
                                Kind="Whatsapp" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="ارسال" />
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Height="auto"
                                    Margin="5,0"
                                    BorderThickness="0"
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastOrderCommand}"
                                    CommandParameter="{Binding}"
                                    Content="All"
                                    Cursor="Hand" />
                                <Button
                                    Height="auto"
                                    Margin="5,0"
                                    BorderThickness="0"
                                    Content="عميل"
                                    Cursor="Hand" />
                                <Button
                                    Height="auto"
                                    Margin="5,0"
                                    BorderThickness="0"
                                    Content="مورد"
                                    Cursor="Hand" />
                                <Button
                                    Height="auto"
                                    Margin="5,0"
                                    BorderThickness="0"
                                    Content="شركة شحن"
                                    Cursor="Hand" />
                                <Button
                                    Height="auto"
                                    Margin="5,0"
                                    BorderThickness="0"
                                    Content="مندوب"
                                    Cursor="Hand" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
