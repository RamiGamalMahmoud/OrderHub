<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="MessageRecipientButtonStyle"
            BasedOn="{StaticResource ButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#e5e7eb" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="DemiBold"
                Text="إدارة الطلبات" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <hc:SearchBar
                    Width="300"
                    VerticalAlignment="Center"
                    hc:InfoElement.Placeholder="ابحث عن طلب باسم العميل ..."
                    hc:InfoElement.ShowClearButton="True"
                    Style="{StaticResource SearchBarPlus}"
                    Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                        <TextBlock
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="تصفية" />
                    </StackPanel>
                </Button>

            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button
                    Grid.Column="2"
                    Height="40"
                    hc:BorderElement.CornerRadius="7"
                    Background="#facc15"
                    Command="{Binding ShowCreateCommand}"
                    Cursor="Hand"
                    Foreground="Black">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon
                            Width="20"
                            Margin="5,0"
                            Kind="Plus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="DemiBold"
                            Text="إنشاء طلب جديد" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>


        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,8"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontWeight="DemiBold"
                Text="من" />
            <DatePicker
                Width="140"
                Margin="0,0,12,0"
                Cursor="Hand"
                SelectedDate="{Binding FromDate}" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                FontWeight="DemiBold"
                Text="إلى" />
            <DatePicker
                Width="140"
                Cursor="Hand"
                SelectedDate="{Binding ToDate}" />
        </StackPanel>

        <DataGrid
            Grid.Row="2"
            d:ItemsSource="{d:SampleData}"
            AutoGenerateColumns="False"
            GridLinesVisibility="Vertical"
            IsReadOnly="True"
            ItemsSource="{Binding Orders, IsAsync=True}"
            VerticalGridLinesBrush="LightGray">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Binding="{Binding OrderNumber}"
                    FontWeight="DemiBold"
                    Header="رقم الطلب"
                    IsReadOnly="False" />

                <DataGridTextColumn
                    Binding="{Binding ClientName}"
                    Header="اسم العميل"
                    IsReadOnly="True" />

                <DataGridTemplateColumn
                    Width="200"
                    Header="حالة الطلب"
                    SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:OrderStatusComponent IsEnabled="{Binding CanEdit}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn
                    Width="200"
                    Header="وسيلة الدفع"
                    SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                Cursor="Hand"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.PaymentMethods}"
                                SelectedItem="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding TotalPrice}" Header="إجمالي الطلب" />

                <DataGridTemplateColumn Header="رقم الهاتف">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                FlowDirection="LeftToRight"
                                FontWeight="DemiBold"
                                Text="{Binding ClientPhoneNumber}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn
                    Binding="{Binding CreatedAt}"
                    Header="التاريخ"
                    IsReadOnly="True" />

                <DataGridTemplateColumn Header="خيارات">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <buttons:ButtonEdit />
                                <buttons:ButtonDelete Margin="5,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon
                                Width="20"
                                Foreground="{StaticResource SuccessBrush}"
                                Kind="Whatsapp" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="ارسال" />
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastOrderCommand}"
                                    CommandParameter="{Binding}"
                                    Content="All"
                                    IsEnabled="{Binding CanBroadcastAll}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource MessageRecipientButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllMessageSent}" Value="True">
                                                    <Setter Property="Background" Value="#16a34a" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastClientCommand}"
                                    CommandParameter="{Binding}"
                                    Content="عميل"
                                    IsEnabled="{Binding HasClientRecipient}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource MessageRecipientButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsClientMessageSent}" Value="True">
                                                    <Setter Property="Background" Value="#16a34a" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastSupplierCommand}"
                                    CommandParameter="{Binding}"
                                    Content="مورد"
                                    IsEnabled="{Binding HasSupplierRecipient}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource MessageRecipientButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSupplierMessageSent}" Value="True">
                                                    <Setter Property="Background" Value="#16a34a" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastShippingCarrierCommand}"
                                    CommandParameter="{Binding}"
                                    Content="شركة شحن"
                                    IsEnabled="{Binding HasShippingCarrierRecipient}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource MessageRecipientButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsShippingCarrierMessageSent}" Value="True">
                                                    <Setter Property="Background" Value="#16a34a" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button
                                    Command="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=DataContext.BroadcastDeliverymanCommand}"
                                    CommandParameter="{Binding}"
                                    Content="مندوب"
                                    IsEnabled="{Binding HasDeliverymanRecipient}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource MessageRecipientButtonStyle}" TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDeliverymanMessageSent}" Value="True">
                                                    <Setter Property="Background" Value="#16a34a" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel
            Grid.Row="3"
            Margin="0,10,0,0"
            LastChildFill="False">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontWeight="DemiBold"
                Text="{Binding PaginationSummary}" />

            <StackPanel
                DockPanel.Dock="Right"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    Height="auto"
                    Margin="0,0,8,0"
                    Command="{Binding PreviousPageCommand}"
                    Content="السابق" />
                <Button
                    Height="auto"
                    Command="{Binding NextPageCommand}"
                    Content="التالي" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
