<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.View"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:OrderHub.UI.Components.Buttons"
    xmlns:converters="clr-namespace:Hoax.WpfConverters;assembly=Hoax.WpfConverters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:local="clr-namespace:OrderHub.UI.Features.Orders.Index"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:orderDetailsPanel="clr-namespace:OrderHub.UI.Features.Orders.Index.OrderDetailsPanel"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=local:ViewModel}"
    x:ClassModifier="internal"
    FontFamily="{StaticResource FontFamily}"
    mc:Ignorable="d">

    <hc:SimplePanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="DemiBold"
                    Text="إدارة الطلبات" />

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <hc:SearchBar
                        Width="300"
                        VerticalAlignment="Center"
                        hc:InfoElement.Placeholder="ابحث عن طلب باسم العميل ..."
                        hc:InfoElement.ShowClearButton="True"
                        Style="{StaticResource SearchBarPlus}"
                        Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Width="20" Kind="FilterVariant" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Text="تصفية" />
                        </StackPanel>
                    </Button>

                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="0,0,8,0"
                        Command="{Binding ShowDraftsOrdersCommand}"
                        Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon
                                Width="20"
                                Margin="5,0"
                                Kind="ReceiptClockOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="DemiBold"
                                Text="الطلبات المعلقة" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DangerBrush}"
                                Text="{Binding OrderDraftsDrawerViewModel.Drafts.Count}" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="2"
                        Height="30"
                        hc:BorderElement.CornerRadius="7"
                        Background="#facc15"
                        Command="{Binding ShowCreateCommand}"
                        Cursor="Hand"
                        Foreground="Black">
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon
                                Width="20"
                                Margin="5,0"
                                Kind="Plus" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="DemiBold"
                                Text="إنشاء طلب جديد" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>


            <local:OrderFiltersBar Grid.Row="1" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <local:OrdersTable />

                <local:Paginator Grid.Row="1" Margin="0,6,0,0" />

                <orderDetailsPanel:Panel
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    DataContext="{Binding OrderDetailsPanelViewModel}" />

            </Grid>


        </Grid>
        <hc:Drawer
            Margin="0,200,0,0"
            Dock="Left"
            IsOpen="{Binding IsDraftsOrderOpened}"
            OpacityMask="{StaticResource Primary}"
            ShowMode="Cover">
            <local:OrderDraftsPanel />
        </hc:Drawer>
    </hc:SimplePanel>
</UserControl>
