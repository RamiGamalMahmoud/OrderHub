<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderFiltersBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="الدفع" />
        <ComboBox
            Width="160"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding PaymentMethodFilters}"
            SelectedItem="{Binding SelectedPaymentMethod}" />
        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="الحالة" />
        <ComboBox
            Width="160"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding OrderStatusFilters}"
            SelectedItem="{Binding SelectedOrderStatus}" />
        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="من" />
        <DatePicker
            Width="140"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Cursor="Hand"
            SelectedDate="{Binding FromDate}" />
        <TextBlock
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            FontWeight="DemiBold"
            Text="إلى" />
        <DatePicker
            Width="140"
            VerticalAlignment="Center"
            Cursor="Hand"
            SelectedDate="{Binding ToDate}" />
        <StackPanel Margin="12,0,0,0" Orientation="Horizontal">
            <Button
                Height="auto"
                Padding="0"
                BorderThickness="0"
                Command="{Binding SetDayCommand}"
                CommandParameter="-1"
                Cursor="Hand">
                <icons:MaterialIcon
                    Width="20"
                    Height="20"
                    Kind="ChevronRight" />
            </Button>

            <Button
                Height="auto"
                Margin="5,0"
                Command="{Binding SetTodayCommand}"
                Content="اليوم"
                Cursor="Hand" />

            <Button
                Height="auto"
                Padding="0"
                BorderThickness="0"
                Command="{Binding SetDayCommand}"
                CommandParameter="1"
                Cursor="Hand">
                <icons:MaterialIcon
                    Width="20"
                    Height="20"
                    Kind="ChevronLeft" />
            </Button>
        </StackPanel>
        <Button
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding SetCurrentWeekCommand}"
            Content="الأسبوع الحالي"
            Cursor="Hand" />
        <Button
            Height="auto"
            Margin="8,0,0,0"
            Command="{Binding SetCurrentMonthCommand}"
            Content="الشهر الحالي"
            Cursor="Hand" />
    </StackPanel>
</UserControl>
