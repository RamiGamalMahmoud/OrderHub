<UserControl
    x:Class="OrderHub.UI.Features.Orders.Index.OrderFiltersBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal"
                Margin="0,0,0,6"
                VerticalAlignment="Center">

        <!-- Payment -->

        <TextBlock
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Text="الدفع"/>

        <ComboBox
            Width="145"
            Height="30"
            Margin="0,0,10,0"
            Cursor="Hand"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding PaymentMethodFilters}"
            SelectedItem="{Binding SelectedPaymentMethod}"/>

        <!-- Status -->

        <TextBlock
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Text="الحالة"/>

        <ComboBox
            Width="145"
            Height="30"
            Margin="0,0,10,0"
            Cursor="Hand"
            DisplayMemberPath="DisplayName"
            ItemsSource="{Binding OrderStatusFilters}"
            SelectedItem="{Binding SelectedOrderStatus}"/>

        <!-- Date -->

        <TextBlock
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Text="من"/>

        <DatePicker
            Width="125"
            Height="30"
            Margin="0,0,10,0"
            Cursor="Hand"
            SelectedDate="{Binding FromDate}"/>

        <TextBlock
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Text="إلى"/>

        <DatePicker
            Width="125"
            Height="30"
            Cursor="Hand"
            SelectedDate="{Binding ToDate}"/>

        <!-- Quick Navigation -->

        <StackPanel Orientation="Horizontal"
                    Margin="10,0,0,0">

            <Button
                Width="28"
                Height="28"
                Padding="0"
                BorderThickness="0"
                Cursor="Hand"
                Command="{Binding SetDayCommand}"
                CommandParameter="-1">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    Kind="ChevronRight"/>

            </Button>

            <Button
                Height="28"
                Margin="4,0"
                Padding="10,2"
                Cursor="Hand"
                Command="{Binding SetTodayCommand}"
                Content="اليوم"/>

            <Button
                Width="28"
                Height="28"
                Padding="0"
                BorderThickness="0"
                Cursor="Hand"
                Command="{Binding SetDayCommand}"
                CommandParameter="1">

                <icons:MaterialIcon
                    Width="16"
                    Height="16"
                    Kind="ChevronLeft"/>

            </Button>

        </StackPanel>

        <!-- Quick Filters -->

        <Button
            Height="28"
            Margin="6,0,0,0"
            Padding="10,2"
            Cursor="Hand"
            Command="{Binding SetCurrentWeekCommand}"
            Content="الأسبوع الحالي"/>

        <Button
            Height="28"
            Margin="6,0,0,0"
            Padding="10,2"
            Cursor="Hand"
            Command="{Binding SetCurrentMonthCommand}"
            Content="الشهر الحالي"/>

    </StackPanel>

</UserControl>